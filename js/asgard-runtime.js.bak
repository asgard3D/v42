      applyOfficialDefaultCharacterAppearanceIfAny();
      state.player = makePlayer(); clearStarterEquipmentForCharacterCreation(); applyClassVisual(); applyHairStyle(state.hairStyle || 'shortCurl', false); applyCharacterAppearance(state.player); state.player.visible = false;
      clearWorld(); scene.background = new THREE.Color(0x050a12); scene.fog = null; document.getElementById('loadbar').style.width = '80%';
      document.getElementById('loadbar').style.width = '100%'; setTimeout(() => document.getElementById('loading').style.display = 'none', 300); state.dead = false; document.getElementById('deathOverlay').classList.remove('show');
      updateUI(); showAuthScreen();
    }
    let __bootOK = false; window.__ASGARD_BOOT_PROMISE__ = boot(); window.__ASGARD_BOOT_PROMISE__.then(() => {__bootOK = true; initMobileMode(); syncGameViewport(isMobileMode()); updateFullscreenUI(); updateAutoBattleButtons(); loop();}).catch(err => {console.error(err); const l = document.getElementById('loading'); if (l) {l.innerHTML = '<div class="loadbox"><b>遊戲啟動失敗</b><p style="font-size:13px;color:#ffd6d6">' + String(err && err.message || err).replace(/</g, '&lt;') + '</p><p style="font-size:11px;color:#aeb9c8">請按 F12 → Console 查看完整錯誤。</p></div>'; l.style.display = 'grid'} });
  