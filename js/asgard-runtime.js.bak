      round: {name: '圓眼', desc: '自然圓形', scale: [.90, .92], rotation: 0},
      sharp: {name: '銳利眼', desc: '外角上挑', scale: [1.12, .66], rotation: 0.05},
      sleepy: {name: '慵懶眼', desc: '細長半瞇', scale: [1.14, .42], rotation: 0},
      soft: {name: '柔和眼', desc: '微垂圓杏眼', scale: [1.02, .76], rotation: -0.02},
      star: {name: '星瞳', desc: '大眼星光', scale: [1.08, .98], rotation: 0},
      wolf: {name: '狼尾參考眼', desc: '較小偏橢圓・柔和眼尾', scale: [.80, .86], rotation: 0.01}
    };
    const EYE_COLOR_INFO = {
      sky: {name: '天空藍', hex: 0x4f91d2, highlight: 0xffffff},
      emerald: {name: '翡翠綠', hex: 0x4fa875, highlight: 0xffffff},
      violet: {name: '紫水晶', hex: 0x8c67c8, highlight: 0xffffff},
      amber: {name: '琥珀金', hex: 0xd29b43, highlight: 0xffffff},
      rose: {name: '玫瑰粉', hex: 0xd06c91, highlight: 0xffffff},
      ice: {name: '冰晶銀', hex: 0xb8d7ee, highlight: 0xffffff},
      ruby: {name: '紅寶石', hex: 0xb43d4e, highlight: 0xffffff},
      ocean: {name: '深海藍', hex: 0x24507f, highlight: 0xffffff},
      wolf: {name: '狼尾赤棕', hex: 0x6f3438, highlight: 0xffffff}
    };
    const MOUTH_STYLE_INFO = {
      none: {name: '無口', desc: '不顯示嘴部'},
      smile: {name: '微笑', desc: '柔和笑弧'},
      small: {name: '小嘴', desc: '小巧自然'},
      open: {name: '開口', desc: '戰鬥／活潑表情'},
      pout: {name: '嘟嘴', desc: '小巧嘟唇'},
      cat: {name: '貓咪嘴', desc: '可愛 W 型'},
      neutral: {name: '平嘴', desc: '簡潔中性'}
    };
    const HAIR_STYLE_INFO = {
      shortCurl: {name: '狼尾頭', icon: '✦', desc: '狼尾頭・蓬鬆層次・後頸延伸', category: '狼尾頭'},
      highPony: {name: '高馬尾', icon: '♧', desc: '髮套底層・可自行設計', category: '高馬尾'},
      mediumLayer: {name: '中長層次', icon: '✦', desc: '髮套底層・可自行設計', category: '中長層次'},
      buzzCut: {name: '短寸頭', icon: '▦', desc: '髮套底層・可自行設計', category: '短寸頭'},
      samuraiLong: {name: '武士長髮', icon: '⚔', desc: '髮套底層・可自行設計', category: '武士長髮'},
      straightLong: {name: '垂直長髮', icon: '│', desc: '髮套底層・可自行設計', category: '垂直長髮'}
    };
    const FEMALE_HAIR_STYLE_INFO = HAIR_STYLE_INFO;
    const MALE_HAIR_STYLE_INFO = HAIR_STYLE_INFO;
    const LEGACY_HAIR_STYLE_MAP = {
      short: 'shortCurl', spiky: 'shortCurl', side: 'mediumLayer', undercut: 'buzzCut', slick: 'shortCurl', wolf: 'mediumLayer',
      curly: 'shortCurl', top_knot: 'samuraiLong', medium: 'mediumLayer', buzz: 'buzzCut', samurai: 'samuraiLong', long: 'straightLong',
      long_center: 'straightLong', ponytail: 'highPony', twin: 'highPony', bob: 'mediumLayer', wavy: 'straightLong', bun: 'samuraiLong',
      low_ponytail: 'highPony', braid: 'mediumLayer', swept: 'mediumLayer', side_braid: 'mediumLayer'
    };
    function getHairStyleInfo() {return HAIR_STYLE_INFO;}
    function normalizeHairStyleId(id) {return HAIR_STYLE_INFO[id] ? id : (LEGACY_HAIR_STYLE_MAP[id] || 'shortCurl');}
    function getHairStyleIds() {return Object.keys(HAIR_STYLE_INFO);}
    function isHairObject(o) {return !!o?.userData?.isHair;}
    function setHairAssetVisibility(hairStyles, style, helmet = null) {
      if (!hairStyles) return null;
      const hairInfo = getHairStyleInfo(); style = normalizeHairStyleId(style); const activeName = 'HairStyle_' + style;
      const mode = helmet ? (HELMET_HAIR_MODE[helmet.visual || ''] || 'hide') : null;
      const sy = Number.isFinite(hairStyles.scale.y) && hairStyles.scale.y > 0 ? hairStyles.scale.y : 1;
      const hasHeadLocal = hairStyles.children.some(g => g?.userData?.hairHeadLocal);
      hairStyles.position.y = hasHeadLocal ? (mode === 'wizard' ? -0.07 : 0) : 2.18 * (1 - sy) + (mode === 'wizard' ? -0.07 : -0.012);
      syncHeadLocalHairGroups(hairStyles);
      let active = null;
      for (const group of hairStyles.children) {
        const isActive = group.name === activeName;
        group.visible = isActive && mode !== 'hide';
        if (isActive) active = group;
        if (!isActive) {group.traverse(o => {if (isHairObject(o)) o.visible = false;}); continue;}
        group.traverse(o => {
          if (!isHairObject(o)) return;
          // V8：不要讓換髮型／裝備時的 visibility pass 把越界髮束重新打開。
          o.visible = o.userData.hairSafetyClipped !== true || !!o.userData.isHairCap;
          if (mode === 'front') o.visible = o.visible && !!o.userData.isFrontHair;
          if (mode === 'wizard') o.visible = !o.userData.isHairCap;
          if (mode === 'all' && o.userData.isHairCap) o.visible = false;
        });
      }
      if (active) {
        const cap = findHairCap(active);
        if (cap) {
          // V10：頭皮殼是底層覆蓋，必須保留；真正的髮型輪廓由外層細髮束完成。
          cap.visible = mode !== 'hide';
          cap.renderOrder = 1;
          hairStyles.userData.activeCap = cap;
        }
        // V4：冠部紋理跟隨當前髮型，避免帽／裝備切換時露出肉色頭皮。
        active.traverse(o => {
          if (o.userData?.isCrownTexture) o.visible = mode !== 'hide';
        });
      }
      return active;
    }
    function applyHairStyle(style, persist = true) {
      style = normalizeHairStyleId(style);
      state.hairStyle = style;
      const hs = state.parts?.hairStyles;
      if (!hs) return;
      const active = setHairAssetVisibility(hs, style, state.equip?.helmet || null);
      if (active) {
        const cap = findHairCap(active);
        if (cap) state.parts.haircap = cap;
      }
      hs.userData.hairSystemVersion = HAIR_SYSTEM_VERSION;
      hs.userData.activeStyle = style;
      applyHairDesignToTarget(state.player);
      if (persist) saveGame();
      updateUI();
      if (persist) toast('💇 已切換髮型：' + getHairStyleInfo()[style].name);
    }

    // ============================================================================
    // HAIR DESIGNER V1 — player-built curved petal accessories
    // One designer profile is stored per hairstyle.  The cap remains the base;
    // these petals are additional layers attached directly to the real head so
    // preview/live models share the same geometry and transform space.
    // ============================================================================
    const HAIR_DESIGN_RESET_TOKEN = 'wolf_cut_v2_face_precision';
    const HAIR_DESIGN_PRESET_VERSION = 15;
    const HAIR_DESIGN_DEFAULT = {
      theta: .52, angle: 90, length: .38, curve: .11, thickness: .055, width: .23,
      x: 0, y: 0, z: 0, roll: 0, twist: 12, hug: .86, rootDrop: .045,
      volume: .72, wave: .12, taper: .82, flare: .10, rootLift: 0, sideSweep: 0
    };
    let hairDesignEditor = {styleId: 'shortCurl', layerIndex: 0, petalIndex: 0};

    // ============================================================================
    // HAIR DESIGN PRESETS V2
    // 01 is the reference short-hair look.  Styles 02-06 use the same curved
    // petal construction, but vary layer count, length, angle distribution and
    // rear/side emphasis so every hairstyle starts with a usable silhouette.
    // Existing player-made designs are never overwritten.
    // ============================================================================
    function presetPetal(p = {}) {return normalizeHairDesignPetal({...HAIR_DESIGN_DEFAULT, ...p});}
    function presetLayer(name, petals) {return {name, petals: petals.map(presetPetal)};}
    function angleList(count, start = 0, span = 360) {return Array.from({length: count}, (_, i) => ((start + (span / count) * i) % 360 + 360) % 360);}
    function layeredRing({theta = .50, length = .30, curve = .08, width = .18, thickness = .036, count = 12, start = 0, z = .016, roll = 0, xBias = 0, yBias = 0} = {}) {
      return angleList(count, start).map((angle, i) => presetPetal({
        theta,
        angle,
        length: length * (1 + (i % 3 === 1 ? .06 : (i % 3 === 2 ? -.035 : 0))),
        curve: curve * (1 + (i % 4 === 1 ? .15 : (i % 4 === 3 ? -.08 : 0))),
        width: width * (1 + (i % 2 ? .035 : 0)),
        thickness,
        z: z + i % 3 * .002,
        roll: roll + (i % 2 ? 3 : -3),
        x: xBias + (i % 5 - 2) * .008,
        y: yBias
      }));
    }
    function frontFringe({theta = .78, length = .28, curve = .075, width = .18, thickness = .036, count = 7, start = 48, z = .044, roll = 0} = {}) {
      return angleList(count, start, 84).map((angle, i) => presetPetal({
        theta: theta + (i % 2 ? .015 : 0), angle, length: length * (1 + (i % 3 ? .06 : -.02)), curve, width, thickness, z: z + i * .0015,
        roll: roll + (i - ((count - 1) / 2)) * 3, x: (i - (count - 1) / 2) * .014, y: i % 2 ? .004 : 0
      }));
    }
    function sideLocks({theta = .82, length = .38, curve = .08, width = .17, thickness = .037, z = .048} = {}) {
      return [55, 70, 110, 125, 215, 230, 250, 270, 290, 310].map((angle, i) => presetPetal({
        theta: theta + (i % 3) * .015, angle, length: length * (1 + (i % 4 === 0 ? .10 : (i % 4 === 1 ? .04 : 0))), curve, width, thickness,
        z: z + (i % 3) * .002, roll: (i < 4 ? 4 : -4), x: (i % 2 ? -.012 : .012), y: (i < 4 ? .006 : -.004)
      }));
    }
    function rearLayer({theta = .72, length = .42, curve = .07, width = .18, thickness = .038, z = .05, count = 9, start = 225, roll = 0} = {}) {
      return angleList(count, start, 110).map((angle, i) => presetPetal({
        theta: theta + (i % 2 ? .012 : 0), angle, length: length * (1 + (i % 3 === 1 ? .07 : (i % 3 === 2 ? -.04 : 0))), curve, width, thickness,
        z: z + i * .0017, roll: roll + (i - ((count - 1) / 2)) * 2.5, x: (i - (count - 1) / 2) * .018, y: -.002
      }));
    }
    function buildHairDesignPresets() {
      const out = Object.fromEntries(getHairStyleIds().map(id => [id, {layers: []}]));

      // V8 reference rebuild:
      // - 01 follows the supplied short-hair reference: dense crown, soft side-sweep,
      //   separated front fringe, then layered rear/nape coverage.
      // - 02-06 intentionally use more crown layers so no scalp/cap boundary is visible.
      // - Rear hair is explicitly built as layered rear locks instead of relying only on
      //   the scalp cap.  High ponytail keeps its separate procedural tail bundle.

      function directedPetals({theta = .30, angles = [], length = .24, curve = .06, width = .19, thickness = .036, z = .02, roll = 0, tiltX = 0, tiltY = 0} = {}) {
        return angles.map((angle, i) => presetPetal({
          theta: theta + (i % 2 ? .008 : 0), angle,
          length: length * (1 + (i % 3 === 1 ? .08 : (i % 3 === 2 ? -.035 : 0))),
          curve: curve * (1 + (i % 4 === 1 ? .14 : 0)),
          width: width * (1 + (i % 2 ? .04 : 0)), thickness,
          z: z + i * .0015, roll: roll + (i - (angles.length - 1) / 2) * 2.2,
          x: tiltX * (i - (angles.length - 1) / 2) * .01, y: tiltY
        }));
      }

      // 01 側分長髮：參照使用者提供的側分中長髮。
      // 特點：頭頂自然側分、左前側較長、右側較短，後腦以多層短束
      // 逐步往頸側收，所有髮根都沿頭部曲面排列，避免露出光頭髮線。
      function sidePartFront() {
        const specs = [
          [44, .24, .052, .186], [58, .26, .055, .19], [72, .29, .060, .194], [86, .31, .064, .198],
          [100, .34, .070, .200], [114, .39, .078, .204], [128, .44, .084, .206], [142, .49, .092, .206],
          [156, .45, .088, .202], [170, .37, .078, .194]
        ];
        return specs.map((q, i) => presetPetal({
          theta: .55 + (i % 3) * .012, angle: q[0], length: q[1], curve: q[2],
          width: q[3], thickness: .038, z: .030 + i * .0017, roll: (i < 4 ? 4 : -2) + (i - 4) * .8,
          x: (i < 5 ? .010 : -.010), y: i < 5 ? .002 : -.002
        }));
      }
      function sidePartLeftSweep() {
        const specs = [
          [108, .39, .075, .190], [120, .44, .082, .194], [132, .51, .090, .198], [144, .57, .100, .200],
          [156, .62, .108, .198], [168, .57, .100, .192]
        ];
        return specs.map((q, i) => presetPetal({
          theta: .69 + (i % 2) * .015, angle: q[0], length: q[1], curve: q[2],
          width: q[3], thickness: .039, z: .043 + i * .0018, roll: -8 + (i - 2) * 2.5,
          x: -.012 + i * .004, y: .004
        }));
      }
      function sidePartRightSide() {
        const specs = [[18, .34, .064, .182], [32, .35, .066, .184], [46, .37, .070, .186], [180, .40, .072, .184], [194, .42, .075, .188], [208, .45, .078, .190]];
        return specs.map((q, i) => presetPetal({
          theta: .76 + (i % 2) * .014, angle: q[0], length: q[1], curve: q[2],
          width: q[3], thickness: .039, z: .048 + i * .0018, roll: i < 3 ? 6 : -5, x: i < 3 ? .012 : -.010, y: -.003
        }));
      }
      function sidePartRear() {
        const specs = [
          [208, .42, .070, .188], [222, .46, .076, .192], [236, .50, .082, .196], [250, .54, .088, .198],
          [264, .57, .092, .200], [278, .55, .090, .198], [292, .51, .084, .196], [306, .47, .078, .192], [320, .43, .072, .188]
        ];
        return specs.map((q, i) => presetPetal({
          theta: .82 + (i % 3) * .014, angle: q[0], length: q[1], curve: q[2],
          width: q[3], thickness: .040, z: .052 + i * .0017, roll: -2 + (i - 4) * 1.5, x: (i - 4) * .006, y: -.004
        }));
      }
      function sidePartNape() {
        const specs = [[214, .33, .060, .184], [228, .38, .066, .188], [242, .43, .072, .192], [256, .47, .078, .194],
        [270, .49, .080, .196], [284, .47, .078, .194], [298, .43, .072, .192], [312, .38, .066, .188], [326, .34, .060, .184]];
        return specs.map((q, i) => presetPetal({
          theta: 1.05 + (i % 2) * .012, angle: q[0], length: q[1], curve: q[2],
          width: q[3], thickness: .040, z: .063 + i * .0016, roll: (i - 4) * 1.2, x: (i - 4) * .005, y: -.006
        }));
      }
      // 01 狼尾頭：取消側分。以對稱碎層冠部 + 額前碎髮 + 左右側層 + 後腦逐層拉長，形成狼尾頭輪廓。
      function sidePartFront() {
        const specs = [
          [46, .22, .050, .186], [58, .24, .054, .190], [70, .27, .058, .194], [82, .31, .062, .198],
          [94, .36, .068, .202], [106, .42, .076, .206], [118, .48, .084, .210], [130, .54, .092, .212],
          [142, .59, .098, .212], [154, .62, .102, .210], [166, .58, .096, .204]
        ];
        return specs.map((q, i) => presetPetal({
          theta: .54 + (i % 3) * .012, angle: q[0], length: q[1], curve: q[2],
          width: q[3], thickness: .039, z: .032 + i * .0017, roll: i < 4 ? 5 : (i - 6) * 1.15,
          x: i < 4 ? .014 : -.014, y: i < 4 ? .003 : -.002
        }));
      }
      function sidePartLeftSweep() {
        const specs = [
          [108, .48, .078, .192], [118, .53, .086, .196], [128, .59, .094, .200], [138, .65, .102, .204],
          [148, .70, .110, .206], [158, .74, .116, .206], [168, .68, .106, .200]
        ];
        return specs.map((q, i) => presetPetal({
          theta: .67 + (i % 2) * .014, angle: q[0], length: q[1], curve: q[2],
          width: q[3], thickness: .040, z: .045 + i * .0018, roll: -10 + (i - 3) * 2.6,
          x: -.015 + i * .004, y: .004
        }));
      }
      function sidePartRightSide() {
        const specs = [[20, .30, .058, .180], [34, .32, .061, .183], [48, .34, .064, .186], [184, .36, .068, .184], [198, .39, .071, .187], [212, .42, .074, .190]];
        return specs.map((q, i) => presetPetal({
          theta: .75 + (i % 2) * .014, angle: q[0], length: q[1], curve: q[2],
          width: q[3], thickness: .039, z: .049 + i * .0018, roll: i < 3 ? 7 : -5, x: i < 3 ? .012 : -.011, y: -.003
        }));
      }
      function sidePartRear() {
        const specs = [
          [204, .44, .070, .190], [218, .49, .076, .194], [232, .55, .082, .198], [246, .60, .088, .202],
          [260, .64, .094, .204], [274, .66, .096, .206], [288, .63, .092, .204], [302, .58, .086, .200],
          [316, .51, .078, .194], [330, .45, .072, .190]
        ];
        return specs.map((q, i) => presetPetal({
          theta: .78 + (i % 3) * .014, angle: q[0], length: q[1], curve: q[2],
          width: q[3], thickness: .040, z: .054 + i * .0017, roll: -2 + (i - 4.5) * 1.5, x: (i - 4.5) * .005, y: -.004
        }));
      }
      function sidePartNape() {
        const specs = [[212, .38, .060, .186], [226, .42, .066, .190], [240, .47, .072, .194], [254, .51, .078, .198],
        [268, .54, .080, .200], [282, .52, .078, .198], [296, .48, .072, .194], [310, .43, .066, .190], [324, .38, .060, .186]];
        return specs.map((q, i) => presetPetal({
          theta: 1.01 + (i % 2) * .012, angle: q[0], length: q[1], curve: q[2],
          width: q[3], thickness: .040, z: .065 + i * .0016, roll: (i - 4) * 1.2, x: (i - 4) * .005, y: -.006
        }));
      }
      // 01 側分長髮 V12：
      // 正面左右兩側增加較長瀏海；後腦使用更寬的背部包覆角度，
      // 並增加多層較長髮片，讓髮帽只作為底層，不再成為可見外輪廓。
      function frontSideSweep(side = 'left') {
        const isLeft = side === 'left';
        const angles = isLeft ? [112, 122, 132, 142, 152, 162] : [18, 28, 38, 48, 58, 68];
        const lens = isLeft ? [.48, .52, .56, .61, .66, .60] : [.43, .46, .49, .53, .57, .53];
        return angles.map((angle, i) => presetPetal({
          theta: .62 + (i % 2) * .013,
          angle,
          length: lens[i],
          curve: .088 + (i % 3) * .006,
          width: .198 + (i % 2) * .006,
          thickness: .040,
          z: .050 + i * .0017,
          roll: isLeft ? -9 + (i - 2) * 2.2 : 8 - (i - 2) * 2.2,
          x: isLeft ? -.012 - i * .002 : .012 + i * .002,
          y: .003
        }));
      }
      function frontSideFrame(side = 'left') {
        const isLeft = side === 'left';
        const angles = isLeft ? [126, 138, 150, 162, 174] : [6, 18, 30, 42, 54];
        return angles.map((angle, i) => presetPetal({
          theta: .78 + (i % 2) * .012,
          angle,
          length: (isLeft ? [.56, .60, .66, .71, .67] : [.50, .54, .58, .63, .59])[i],
          curve: .092 + (i % 3) * .007,
          width: .188 + (i % 2) * .008,
          thickness: .041,
          z: .060 + i * .0017,
          roll: isLeft ? -10 + (i - 2) * 2.4 : 10 - (i - 2) * 2.4,
          x: isLeft ? -.020 - i * .002 : .020 + i * .002,
          y: -.002
        }));
      }
      function rearWrap({theta = .78, length = .54, curve = .085, width = .198, thickness = .041, count = 16, start = 194, span = 172, z = .056, roll = 0} = {}) {
        return angleList(count, start, span).map((angle, i) => presetPetal({
          theta: theta + (i % 3) * .012,
          angle,
          length: length * (1 + (i % 4 === 1 ? .07 : (i % 4 === 2 ? -.035 : 0))),
          curve: curve * (1 + (i % 4 === 1 ? .10 : (i % 4 === 3 ? -.06 : 0))),
          width: width * (1 + (i % 2 ? .025 : 0)),
          thickness,
          z: z + i * .0016,
          roll: roll + (i - (count - 1) / 2) * 1.45,
          x: (i - (count - 1) / 2) * .004,
          y: -.004
        }));
      }

      // 01 狼尾頭：不再使用側分。頭頂密集、前額碎髮、左右鬢角自然分層，後腦從短到長逐層拉到後頸。
      // 所有髮根均以 Head local 曲面為基準，讓髮片像從頭皮長出來；髮尾保持自然向下並帶輕微弧度。
      function wolfCrownLayer(theta, length, curve, width, count = 16, start = 0, z = .02) {
        return layeredRing({theta, length, curve, width, thickness: .038, count, start, z, roll: 0});
      }
      function wolfFront() {
        const angles = [54, 64, 74, 84, 94, 104, 114, 124];
        const lens = [.30, .34, .38, .40, .39, .36, .33, .29];
        return angles.map((angle, i) => presetPetal({theta: .67 + (i % 2) * .012, angle, length: lens[i], curve: .082 + (i % 3) * .006, width: .19 + (i % 2) * .006, thickness: .039, z: .050 + i * .0016, roll: (i - 3.5) * 2.2, x: (i - 3.5) * .012, y: .002}));
      }
      function wolfSide(side = 'left') {
        const left = side === 'left';
        const angles = left ? [108, 120, 132, 144, 156, 168] : [12, 24, 36, 48, 60, 72];
        const lens = left ? [.36, .40, .45, .50, .54, .50] : [.35, .39, .44, .49, .52, .48];
        return angles.map((angle, i) => presetPetal({theta: .70 + (i % 2) * .012, angle, length: lens[i], curve: .086 + (i % 3) * .006, width: .19 + (i % 2) * .006, thickness: .040, z: .055 + i * .0017, roll: left ? -6 + (i - 2) * 2 : 6 - (i - 2) * 2, x: left ? -.012 - i * .002 : .012 + i * .002, y: -.001}));
      }
      function wolfRearLayer(theta, length, curve, width, count = 16, start = 206, span = 148, z = .06) {
        return angleList(count, start, span).map((angle, i) => presetPetal({theta: theta + (i % 3) * .010, angle, length: length * (1 + (i % 4 === 1 ? .06 : (i % 4 === 2 ? -.025 : 0))), curve: curve * (1 + (i % 4 === 1 ? .10 : (i % 4 === 3 ? -.05 : 0))), width: width * (1 + (i % 2 ? .025 : 0)), thickness: .040, z: z + i * .0015, roll: (i - (count - 1) / 2) * 1.4, x: (i - (count - 1) / 2) * .003, y: -.004}));
      }
      // 01 狼尾頭 V15：依照參考圖重新設計。減少過多細碎層數，
      // 改為少量但更厚、更寬、更有體積的髮片；前額、左右與後腦連續覆蓋。
      function wolfTopLayer(theta, length, width, curve, count, start, z) {
        return layeredRing({theta, length, width, curve, thickness: .056, count, start, z, roll: 0, xBias: 0, yBias: 0});
      }
      function wolfFront() {
        const angles = [-38, -22, -8, 8, 24, 40, 56, 72, 88];
        const lens = [.32, .40, .45, .48, .44, .40, .36, .33, .31];
        return angles.map((angle, i) => presetPetal({
          theta: .63 + (i % 3) * .014, angle, length: lens[i], curve: .075 + (i % 3) * .006,
          width: .235 + (i % 2) * .012, thickness: .062, z: .050 + i * .0015,
          roll: (i - 4) * 1.8, twist: 8 + (i % 3) * 4, hug: .91, rootDrop: .052, volume: .80, wave: .14,
          taper: .78, flare: .12, rootLift: .004, sideSweep: (i - 4) * .008
        }));
      }
      function wolfSide(side = 'left') {
        const left = side === 'left';
        const angles = left ? [108, 122, 136, 150, 164] : [16, 30, 44, 58, 72];
        const lens = left ? [.43, .50, .57, .61, .55] : [.40, .46, .52, .57, .52];
        return angles.map((angle, i) => presetPetal({
          theta: .69 + (i % 2) * .015, angle, length: lens[i], curve: .088 + (i % 3) * .007,
          width: .240 + (i % 2) * .010, thickness: .064, z: .056 + i * .0017,
          roll: (left ? -1 : 1) * (-7 + (i - 2) * 2.1), twist: (left ? -14 : 14) + (i % 3) * 4,
          hug: .92, rootDrop: .050, volume: .84, wave: .16, taper: .78, flare: .14,
          rootLift: .003, sideSweep: left ? -.014 : .014
        }));
      }
      function wolfRear(theta, length, width, curve, count, start, z) {
        return angleList(count, start, 154).map((angle, i) => presetPetal({
          theta: theta + (i % 2) * .012, angle, length: length * (1 + (i % 4 === 1 ? .06 : (i % 4 === 2 ? -.025 : 0))),
          curve: curve * (1 + (i % 3 === 1 ? .12 : 0)), width: width * (1 + (i % 2 ? .035 : 0)), thickness: .066,
          z: z + i * .0016, roll: (i - (count - 1) / 2) * 1.45, twist: (i % 2 ? 10 : -8), hug: .93, rootDrop: .042,
          volume: .86, wave: .15, taper: .72, flare: .18, rootLift: .002, sideSweep: (i - (count - 1) / 2) * .0035
        }));
      }
      out.shortCurl = {
        layers: [
          presetLayer('第 1 層 · 頂冠核心', wolfTopLayer(.10, .15, .215, .030, 8, 0, .010)),
          presetLayer('第 2 層 · 頂冠主層', wolfTopLayer(.20, .20, .232, .042, 10, 14, .016)),
          presetLayer('第 3 層 · 上冠厚層', wolfTopLayer(.30, .25, .248, .054, 12, 0, .023)),
          presetLayer('第 4 層 · 中上厚層', wolfTopLayer(.40, .31, .262, .066, 13, 15, .030)),
          presetLayer('第 5 層 · 前額碎瀏海', wolfFront()),
          presetLayer('第 6 層 · 左側包臉', wolfSide('left')),
          presetLayer('第 7 層 · 右側包臉', wolfSide('right')),
          presetLayer('第 8 層 · 後腦上層', wolfRear(.60, .42, .252, .072, 14, 202, .049)),
          presetLayer('第 9 層 · 後腦中層', wolfRear(.72, .53, .268, .083, 15, 198, .057)),
          presetLayer('第 10 層 · 後腦下層', wolfRear(.85, .66, .282, .094, 16, 194, .065)),
          presetLayer('第 11 層 · 狼尾長層', wolfRear(.99, .79, .292, .102, 16, 190, .073))
        ]
      };

      // 02 高馬尾：頭頂增加冠部層數，後方以高位集束承接馬尾。
      out.highPony = {
        layers: [
          presetLayer('第 1 層 · 頂冠中心', directedPetals({theta: .13, angles: [70, 80, 90, 100, 110], length: .13, curve: .028, width: .17, thickness: .034, z: .008})),
          presetLayer('第 2 層 · 頂冠外圈', layeredRing({theta: .23, length: .18, curve: .042, width: .182, count: 10, start: 8, z: .012})),
          presetLayer('第 3 層 · 上冠', layeredRing({theta: .33, length: .22, curve: .052, width: .194, count: 12, start: 0, z: .018})),
          presetLayer('第 4 層 · 上中層', layeredRing({theta: .43, length: .265, curve: .060, width: .204, count: 13, start: 14, z: .024})),
          presetLayer('第 5 層 · 中層', layeredRing({theta: .54, length: .32, curve: .070, width: .214, count: 14, start: 0, z: .031})),
          presetLayer('第 6 層 · 下層', layeredRing({theta: .65, length: .37, curve: .080, width: .218, count: 14, start: 15, z: .038})),
          presetLayer('第 7 層 · 額前', frontFringe({theta: .76, length: .35, curve: .073, width: .195, thickness: .038, count: 8, start: 46, z: .046})),
          presetLayer('第 8 層 · 側後', sideLocks({theta: .86, length: .43, curve: .078, width: .18, thickness: .039, z: .052})),
          presetLayer('第 9 層 · 高位綁點', rearLayer({theta: .98, length: .34, curve: .068, width: .184, thickness: .039, z: .059, count: 10, start: 228, roll: 0}))
        ]
      };

      // 03 中長層次：增加頭頂層數，後腦向肩側逐層加長。
      out.mediumLayer = {
        layers: [
          presetLayer('第 1 層 · 頂冠中心', directedPetals({theta: .13, angles: [70, 80, 90, 100, 110], length: .14, curve: .030, width: .17, z: .008})),
          presetLayer('第 2 層 · 頂冠外圈', layeredRing({theta: .23, length: .19, curve: .043, width: .183, count: 10, start: 6, z: .012})),
          presetLayer('第 3 層 · 上冠', layeredRing({theta: .33, length: .23, curve: .053, width: .194, count: 12, start: 18, z: .018})),
          presetLayer('第 4 層 · 中上層', layeredRing({theta: .43, length: .28, curve: .064, width: .205, count: 13, start: 0, z: .024})),
          presetLayer('第 5 層 · 中層', layeredRing({theta: .54, length: .35, curve: .074, width: .214, count: 14, start: 14, z: .031})),
          presetLayer('第 6 層 · 中下層', layeredRing({theta: .65, length: .43, curve: .084, width: .222, count: 15, start: 0, z: .038})),
          presetLayer('第 7 層 · 額前瀏海', frontFringe({theta: .76, length: .43, curve: .083, width: .198, thickness: .039, count: 8, start: 46, z: .046})),
          presetLayer('第 8 層 · 側面延伸', sideLocks({theta: .87, length: .56, curve: .089, width: .182, thickness: .040, z: .053})),
          presetLayer('第 9 層 · 後腦中段', rearLayer({theta: 1.00, length: .58, curve: .080, width: .19, thickness: .040, z: .061, count: 11, start: 220})),
          presetLayer('第 10 層 · 肩側收尾', rearLayer({theta: 1.10, length: .47, curve: .072, width: .19, thickness: .040, z: .068, count: 11, start: 220}))
        ]
      };

      // 04 短寸頭：雖然短，仍以多層貼合避免髮帽邊緣露出。
      out.buzzCut = {
        layers: [
          presetLayer('第 1 層 · 頂冠中心', directedPetals({theta: .12, angles: [72, 81, 90, 99, 108], length: .095, curve: .020, width: .155, thickness: .033, z: .007})),
          presetLayer('第 2 層 · 頂冠', layeredRing({theta: .22, length: .11, curve: .024, width: .160, count: 10, start: 5, z: .011})),
          presetLayer('第 3 層 · 上層', layeredRing({theta: .33, length: .135, curve: .029, width: .166, count: 12, start: 16, z: .016})),
          presetLayer('第 4 層 · 中上', layeredRing({theta: .44, length: .16, curve: .034, width: .171, count: 13, start: 0, z: .021})),
          presetLayer('第 5 層 · 中下', layeredRing({theta: .55, length: .185, curve: .038, width: .176, count: 14, start: 14, z: .026})),
          presetLayer('第 6 層 · 下緣', layeredRing({theta: .66, length: .205, curve: .042, width: .181, count: 14, start: 0, z: .032})),
          presetLayer('第 7 層 · 額前短瀏海', frontFringe({theta: .76, length: .19, curve: .040, width: .17, thickness: .036, count: 8, start: 46, z: .038})),
          presetLayer('第 8 層 · 後頸收邊', rearLayer({theta: .93, length: .22, curve: .038, width: .177, thickness: .037, z: .045, count: 11, start: 220}))
        ]
      };

      // 05 武士長髮：頭頂厚實、後方長層次明顯。
      out.samuraiLong = {
        layers: [
          presetLayer('第 1 層 · 頂冠中心', directedPetals({theta: .13, angles: [70, 80, 90, 100, 110], length: .14, curve: .030, width: .17, z: .008})),
          presetLayer('第 2 層 · 頂冠外圈', layeredRing({theta: .23, length: .20, curve: .044, width: .184, count: 10, start: 8, z: .012})),
          presetLayer('第 3 層 · 上冠', layeredRing({theta: .33, length: .25, curve: .055, width: .195, count: 12, start: 0, z: .018})),
          presetLayer('第 4 層 · 中上層', layeredRing({theta: .43, length: .31, curve: .066, width: .205, count: 13, start: 15, z: .025})),
          presetLayer('第 5 層 · 中層', layeredRing({theta: .54, length: .39, curve: .078, width: .216, count: 14, start: 0, z: .032})),
          presetLayer('第 6 層 · 中下層', layeredRing({theta: .65, length: .48, curve: .088, width: .224, count: 15, start: 14, z: .039})),
          presetLayer('第 7 層 · 額側長束', frontFringe({theta: .77, length: .47, curve: .085, width: .198, thickness: .040, count: 8, start: 46, z: .047})),
          presetLayer('第 8 層 · 側後長束', sideLocks({theta: .88, length: .70, curve: .095, width: .184, thickness: .041, z: .055})),
          presetLayer('第 9 層 · 後腦長層', rearLayer({theta: 1.00, length: .86, curve: .082, width: .194, thickness: .041, z: .064, count: 12, start: 218})),
          presetLayer('第 10 層 · 後頸長收尾', rearLayer({theta: 1.12, length: .72, curve: .074, width: .194, thickness: .041, z: .070, count: 12, start: 218}))
        ]
      };

      // 06 垂直長髮：頭頂密、長束直落，刻意保留較低曲率。
      out.straightLong = {
        layers: [
          presetLayer('第 1 層 · 頂冠中心', directedPetals({theta: .13, angles: [70, 80, 90, 100, 110], length: .14, curve: .021, width: .17, z: .008})),
          presetLayer('第 2 層 · 頂冠外圈', layeredRing({theta: .23, length: .19, curve: .030, width: .184, count: 10, start: 8, z: .012})),
          presetLayer('第 3 層 · 上冠', layeredRing({theta: .33, length: .24, curve: .034, width: .194, count: 12, start: 0, z: .018})),
          presetLayer('第 4 層 · 中上層', layeredRing({theta: .43, length: .29, curve: .039, width: .205, count: 13, start: 15, z: .025})),
          presetLayer('第 5 層 · 中層', layeredRing({theta: .54, length: .36, curve: .044, width: .214, count: 14, start: 0, z: .032})),
          presetLayer('第 6 層 · 中下層', layeredRing({theta: .65, length: .45, curve: .049, width: .222, count: 15, start: 14, z: .039})),
          presetLayer('第 7 層 · 額側直束', frontFringe({theta: .77, length: .48, curve: .040, width: .196, thickness: .040, count: 8, start: 46, z: .047})),
          presetLayer('第 8 層 · 側面直落', sideLocks({theta: .88, length: .80, curve: .042, width: .184, thickness: .041, z: .055})),
          presetLayer('第 9 層 · 後方直落', rearLayer({theta: 1.00, length: 1.02, curve: .034, width: .194, thickness: .041, z: .064, count: 12, start: 218})),
          presetLayer('第 10 層 · 後頸直落', rearLayer({theta: 1.12, length: .90, curve: .026, width: .194, thickness: .041, z: .070, count: 12, start: 218}))
        ]
      };

      return out;
    }
    const HAIR_DESIGN_PRESETS = buildHairDesignPresets();
    function makeDefaultHairDesigns() {
      const out = Object.fromEntries(getHairStyleIds().map(id => [id, {layers: [], cap: {x: 0, y: 0, z: 0, sx: 1, sy: 1, sz: 1}}]));
      for (const id of ['highPony', 'mediumLayer', 'buzzCut', 'samuraiLong', 'straightLong']) out[id] = JSON.parse(JSON.stringify(HAIR_DESIGN_PRESETS[id]));
      // 01 uses a side-part long-hair reference with 10 curved head-bound layers.
      // Existing player-made designs remain untouched when their layer structure is clearly customized.
      out.shortCurl = JSON.parse(JSON.stringify(HAIR_DESIGN_PRESETS.shortCurl));
      return out;
    }
    function applyHairDesignPresetMigration(raw, version) {
      const out = normalizeHairDesigns(raw);
      const from = Number(version || 0);
      if (from >= HAIR_DESIGN_PRESET_VERSION) return out;
      // V13：新增髮絲扭曲、貼服程度、根部下移。舊資料沒有這三個欄位時，
      // normalizeHairDesignPetal() 會以新的安全預設值補上，不改寫玩家原本的其他參數。
      // V5：短髮原本 3 層，現在補上第 4～8 層。只在舊設計仍是 3 層時追加，
      // 不覆蓋玩家已經自行增加／刪除／調整過的設計。
      if (from < 5) {
        const src = HAIR_DESIGN_PRESETS.shortCurl;
        if (out.shortCurl?.layers?.length === 3 && src?.layers?.length >= 8) {
          out.shortCurl.layers.push(...JSON.parse(JSON.stringify(src.layers.slice(3, 8))));
        }
      }
      // V6：01 短髮增加第 9 層外覆蓋收邊，僅對原本完整 8 層預設追加；
      // 不覆蓋玩家已自行增刪／調整過的自訂層。
      if (from < 6) {
        const src = HAIR_DESIGN_PRESETS.shortCurl;
        if (out.shortCurl?.layers?.length === 8 && src?.layers?.length >= 9) {
          out.shortCurl.layers.push(JSON.parse(JSON.stringify(src.layers[8])));
        }
      }
      // V7：02～06 增加頭部覆蓋層與對應長度。
      // 已有自訂內容不重寫；僅在原設計層數不足時，從新預設補上缺少的後續層。
      if (from < 7) {
        for (const id of ['highPony', 'mediumLayer', 'buzzCut', 'samuraiLong', 'straightLong']) {
          const src = HAIR_DESIGN_PRESETS[id];
          const cur = out[id]?.layers || [];
          if (!cur.length) {
            out[id] = JSON.parse(JSON.stringify(src));
          } else if (src?.layers?.length > cur.length) {
            cur.push(...JSON.parse(JSON.stringify(src.layers.slice(cur.length))));
          }
        }
      }
      // V9：01 改為側分長髮。僅更新仍保留 V8 預設層名稱的 10 層設計，
      // 玩家若已增刪層數或自行建立不同層名稱，則保留原設計不動。
      if (from < 9) {
        const cur = out.shortCurl?.layers || [];
        const looksLikeV8Short = cur.length === 10 &&
          String(cur[0]?.name || '').includes('頂冠中心') &&
          String(cur[4]?.name || '').includes('額前碎髮') &&
          String(cur[9]?.name || '').includes('後頸收邊');
        if (looksLikeV8Short) {
          out.shortCurl = JSON.parse(JSON.stringify(HAIR_DESIGN_PRESETS.shortCurl));
        }
      }

      // V11：01 側分長髮加密前後覆蓋層，並加入較長花瓣填補髮帽邊界。
      // 僅在目前設計仍與 V10 預設完全一致時升級；玩家已自行調整過就保留。
      if (from < 11) {
        const cur = out.shortCurl?.layers || [];
        const baseV10 = HAIR_DESIGN_PRESETS.shortCurl?.layers || [];
        if (cur.length === baseV10.length && JSON.stringify(cur) === JSON.stringify(baseV10)) {
          out.shortCurl = JSON.parse(JSON.stringify(HAIR_DESIGN_PRESETS.shortCurl));
        }
      }

      // V8：更新六款預設髮型的層數與分布。
      // 只升級仍保持舊版「預設層名稱／層數」結構的設計；若玩家已明顯修改層數，保留玩家設定。
      if (from < 8) {
        const legacyShape = {
          shortCurl: ['第 1 層 · 頂冠', '第 8 層 · 後腦收尾'],
          highPony: ['第 1 層 · 頂冠', '第 7 層 · 綁髮前段'],
          mediumLayer: ['第 1 層 · 頂冠', '第 7 層 · 肩側收尾'],
          buzzCut: ['第 1 層 · 低矮頂冠', '第 6 層 · 額前短瀏海'],
          samuraiLong: ['第 1 層 · 頂冠', '第 8 層 · 後腦長束'],
          straightLong: ['第 1 層 · 頂冠', '第 8 層 · 後方直落']
        };
        for (const id of Object.keys(legacyShape)) {
          const cur = out[id]?.layers || [];
          const [first, last] = legacyShape[id];
          if (cur.length && cur[0]?.name === first && cur[cur.length - 1]?.name === last) {
            out[id] = JSON.parse(JSON.stringify(HAIR_DESIGN_PRESETS[id]));
          }
        }
      }
      // V12：01 側分長髮增加前後長束與更密集後腦覆蓋。
      // 僅對仍完整保持 V11 預設層名稱／18 層以前未客製的舊設計升級；
      // 玩家已自行增刪髮層則保留。
      if (from < 12) {
        const cur = out.shortCurl?.layers || [];
        const v11Names = [
          '第 1 層 · 側分頂冠', '第 2 層 · 頂冠貼合', '第 3 層 · 上層覆蓋',
          '第 4 層 · 中上層覆蓋', '第 5 層 · 側分前額', '第 6 層 · 左側長瀏海',
          '第 7 層 · 右側短鬢角', '第 8 層 · 後腦上層', '第 9 層 · 後腦中層',
          '第 10 層 · 後頸收邊', '第 11 層 · 上後覆蓋', '第 12 層 · 中後覆蓋',
          '第 13 層 · 前後長花', '第 14 層 · 下緣封邊'
        ];
        const sameV11 = cur.length === 14 && cur.every((l, i) => String(l?.name || '') === v11Names[i]);
        if (sameV11) out.shortCurl = JSON.parse(JSON.stringify(HAIR_DESIGN_PRESETS.shortCurl));
      }

      // V14：01 由側分長髮改為狼尾頭；只有明顯仍是舊 V13 側分預設時才升級。
      if (from < 14) {
        const cur = out.shortCurl?.layers || [];
        const looksOldSidePart = cur.length >= 14 && String(cur[0]?.name || '').includes('側分') && String(cur[cur.length - 1]?.name || '').includes('封邊');
        if (looksOldSidePart) out.shortCurl = JSON.parse(JSON.stringify(HAIR_DESIGN_PRESETS.shortCurl));
      }

      // V15：01 狼尾頭改為較少層、較厚實、較接近參考圖的版本；
      // 僅升級仍是 V14 原始 16 層預設，玩家自訂內容不覆蓋。
      if (from < 15) {
        const cur = out.shortCurl?.layers || [];
        const looksV14Wolf = cur.length === 16 &&
          String(cur[0]?.name || '').includes('頂冠中心') &&
          String(cur[7]?.name || '').includes('額前碎髮') &&
          String(cur[15]?.name || '').includes('外輪廓封邊');
        if (looksV14Wolf) out.shortCurl = JSON.parse(JSON.stringify(HAIR_DESIGN_PRESETS.shortCurl));
      }

      // Only fill an empty style. Never overwrite an existing custom design.
      for (const id of ['highPony', 'mediumLayer', 'buzzCut', 'samuraiLong', 'straightLong']) {
        if (!out[id]?.layers?.length) out[id] = JSON.parse(JSON.stringify(HAIR_DESIGN_PRESETS[id]));
      }
      return out;
    }

    // New characters start with six cap-backed hairstyles. 01 uses the wolf-cut preset; styles 02-06 keep their existing starter designs.
    if (!state.characterCreated) {
      // Do not call canonicalCharacterProfile() here: CHARACTER_CUSTOM_DEFAULTS is
      // declared later in this script. Boot initializes the canonical profile after
      // all appearance constants have been created.
      state.hairDesigns = makeDefaultHairDesigns();
      state.hairDesignPresetVersion = HAIR_DESIGN_PRESET_VERSION;
    }
    function normalizeHairDesignPetal(raw = {}) {
      const d = {...HAIR_DESIGN_DEFAULT, ...raw};
      const num = (v, f, min, max) => {const n = Number(v); return Number.isFinite(n) ? Math.max(min, Math.min(max, n)) : f};
      return {
        theta: num(d.theta, .52, .05, 1.40), angle: num(d.angle, 90, -180, 360),
        length: num(d.length, .38, .10, 1.15), curve: num(d.curve, .11, 0, .45),
        thickness: num(d.thickness, .035, .008, .14), width: num(d.width, .19, .05, .45),
        x: num(d.x, 0, -.42, .42), y: num(d.y, 0, -.34, .34), z: num(d.z, 0, -.42, .42),
        roll: num(d.roll, 0, -180, 180),
        twist: num(d.twist, 12, -180, 180), hug: num(d.hug, .86, 0, 1), rootDrop: num(d.rootDrop, .045, -.24, .28),
        volume: num(d.volume, .72, 0, 1.40), wave: num(d.wave, .12, 0, .60), taper: num(d.taper, .82, .45, 1.05),
        flare: num(d.flare, .10, 0, .55), rootLift: num(d.rootLift, 0, -.18, .18), sideSweep: num(d.sideSweep, 0, -.35, .35)
      };
    }
    function normalizeHairDesigns(raw) {
      const out = makeDefaultHairDesigns();
      if (!raw || typeof raw !== 'object') return out;
      for (const styleId of getHairStyleIds()) {
        const src = raw[styleId];
        if (!src || !Array.isArray(src.layers)) continue;
        out[styleId].layers = src.layers.slice(0, 18).map((layer, li) => ({
          name: String(layer?.name || ('第 ' + (li + 1) + ' 層')).slice(0, 20),
          petals: Array.isArray(layer?.petals) ? layer.petals.slice(0, 24).map(normalizeHairDesignPetal) : []
        }));
        const c = src.cap || {};
        out[styleId].cap = {
          x: Number.isFinite(Number(c.x)) ? Math.max(-.60, Math.min(.60, Number(c.x))) : 0,
          y: Number.isFinite(Number(c.y)) ? Math.max(-.60, Math.min(.60, Number(c.y))) : 0,
          z: Number.isFinite(Number(c.z)) ? Math.max(-.60, Math.min(.60, Number(c.z))) : 0,
          sx: Number.isFinite(Number(c.sx)) ? Math.max(.82, Math.min(1.18, Number(c.sx))) : 1,
          sy: Number.isFinite(Number(c.sy)) ? Math.max(.82, Math.min(1.18, Number(c.sy))) : 1,
          sz: Number.isFinite(Number(c.sz)) ? Math.max(.82, Math.min(1.18, Number(c.sz))) : 1
        };
      }
      return out;
    }
    function ensureHairDesigns() {
      state.hairDesigns = normalizeHairDesigns(state.hairDesigns);
      if (!state.hairDesigns[state.hairStyle]) state.hairDesigns[state.hairStyle] = {layers: []};
      hairDesignEditor.styleId = state.hairStyle;
      const layers = state.hairDesigns[state.hairStyle].layers || [];
      if (!layers.length) {hairDesignEditor.layerIndex = 0; hairDesignEditor.petalIndex = 0; return;}
      hairDesignEditor.layerIndex = Math.max(0, Math.min(layers.length - 1, Number(hairDesignEditor.layerIndex) || 0));
      const petals = layers[hairDesignEditor.layerIndex]?.petals || [];
      hairDesignEditor.petalIndex = Math.max(0, Math.min(Math.max(0, petals.length - 1), Number(hairDesignEditor.petalIndex) || 0));
    }
    function getCurrentHairDesign() {
      ensureHairDesigns();
      return state.hairDesigns[state.hairStyle];
    }
    function getCurrentHairDesignPetal() {
      const d = getCurrentHairDesign();
      const layer = d.layers?.[hairDesignEditor.layerIndex];
      return layer?.petals?.[hairDesignEditor.petalIndex] || null;
    }
    function findHairCap(group) {
      if (!group) return null;
      let found = null;
      group.traverse(o => {if (!found && isHairObject(o) && o.userData?.isHairCap) found = o;});
      return found;
    }
    function buildDesignerPetalGeometry(params) {
      // V36：厚實、微波浪、可扭曲、貼服頭皮的髮片。
      // volume：蓬鬆體積；wave：髮絲波動；taper：尖端收束；flare：外張；
      // rootLift：髮根上下微調；sideSweep：髮流左右偏移。
      const T = 24, U = 10;
      const length = Math.max(.10, Number(params.length) || .38);
      const curve = Math.max(0, Number(params.curve) || 0);
      const thickness = Math.max(.008, Number(params.thickness) || .055);
      const width = Math.max(.05, Number(params.width) || .23);
      const volume = Math.max(0, Number(params.volume) || 0);
      const wave = Math.max(0, Number(params.wave) || 0);
      const taper = Math.max(.45, Math.min(1.05, Number(params.taper) || .82));
      const flare = Math.max(0, Number(params.flare) || 0);
      const rootLift = Number(params.rootLift) || 0;
      const sideSweep = Number(params.sideSweep) || 0;
      const twistRad = (Number(params.twist) || 0) * Math.PI / 180;
      const hug = Math.max(0, Math.min(1, Number(params.hug)));
      const pos = [], idx = [];
      const headR = .64;
      function pushRow(front, j) {
        const t = j / T;
        const y = -length * Math.pow(t, taper);
        const surfaceT = Math.min(1, t / .80);
        const surfaceY = length * surfaceT;
        const surfaceSag = -(surfaceY * surfaceY) / (2 * headR) * hug;
        const baseCurve = curve * (Math.sin(Math.PI * t) * .88 + .10 * t);
        const waveCurve = wave * (Math.sin(Math.PI * 2 * t) * .46 + Math.sin(Math.PI * 4 * t) * .12) * t;
        const release = (1 - hug) * baseCurve;
        const depth = surfaceSag + release + waveCurve + volume * .034 * (1 - t) + flare * .018 * Math.sin(Math.PI * t);
        const tw = twistRad * Math.pow(t, 1.10);
        const cs = Math.cos(tw), sn = Math.sin(tw);
        const taperValue = Math.max(.06, 1 - Math.pow(t, Math.max(.35, taper)));
        const rootBulge = 1 + volume * .30 * (1 - t) + flare * .14 * Math.sin(Math.PI * t);
        const taperWidth = width * taperValue * rootBulge + .008 * (1 - t);
        const sweep = sideSweep * (.25 + .75 * t);
        const crownLift = rootLift * (1 - t) * (.75 + .25 * Math.cos(Math.PI * t));
        for (let i = 0; i <= U; i++) {
          const u = i / U * 2 - 1;
          const ridge = (.018 + volume * .014) * (1 - Math.abs(u)) * Math.sin(Math.PI * t);
          const edgeBend = flare * .026 * u * u * Math.sin(Math.PI * t);
          const x0 = u * taperWidth + sweep + sideSweep * .10 * u * (1 - t);
          const z0 = depth + ridge + edgeBend + crownLift + (front ? thickness * .52 : -thickness * .52);
          const x = x0 * cs - z0 * sn;
          const z = x0 * sn + z0 * cs;
          pos.push(x, y, z);
        }
      }
      for (let j = 0; j <= T; j++)pushRow(true, j);
      const frontCount = (T + 1) * (U + 1);
      for (let j = 0; j <= T; j++)pushRow(false, j);
      for (let j = 0; j < T; j++)for (let i = 0; i < U; i++) {
        const a = j * (U + 1) + i, b = a + 1, d = (j + 1) * (U + 1) + i, c = d + 1;
        idx.push(a, d, b, b, d, c);
        const off = frontCount, a2 = a + off, b2 = b + off, d2 = d + off, c2 = c + off;
        idx.push(a2, b2, d2, b2, c2, d2);
      }
      const edgePairs = [];
      for (let j = 0; j < T; j++) {
        edgePairs.push([j * (U + 1), (j + 1) * (U + 1)]);
        edgePairs.push([j * (U + 1) + U, (j + 1) * (U + 1) + U]);
      }
      for (const [a, d] of edgePairs) {const b = a + frontCount, c = d + frontCount; idx.push(a, b, d, d, b, c);}
      const lastRow = T * (U + 1), lastOff = frontCount;
      for (let i = 0; i < U; i++) {const a = lastRow + i, b = a + 1, c = a + lastOff, d = b + lastOff; idx.push(a, d, b, b, d, c);}
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
      geo.setIndex(idx); geo.computeVertexNormals();
      return geo;
    }
    function buildDesignerPetalObject(params, layerIndex, petalIndex) {
      // V31：髮根直接投影到 Character Model V2 頭部橢球曲面。
      // 不再使用固定球半徑，避免花瓣根部藏進髮帽，造成後腦光頭與髮套水平線。
      // V34：DesignerPetalRoot 是 Head 的子物件，因此座標必須使用 Head
      // 的「未縮放局部球面」半徑 .64；舊版誤用了 .73/.84/.70，會造成
      // 花根被推得過高、過外，正面與後腦都出現髮套裸露。
      const r = .64 * 1.010;
      const rawTheta = Number(params.theta) || .52;
      const rootDrop = Number(params.rootDrop) || 0;
      const theta = Math.max(.05, Math.min(1.40, rawTheta + rootDrop));
      const phi = (Number(params.angle) || 90) * Math.PI / 180;
      const st = Math.sin(theta), ct = Math.cos(theta);
      const pf = getHeadProfileFactors(getCharacterCustomization(), ct);
      let base = new THREE.Vector3(r * st * Math.cos(phi) * pf.fx, r * ct, r * st * Math.sin(phi) * pf.fz);
      let normal = base.clone().normalize();
      base.addScaledVector(normal, .014);
      base.add(new THREE.Vector3(Number(params.x) || 0, Number(params.y) || 0, Number(params.z) || 0));
      normal = base.clone().normalize();
      let down = new THREE.Vector3(0, -1, 0);
      down.addScaledVector(normal, -down.dot(normal));
      if (down.lengthSq() < .0001) down = new THREE.Vector3(0, 0, -1);
      down.normalize();
      const yAxis = down.clone().negate();
      const zAxis = normal.clone();
      const xAxis = new THREE.Vector3().crossVectors(yAxis, zAxis).normalize();
      const basis = new THREE.Matrix4().makeBasis(xAxis, yAxis, zAxis);
      const q = new THREE.Quaternion().setFromRotationMatrix(basis);
      const g = new THREE.Group();
      g.name = `DesignerPetal_${layerIndex}_${petalIndex}`;
      g.position.copy(base);
      g.quaternion.copy(q);
      g.rotateZ((Number(params.roll) || 0) * Math.PI / 180);
      const material = hexMat((HAIR_COLOR_INFO[state.hairColor] || HAIR_COLOR_INFO.chestnut).hex, .56, .02);
      const meshPetal = mesh(buildDesignerPetalGeometry(params), material);
      meshPetal.material.side = THREE.DoubleSide;
      meshPetal.userData.isHair = true;
      meshPetal.userData.isHairPetal = true;
      meshPetal.userData.isHairDesignerPetal = true;
      meshPetal.userData.hairStyleId = state.hairStyle;
      meshPetal.userData.hairLayer = `designer${layerIndex + 1}`;
      meshPetal.renderOrder = 7 + layerIndex;
      g.userData.isHairDesignerPetalRoot = true;
      g.userData.hairDesignerParams = {...params};
      g.add(meshPetal);
      return g;
    }
    function makePonytailBundle() {
      const g = new THREE.Group();
      g.name = 'HairProcedural_Ponytail';
      g.userData.isHair = true;
      g.userData.isProceduralPonytail = true;
      const info = HAIR_COLOR_INFO[state.hairColor] || HAIR_COLOR_INFO.chestnut;
      const baseMat = hexMat(info.hex, .58, .02);
      const hiMat = hexMat(info.highlight, .48, .015);
      // 綁點位於頭頂偏後的位置，所有座標皆以 Head local 為基準。
      const strands = [
        {x: -.15, z: -.51, len: .83, r: .050, bias: -.04},
        {x: -.105, z: -.54, len: .92, r: .057, bias: -.02},
        {x: -.055, z: -.56, len: 1.00, r: .064, bias: 0},
        {x: 0, z: -.57, len: 1.05, r: .070, bias: .01},
        {x: .055, z: -.56, len: 1.00, r: .064, bias: 0},
        {x: .105, z: -.54, len: .92, r: .057, bias: -.02},
        {x: .15, z: -.51, len: .83, r: .050, bias: -.04}
      ];
      strands.forEach((st, i) => {
        const y = .34;
        const pts = [
          new THREE.Vector3(st.x, y, st.z),
          new THREE.Vector3(st.x * 1.14, y - .20, st.z - .035),
          new THREE.Vector3(st.x * 1.32, y - .50, st.z - .075),
          new THREE.Vector3(st.x * 1.55, y - .78 * st.len, st.z - .045 + st.bias),
          new THREE.Vector3(st.x * 1.35, y - 1.05 * st.len, st.z + .015 + st.bias)
        ];
        const curve = new THREE.CatmullRomCurve3(pts, false, 'catmullrom', .72);
        const tube = new THREE.TubeGeometry(curve, 24, st.r, 8, false);
        const m = mesh(tube, (i % 3 === 0) ? hiMat : baseMat);
        m.material.side = THREE.DoubleSide;
        m.userData.isHair = true;
        m.userData.isProceduralPonytail = true;
        m.userData.hairLayer = 'proceduralPonytail';
        m.renderOrder = 9;
        g.add(m);
      });
      const tieMat = new THREE.MeshStandardMaterial({color: info.hex, roughness: .42, metalness: .03});
      const tie = new THREE.Mesh(new THREE.TorusGeometry(.135, .026, 10, 28), tieMat);
      tie.rotation.x = Math.PI / 2;
      tie.position.set(0, .335, -.565);
      tie.userData.isHair = true;
      tie.userData.isPonytailTie = true;
      tie.renderOrder = 10;
      g.add(tie);
      // 輕微中央束，避免馬尾看起來像單一圓管。
      const core = new THREE.Mesh(new THREE.SphereGeometry(.105, 16, 12), baseMat);
      core.scale.set(.92, .70, .72);
      core.position.set(0, .355, -.555);
      core.userData.isHair = true;
      core.renderOrder = 9;
      g.add(core);
      return g;
    }

    function applyHairDesignToTarget(target) {
      const parts = target?.userData?.parts; if (!parts?.head) return;
      ensureHairDesigns();
      const head = parts.head;
      let root = head.getObjectByName('HairDesignerRoot');
      if (!root) {root = new THREE.Group(); root.name = 'HairDesignerRoot'; root.userData.hairDesignerRoot = true; head.add(root);}
      while (root.children.length) root.remove(root.children[root.children.length - 1]);
      const design = state.hairDesigns?.[state.hairStyle];
      const cap = findHairCap(target.userData.parts?.hairStyles?.children?.find(g => g.name === 'HairStyle_' + state.hairStyle) || null);
      const capCfg = design?.cap || {x: 0, y: 0, z: 0, sx: 1, sy: 1, sz: 1};
      if (cap) {
        cap.position.set(0, 2.18, 0);
        cap.position.x += Number(capCfg.x) || 0;
        cap.position.y += Number(capCfg.y) || 0;
        cap.position.z += Number(capCfg.z) || 0;
        cap.scale.set(.73 * 1.006 * (Number(capCfg.sx) || 1), .84 * 1.006 * (Number(capCfg.sy) || 1), .70 * 1.006 * (Number(capCfg.sz) || 1));
      }
      if (state.hairStyle === 'highPony') {
        root.add(makePonytailBundle());
      }
      const helmet = state.equip?.helmet;
      const helmetMode = helmet ? (HELMET_HAIR_MODE[helmet.visual || ''] || 'hide') : null;
      root.visible = helmetMode !== 'hide';
      if (!design) return;
      (design.layers || []).forEach((layer, li) => {
        const lg = new THREE.Group(); lg.name = `HairDesignerLayer_${li + 1}`; lg.userData.hairDesignerLayer = true;
        (layer.petals || []).forEach((petal, pi) => lg.add(buildDesignerPetalObject(normalizeHairDesignPetal(petal), li, pi)));
        root.add(lg);
      });
    }
    function refreshHairDesignerPreview() {
      if (ccPreview?.active && ccPreview.player) {applyHairDesignToTarget(ccPreview.player); setHairColorOnTarget(ccPreview.player, state.hairColor || 'chestnut');}
    }
    function addHairDesignPetal() {
      ensureHairDesigns();
      const design = getCurrentHairDesign();
      if (!design.layers.length) {design.layers.push({name: '第 1 層', petals: []}); hairDesignEditor.layerIndex = 0;}
      const layer = design.layers[hairDesignEditor.layerIndex];
      const layerIndex = hairDesignEditor.layerIndex;
      const outward = .012 + layerIndex * .025;
      const sideOffset = (layer.petals.length % 5 - 2) * .055;
      layer.petals.push(normalizeHairDesignPetal({...HAIR_DESIGN_DEFAULT, z: outward, x: sideOffset * .35, angle: 90 + sideOffset * 120, length: .36 + layerIndex * .03, width: .18 + layerIndex * .012, curve: .10 + layerIndex * .015, twist: 16 + layerIndex * 2, hug: .82, rootDrop: .06}));
      hairDesignEditor.petalIndex = layer.petals.length - 1;
      refreshHairDesignerPreview(); refreshHairDesignPanel();
    }
    function addHairDesignLayer() {
      ensureHairDesigns();
      const design = getCurrentHairDesign();
      if (design.layers.length >= 18) {toast('⚠ 最多 18 層'); return;}
      const li = design.layers.length;
      design.layers.push({name: '第 ' + (li + 1) + ' 層', petals: [normalizeHairDesignPetal({z: .012 + li * .028, length: .39 + li * .03, width: .19 + li * .012, curve: .11 + li * .015, angle: 90, twist: 16 + li * 2, hug: .82, rootDrop: .06})]});
      hairDesignEditor.layerIndex = li; hairDesignEditor.petalIndex = 0;
      refreshHairDesignerPreview(); refreshHairDesignPanel();
    }
    function selectHairDesignLayer(i) {
      ensureHairDesigns(); hairDesignEditor.layerIndex = Number(i) || 0; hairDesignEditor.petalIndex = 0; ensureHairDesigns(); refreshHairDesignPanel(); refreshHairDesignerPreview();
    }
    function selectHairDesignPetal(i) {hairDesignEditor.petalIndex = Number(i) || 0; ensureHairDesigns(); refreshHairDesignPanel(); refreshHairDesignerPreview();}
    function updateHairDesignParam(key, value) {
      const petal = getCurrentHairDesignPetal(); if (!petal) return;
      const next = normalizeHairDesignPetal({...petal, [key]: value});
      const design = getCurrentHairDesign(), layer = design.layers[hairDesignEditor.layerIndex];
      layer.petals[hairDesignEditor.petalIndex] = next;
      const valEl = document.getElementById('hairDesignValue_' + key); if (valEl) valEl.textContent = Number(next[key]).toFixed(key === 'angle' || key === 'roll' ? 0 : 2);
      refreshHairDesignerPreview();
    }
    function removeCurrentHairDesignPetal() {
      const design = getCurrentHairDesign(), layer = design.layers[hairDesignEditor.layerIndex]; if (!layer?.petals?.length) return;
      layer.petals.splice(hairDesignEditor.petalIndex, 1);
      hairDesignEditor.petalIndex = Math.max(0, Math.min(hairDesignEditor.petalIndex, layer.petals.length - 1));
      refreshHairDesignerPreview(); refreshHairDesignPanel();
    }
    function removeCurrentHairDesignLayer() {
      const design = getCurrentHairDesign(); if (!design.layers.length) return;
      design.layers.splice(hairDesignEditor.layerIndex, 1);
      hairDesignEditor.layerIndex = Math.max(0, Math.min(hairDesignEditor.layerIndex, design.layers.length - 1)); hairDesignEditor.petalIndex = 0;
      refreshHairDesignerPreview(); refreshHairDesignPanel();
    }
    function resetHairDesign() {
      ensureHairDesigns(); state.hairDesigns[state.hairStyle] = {layers: []}; hairDesignEditor.layerIndex = 0; hairDesignEditor.petalIndex = 0;
      refreshHairDesignerPreview(); refreshHairDesignPanel(); toast('↺ 已清除目前髮型的自訂花瓣');
    }
    function saveHairDesign() {
      ensureHairDesigns(); saveGame(); toast('💾 髮型設計已儲存，建立角色後會套用到實體角色');
    }
    function hairCapSlider(key, label, min, max, step) {
      ensureHairDesigns();
      const d = getCurrentHairDesign();
      if (!d.cap) d.cap = {x: 0, y: 0, z: 0, sx: 1, sy: 1, sz: 1};
      const value = Number(d.cap[key] ?? 1);
      const decimals = step < .1 ? 2 : 0;
      return `<label class=hairDesignField><span><b>${label}</b><em id="hairCapValue_${key}">${decimals ? value.toFixed(decimals) : value.toFixed(0)}</em></span><input type="range" min="${min}" max="${max}" step="${step}" value="${value}" oninput="updateHairCapParam('${key}',this.value)"></label>`;
    }
    function updateHairCapParam(key, value) {
      ensureHairDesigns();
      const d = getCurrentHairDesign();
      if (!d.cap) d.cap = {x: 0, y: 0, z: 0, sx: 1, sy: 1, sz: 1};
      const limits = {x: [-.60, .60], y: [-.60, .60], z: [-.60, .60], sx: [.82, 1.18], sy: [.82, 1.18], sz: [.82, 1.18]};
      if (!limits[key]) return;
      const n = Number(value);
      d.cap[key] = Math.max(limits[key][0], Math.min(limits[key][1], Number.isFinite(n) ? n : 1));
      const valEl = document.getElementById('hairCapValue_' + key);
      if (valEl) {const step = key.startsWith('s') ? .01 : .01; valEl.textContent = Number(d.cap[key]).toFixed(2);}
      refreshHairDesignerPreview();
    }
    function resetHairCapAdjustment() {
      ensureHairDesigns();
      getCurrentHairDesign().cap = {x: 0, y: 0, z: 0, sx: 1, sy: 1, sz: 1};
      refreshHairDesignerPreview(); refreshHairDesignPanel(); toast('↺ 已還原髮套貼合位置與比例');
    }
    function hairDesignSlider(key, label, min, max, step) {
      const petal = getCurrentHairDesignPetal(); if (!petal) return '';
      const value = Number(petal[key] ?? HAIR_DESIGN_DEFAULT[key]);
      const decimals = step < .1 ? 2 : 0;
      return `<label class=hairDesignField><span><b>${label}</b><em id="hairDesignValue_${key}">${decimals ? value.toFixed(decimals) : value.toFixed(0)}</em></span><input type="range" min="${min}" max="${max}" step="${step}" value="${value}" oninput="updateHairDesignParam('${key}',this.value)"></label>`;
    }
    function renderHairDesignEditorMarkup() {
      ensureHairDesigns();
      const design = getCurrentHairDesign();
      const hasLayers = design.layers.length > 0;
      if (!hasLayers) {
        return `<div class=hairDesignEmpty>目前沒有自訂花瓣。先按「＋ 花瓣配件」，花瓣會立即出現在左側 3D 創建人物視窗。</div>`;
      }
      const layerTabs = design.layers.map((l, i) => `<button type="button" class="hairLayerTab ${i === hairDesignEditor.layerIndex ? 'active' : ''}" onclick="selectHairDesignLayer(${i})">${escapeHtml(l.name || ('第 ' + (i + 1) + ' 層'))} <small>${l.petals.length} 花瓣</small></button>`).join('');
      const layer = design.layers[hairDesignEditor.layerIndex] || design.layers[0];
      const petalTabs = (layer.petals || []).map((_, i) => `<button type="button" class="hairPetalTab ${i === hairDesignEditor.petalIndex ? 'active' : ''}" onclick="selectHairDesignPetal(${i})">花瓣 ${String(i + 1).padStart(2, '0')}</button>`).join('');
      const capControls = [
        hairCapSlider('x', '髮套 X', -.60, .60, .01),
        hairCapSlider('y', '髮套 Y', -.60, .60, .01),
        hairCapSlider('z', '髮套 Z', -.60, .60, .01),
        hairCapSlider('sx', '髮套寬度', .82, 1.18, .01),
        hairCapSlider('sy', '髮套高度', .82, 1.18, .01),
        hairCapSlider('sz', '髮套深度', .82, 1.18, .01)
      ].join('');
      const controls = [
        hairDesignSlider('length', '長度', .10, 1.15, .01),
        hairDesignSlider('curve', '弧度', 0, .45, .01),
        hairDesignSlider('twist', '髮絲扭曲', -180, 180, 1),
        hairDesignSlider('hug', '貼服程度', 0, 1, .05),
        hairDesignSlider('volume', '蓬鬆體積', 0, 1.40, .01),
        hairDesignSlider('wave', '髮絲波動', 0, .60, .01),
        hairDesignSlider('taper', '尖端收束', .45, 1.05, .01),
        hairDesignSlider('flare', '外張程度', 0, .55, .01),
        hairDesignSlider('rootDrop', '根部下移', -.24, .28, .01),
        hairDesignSlider('rootLift', '根部抬升', -.18, .18, .01),
        hairDesignSlider('sideSweep', '側向流動', -.35, .35, .01),
        hairDesignSlider('thickness', '厚度', .008, .16, .004),
        hairDesignSlider('width', '闊度', .05, .55, .01),
        hairDesignSlider('x', '位置 X', -.42, .42, .01),
        hairDesignSlider('y', '位置 Y', -.34, .34, .01),
        hairDesignSlider('z', '位置 Z', -.42, .42, .01),
        hairDesignSlider('angle', '繞頭角度', -180, 360, 1),
        hairDesignSlider('theta', '貼合高度', .05, 1.40, .01),
        hairDesignSlider('roll', '髮絲傾斜', -180, 180, 1)
      ].join('');
      return `<div class=hairDesignEditorHead><div><b>目前髮型：${escapeHtml(getHairStyleInfo()[state.hairStyle]?.name || state.hairStyle)}</b><small>髮帽保留為底層；可先調整髮套整體位置／比例，再疊加花瓣。</small></div><div class=hairDesignBtns><button type="button" class="hairDesignBtn" onclick="addHairDesignPetal()">＋ 花瓣配件</button><button type="button" class="hairDesignBtn" onclick="addHairDesignLayer()">＋ 新增外層</button><button type="button" class="hairDesignBtn" onclick="resetHairCapAdjustment()">↺ 髮套重設</button><button type="button" class="hairDesignBtn danger" onclick="removeCurrentHairDesignLayer()">刪除層</button><button type="button" class="hairDesignBtn danger" onclick="removeCurrentHairDesignPetal()">刪除花瓣</button></div></div><div class=hairCapControls>${capControls}</div><div class=hairLayerTabs>${layerTabs}</div><div class=hairPetalTabs>${petalTabs}</div><div class=hairDesignControls>${controls}</div>`;
    }
    function refreshHairDesignPanel() {
      const el = document.getElementById('hairDesignEditorPanel'); if (el) el.innerHTML = renderHairDesignEditorMarkup();
    }
    function hexMat(hex, rough = .55, metal = .02) {return mat(hex, rough, metal)}
    function setHairColorOnTarget(target, colorId) {
      const parts = target?.userData?.parts; if (!parts?.hairStyles) return;
      const info = HAIR_COLOR_INFO[colorId] || HAIR_COLOR_INFO.chestnut;
      const applyHairMaterial = (o) => {
        if (!isHairObject(o) || !o.isMesh) return;
        if (o.userData.generatedHairMaterial && o.material) o.material.dispose?.();
        const isHi = !!o.userData.isHairHighlight;
        o.material = hexMat(isHi ? info.highlight : info.hex, .56, .02);
        o.userData.generatedHairMaterial = true;
      };
      parts.hairStyles.traverse(applyHairMaterial);
      parts.head?.traverse(applyHairMaterial);
      parts.hairStyles.userData.hairColor = colorId;
    }
    function makeFaceShapeGeometry(style) {
      if (style === 'sharp') {
        const sh = new THREE.Shape(); sh.moveTo(-.14, 0); sh.quadraticCurveTo(0, .11, .14, 0); sh.quadraticCurveTo(0, -.055, -.14, 0); return new THREE.ShapeGeometry(sh, 12);
      }
      if (style === 'sleepy') {
        const sh = new THREE.Shape(); sh.moveTo(-.16, 0); sh.quadraticCurveTo(0, .045, .16, 0); sh.quadraticCurveTo(0, -.02, -.16, 0); return new THREE.ShapeGeometry(sh, 12);
      }
      if (style === 'soft') {
        const sh = new THREE.Shape(); sh.moveTo(-.15, 0); sh.quadraticCurveTo(0, .09, .15, 0); sh.quadraticCurveTo(0, -.075, -.15, 0); return new THREE.ShapeGeometry(sh, 12);
      }
      if (style === 'wolf') {
        const sh = new THREE.Shape();
        sh.moveTo(-.155, 0);
        sh.quadraticCurveTo(-.060, .075, 0, .050);
        sh.quadraticCurveTo(.060, .075, .155, 0);
        sh.quadraticCurveTo(.075, -.060, 0, -.072);
        sh.quadraticCurveTo(-.075, -.060, -.155, 0);
        sh.closePath();
        return new THREE.ShapeGeometry(sh, 16);
      }
      return new THREE.CircleGeometry(.078, 24);
    }
    function applyEyeStyleOnTarget(target, styleId, colorId) {
      const parts = target?.userData?.parts; if (!parts?.faceEyes) return;
      const style = EYE_STYLE_INFO[styleId] || EYE_STYLE_INFO.anime;
      const color = EYE_COLOR_INFO[colorId] || EYE_COLOR_INFO.sky;
      const c = getCharacterCustomization();
      parts.faceEyes.forEach((eg, i) => {
        eg.userData.eyeStyle = styleId; eg.userData.eyeColor = colorId;
        eg.scale.set(style.scale[0] * (Number(c.eyeScale) || 1), style.scale[1] * (Number(c.eyeScale) || 1) * (Number(c.eyeHeightScale) || 1), 1);
        eg.rotation.z = (i === 0 ? -style.rotation : style.rotation) + (i === 0 ? -1 : 1) * Number(c.eyeTilt || 0);
        const ep = eg.userData.eyeParts || {};
        const iris = ep.iris || eg.children?.[0];
        const hi = ep.hi || eg.children?.[1];
        const pupil = ep.pupil;
        const hi2 = ep.hi2;
        if (iris?.isMesh) {
          iris.geometry.dispose?.();
          iris.geometry = makeFaceShapeGeometry(styleId);
          iris.material = hexMat(color.hex, .28, .02);
          iris.position.set(0, 0, .004);
          iris.scale.set((styleId === 'star' ? 1.06 : 1) * (Number(c.irisScale) || 1), (styleId === 'star' ? 1.06 : 1) * (Number(c.irisScale) || 1), 1);
        }
        if (pupil?.isMesh) {
          pupil.material = hexMat(0x17202c, .24, .01);
          pupil.position.set(0, -.004, .009);
          pupil.scale.set(styleId === 'sleepy' ? .88 : 1, styleId === 'sleepy' ? .78 : 1, 1);
        }
        if (hi?.isMesh) {
          hi.material = hexMat(color.highlight, .16, .02);
          hi.position.set(-.030, .032, .014);
          hi.scale.set(styleId === 'star' ? 1.22 : 1, styleId === 'star' ? 1.22 : 1, 1);
        }
        if (hi2?.isMesh) {
          hi2.material = hexMat(0xffffff, .16, .01);
          hi2.position.set(.030, -.025, .014);
          hi2.visible = styleId === 'star';
        }
        // 舊版存檔／舊模型若仍有 starHighlight，保持兼容。
        if (styleId === 'star') {
          if (!eg.userData.starHighlight) {
            const sh = mesh(new THREE.CircleGeometry(.014, 8), hexMat(0xffffff, .12));
            sh.position.set(.035, -.028, .012); eg.add(sh); eg.userData.starHighlight = sh;
          }
          eg.userData.starHighlight.visible = true;
        } else if (eg.userData.starHighlight) eg.userData.starHighlight.visible = false;
      });
      parts.faceEyesGroupStyle = styleId; parts.faceEyeColor = colorId;
    }
    function getHeadFaceSurface(target, yWorld = 1.93, xWorld = 0) {
      const c = getCharacterCustomization();
      const headRx = .64 * .73 * c.head * c.headWidth;
      const headRy = .64 * .84 * c.head * c.headHeight;
      const headRz = .64 * .70 * c.head * c.headDepth;
      const headCY = 2.18 + (Number(c.headOffsetY) || 0), headCX = Number(c.headOffsetX) || 0, headCZ = Number(c.headOffsetZ) || 0;
      const dy = yWorld - headCY, relX = xWorld - headCX;
      const ny0 = dy / Math.max(.001, headRy), pf = getHeadProfileFactors(c, ny0);
      const rx = headRx * pf.fx, rz = headRz * pf.fz;
      const nx = relX / Math.max(.001, rx), ny = ny0;
      const rem = Math.max(.0001, 1 - nx * nx - ny * ny), nz = Math.sqrt(rem), z = rz * nz;
      const nX = nx / Math.max(.001, rx), nY = dy / Math.max(.001, headRy * headRy), nZ = z / Math.max(.001, rz * rz), len = Math.hypot(nX, nY, nZ) || 1;
      return {position: new THREE.Vector3(headCX + relX, yWorld, headCZ + z + .003 + (Number(c.eyeSurfaceOffset) || 0)), normal: new THREE.Vector3(nX / len, nY / len, nZ / len), rx, ry: headRy, rz};
    }
    function applyMouthStyleOnTarget(target, styleId) {
      const parts = target?.userData?.parts; if (!parts?.mouth) return;
      const m = parts.mouth; styleId = MOUTH_STYLE_INFO[styleId] ? styleId : 'smile';
      m.userData.mouthStyle = styleId;
      const colors = {smile: 0x7b3540, small: 0x6f3540, open: 0x5d2630, pout: 0x9b4d5c, cat: 0x7b3540, neutral: 0x6b4650};
      if (styleId === 'none') {
        m.visible = false;
        return;
      }
      m.visible = true;
      m.material = hexMat(colors[styleId], .42, .01);
      m.geometry.dispose?.();
      if (styleId === 'open') {
        m.geometry = new THREE.CircleGeometry(.075, 20); m.scale.set(1.0, .72, 1);
      } else if (styleId === 'small') {
        m.geometry = new THREE.CircleGeometry(.052, 20); m.scale.set(1.5, .62, 1);
      } else if (styleId === 'pout') {
        m.geometry = new THREE.CircleGeometry(.055, 20); m.scale.set(1.55, .75, 1);
      } else if (styleId === 'cat') {
        const sh = new THREE.Shape(); sh.moveTo(-.11, .025); sh.quadraticCurveTo(-.055, -.035, 0, .018); sh.quadraticCurveTo(.055, -.035, .11, .025); sh.lineTo(.07, -.005); sh.quadraticCurveTo(0, .035, -.07, -.005); sh.closePath(); m.geometry = new THREE.ShapeGeometry(sh); m.scale.set(1, 1, 1);
      } else if (styleId === 'neutral') {
        m.geometry = new THREE.BoxGeometry(.15, .018, .01); m.scale.set(1, 1, 1);
      } else {
        m.geometry = new THREE.TorusGeometry(.070, .014, 6, 14, Math.PI); m.scale.set(.95, -.62, 1);
      }
      // V18：嘴型直接投影到 Head 橢球表面。
      // 嘴部以前固定 z=.519，對目前頭型來說會漂在臉前；現在依實際臉部曲率取表面點。
      const c = getCharacterCustomization();
      const y = 1.925 + (Number(c.headOffsetY) || 0) + (Number(c.mouthYOffset) || 0);
      const face = getHeadFaceSurface(target, y + (Number(c.cheekVertical) || 0) * .10, 0);
      m.scale.x *= Number(c.mouthScale || 1) * Number(c.mouthWidth || 1); m.scale.y *= Number(c.mouthScale || 1); m.rotation.z = Math.PI + Number(c.mouthTilt || 0);
      m.position.copy(face.position);
      // 讓嘴部平面沿臉部法線傾斜，真正貼著臉，不再像貼紙浮在前方。
      const tiltX = Math.atan2(-face.normal.y, Math.max(.001, face.normal.z));
      m.rotation.set(tiltX, 0, styleId === 'smile' ? Math.PI : Math.PI);
      m.renderOrder = 20;
    }

    function applyCharacterAppearance(target = state.player) {
      if (!target?.userData?.parts) return;
      setHairColorOnTarget(target, state.hairColor || 'chestnut');
      applyEyeStyleOnTarget(target, state.eyeStyle || 'anime', state.eyeColor || 'sky');
      applyMouthStyleOnTarget(target, state.mouthStyle || 'smile');
      applyBrowCustomization(target);
    }
    // ============================================================================
    // CHARACTER APPEARANCE TRANSFER V1
    // 匯出／匯入玩家自建人物外觀。只保存外觀資料，不覆蓋等級、裝備、背包、技能、位置等遊戲進度。
    // ============================================================================
    const CHARACTER_APPEARANCE_EXPORT_VERSION = 1;
    const CHARACTER_APPEARANCE_EXPORT_TYPE = 'ASGARD_CHARACTER_APPEARANCE';
    // ============================================================================
    // OFFICIAL CHARACTER DEFAULT V1
    // 官方預設獨立放在 index.html 同目錄的 default-character.json。
    // GitHub Pages / 網站環境會從這裡載入；file:// 本機開啟若無法 fetch，則自動回退
    // 到程式內既有的安全預設，不會影響現有角色存檔。
    // ============================================================================
    const OFFICIAL_CHARACTER_DEFAULT_URL = './data/default-character.json';
    // GitHub Pages 的固定備援位址：即使 index.html 被放到不同子目錄，
    // 仍可取得目前 Game-Testing repository 的官方人物外觀。
    const OFFICIAL_CHARACTER_DEFAULT_FALLBACK_URL = 'https://asgard3d.github.io/Game-Testing/default-character.json';
    let officialDefaultCharacterAppearance = null;
    let officialDefaultCharacterLoadError = '';
    let officialDefaultCharacterSourceUrl = '';

    async function loadOfficialDefaultCharacterAppearance() {
      officialDefaultCharacterAppearance = null;
      officialDefaultCharacterLoadError = '';
      officialDefaultCharacterSourceUrl = '';
      try {
        const embedded = window.__ASGARD_DEFAULT_CHARACTER_CONFIG__;
        if (embedded && typeof embedded === 'object') {
          const raw = (embedded?.appearance && typeof embedded.appearance === 'object') ? embedded.appearance : embedded;
          const data = cloneAppearanceData(raw);
          if (data && typeof data === 'object' && !data.type && data.characterCustomization) {
            data.type = CHARACTER_APPEARANCE_EXPORT_TYPE;
            data.version = CHARACTER_APPEARANCE_EXPORT_VERSION;
          }
          validateCharacterAppearanceImport(data);
          officialDefaultCharacterAppearance = cloneAppearanceData(data);
          officialDefaultCharacterSourceUrl = 'embedded://default-character.json';
          return true;
        }
      } catch (e) { officialDefaultCharacterLoadError = 'embedded default-character failed: ' + String(e?.message || e); }

      const urls = [];
      try { urls.push(new URL(OFFICIAL_CHARACTER_DEFAULT_URL, document.baseURI).href); } catch (e) {}
      urls.push(OFFICIAL_CHARACTER_DEFAULT_FALLBACK_URL);

      const tried = [];
      for (const url of [...new Set(urls)]) {
        try {
          const res = await fetch(url + (url.includes('?') ? '&' : '?') + 'v=' + Date.now(), {cache: 'no-store'});
          if (!res.ok) throw new Error('HTTP ' + res.status);

          const raw = await res.json();
          // 支援兩種格式：
          // 1. 正式 downloadCharacterAppearance() 產生的完整外觀檔
          // 2. 只有 characterCustomization 等外觀欄位的簡化 JSON
          const data = (raw?.appearance && typeof raw.appearance === 'object') ? raw.appearance : raw;
          if (data && typeof data === 'object' && !data.type && data.characterCustomization) {
            data.type = CHARACTER_APPEARANCE_EXPORT_TYPE;
            data.version = CHARACTER_APPEARANCE_EXPORT_VERSION;
          }

          validateCharacterAppearanceImport(data);
          officialDefaultCharacterAppearance = cloneAppearanceData(data);
          officialDefaultCharacterSourceUrl = url;
          return true;
        } catch (e) {
          tried.push(url + ' → ' + String(e?.message || e || 'unknown error'));
        }
      }

      officialDefaultCharacterLoadError = tried.join('； ');
      console.warn('official default-character.json unavailable; using built-in fallback:', officialDefaultCharacterLoadError);
      return false;
    }

    function getOfficialDefaultStatusMarkup() {
      if (officialDefaultCharacterAppearance) {
        const shortUrl = officialDefaultCharacterSourceUrl || OFFICIAL_CHARACTER_DEFAULT_URL;
        return '<span style="display:inline-flex;align-items:center;gap:5px;padding:5px 8px;border:1px solid #4f9d70;border-radius:8px;background:#0b2418;color:#9ff0bb;font-size:10px;font-weight:800" title="' + escapeHtml(shortUrl) + '">✓ 官方預設已載入</span>';
      }
      return '<span style="display:inline-flex;align-items:center;gap:5px;padding:5px 8px;border:1px solid #a86b4d;border-radius:8px;background:#28150e;color:#ffc29f;font-size:10px;font-weight:800" title="' + escapeHtml(officialDefaultCharacterLoadError || '尚未載入') + '">⚠ 官方預設載入失敗</span>';
    }

    function getOfficialDefaultCharacterAppearance() {
      return officialDefaultCharacterAppearance ? cloneAppearanceData(officialDefaultCharacterAppearance) : null;
    }

    function applyOfficialDefaultCharacterAppearanceIfAny() {
      const data = getOfficialDefaultCharacterAppearance();
      if (!data) return false;
      try {
        validateCharacterAppearanceImport(data);
        const gender = data.gender === 'female' ? 'female' : 'male';
        state.gender = gender;
        state.characterCustomization = {...canonicalCharacterProfile(gender), ...cloneAppearanceData(data.characterCustomization)};
        state.hairStyle = normalizeHairStyleId(data.hairStyle || 'shortCurl');
        state.hairColor = HAIR_COLOR_INFO[data.hairColor] ? data.hairColor : 'chestnut';
        state.hairDesigns = data.hairDesigns && typeof data.hairDesigns === 'object'
          ? normalizeHairDesigns(cloneAppearanceData(data.hairDesigns))
          : makeDefaultHairDesigns();
        state.hairDesignPresetVersion = HAIR_DESIGN_PRESET_VERSION;
        state.eyeStyle = EYE_STYLE_INFO[data.eyeStyle] ? data.eyeStyle : 'anime';
        state.eyeColor = EYE_COLOR_INFO[data.eyeColor] ? data.eyeColor : 'sky';
        state.mouthStyle = MOUTH_STYLE_INFO[data.mouthStyle] ? data.mouthStyle : 'smile';
        state.earAdjustments = normalizeEarAdjustments(data.earAdjustments);
        state.hatAdjustments = data.hatAdjustments && typeof data.hatAdjustments === 'object' ? cloneAppearanceData(data.hatAdjustments) : {};
        state.cloakAdjustments = data.cloakAdjustments && typeof data.cloakAdjustments === 'object'
          ? {...getCloakAdjustments(), ...cloneAppearanceData(data.cloakAdjustments)}
          : getCloakAdjustments();
        return true;
      } catch (e) {
        console.warn('official default appearance ignored:', e);
        return false;
      }
    }

    function downloadOfficialDefaultCharacterJson() {
      try {
        const data = buildCharacterAppearanceExportData();
        data.officialDefault = true;
        data.defaultVersion = 1;
        data.sourceCharacterName = '官方預設';
        const json = JSON.stringify(data, null, 2);
        const blob = new Blob([json], {type: 'application/json;charset=utf-8'});
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'default-character.json';
        a.style.display = 'none';
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 2000);
        const status = document.getElementById('appearanceTransferStatus');
        if (status) status.textContent = '⭐ 已建立 default-character.json。把它放在 index.html 同一層並推送到 GitHub Pages，即可成為網站官方預設。';
        const creatorStatus = document.getElementById('creatorAppearanceTransferStatus');
        if (creatorStatus) creatorStatus.textContent = '⭐ 已建立 default-character.json；放到 index.html 同一層後即可成為官方預設。';
        toast('⭐ 已匯出官方 default-character.json');
      } catch (e) {
        console.error('official default export failed', e);
        toast('⚠️ 建立 default-character.json 失敗');
      }
    }


    function cloneAppearanceData(value) {
      try { return JSON.parse(JSON.stringify(value)); } catch (e) { return null; }
    }

    function buildCharacterAppearanceExportData() {
      const gender = state.gender === 'female' ? 'female' : 'male';
      return {
        type: CHARACTER_APPEARANCE_EXPORT_TYPE,
        version: CHARACTER_APPEARANCE_EXPORT_VERSION,
        exportedAt: new Date().toISOString(),
        gender,
        characterCustomization: cloneAppearanceData(getCharacterCustomization()),
        hairStyle: normalizeHairStyleId(state.hairStyle || 'shortCurl'),
        hairColor: HAIR_COLOR_INFO[state.hairColor] ? state.hairColor : 'chestnut',
        hairDesigns: cloneAppearanceData(normalizeHairDesigns(state.hairDesigns)),
        hairDesignPresetVersion: HAIR_DESIGN_PRESET_VERSION,
        hairDesignResetToken: HAIR_DESIGN_RESET_TOKEN,
        eyeStyle: EYE_STYLE_INFO[state.eyeStyle] ? state.eyeStyle : 'anime',
        eyeColor: EYE_COLOR_INFO[state.eyeColor] ? state.eyeColor : 'sky',
        mouthStyle: MOUTH_STYLE_INFO[state.mouthStyle] ? state.mouthStyle : 'smile',
        earAdjustments: cloneAppearanceData(normalizeEarAdjustments(state.earAdjustments)),
        hatAdjustments: cloneAppearanceData(state.hatAdjustments || {}),
        cloakAdjustments: cloneAppearanceData(getCloakAdjustments()),
        sourceClassId: state.classId || null,
        sourceCharacterName: String(state.characterName || '').trim().slice(0, 16)
      };
    }

    function downloadCharacterAppearance() {
      // V2：匯出只讀取外觀資料，不重建／移除正式 3D 人物。
      // 下載失敗時改用 data URL 開新分頁，避免舊版瀏覽器把 blob 導航成空白頁。
      try {
        const data = buildCharacterAppearanceExportData();
        const json = JSON.stringify(data, null, 2);
        const safeName = String(state.characterName || '我的角色').replace(/[\\/:*?"<>|]/g, '_').trim() || '我的角色';
        const fileName = 'asgard_' + safeName + '_appearance.json';
        const status = document.getElementById('appearanceTransferStatus');
        if (status) status.textContent = '⏳ 正在建立外觀檔案…';

        const blob = new Blob([json], {type: 'application/json;charset=utf-8'});
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = fileName;
        a.target = '_blank';
        a.rel = 'noopener';
        a.style.display = 'none';
        document.body.appendChild(a);
        // 保留目前 canvas／state，不呼叫 closeModal、stopCharacterPreview 或重建玩家。
        try { a.click(); } catch (_) { a.dispatchEvent(new MouseEvent('click', {bubbles: true, cancelable: true, view: window})); }
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1500);
        if (status) status.textContent = '✅ 已建立：' + fileName + '（人物 3D 不會被重建）';
        toast('💾 已匯出人物外觀參數');
      } catch (e) {
        console.error('appearance export failed', e);
        const status = document.getElementById('appearanceTransferStatus');
        if (status) status.textContent = '⚠️ 下載失敗，可重新按一次匯出。錯誤：' + (e?.message || e);
        toast('⚠️ 外觀匯出失敗，請再按一次');
      }
    }

    function openCharacterAppearanceFilePicker() {
      const input = document.getElementById('characterAppearanceImportFile');
      if (input) input.click();
    }

    function validateCharacterAppearanceImport(data) {
      if (!data || typeof data !== 'object') throw new Error('檔案不是有效的 JSON 物件');
      if (data.type !== CHARACTER_APPEARANCE_EXPORT_TYPE) throw new Error('這不是 ASGARD 人物外觀檔');
      const version = Number(data.version) || 0;
      if (version < 1 || version > CHARACTER_APPEARANCE_EXPORT_VERSION) throw new Error('外觀檔版本不相容');
      if (!data.characterCustomization || typeof data.characterCustomization !== 'object') throw new Error('缺少 Character Model V2 參數');
      return true;
    }

    function applyImportedCharacterAppearance(data) {
      validateCharacterAppearanceImport(data);
      const gender = data.gender === 'female' ? 'female' : 'male';
      state.gender = gender;
      state.characterCustomization = {...canonicalCharacterProfile(gender), ...cloneAppearanceData(data.characterCustomization)};
      state.hairStyle = normalizeHairStyleId(data.hairStyle || 'shortCurl');
      state.hairColor = HAIR_COLOR_INFO[data.hairColor] ? data.hairColor : 'chestnut';
      state.eyeStyle = EYE_STYLE_INFO[data.eyeStyle] ? data.eyeStyle : 'anime';
      state.eyeColor = EYE_COLOR_INFO[data.eyeColor] ? data.eyeColor : 'sky';
      state.mouthStyle = MOUTH_STYLE_INFO[data.mouthStyle] ? data.mouthStyle : 'smile';
      state.hairDesigns = data.hairDesigns && typeof data.hairDesigns === 'object' ? normalizeHairDesigns(cloneAppearanceData(data.hairDesigns)) : makeDefaultHairDesigns();
      state.hairDesignPresetVersion = HAIR_DESIGN_PRESET_VERSION;
      state.earAdjustments = normalizeEarAdjustments(data.earAdjustments);
      state.hatAdjustments = data.hatAdjustments && typeof data.hatAdjustments === 'object' ? cloneAppearanceData(data.hatAdjustments) : {};
      state.cloakAdjustments = data.cloakAdjustments && typeof data.cloakAdjustments === 'object' ? {...getCloakAdjustments(), ...cloneAppearanceData(data.cloakAdjustments)} : getCloakAdjustments();

      if (state.player && state.parts) {
        applyCharacterCustomization();
        applyHairStyle(state.hairStyle, false);
        applyCharacterAppearance(state.player);
        applyHairDesignToTarget(state.player);
        applyCurrentHatAdjustment();
        updateEquipmentVisual();
      }

      if (typeof ccPreview !== 'undefined' && ccPreview.active && ccPreview.player) {
        _withCreatorPreviewState(() => {
          applyCharacterCustomization();
          applyPreviewHairStyle();
          applyCharacterAppearance(ccPreview.player);
          applyHairDesignToTarget(ccPreview.player);
        });
      }

      if (document.getElementById('creatorCharacterName')) renderCharacterCreator();
      if (state.characterCreated) saveGame();
      updateUI();
      return true;
    }

    function importCharacterAppearanceFile(input) {
      const file = input?.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        try {
          const data = JSON.parse(String(reader.result || ''));
          applyImportedCharacterAppearance(data);
          toast('✅ 已匯入人物外觀：髮型／臉型／眼睛／嘴型／耳朵／外觀調整');
          if (!document.getElementById('creatorCharacterName')) renderModal('appearanceTransfer');
        } catch (e) {
          console.error('appearance import failed', e);
          alert('外觀匯入失敗：' + (e?.message || 'JSON 格式錯誤'));
          renderModal('appearanceTransfer');
        } finally {
          input.value = '';
        }
      };
      reader.onerror = () => { alert('無法讀取外觀檔案。'); input.value = ''; };
      reader.readAsText(file, 'utf-8');
    }

    function renderCharacterAppearanceTransferModal(c) {
      const data = buildCharacterAppearanceExportData();
      const hairName = getHairStyleInfo()[data.hairStyle]?.name || data.hairStyle;
      const petalCount = Object.values(data.hairDesigns || {}).reduce((sum, d) => sum + ((d?.layers || []).reduce((n, layer) => n + ((layer?.petals || []).length), 0)), 0);
      c.innerHTML = '<h2>🎨 人物外觀匯出／匯入</h2>' +
        '<p class="tip">把你在這個 Browser 調好的角色外觀帶到另一個 Browser。只處理人物外觀，不會覆蓋等級、裝備、背包、技能、金幣、地圖位置等遊戲進度。</p>' +
        '<div class="settingsBlock" style="line-height:1.7"><div><b>目前外觀</b><br><small>性別：' + (data.gender === 'female' ? '女性' : '男性') + '　髮型：' + escapeHtml(hairName) + '　髮色：' + escapeHtml(data.hairColor) + '<br>自建髮片／花瓣：' + petalCount + ' 個　臉型／五官／耳朵調整：已包含</small></div></div>' +
        '<div id="appearanceTransferStatus" class="settingsBlock" style="margin-top:10px;color:#b9d8ff">可匯出／匯入外觀；也可以把目前外觀輸出成官方 default-character.json，放到 index.html 同一層。</div>' +
        '<div class="menuGrid" style="margin-top:10px">' +
        '<button type="button" class="menuCard" onclick="downloadCharacterAppearance();return false;"><span class="big">💾</span>匯出我的外觀<small>下載 JSON 檔，不重建人物</small></button>' +
        '<button type="button" class="menuCard" onclick="openCharacterAppearanceFilePicker()"><span class="big">📥</span>匯入外觀<small>選擇 JSON 檔並套用</small></button><button type="button" class="menuCard" onclick="downloadOfficialDefaultCharacterJson();return false;"><span class="big">⭐</span>建立官方預設 JSON<small>下載 default-character.json，放到 index.html 同層</small></button>' +
        '</div>' +
        '<input id="characterAppearanceImportFile" type="file" accept="application/json,.json" style="display:none" onchange="importCharacterAppearanceFile(this)">' +
        '<div class="menuActions"><button type="button" class="menuBtn" onclick="closeModal()">完成</button></div>';
    }

    function renderHairModal(c) {
      const cards = Object.entries(getHairStyleInfo()).map(([id, v]) => '<button type="button" class="hairCard ' + (state.hairStyle === id ? 'selected' : '') + '" onclick="applyHairStyle(\'' + id + '\');openModal(\'hair\')"><span class="hairIcon">' + v.icon + '</span><b>' + v.name + '</b><small>' + v.category + ' · ' + v.desc + '</small></button>').join('');
      c.innerHTML = '<h2>💇 髮型設定 V6</h2><p class="tip">六種固定髮型共用同一個 Character Model V2 頭部曲面。髮根沿頭皮弧線貼合，花瓣髮束由根部寬圓弧逐層向下收尖。</p><div class="hairGrid">' + cards + '</div><div class="menuActions"><button type="button" class="menuBtn" onclick="closeModal()">關閉</button></div>';
    }

    const CHARACTER_CUSTOM_DEFAULTS = {
      height: 1, head: 1, neck: 1, shoulder: 1, chest: 1, waist: 1, hip: 1, upperArm: 1, forearm: 1, hand: 1, thigh: 1, calf: 1, foot: 1, spine: 1, shoulderBone: 1, elbowBone: 1, wristBone: 1, hipBone: 1, kneeBone: 1, ankleBone: 1,
      torsoWidth: 1, torsoDepth: 1, torsoLength: 1, pelvisWidth: 1, pelvisDepth: 1, armLength: 1, forearmLength: 1, thighLength: 1, calfLength: 1, footWidth: 1, footLength: 1,
      headWidth: 1, headHeight: 1, headDepth: 1,
      headForeheadWidth: .98, headCheekWidth: 1.04, headJawWidth: .91, headChinWidth: .88,
      headForeheadDepth: .98, headCheekDepth: 1.03, headJawDepth: .92, headCrownWidth: .98,
      headOffsetX: 0, headOffsetY: 0, headOffsetZ: 0,
      eyeScale: .82, eyeHeightScale: .97, eyeSpacing: .90, eyeYOffset: 0, eyeSurfaceOffset: .002, eyeFrontBack: .008, eyeTilt: 0, irisScale: .92,
      browWidth: .82, browThickness: .85, browSpacing: .92, browYOffset: .055, browTilt: .02, browArch: .18,
      mouthScale: 1, mouthWidth: 1, mouthYOffset: 0, mouthTilt: 0,
      cheekVertical: .03, chinDrop: .02
    };
    function getCharacterCustomization() {return {...CHARACTER_CUSTOM_DEFAULTS, ...(state.characterCustomization || {})};}
    function setCharacterGender(gender, preset = true) {
      state.gender = gender === 'female' ? 'female' : 'male';
      if (preset) state.characterCustomization = canonicalCharacterProfile(state.gender);
      applyCharacterCustomization(); ccPreviewSync(); const g1 = document.getElementById('characterGenderMale'), g2 = document.getElementById('characterGenderFemale'); if (g1) g1.classList.toggle('active', state.gender === 'male'); if (g2) g2.classList.toggle('active', state.gender === 'female'); renderCharacterCreatePreviewValues();
    }
    function setCharacterBodyParam(key, value) {const v = Number(value); if (!Number.isFinite(v)) return; if (!state.characterCustomization) state.characterCustomization = {...CHARACTER_CUSTOM_DEFAULTS}; state.characterCustomization[key] = v; applyCharacterCustomization(); renderCharacterCreatePreviewValues(); ccPreviewSync();}
    function resetCharacterBody() {setCharacterGender(state.gender, true); applyCharacterCustomization(); renderCharacterCreatePreviewValues();}
    const CLASS_BODY_PROPORTIONS = {
      novice: {torso: .90, shoulder: .88, upperArm: .90, forearm: .90, hand: .94, pelvis: .92, thigh: .92, calf: .90, foot: .94, outfit: .88},
