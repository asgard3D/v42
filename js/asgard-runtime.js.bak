      const maxHp = getMaxHP(), maxMp = getMaxMP(), maxSp = getMaxSP(), need = xpToNext();
      state.hp = Math.min(state.hp, maxHp); state.mp = Math.min(state.mp, maxMp); state.sp = Math.min(state.sp, maxSp);
      const $ = id => document.getElementById(id);
      const playerNameEl = $('characterNameText'); if (playerNameEl) playerNameEl.textContent = state.characterName || '凱伊';
      $('level').textContent = 'Lv.' + state.level;
      $('classText').textContent = c.name;
      $('hp').style.width = (state.hp / maxHp * 100) + '%'; $('mp').style.width = (state.mp / maxMp * 100) + '%'; $('sp').style.width = (state.sp / maxSp * 100) + '%';
      $('xp').style.width = (state.level >= 100 ? 100 : (state.xp / need * 100)) + '%';
      $('hpt').textContent = Math.round(state.hp) + '/' + maxHp; $('mpt').textContent = Math.round(state.mp) + '/' + maxMp; $('spt').textContent = Math.round(state.sp) + '/' + maxSp;
      $('xpt').textContent = state.level >= 100 ? 'MAX' : Math.round(state.xp) + '/' + need;
      const g = $('gold'); if (g) g.textContent = state.gold; const k = $('killText'); if (k) k.textContent = Math.min(state.kills, 5) + ' / 5';
      const skillNameEl = $('skillName'); if (skillNameEl) skillNameEl.textContent = c.skill;
      const expPct = state.level >= 100 ? 100 : (need > 0 ? Math.max(0, Math.min(100, state.xp / need * 100)) : 0);
      const hef = $('hudExpFill'); if (hef) hef.style.width = expPct + '%';
