      }
      c.innerHTML = '<h2>⚔ 職業資訊</h2><p class="tip">職業現在於「創建角色」時直接選擇，不再使用 Lv.10 轉職流程。現有角色職業不會在此畫面被切換。</p><div class="classlist"></div>'; const list = c.querySelector('.classlist'); for (const id of PLAYABLE_CLASS_IDS) {const v = classes[id], b = document.createElement('button'); b.className = 'classbtn'; b.innerHTML = '<b>' + v.name + '</b><small>Lv.1 起始職業 · ' + v.skill + '</small>'; list.appendChild(b)}
    }
    function closeModal() {hideEquipmentHoverTip(); stopCharacterPreview(); stopCloakAdjustPreview(); const m = document.getElementById('modal'); m.classList.remove('show'); const c = document.getElementById('modalContent'); if (c && c.parentElement) c.parentElement.classList.remove('menuWindow')}
    const hkClockFormatter = new Intl.DateTimeFormat('zh-Hant-HK', {timeZone: 'Asia/Hong_Kong', hour: '2-digit', minute: '2-digit', hour12: false});
    function getHongKongHour() {const parts = new Intl.DateTimeFormat('en-GB', {timeZone: 'Asia/Hong_Kong', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23'}).formatToParts(new Date()); const h = Number(parts.find(p => p.type === 'hour')?.value || 0); const m = Number(parts.find(p => p.type === 'minute')?.value || 0); const sec = Number(parts.find(p => p.type === 'second')?.value || 0); return h + m / 60 + sec / 3600}
    let environmentTimer = 0;
    function updateCityLighting(daylight) {
      const list = state.cityLights || [];
      const nightFactor = Math.max(0, Math.min(1, (.66 - daylight) / .42));
      const time = performance.now() * .002;
      for (let i = 0; i < list.length; i++) {
        const rec = list[i]; if (!rec?.light) continue;
        const pulse = .94 + .06 * Math.sin(time + i * .37);
        rec.light.intensity = rec.baseIntensity * (.12 + .88 * nightFactor) * pulse;
        if (rec.glow?.material?.emissive) {
          rec.glow.material.emissiveIntensity = 2.1 * nightFactor;
          rec.glow.material.opacity = .26 + .66 * nightFactor;
        }
        if (rec.lamp?.material?.emissiveIntensity != null) {
          rec.lamp.material.emissiveIntensity = .72 + 2.1 * nightFactor;
        }
      }
    }
    function dayNight(dt = .016) {
      environmentTimer -= dt;
      if (environmentTimer > 0) return;
      environmentTimer = .25;
      const enabled = state.environment?.dayNight !== false;
      const t = enabled ? getHongKongHour() : 12.0; state.time = t;
      const ang = (t / 24) * Math.PI * 2 - Math.PI / 2;
      const sunY = Math.sin(ang), sunX = Math.cos(ang);
      sun.position.set(sunX * 70, Math.max(8, sunY * 70), 20);
      moon.position.set(-sunX * 60, Math.max(5, -sunY * 60), -20);
      const rawDaylight = Math.max(0, Math.min(1, sunY * .5 + .5));
      const daylight = Math.pow(rawDaylight, .72), night = 1 - daylight;
      updateCityLighting(daylight);
      // 夜間場景保留可見度：整體比白天暗，但不會變成純黑。
      // 夜晚只把城鎮壓暗，不把 3D 世界完全關掉。
      sun.intensity = .018 + daylight * 2.35;
      hemi.intensity = .095 + daylight * 1.18;
      moon.intensity = .035 + night * .30;
      const sky = getZoneSkyColor(state.zone, daylight);
      scene.background.copy(sky);
      if (scene.fog) scene.fog.color.copy(sky);
      moon.color.setHSL(.61, .72, .78);
      sun.color.setHSL(.11, .10, .98);
      updateNightSky(daylight, night);
      document.getElementById('clockText').textContent = enabled ? hkClockFormatter.format(new Date()) : '日間';
    }
    function setWeather(w) {state.weather = w; const el = document.getElementById('weatherText'); if (el) el.textContent = {clear: '晴朗', rain: '下雨', snow: '下雪'}[w] || '晴朗';}
    function weatherParticles() {
      if (state.weather === 'clear') return;
      const isSnow = state.weather === 'snow';
      const count = isSnow ? (state.zone === 'snowcity' ? 650 : 180) : 240;
      const geo = new THREE.BufferGeometry(), pos = new Float32Array(count * 3), vel = new Float32Array(count), drift = new Float32Array(count), phase = new Float32Array(count);
      for (let i = 0; i < count; i++) {
        pos[i * 3] = (Math.random() - .5) * 130; pos[i * 3 + 1] = Math.random() * 45; pos[i * 3 + 2] = (Math.random() - .5) * 130;
        vel[i] = isSnow ? 3.0 + Math.random() * 2.8 : 15 + Math.random() * 11;
        drift[i] = isSnow ? 0.45 + Math.random() * .8 : .05 + Math.random() * .12;
        phase[i] = Math.random() * Math.PI * 2;
      }
      geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
      geo.setAttribute('velocity', new THREE.BufferAttribute(vel, 1));
      geo.setAttribute('drift', new THREE.BufferAttribute(drift, 1));
      geo.setAttribute('phase', new THREE.BufferAttribute(phase, 1));
      const pm = new THREE.PointsMaterial({color: isSnow ? 0xffffff : 0x8fc9ff, size: isSnow ? .20 : .105, transparent: true, opacity: isSnow ? .82 : .72, depthWrite: false});
      const p = new THREE.Points(geo, pm); p.userData.weatherType = state.weather; p.userData.elapsed = 0; addWorld(p); return p;
    }
    function updateWeatherParticles(dt) {
      if (!weatherObj || !weatherObj.geometry) return;
      const type = weatherObj.userData.weatherType;
      const pos = weatherObj.geometry.attributes.position, vel = weatherObj.geometry.attributes.velocity, drift = weatherObj.geometry.attributes.drift, phase = weatherObj.geometry.attributes.phase;
      const isSnow = type === 'snow'; weatherObj.userData.elapsed = (weatherObj.userData.elapsed || 0) + dt;
      const t = weatherObj.userData.elapsed, half = 65, top = 46;
      for (let i = 0; i < pos.count; i++) {
        const idx = i * 3; pos.array[idx + 1] -= vel.array[i] * dt;
        if (isSnow) {pos.array[idx] += Math.sin(t * 1.7 + phase.array[i]) * drift.array[i] * dt; pos.array[idx + 2] += Math.cos(t * 1.25 + phase.array[i] * 1.3) * drift.array[i] * .45 * dt;}
        else {pos.array[idx] += Math.sin(phase.array[i]) * drift.array[i] * dt; pos.array[idx + 2] += Math.cos(phase.array[i]) * drift.array[i] * .2 * dt;}
        if (pos.array[idx + 1] < 0) {pos.array[idx + 1] = top + Math.random() * 8; pos.array[idx] = (Math.random() - .5) * 130; pos.array[idx + 2] = (Math.random() - .5) * 130; phase.array[i] = Math.random() * Math.PI * 2;}
      }
      pos.needsUpdate = true;
    }

    let weatherTimer = 0, weatherObj = null, saveTimer = 2, monsterRespawnTimer = 0;
    const WANDER_RADIUS = 78;

    function updateWeather(dt) {weatherTimer -= dt; if (state.zone === 'snowcity') {if (state.weather !== 'snow') {setWeather('snow'); if (weatherObj) {window.AsgardEngineBridge.removeWorldObject(worldRoot, weatherObj); state.world = state.world.filter(x => x !== weatherObj)} weatherObj = weatherParticles();} return;} if (weatherTimer <= 0) {const list = ['clear', 'clear', 'rain', 'snow']; setWeather(list[Math.floor(Math.random() * list.length)]); if (weatherObj) {window.AsgardEngineBridge.removeWorldObject(worldRoot, weatherObj); state.world = state.world.filter(x => x !== weatherObj)} weatherObj = weatherParticles(); weatherTimer = 35 + Math.random() * 25} }
    function monsterSay(e, text) {
      if (!e.userData.label) {const c = document.createElement('canvas'); c.width = 420; c.height = 92; const ctx = c.getContext('2d'); ctx.fillStyle = 'rgba(10,15,24,.88)'; ctx.roundRect(6, 6, 408, 80, 18); ctx.fill(); ctx.fillStyle = '#fff'; ctx.font = 'bold 22px Microsoft JhengHei'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(text, 210, 46); const t = new THREE.CanvasTexture(c); const sp = new THREE.Sprite(new THREE.SpriteMaterial({map: t, transparent: true})); sp.scale.set(4.8, 1.05, 1); sp.position.y = 3.0; e.add(sp); e.userData.label = sp; e.userData.labelUntil = performance.now() + 2600;} else {e.userData.label.material.map.image.getContext?.('2d'); e.userData.label.visible = true; e.userData.labelUntil = performance.now() + 2600;}
    }
    function bossUseSkill(e, playerPos) {
      const u = e.userData, sk = u.bossSkill;
      if (!sk || !u.alive || state.dead) return false;
      const d = e.position.distanceTo(playerPos);
      if (d > sk.range) return false;
      u.bossSkillCd = sk.cooldown * (.9 + Math.random() * .2);
      const from = e.position.clone().add(new THREE.Vector3(0, 1.2, .35));
      const to = playerPos.clone(); to.y = .15;
      spawnEffect(sk.type, from, sk.color || 0xff5b6e);
      if (sk.type === 'fireball' || sk.type === 'magicbolt') spawnSkillPath(sk.type, from, to, sk.color || 0xffb14e);
      else spawnEffect(sk.type, playerPos.clone(), sk.color || 0xffb14e);
      try {playGameSound(sk.sound || 'hit', sk.sound || 'hit', 1.45)} catch (_) { }
      const damage = Math.max(1, Math.round((u.stats?.atk || 20) * sk.mult - getDefense() * .18));
      state.hp = Math.max(0, state.hp - damage);
      playPlayerHurtSound(1.25);
      monsterSay(e, '【' + sk.name + '】');
      addCombatLog('👑 ' + u.name + ' 使用 ' + sk.name + '　-' + damage + ' HP', 'sys');
      updateUI(); toast('👑 ' + sk.name + '！ -' + damage + ' HP');
      if (state.hp <= 0) diePlayer(u.name + '的' + sk.name);
      return true;
    }
    function setupEnemyWalkParts(g, type) {
      const flying = ['dragon', 'ghost', 'fairy', 'bat', 'firebat'].includes(type);
      const potter = ['potterWater', 'potterSailor', 'potterHedgehog', 'potterKnight', 'potterGeneral'].includes(type);
      // 波特族完全漂浮，沒有腿／腳；禁止 fallback 自動抓取身體零件當成腿。
      if (flying || potter) return [];
      const marked = [];
      g.traverse(o => {
        if (o === g || !o.userData?.enemyLeg) return;
        marked.push(o);
      });
      // 妖貓族使用「整條腿 Group」作為髖部 Pivot，不能拆成零件分別晃動。
      // 其他怪物則沿用已標記的腿部零件；沒有標記時才使用最低位置的部件作備援。
      const parts = marked.length ? marked.slice(0, 12) : (() => {
        const candidates = [];
        g.traverse(o => {
          if (!o.isMesh || o === g) return;
          const x = Math.abs(o.position.x || 0), y = o.position.y || 0;
          if (x > .08 && y >= .08 && y <= .72) candidates.push(o);
        });
        candidates.sort((a, b) => (a.position.y || 0) - (b.position.y || 0));
        return candidates.slice(0, 4);
      })();
      return parts.map(o => ({
        o,
        baseZ: o.rotation.z,
        baseX: o.rotation.x,
        baseY: o.position.y,
        baseZPos: o.position.z,
        side: o.userData?.enemyLegSide || ((o.position.x || 0) < 0 ? -1 : 1),
        catLeg: o.userData?.enemyLeg === true && (type === 'beastknight' || type === 'beastmage' || type === 'beastclaw')
      }));
    }
    function setupEnemyAttackParts(g, type) {
      const isCat = ['beastknight', 'beastmage', 'beastclaw'].includes(type);
      if (!isCat) return [];
      const parts = [];
      g.traverse(o => {
        if (o.userData?.enemyArm === true || o.userData?.enemyAttackWeapon === true || o.userData?.potterHand === true) {
          parts.push({
            o,
            baseX: o.rotation.x,
            baseY: o.rotation.y,
            baseZ: o.rotation.z,
            side: o.userData.enemyArmSide || o.userData.enemyAttackSide || ((o.position.x || 0) < 0 ? -1 : 1),
            weapon: o.userData.enemyAttackWeapon === true,
            potterHand: o.userData.potterHand === true,
            basePosX: o.position.x,
            basePosY: o.position.y,
            basePosZ: o.position.z
          });
        }
      });
      return parts;
    }
    function updateEnemyMotionAnimation(e, dt) {
      const u = e.userData; if (!u) return;
      if (u.walkParts?.length) {
        if (u.walking) {
          // 妖貓族：以髖部為軸做明確的「左腳前、右腳後」交替步伐，
          // 同時抬腳、踩地，讓追玩家時也能看出雙腳真正走路，而不是整體滑行。
          const isCat = ['beastknight', 'beastmage', 'beastclaw'].includes(u.type);
          const isPotter = ['potterWater', 'potterSailor', 'potterHedgehog', 'potterKnight', 'potterGeneral'].includes(u.type);
          const speedBase = Math.max(2.8, u.wanderSpeed || u.stats?.speed || 2.5);
          u.walkPhase = (u.walkPhase || 0) + dt * speedBase * (isCat ? 5.8 : 4.8);
          u.walkParts.forEach((p) => {
            const phase = u.walkPhase + (p.side < 0 ? 0 : Math.PI);
            const swing = Math.sin(phase);
            const forward = Math.cos(phase);
            if (isCat) {
              // RPG 式明顯步伐：一腳前踏、一腳後蹬，並抬腳離地。
              // 使用較大的髖部擺幅與腳步前後位移，讓追擊時也能清楚看到雙腳。
              p.o.rotation.x = p.baseX + swing * 1.02;
              p.o.rotation.z = p.baseZ;
              p.o.position.z = p.baseZPos + forward * .30;
              p.o.position.y = p.baseY + Math.max(0, swing) * .13;
            } else {
              const lift = Math.max(0, swing) * .035;
              p.o.rotation.x = p.baseX + swing * .62;
              p.o.rotation.z = p.baseZ;
              p.o.position.z = p.baseZPos + forward * .16;
              p.o.position.y = p.baseY + lift;
            }
          });
          // 移動中也保留符合武器／能力的戰鬥姿勢：劍類有揮臂節奏、長槍有突刺預備、法系有施法蓄力、重型怪物有沉重踏步。
          // 這是「走路中的攻擊感」，真正命中時仍由 enemyAttackAnim 播放完整攻擊。
          const moveSwing = Math.sin(u.walkPhase), movePulse = Math.max(0, Math.sin(u.walkPhase * 0.5));
          if (isPotter && u.attackParts?.length) {
            // 波特移動：身體左右漂移時，兩隻舉起的手臂／手掌同步輕擺。
            const handSwing = Math.sin(u.walkPhase) * .16;
            u.attackParts.forEach(ap => {
              if (ap.potterHand) {
                const side = ap.side || 1;
                ap.o.position.x = ap.basePosX + side * handSwing * .10;
                ap.o.position.y = ap.basePosY + Math.cos(u.walkPhase) * .035;
                ap.o.position.z = ap.basePosZ + Math.abs(handSwing) * .035;
              } else if (!ap.weapon) {
                ap.o.rotation.x = ap.baseX - handSwing * .18;
              }
            });
            // 將軍披風：保持向下斜約 60°，走動時左右＋上下輕微擺動，避免僵硬。
            if (u.potterCape) {
              const cape = u.potterCape;
              const flap = Math.sin(u.walkPhase * 1.35);
              const flutter = Math.sin(u.walkPhase * 2.15 + 0.7);
              cape.rotation.x = cape.userData.capeBaseRotX + flap * .10;
              cape.rotation.y = cape.userData.capeBaseRotY + flutter * .08;
              cape.rotation.z = cape.userData.capeBaseRotZ + flap * .07;
              cape.position.y = cape.userData.capeBasePosY + flutter * .035;
              cape.position.z = cape.userData.capeBasePosZ - flap * .06;
            }
            // 將軍披風即使沒有攻擊手臂動畫，也必須獨立產生布料飄動。
            if (u.potterCape) {
              const cape = u.potterCape;
              const flap = Math.sin(u.walkPhase * 1.35);
              const flutter = Math.sin(u.walkPhase * 2.15 + 0.7);
              cape.rotation.x = cape.userData.capeBaseRotX + flap * .10;
              cape.rotation.y = cape.userData.capeBaseRotY + flutter * .08;
              cape.rotation.z = cape.userData.capeBaseRotZ + flap * .07;
              cape.position.y = cape.userData.capeBasePosY + flutter * .035;
              cape.position.z = cape.userData.capeBasePosZ - flap * .06;
            }
            e.position.y = (u.baseY || 0) + Math.abs(Math.sin(u.walkPhase)) * .035;
            e.rotation.z = Math.sin(u.walkPhase) * .045;
          } else if (!isCat) {
            if (u.attackStyle === 'slash' || u.attackStyle === 'claw') {
              e.rotation.z = moveSwing * .035;
              e.rotation.x = moveSwing * .035;
            } else if (u.attackStyle === 'thrust') {
              e.rotation.x = -Math.max(0, moveSwing) * .045;
            } else if (u.attackStyle === 'charge') {
              e.rotation.x = -Math.max(0, moveSwing) * .07;
            } else if (u.attackStyle === 'cast') {
              e.rotation.z = moveSwing * .045;
              e.position.y = (u.baseY || 0) + Math.max(0, moveSwing) * .025;
            } else if (u.attackStyle === 'slam') {
              e.position.y = (u.baseY || 0) - Math.max(0, moveSwing) * .025;
              e.rotation.x = moveSwing * .025;
            } else if (u.attackStyle === 'fly') {
              e.rotation.x = moveSwing * .08;
            } else if (u.attackStyle === 'hop') {
              e.position.y = (u.baseY || 0) + Math.max(0, moveSwing) * .10;
            }
          }
          // 妖貓追擊時增加很輕微的身體上下起伏，讓腳步與身體節奏一致。
          if (isCat) {
            const bob = Math.abs(Math.sin(u.walkPhase)) * .035;
            e.position.y = (u.baseY || 0) + bob;
          }
        } else {
          u.walkParts.forEach(p => {
            p.o.rotation.z += (p.baseZ - p.o.rotation.z) * Math.min(1, dt * 10);
            p.o.rotation.x += (p.baseX - p.o.rotation.x) * Math.min(1, dt * 10);
            p.o.position.y += (p.baseY - p.o.position.y) * Math.min(1, dt * 10);
            p.o.position.z += (p.baseZPos - p.o.position.z) * Math.min(1, dt * 10);
          });
          if (['beastknight', 'beastmage', 'beastclaw'].includes(u.type)) e.position.y += ((u.baseY || 0) - e.position.y) * Math.min(1, dt * 10);
          if (u.potterCape) {
            const cape = u.potterCape;
            cape.rotation.x += (cape.userData.capeBaseRotX - cape.rotation.x) * Math.min(1, dt * 8);
            cape.rotation.y += (cape.userData.capeBaseRotY - cape.rotation.y) * Math.min(1, dt * 8);
            cape.rotation.z += (cape.userData.capeBaseRotZ - cape.rotation.z) * Math.min(1, dt * 8);
            cape.position.y += (cape.userData.capeBasePosY - cape.position.y) * Math.min(1, dt * 8);
            cape.position.z += (cape.userData.capeBasePosZ - cape.position.z) * Math.min(1, dt * 8);
          }
        }
      }
      if (u.enemyAttackAnim && !u.aliceSpear) {
        const a = u.enemyAttackAnim; a.t += dt; const p = Math.min(1, a.t / a.duration), wave = Math.sin(Math.PI * p), style = a.style;
        const isCat = ['beastknight', 'beastmage', 'beastclaw'].includes(u.type);
        const isPotter = ['potterWater', 'potterSailor', 'potterHedgehog', 'potterKnight', 'potterGeneral'].includes(u.type);
        if (style === 'charge') {e.position.z = a.baseZ + wave * .32; e.rotation.x = Math.sin(Math.PI * p) * -.18;}
        else if (style === 'thrust') {
          e.position.z = a.baseZ + wave * .34;
          e.rotation.x = Math.sin(Math.PI * p) * -.10;
          if (isCat && u.attackParts?.length) {u.attackParts.forEach(ap => {ap.o.position.z = ap.basePosZ + wave * .30; ap.o.rotation.x = ap.baseX - wave * .72;});}
        }
        else if (style === 'slash' || style === 'claw') {
          if (isPotter && u.attackParts?.length) {
            const strike = Math.sin(Math.PI * Math.min(1, p / .72));
            u.attackParts.forEach(ap => {
              if (ap.potterHand) {
                const side = ap.side || 1;
                ap.o.position.z = ap.basePosZ + strike * .16;
                ap.o.position.y = ap.basePosY + strike * .03;
                ap.o.position.x = ap.basePosX + side * strike * .04;
              } else if (!ap.weapon) {
                ap.o.rotation.x = ap.baseX - strike * .22;
              }
            });
            e.position.z = a.baseZ + wave * .10;
          } else if (isCat && u.attackParts?.length) {
            // 妖貓真正「手向前揮」：先收臂，再快速向前／下方劈出。
            const attackWave = Math.sin(Math.PI * p);
            const strike = Math.sin(Math.PI * Math.min(1, p / .72));
            u.attackParts.forEach(ap => {
              const side = ap.side || 1;
              ap.o.rotation.z = ap.baseZ + side * (0.12 + attackWave * .28);
              ap.o.rotation.x = ap.baseX - strike * 1.18;
              ap.o.position.z = ap.basePosZ + strike * .18;
              ap.o.position.y = ap.basePosY - strike * .035;
            });
            e.rotation.y = a.baseRotY + Math.sin(Math.PI * p) * .18;
            e.position.z = a.baseZ + wave * .10;
          } else {
            e.rotation.y = a.baseRotY + Math.sin(Math.PI * p) * .62; e.position.z = a.baseZ + wave * .18;
          }
        }
        else if (style === 'cast') {
          e.rotation.z = Math.sin(Math.PI * p) * .14; e.position.y = a.baseY + wave * .12;
          if (isPotter && u.attackParts?.length) {
            const castIn = Math.sin(Math.PI * p);
            u.attackParts.forEach(ap => {
              if (ap.potterHand) {
                ap.o.position.z = ap.basePosZ + castIn * .14;
                ap.o.position.y = ap.basePosY + castIn * .05;
              } else if (!ap.weapon) {
                ap.o.rotation.x = ap.baseX - castIn * .35;
              }
            });
          } else if (isCat && u.attackParts?.length) {
            const castIn = Math.sin(Math.PI * p);
            u.attackParts.forEach(ap => {
              if (ap.weapon) {ap.o.rotation.x = ap.baseX - castIn * .62; ap.o.rotation.z = ap.baseZ + castIn * .16;}
              else {const side = ap.side || 1; ap.o.rotation.x = ap.baseX - castIn * .72; ap.o.rotation.z = ap.baseZ - side * castIn * .20;}
            });
          }
        }
        else if (style === 'slam') {
          const bs = u.baseScale || new THREE.Vector3(1, 1, 1);
          e.scale.copy(bs); e.scale.y = bs.y * (1 + wave * .12); e.position.y = a.baseY + wave * .08;
        }
        else if (style === 'fly') {e.position.y = a.baseY + Math.sin(Math.PI * p) * .38; e.rotation.x = Math.sin(Math.PI * p) * .20;}
        else if (style === 'hop') {e.position.y = a.baseY + wave * .32;}
        else {e.rotation.x = Math.sin(Math.PI * p) * -.14;}
        if (p >= 1) {
          e.position.y = a.baseY; e.rotation.x = 0; e.rotation.z = 0; e.rotation.y = a.baseRotY || e.rotation.y;
          if (u.baseScale) e.scale.copy(u.baseScale);
          // 攻擊結束後強制恢復可見／站立狀態，避免部分怪物在近身時殘留動畫狀態而看起來像消失。
          e.visible = true; u.walking = false;
          if (u.attackParts?.length) {u.attackParts.forEach(ap => {ap.o.rotation.x = ap.baseX; ap.o.rotation.y = ap.baseY; ap.o.rotation.z = ap.baseZ; ap.o.position.x = ap.basePosX; ap.o.position.y = ap.basePosY; ap.o.position.z = ap.basePosZ;});}
          u.enemyAttackAnim = null;
        }
      }
      if (u.aliceSpear) {
        const a = u.enemyAttackAnim;
        if (a) {
          a.t += dt; const p = Math.min(1, a.t / .46); const thrust = p < .28 ? p / .28 : 1 - (p - .28) / .72;
          const z = .28 + Math.max(0, thrust) * .72; u.aliceSpear.group.position.z = z;
          if (a.t >= .46) {u.enemyAttackAnim = null; u.aliceSpear.group.position.z = .28;}
        }
      }
    }
    function getMonsterRangedAttack(type) {
      const map = {
        beastmage: {name: '暗黑彈', effect: 'blacksmoke', color: 0xb06cff},
        snowmage: {name: '冰霜魔法彈', effect: 'magicbolt', color: 0x8ed8ff},
        dragon: {name: '龍息火焰彈', effect: 'fireball', color: 0xff6a22},
        firebat: {name: '火焰彈', effect: 'fireball', color: 0xff8b2e},
        ghost: {name: '暗影彈', effect: 'blacksmoke', color: 0x9d72ff},
        imp: {name: '暗黑彈', effect: 'blacksmoke', color: 0x8d3cff},
        fairy: {name: '魔法彈', effect: 'magic', color: 0xff9ff5},
        bat: {name: '音波彈', effect: 'magic', color: 0x9fdcff},
        cardQueen: {name: '黑桃魔法彈', effect: 'magicbolt', color: 0xc58cff},
        potterWater: {name: '水滴魔彈', effect: 'magicbolt', color: 0x55dfff},
        potterHedgehog: {name: '刺水魔彈', effect: 'magicbolt', color: 0x38bfff}
      };
      return map[type] || {name: '魔法彈', effect: 'magic', color: 0x9fdcff};
    }
    function fireMonsterRangedAttack(e, damage) {
      const u = e?.userData; if (!e || !u?.alive || state.dead) return false;
      const spec = getMonsterRangedAttack(u.type);
      const from = e.position.clone().add(new THREE.Vector3(0, 1.05, 0));
      const to = state.player.position.clone().add(new THREE.Vector3(0, .72, 0));
      // 遠距離怪物先做施法／蓄力動作，再發射真正的攻擊彈，避免玩家只看到固定扣血。
      triggerEnemyAttackAnimation(e, u.attackStyle || 'cast');
      spawnSkillPath(spec.effect, from, to, spec.color);
      monsterSay(e, '【' + spec.name + '】');
      addCombatLog('✨ ' + u.name + ' 施放 ' + spec.name, 'sys');
      // 命中由投射物抵達時結算；同一時間只允許一個遠程命中事件，避免每幀扣血。
      const hitDelay = 320;
      setTimeout(() => {
        if (state.dead || !u.alive || !state.player) return;
        const dist = e.position.distanceTo(state.player.position);
        if (dist > MONSTER_RANGED_ATTACK_RANGE + 3.0) return;
        // 全體怪物共享短暫受擊間隔，避免多隻怪物疊加造成「不停扣血」。
        if ((state.enemyHitCooldown || 0) > 0) return;
        const finalDamage = Math.max(1, Math.round(damage));
        state.enemyHitCooldown = .32;
        state.hp = Math.max(0, state.hp - finalDamage);
        spawnEffect('hit', state.player.position.clone().add(new THREE.Vector3(0, .75, 0)), spec.color);
        playPlayerHurtSound(1.35);
        try {playGameSound('hit', 'hurt', 1.15)} catch (_) { }
        updateUI(); toast('✨ ' + u.name + ' ' + spec.name + ' -' + finalDamage + ' HP');
        if (state.hp <= 0) diePlayer(u.name + '的' + spec.name);
      }, hitDelay);
      return true;
    }
    function updateEnemies(dt) {
      if (state.dead) return;
      state.enemyHitCooldown = Math.max(0, (state.enemyHitCooldown || 0) - dt);
      const currentZone = zoneData[state.zone] || zoneData.forest; if (!zoneData[state.zone]) state.zone = 'forest';
      if (!state.enemies.length && currentZone.types.length) spawnEnemies();
      const highLevelMap = (currentZone.range?.[0] || 0) >= 11;
      const hostileMap = !currentZone.safe;
      const playerPos = state.player.position;
      const now = performance.now();
      // 高等級怪物共享警戒：一隻發現玩家，附近同種／同區域怪物會迅速加入戰鬥。
      if (highLevelMap) {
        for (const e of state.enemies) {
          if (!e.userData.alive || e.userData.boss || !e.userData.aggroed) continue;
          for (const ally of state.enemies) {
            if (ally === e || !ally.userData.alive || ally.userData.boss || ally.userData.aggroed) continue;
            const ad = ally.position.distanceTo(e.position);
            if (ad < 15) {ally.userData.aggroed = true; ally.userData.aiAlert = 2.8; ally.userData.aiOffsetAngle = (Math.atan2(e.position.x - playerPos.x, e.position.z - playerPos.z) + (Math.random() - .5) * 1.4);}
          }
        }
      }
      for (const e of state.enemies) {
        if (!e.userData.alive) continue;
        // 先清除上一幀狀態，再依本幀是否真的移動決定 walking。
        // 舊版在 updateEnemyMotionAnimation() 後才設 false，導致追擊時上一幀的走路狀態被直接清掉。
        e.userData.walking = false;
        const d = e.position.distanceTo(playerPos), v = e.userData.stats || monsterTypes[e.userData.type], u = e.userData;
        if (['beastknight', 'beastmage', 'beastclaw'].includes(u.type) && u.aggroed && d > (isMonsterRangedType(u.type) ? MONSTER_RANGED_ATTACK_RANGE : 2.35)) u.walking = true;
        updateEnemyMotionAnimation(e, dt);
        if (u.label && now > u.labelUntil) u.label.visible = false;
        u.dialogueTimer -= dt; if (u.dialogueTimer <= 0 && !u.boss) {const lines = (MONSTER_RACE[u.type]?.lines) || ['……']; monsterSay(e, lines[Math.floor(Math.random() * lines.length)]); u.dialogueTimer = 8 + Math.random() * 14;}
        if (u.boss) {
          // Lv.60+ 地圖王為被動巡遊型：不主動索敵、不攻擊玩家、不追玩家。
          // 只在地圖外圍巡邏，不干擾玩家正常打怪，也不會把玩家卡住。
          u.aggroed = false;
          u.bossSkillCd = Math.max(0, (u.bossSkillCd || 0) - dt);
          u.wanderTimer -= dt;
          const mapSize = Math.max(24, zoneData[state.zone]?.size || 70);
          const patrolRadius = Math.max(18, mapSize * .72);
          if (u.wanderTimer <= 0 || Math.hypot(u.wanderX - e.position.x, u.wanderZ - e.position.z) < 2) {
            const a = Math.random() * Math.PI * 2;
            const r = patrolRadius * (.72 + Math.random() * .24);
            u.wanderX = Math.cos(a) * r; u.wanderZ = Math.sin(a) * r; u.wanderTimer = 5 + Math.random() * 8;
          }
          const dx = u.wanderX - e.position.x, dz = u.wanderZ - e.position.z, dd = Math.hypot(dx, dz);
          if (dd > .6) {
            const sp = Math.max(.65, (u.wanderSpeed || 2.2) * .48);
            tryMoveEntity(e, dx / dd * sp * dt, dz / dd * sp * dt, Math.max(.55, (e.userData.boss ? 1.05 : .62) * (e.scale?.x || 1)));
            u.walking = true; e.rotation.y = Math.atan2(dx, dz);
          } else u.walking = false;
          continue;
        }
        const ai = HIGH_LEVEL_AI[u.moveType] || HIGH_LEVEL_AI.default;
        const forestPassive = state.zone === 'forest';
        const aggro = (!forestPassive && hostileMap) ? Math.max(10, u.aggroRange * ai.aggro) : 0;
        // 路爾斯森林為安全練習區：怪物只巡遊，不會主動索敵或追擊玩家。
        if (!forestPassive && hostileMap && d <= aggro) u.aggroed = true;
        if (u.aiAlert > 0) u.aiAlert -= dt;
        if (u.aggroed) {
          const rangedMonster = isMonsterRangedType(u.type);
          if (u.elite) {u.eliteSkillCd = Math.max(0, (u.eliteSkillCd || 0) - dt); if (useEliteSkill(e)) continue;}
          if (d > 24) {u.aggroed = false; u.aiAlert = 0; u.wanderTimer = 0; continue;}
          u.aiThink -= dt;
          if (u.aiThink <= 0) {
            // 依隊形計算包圍點：不同怪物不會全部疊在玩家同一個位置。
            const same = state.enemies.filter(a => a.userData.alive && !a.userData.boss && a.userData.aggroed);
            const idx = Math.max(0, same.indexOf(e));
            const count = Math.max(1, same.length), angle = u.aiOffsetAngle + (idx / count) * Math.PI * 2;
            const radius = rangedMonster
              ? Math.max(MONSTER_RANGED_ATTACK_RANGE * .82, Math.min(MONSTER_RANGED_ATTACK_RANGE * .98, u.aiOffsetRadius + MONSTER_RANGED_ATTACK_RANGE * .55))
              : Math.max(2.0, Math.min(5.5, u.aiOffsetRadius + (d < 5 ? -1 : 1)));
            u.aiTargetX = playerPos.x + Math.sin(angle) * radius;
            u.aiTargetZ = playerPos.z + Math.cos(angle) * radius;
            u.aiThink = .35 + Math.random() * .45;
          }
          const combatRange = rangedMonster ? MONSTER_RANGED_ATTACK_RANGE : 2.35;
          if (d > combatRange) {
            const target = new THREE.Vector3(u.aiTargetX, 0, u.aiTargetZ), dir = target.clone().sub(e.position).setY(0);
            if (dir.length() < .35) {
              // 到達包圍點後，微調面向玩家，形成近戰包圍。
              dir.copy(playerPos).sub(e.position).setY(0);
            }
            dir.normalize();
            let speed = v.speed * ai.speed * 1.22 * MONSTER_SPEED_MULTIPLIER;
            if (u.moveType === 'zigzag' || u.moveType === 'flutter') speed *= 1.08;
            if (u.moveType === 'heavy' || u.moveType === 'rooted') speed *= .72;
            if (u.moveType === 'charge' && d > 7) speed *= 1.22;
            if (u.moveType === 'burrow' && d > 9) speed *= 1.18;
            const beforeX = e.position.x, beforeZ = e.position.z;
            navMoveEntity(e, playerPos.x, playerPos.z, speed * dt, Math.max(.55, (e.userData.boss ? 1.05 : .62) * (e.scale?.x || 1)));
            // 追擊玩家時才播放步行姿勢；自由漫遊則維持站立／待機姿勢。
            const moved = Math.hypot(e.position.x - beforeX, e.position.z - beforeZ) > .0005;
            u.walking = moved;
            if (['beastknight', 'beastmage', 'beastclaw'].includes(u.type) && d > (rangedMonster ? MONSTER_RANGED_ATTACK_RANGE : 2.35)) u.walking = true;
            // 讓不同種類產生不同的移動習性。
            if (u.moveType === 'zigzag') tryMoveEntity(e, Math.sin(now * .007 + (e.id || 0)) * .22 * dt, 0, Math.max(.55, .62 * (e.scale?.x || 1)));
            if (u.moveType === 'flutter') e.position.y = .05 + Math.abs(Math.sin(now * .006 + e.id)) * 0.16;
            e.rotation.y = Math.atan2(playerPos.x - e.position.x, playerPos.z - e.position.z);
          } else {
            u.aiAttackCd -= dt;
            if (u.aiAttackCd <= 0) {
              // 團隊攻擊不會完全同一幀爆發；遠程怪物改為「施法→投射物→命中」流程。
              const damage = Math.max(1, Math.round(v.atk * (highLevelMap ? .34 : .28) - getDefense() * .10));
              u.aiAttackCd = ai.attackCd * (.85 + Math.random() * .35);
              if (rangedMonster) {
                fireMonsterRangedAttack(e, damage);
              } else {
                triggerEnemyAttackAnimation(e, u.attackStyle); if (u.aliceSpear) u.enemyAttackAnim = {t: 0, duration: .46, style: 'charge'};
                const attackFxColor = u.moveType === 'float' || u.moveType === 'flutter' ? 0x9fdcff : (u.moveType === 'heavy' ? 0xff9d55 : 0xffd36a);
                const attackEffect = u.attackStyle === 'slam' ? 'shockwave' : 'slash';
                const impactPos = state.player.position.clone().add(new THREE.Vector3(0, .75, 0));
                spawnEffect(attackEffect, impactPos, attackFxColor);
                // 每次怪物真正命中玩家時都顯示明確的打擊／受擊特效。
                spawnEffect('hit', impactPos, attackFxColor);
                // 近戰也有短暫受擊間隔，避免多隻怪物同幀疊傷造成玩家持續快速掉血。
                if ((state.enemyHitCooldown || 0) <= 0) {
                  state.enemyHitCooldown = .32;
                  state.hp = Math.max(0, state.hp - damage);
                  playPlayerHurtSound(u.moveType === 'heavy' ? 1.55 : 1.35);
                  try {playGameSound('hit', 'hurt', 1.15)} catch (_) { }
                  monsterSay(e, (MONSTER_RACE[u.type]?.lines || ['……'])[0]); updateUI(); toast('💥 ' + u.name + ' 攻擊你 -' + damage + ' HP');
                  if (state.hp <= 0) diePlayer(u.name);
                }
              }
            }
          }
          continue;
        }
        // 低等級地圖仍保持較安全；怪物只做自然漫遊。
        u.wanderTimer -= dt; if (u.wanderTimer <= 0 || Math.hypot(u.wanderX - e.position.x, u.wanderZ - e.position.z) < 1.2) {
          const mode = u.moveType; let a = Math.random() * Math.PI * 2, r = 8 + Math.random() * (mode === 'pack' ? 34 : WANDER_RADIUS - 8);
          if (mode === 'patrol') a = Math.round(a / (Math.PI / 2)) * (Math.PI / 2);
          u.wanderX = u.homeX + Math.cos(a) * r; u.wanderZ = u.homeZ + Math.sin(a) * r; u.wanderX = Math.max(-WANDER_RADIUS, Math.min(WANDER_RADIUS, u.wanderX)); u.wanderZ = Math.max(-WANDER_RADIUS, Math.min(WANDER_RADIUS, u.wanderZ)); u.wanderTimer = mode === 'scuttle' ? 1.2 + Math.random() * 2.5 : 2.5 + Math.random() * 5.5;
        }
        const dx = u.wanderX - e.position.x, dz = u.wanderZ - e.position.z, dd = Math.hypot(dx, dz); if (dd > .3) {let sp = u.wanderSpeed; if (u.moveType === 'hop') sp *= .8; if (u.moveType === 'heavy' || u.moveType === 'rooted') sp *= .55; if (u.moveType === 'flutter') sp *= 1.2; tryMoveEntity(e, dx / dd * sp * dt, dz / dd * sp * dt, Math.max(.55, (e.userData.boss ? 1.05 : .62) * (e.scale?.x || 1))); u.walking = false; if (u.moveType === 'hop') e.position.y = Math.abs(Math.sin(now * .008)) * 0.35; e.rotation.y = Math.atan2(dx, dz);}
      }
      state.enemies = state.enemies.filter(e => {if (!e.userData.alive && e.userData.removeAt && now >= e.userData.removeAt) {window.AsgardEngineBridge.removeWorldObject(monsterRoot, e); disposeObject3D(e); return false} return true});
      processMonsterRespawnQueue();
      monsterRespawnTimer -= dt;
      updateFrenzyState();
      if (monsterRespawnTimer <= 0) {
        monsterRespawnTimer = MONSTER_RESPAWN_INTERVAL;
        const types = zoneData[state.zone].types;
        if (types.length) {
          for (const type of types) {
            const region = getMonsterRegionState(type);
            const alive = getFrenzyAliveCount(type);
            let spawnCount = 0;
            if (region.frenzy) {
              // 暴走區：每滿一分鐘增加 5 隻，總量最多 50 隻。
              const nowSec = performance.now() / 1000;
              const elapsed = nowSec - region.lastKill;
              const minuteTick = Math.max(1, Math.floor((elapsed - FRENZY_IDLE_THRESHOLD) / 60) + 1);
              const desired = Math.min(FRENZY_REGION_CAP, MONSTER_REGION_CAP + minuteTick * FRENZY_SPAWN_PER_MINUTE);
              const currentMinute = Math.floor((elapsed - FRENZY_IDLE_THRESHOLD) / 60);
              if (currentMinute !== region.lastSpawnMinute && alive < desired) {
                spawnCount = Math.min(FRENZY_SPAWN_PER_MINUTE, desired - alive);
                region.lastSpawnMinute = currentMinute;
              }
            } else {
              // 正常區域：只補真正缺口；已排入延遲重生佇列的不再重複生成。
              const pending = countPendingMonsterRespawns(type);
              const missing = Math.max(0, MONSTER_REGION_CAP - alive - pending);
              spawnCount = Math.min(MONSTER_SPAWN_PER_SECOND, missing);
            }
            for (let i = 0; i < spawnCount; i++) {const p = getMonsterSpawnPoint(type); spawnEnemy(type, p.x, p.z);}
          }
        }
      }
      updateFrenzyZoneNotice(); updateEnemyLabelForAll(); updateTargetPanel();
    }
    function updateEnemyLabelForAll() {for (const e of state.enemies) if (e.userData.alive && e.userData.labelDirty) updateEnemyLabel(e)}
    function updateDrops(dt) {
      for (const d of state.drops) {
        d.rotation.y += dt * 2.4;
        d.userData.life -= dt;
        const item = d.userData.item;
        const blocked = item && item.dropable && EQUIP_SLOTS.includes(item.slot || item.type) && RARITY_ORDER[item.rarity || 'normal'] < RARITY_ORDER[state.pickupMinRarity || 'normal'];
        const dist = d.position.distanceTo(state.player.position);
        // 戰利品現在會主動追蹤玩家，不需要走到掉落物旁邊；仍尊重「最低裝備品質」設定。
        if (!blocked) {
          if (dist > 1.15) {
            const dir = state.player.position.clone().sub(d.position);
            if (dir.length() > 0.05) {
              dir.normalize();
              const speed = Math.min(18, 8 + dist * .65);
              d.position.addScaledVector(dir, Math.min(speed * dt, dist - 1.0));
            }
          } else {
            if (item) {
              const it = state.inventory.find(x => x.id === item.id);
              if (it && it.type === 'material') it.qty++;
              else if (item.type === 'consumable' && item.potion === 'hp') addConsumable('potion', 'HP藥水', HP_POTION_ICON_SRC, 'hp', item.qty || 1);
              else if (item.type === 'consumable' && item.potion === 'mp') addConsumable('mp_potion', 'MP藥水', MP_POTION_ICON_SRC, 'mp', item.qty || 1);
              else if (item.type === 'consumable' && item.potion === 'sp') addConsumable('sp_potion', 'SP藥水', SP_POTION_ICON_SRC, 'sp', item.qty || 1);
              else state.inventory.push({...item});
              addCombatLog('🎁 掉落：' + (EQUIP_SLOTS.includes(item.slot || item.type) ? equipmentDisplayName(item) : item.name) + (item.qty > 1 ? ' x' + item.qty : ''), 'sys');
              // 自動拾取不再在畫面上方彈出資料框，避免遮擋遊戲畫面。
              // toast('🧲 自動拾取：'+item.name);
              saveGame();
            }
            d.userData.life = 0;
          }
        }
      }
      state.drops = state.drops.filter(d => {if (d.userData.life <= 0) {scene.remove(d); return false} return true});
    }
    function updatePortals(dt) {
      if (!state.portals.length || state.dead) return;
      const sec = performance.now() * .001;
      for (const p of state.portals) {
        const phase = Number(p.userData?.portalPhase) || 0;
        const pulse = .5 + .5 * Math.sin(sec * 3.0 + phase);
        p.traverse(o => {
          if (!o.userData?.portalGlow) return;
          if (o.material && 'opacity' in o.material) {
            const base = Number(o.userData.portalBaseOpacity ?? .34);
            if (o.userData.portalBeam) o.material.opacity = Math.max(.035, base + Math.sin(sec * 2.4 + phase) * base * .34);
            else if (o.userData.portalParticle) o.material.opacity = .48 + .42 * (.5 + .5 * Math.sin(sec * 7.0 + (o.userData.portalParticlePhase || 0) * Math.PI * 2));
            else o.material.opacity = Math.min(.96, base * (.72 + .55 * pulse));
          }
          if (o.userData?.portalBeam) {
            const sway = 1 + Math.sin(sec * 1.7 + phase) * .035; o.scale.x = sway; o.scale.z = 2 - sway;
          }
          if (o.userData?.portalParticle) {
            const speed = o.userData.portalParticleSpeed || 1;
            let ph = ((sec * speed + (o.userData.portalParticlePhase || 0)) % 1 + 1) % 1;
            const r = o.userData.portalParticleRadius || .18;
            const ang = sec * (1.2 + speed * .35) + (o.userData.portalParticlePhase || 0) * Math.PI * 2;
            o.position.y = .10 + ph * 5.55;
            o.position.x = Math.cos(ang) * r * (1 - ph * .35);
            o.position.z = Math.sin(ang) * r * (1 - ph * .35);
            const s = .72 + .7 * Math.sin(Math.PI * ph); o.scale.setScalar(s);
          }
          if (o.userData?.portalMovingLight) {
            const ph = ((sec * 1.05 + phase * .11) % 1 + 1) % 1; o.position.y = .7 + ph * 5.35; o.intensity = 1.5 + 2.8 * Math.sin(Math.PI * ph) ** 2;
          }
          if (o.isLight && !o.userData?.portalMovingLight) o.intensity = .8 + 1.6 * pulse;
        });
        const d = Math.hypot(p.position.x - state.player.position.x, p.position.z - state.player.position.z);
        if (d < 2.0 && p.userData.to && !p.userData._cooldown) {p.userData._cooldown = 1.5; toast('🟡 傳送至 ' + p.userData.name); goZone(p.userData.to); return;}
        p.userData._cooldown = Math.max(0, (p.userData._cooldown || 0) - dt);
      }
    }

    function updateCamera() {
      if (!state.player) return;
      const c = state.cam;
      // V1.01.18-RPG-SKY-FIX:
      // The vertical pivot is the character's shoes/feet, not the head.
      // Looking upward is therefore allowed to bring the camera down to the
      // feet/ankle area and, at the closest point, into a low first-person-like
      // perspective looking upward at the sky.
      const footY = state.player.position.y + 0.08;
      const target = new THREE.Vector3(
        state.player.position.x,
        footY,
        state.player.position.z
      );
      // Negative pitch = look upward. Keep the full RPG range.
      const cp = Math.max(-1.25, Math.min(1.25, c.pitch));
      const up = Math.max(0, Math.min(1, (-cp - 0.05) / 1.20));
      const skyT = up * up * (3 - 2 * up);

      const baseDist = Math.max(5, Number(c.dist) || 8);
      // As the player looks higher, smoothly collapse the orbit distance.
      // The final distance is intentionally short enough to feel almost
      // first-person, while retaining a tiny amount of character context.
      const orbitDist = Math.max(0.62, baseDist * (1 - 0.91 * skyT));
      // At the extreme skyward end, smoothly collapse the horizontal orbit to
      // the character's body centre. This is the intentional first-person
      // transition: the camera may pass through the character model.
      const firstPersonT = skyT * skyT * (3 - 2 * skyT);
      const orbitHorizontal = Math.max(0.28, Math.cos(cp) * orbitDist);
      const horizontalDist = THREE.MathUtils.lerp(orbitHorizontal, 0.015, firstPersonT);

      // IMPORTANT: use sin(cp), not sin(-cp). Negative sky pitch therefore
      // moves the camera downward first, then the closest point settles at
      // head-top height for the first-person view.
      let orbitY = target.y + Math.sin(cp) * orbitDist;
      const firstPersonY = state.player.position.y + 2.02;
      orbitY = Math.max(state.player.position.y + 1.55, orbitY);
      const desiredY = THREE.MathUtils.lerp(orbitY, firstPersonY, firstPersonT);
      // V1.01.22: true first-person state. The camera may pass through the
      // complete Character Model V2 visual stack (body, hair, face, armor,
      // helmet, cloak, weapon and offhand) without collision/occlusion.
      state.cameraFirstPerson = firstPersonT > 0.82;

      const desired = new THREE.Vector3(
        target.x + Math.sin(c.yaw) * horizontalDist,
        desiredY,
        target.z + Math.cos(c.yaw) * horizontalDist
      );

      // Keep the normal third-person foot pivot, but as the camera reaches the
      // first-person end, aim from head level into the sky. The camera is not
      // collision-clamped against the character model.
      const lookTarget = target.clone();
      lookTarget.y += THREE.MathUtils.lerp(skyT * 2.10, 2.82, firstPersonT);

      if (isMobileMode()) {
        camera.position.copy(desired);
        camera.near = .08;
        camera.far = 420;
      } else {
        camera.position.lerp(desired, .16);
        camera.position.y = Math.max(camera.position.y, state.player.position.y + 1.55);
        camera.near = .05;
        camera.far = 300;
      }
      camera.lookAt(lookTarget);
    }
    function updateResourceRegen(dt) {if (state.dead) return; state.regenTimer += dt; if (state.regenTimer < 1) return; const ticks = Math.floor(state.regenTimer); state.regenTimer -= ticks; state.hp = Math.min(getMaxHP(), state.hp + getHpRegen() * ticks); state.mp = Math.min(getMaxMP(), state.mp + getMpRegen() * ticks); state.sp = Math.min(getMaxSP(), state.sp + getSpRegen() * ticks); updateUI()}
    function updateMovement(dt) {
      if (state.dead || state.auto) {return;}
      let inputX = 0, inputZ = 0;
      if (state.keys.w || state.keys.ArrowUp) inputZ--;
      if (state.keys.s || state.keys.ArrowDown) inputZ++;
      if (state.keys.a || state.keys.ArrowLeft) inputX--;
      if (state.keys.d || state.keys.ArrowRight) inputX++;
      state.walkAnim.moving = false;
      if (inputX || inputZ) {
        state.target = null;
        const l = Math.hypot(inputX, inputZ); inputX /= l; inputZ /= l;
        // WASD follows the camera's horizontal facing.  The camera pitch is
        // intentionally ignored so vertical look does not affect movement.
        // W = screen-forward, S = screen-back, A/D = screen-left/right.
        const yaw = state.cam.yaw;
        const sinY = Math.sin(yaw), cosY = Math.cos(yaw);
        const x = inputX * cosY + inputZ * sinY;
        const z = inputX * sinY - inputZ * cosY;
        const speed = 6;
        const moved = tryMovePlayer(x * speed * dt, z * speed * dt);
        if (moved) state.player.rotation.y = Math.atan2(x, z);
        state.walkAnim.moving = moved; state.walkAnim.speed = speed;
      } else if (state.target) {
        const dx = state.target.x - state.player.position.x, dz = state.target.z - state.player.position.z, d = Math.hypot(dx, dz);
        if (d < .35) state.target = null;
        else {const speed = 6, vx = dx / d, vz = dz / d; const moved = navMoveEntity(state.player, state.target.x, state.target.z, speed * dt, .48); if (moved) state.player.rotation.y = Math.atan2(vx, vz); state.walkAnim.moving = moved; state.walkAnim.speed = speed; if (!moved && Math.random() < .02) state.target = null;}
      }
    }
    let miniTimer = 0;
    let miniTerrainTimer = 0;
    let miniTerrainKey = '';
    let miniTerrain = null;
    function miniMapStyle(zone) {
      const styles = {
        city: {ground: '#c8c4ba', road: '#f4f1e8', edge: '#88857d', water: '#6bb9d7', obstacle: '#34302b'},
        forest: {ground: '#4f914d', road: '#bca56b', edge: '#18351d', water: '#43aeca', obstacle: '#111'},
        miluris: {ground: '#39734a', road: '#9e9b65', edge: '#14291b', water: '#3e9eb3', obstacle: '#111'},
        demon: {ground: '#34194a', road: '#70507d', edge: '#09060e', water: '#6f55a5', obstacle: '#111'},
        seomi: {ground: '#edf4f8', road: '#d7e8ef', edge: '#708897', water: '#167eb6', obstacle: '#596b76'},
        volcano: {ground: '#76251a', road: '#b86635', edge: '#170706', water: '#ff5a16', obstacle: '#111'},
        snowcity: {ground: '#e8f1f7', road: '#ffffff', edge: '#596a78', water: '#8ed1eb', obstacle: '#111'}
      };
      if (zone.startsWith('beast')) return {ground: '#3a3433', road: '#665d58', edge: '#111111', water: '#4d777d', obstacle: '#111'};
      if (zone.startsWith('alice')) return {ground: '#e9a5bf', road: '#ffd3e2', edge: '#6f354c', water: '#d889bb', obstacle: '#111'};
      return styles[zone] || styles.forest;
    }
    function miniWorldToCanvas(wx, wz, mapSize = 220, w = 166, h = 120) {
      const half = Math.max(1, mapSize * .5);
      return {x: w / 2 + (wx / half) * (w / 2), y: h / 2 + (wz / half) * (h / 2)};
    }
    function miniWalkable(wx, wz, r = .72) {
      // 小地圖的「可行走像素」與實際碰撞判定共用同一規則。
      // 因此小地圖黑色區域 = 實際不能走的區域，也不允許怪物生成。
      return canEntityMoveTo(wx, wz, r);
    }
    function drawMiniTerrainPattern(g, zone, ox, oy, mapW, mapH, style) {
      const cx = ox + mapW / 2, cy = oy + mapH / 2;
      g.save(); g.globalAlpha = .62;
      if (zone === 'seomi') {
        // 斯歐米森林：白雪外圍＋中央裂開冰湖。小地圖必須直接反映雪地與冰湖環境。
        g.save();
        g.fillStyle = style.ground; g.fillRect(0, 0, mapW, mapH);
        const lx = cx, ly = cy, rx = mapW * .34, ry = mapH * .39;
        g.fillStyle = style.water; g.beginPath();
        g.moveTo(lx - rx * .85, ly - ry * .72); g.bezierCurveTo(lx - rx * .45, ly - ry * 1.02, lx + rx * .30, ly - ry * .92, lx + rx * .82, ly - ry * .55);
        g.bezierCurveTo(lx + rx * 1.04, ly - .05 * ry, lx + rx * .66, ly + ry * .76, lx + .08 * rx, ly + ry * .92);
        g.bezierCurveTo(lx - rx * .52, ly + ry * 1.04, lx - rx * 1.04, ly + ry * .44, lx - rx * .85, ly - ry * .72); g.fill();
        g.strokeStyle = '#8fe5ff'; g.lineWidth = Math.max(1.2, mapW * .014); g.globalAlpha = .9;
        const cracks = [[-.28, -.05, .05, .20], [.04, -.38, -.02, .02], [.12, .02, .35, .18], [-.10, .20, -.30, .42], [.30, -.15, .12, .48], [-.45, -.34, -.12, -.18]];
        for (const [x1, y1, x2, y2] of cracks) {g.beginPath(); g.moveTo(lx + x1 * mapW, ly + y1 * mapH); g.lineTo(lx + x2 * mapW, ly + y2 * mapH); g.stroke();}
        g.strokeStyle = '#b9e8f5'; g.lineWidth = Math.max(2, mapW * .018); g.stroke();
        // 雪地道路：只畫在外圍，避免把湖畫成綠地。
        g.strokeStyle = style.road; g.lineWidth = Math.max(3, mapW * .035); g.beginPath(); g.moveTo(ox, cy + mapH * .04); g.bezierCurveTo(ox + mapW * .22, cy - mapH * .18, ox + mapW * .32, cy - mapH * .34, ox + mapW * .43, oy + mapH * .06); g.moveTo(ox + mapW, cy - mapH * .05); g.bezierCurveTo(ox + mapW * .78, cy + mapH * .20, ox + mapW * .72, cy + mapH * .38, ox + mapW * .57, oy + mapH * .94); g.stroke();
        g.restore();
      } else if (zone === 'forest' || zone === 'miluris' || zone === 'demon') {
        g.strokeStyle = style.road; g.lineWidth = Math.max(3, mapW * .035); g.beginPath();
        g.moveTo(ox, cy + mapH * .02); g.bezierCurveTo(ox + mapW * .22, cy - mapH * .10, ox + mapW * .58, cy + mapH * .12, ox + mapW, cy - mapH * .02); g.stroke();
        if (zone === 'forest') {
          g.strokeStyle = style.water; g.lineWidth = Math.max(4, mapW * .055); g.beginPath();
          g.moveTo(ox + mapW * .05, oy + mapH * .72); g.bezierCurveTo(ox + mapW * .30, oy + mapH * .62, ox + mapW * .50, oy + mapH * .52, ox + mapW * .96, oy + mapH * .60); g.stroke();
          g.strokeStyle = '#9b6b3f'; g.lineWidth = Math.max(5, mapW * .035); g.beginPath(); g.moveTo(ox + mapW * .46, oy + mapH * .57); g.lineTo(ox + mapW * .54, oy + mapH * .57); g.stroke();
        } else if (zone !== 'demon') {g.strokeStyle = style.water; g.lineWidth = Math.max(1.3, mapW * .014); g.beginPath(); g.moveTo(ox + mapW * .05, oy + mapH * .72); g.bezierCurveTo(ox + mapW * .30, oy + mapH * .38, ox + mapW * .58, oy + mapH * .62, ox + mapW * .96, oy + mapH * .72); g.stroke();}
      } else if (zone === 'city') {
        // 路爾斯城：封閉方形城牆＋四座城門＋密集街區，沒有中央大廣場。
        g.strokeStyle = style.edge; g.lineWidth = Math.max(3, mapW * .030); g.strokeRect(ox + mapW * .145, oy + mapH * .095, mapW * .71, mapH * .81);
        g.strokeStyle = style.water; g.lineWidth = Math.max(1.5, mapW * .016); g.setLineDash([4, 3]); g.strokeRect(ox + mapW * .165, oy + mapH * .115, mapW * .67, mapH * .77); g.setLineDash([]);
        g.strokeStyle = style.road; g.lineWidth = Math.max(4, mapW * .040); g.beginPath();
        g.moveTo(cx, oy + mapH * .13); g.lineTo(cx, oy + mapH * .87); g.moveTo(ox + mapW * .15, cy); g.lineTo(ox + mapW * .85, cy); g.stroke();
        g.lineWidth = Math.max(2, mapW * .018); g.beginPath();
        g.moveTo(ox + mapW * .24, oy + mapH * .24); g.lineTo(ox + mapW * .76, oy + mapH * .76); g.moveTo(ox + mapW * .76, oy + mapH * .24); g.lineTo(ox + mapW * .24, oy + mapH * .76); g.stroke();
        g.fillStyle = style.obstacle; g.globalAlpha = .78;
        for (const [xx, yy] of [[-.34, -.33], [0, -.33], [.34, -.33], [-.34, 0], [.34, 0], [-.34, .33], [0, .33], [.34, .33], [-.18, -.08], [.18, .08]]) {
          const bw = 7, bh = 5; g.fillRect(cx + xx * mapW * .72 - bw / 2, cy + yy * mapH * .72 - bh / 2, bw, bh);
        }
        // 四座城門位置。
        g.fillStyle = style.water; g.globalAlpha = .95;
        for (const [gx, gy] of [[cx, oy + mapH * .10], [ox + mapW * .90, cy], [cx, oy + mapH * .90], [ox + mapW * .10, cy]]) {g.fillRect(gx - 3, gy - 3, 6, 6)}
      } else if (zone === 'volcano') {
        g.strokeStyle = style.road; g.lineWidth = Math.max(2.5, mapW * .028); g.beginPath(); g.moveTo(ox + mapW * .03, oy + mapH * .70); g.bezierCurveTo(ox + mapW * .35, oy + mapH * .30, ox + mapW * .60, oy + mapH * .72, ox + mapW * .97, oy + mapH * .34); g.stroke();
        g.strokeStyle = style.water; g.lineWidth = Math.max(2, mapW * .022); g.beginPath(); g.moveTo(ox + mapW * .12, oy); g.bezierCurveTo(ox + mapW * .30, oy + mapH * .38, ox + mapW * .48, oy + mapH * .48, ox + mapW * .72, oy + mapH * .18); g.stroke();
      } else if (zone.startsWith('beast')) {
        g.strokeStyle = style.road; g.lineWidth = Math.max(3, mapW * .035); g.beginPath(); g.moveTo(cx, oy); g.lineTo(cx, oy + mapH); g.moveTo(ox, cy); g.lineTo(ox + mapW, cy); g.stroke();
      } else if (zone.startsWith('alice')) {
        g.strokeStyle = style.road; g.lineWidth = Math.max(3, mapW * .035); g.beginPath(); g.moveTo(ox, oy + mapH * .55); g.lineTo(ox + mapW, oy + mapH * .55); g.moveTo(cx, oy); g.lineTo(cx, oy + mapH); g.stroke();
      }
      g.restore();
    }
    function buildMiniTerrain() {
      const W = 166, H = 120, zone = state.zone, data = zoneData[zone] || zoneData.forest, style = miniMapStyle(zone);
      const c = document.createElement('canvas'); c.width = W; c.height = H; const g = c.getContext('2d');
      const mapSize = Math.min(230, Math.max(40, Number(data.size) || 180));
      const scaleX = W / mapSize, scaleY = H / mapSize;
      const ox = 0, oy = 0, mapW = W, mapH = H;
      // 世界外部一律黑色；地圖內再依「實際可走性」填入對應地形。
      g.fillStyle = '#000'; g.fillRect(0, 0, W, H);
      // 低解析採樣，避免每次更新都建立大量幾何，同時精準跟隨碰撞邊界。
      const cols = 83, rows = 60, cellW = W / cols, cellH = H / rows;
      const walkableMask = new Uint8Array(cols * rows);
      for (let iy = 0; iy < rows; iy++) {
        for (let ix = 0; ix < cols; ix++) {
          const wx = ((ix + .5) / cols - .5) * mapSize;
          const wz = ((iy + .5) / rows - .5) * mapSize;
          const ok = miniWalkable(wx, wz, .70);
          walkableMask[iy * cols + ix] = ok ? 1 : 0;
          if (ok) {
            g.fillStyle = style.ground;
            g.fillRect(ix * cellW, iy * cellH, Math.ceil(cellW) + .35, Math.ceil(cellH) + .35);
          }
        }
      }
      // 道路、水域只繪製在實際地圖範圍內；黑色不可行走區會在後面再次覆蓋。
      drawMiniTerrainPattern(g, zone, ox, oy, mapW, mapH, style);
      // 再次遮掉實際不可走區，確保道路不會「畫到牆外」。
      for (let iy = 0; iy < rows; iy++) {
        for (let ix = 0; ix < cols; ix++) {
          if (!walkableMask[iy * cols + ix]) {
            const wx = ((ix + .5) / cols - .5) * mapSize, wz = ((iy + .5) / rows - .5) * mapSize;
            if (zone === 'seomi' && isSeomiFrozenLakeBlocked(wx, wz, 0)) {
              g.fillStyle = style.water;
              g.fillRect(ix * cellW, iy * cellH, Math.ceil(cellW) + .35, Math.ceil(cellH) + .35);
            } else {
              g.fillStyle = '#000';
              g.fillRect(ix * cellW, iy * cellH, Math.ceil(cellW) + .35, Math.ceil(cellH) + .35);
            }
          }
        }
      }
      // 可碰撞物件不再一律畫成黑色：建築／牆體保留矩形輪廓與原本顏色，岩石等物件以圓形近似。
      for (const col of state.colliders || []) {
        if (!col || !col.object || !col.object.parent) continue;
        const p = miniWorldToCanvas(col.x, col.z, mapSize, W, H);
        const mm = col.object.userData?.miniMap || {};
        g.save();
        g.fillStyle = mm.color || '#555b63';
        g.strokeStyle = '#1a1a1a';
        g.lineWidth = 1;
        if (mm.shape === 'rect' && Number(mm.w) > 0 && Number(mm.d) > 0) {
          const rw = Math.max(2, Number(mm.w) * scaleX), rh = Math.max(2, Number(mm.d) * scaleY);
          g.fillRect(p.x - rw / 2, p.y - rh / 2, rw, rh); g.strokeRect(p.x - rw / 2, p.y - rh / 2, rw, rh);
        } else {
          const rr = Math.max(1.2, Math.min(7, (Number(col.r) || 1.2) * Math.min(scaleX, scaleY) * .82));
          g.beginPath(); g.arc(p.x, p.y, rr, 0, Math.PI * 2); g.fill(); g.stroke();
        }
        g.restore();
      }
      miniTerrain = {canvas: c, mapSize, style};
      miniTerrainKey = zone;
    }
    function drawMini() {
      const c = document.getElementById('minimap'), x = c.getContext('2d');
      if (!state.player) return;
      if (!miniTerrain || miniTerrainKey !== state.zone || performance.now() - miniTerrainTimer > 2500) {buildMiniTerrain(); miniTerrainTimer = performance.now();}
      x.clearRect(0, 0, 332, 240);
      x.imageSmoothingEnabled = true;
      // 地形本身填滿小地圖，不再額外畫黑色框。
      x.drawImage(miniTerrain.canvas, 0, 0, 332, 240);
      const mapSize = miniTerrain.mapSize;
      const toScreen = (wx, wz) => miniWorldToCanvas(wx, wz, mapSize, 332, 240);
      // 只顯示位於實際可行走區的怪物；黑色不可達區不生成怪物，也不顯示怪物。
      for (const e of state.enemies) {
        if (!e.userData.alive) continue;
        const p = toScreen(e.position.x, e.position.z);
        x.fillStyle = e.userData.elite ? '#ffd54a' : '#e45a62'; x.beginPath(); x.arc(p.x, p.y, e.userData.elite ? 3.5 : 2.5, 0, 7); x.fill();
      }
      {
        const pp = toScreen(state.player.position.x, state.player.position.z);
        x.fillStyle = '#fff'; x.strokeStyle = '#111'; x.lineWidth = 2; x.beginPath(); x.arc(pp.x, pp.y, 5.5, 0, 7); x.fill(); x.stroke();
      }
      x.fillStyle = 'rgba(10,12,16,.75)'; x.font = 'bold 10px sans-serif'; x.textAlign = 'left'; x.fillText('N', 6, 13);
    }

    function updateSpecialEquipmentWings(dt) {
      if (!state.parts?.equipment) return;

      const specialEquip = EQUIP_SLOTS
        .map(k => state.equip[k])
        .find(it => it && (it.specialSeries === 'sacred' || it.specialSeries === 'demon'));

      const wings = state.parts.equipment.getObjectByName('SpecialEquipmentWings');

      // 沒有真正的神聖／惡魔裝備時，翼必須完全不存在。
      if (!specialEquip) {
        if (wings) state.parts.equipment.remove(wings);
        return;
      }

      if (!wings) return;
      const t = performance.now() * .002;
      const pulse = .96 + Math.sin(t) * .045;
      wings.scale.set(pulse, 1.0 + Math.sin(t * .82) * .018, pulse);
      wings.rotation.y = Math.sin(t * .72) * .018;
      wings.rotation.z = Math.sin(t * .63) * .012;
      wings.position.x = Math.sin(t * .55) * .012;
    }

    function loop() {
      requestAnimationFrame(loop); const dt = Math.min(.05, clock.getDelta());
      if (renderPerformanceGovernor && renderAdapter.updateRenderPerformanceGovernor) {
        renderAdapter.updateRenderPerformanceGovernor(renderPerformanceGovernor, renderer, dt);
      }
      syncPlayCanvasMapCameraV104(); syncPlayCanvasCharacterTransformV106(); syncPlayCanvasCharacterWeaponAttackV108(); syncPlayCanvasCharacterAttackTimelineV110(); syncPlayCanvasCharacterVisualV117(); const authOpen = document.getElementById('authScreen')?.classList.contains('show'); if (authOpen) {renderAdapter.renderFrame(renderer, scene, camera); return } if (ccPreview.active || authPreview.renderer) {renderAdapter.renderFrame(renderer, scene, camera); return } updateBuffs(); updateBuffVisuals(dt); updateAreaSkills(dt); state.attackCd = Math.max(0, state.attackCd - dt);
      for (const id of Object.keys(state.skillCds || {})) {state.skillCds[id] = Math.max(0, Number(state.skillCds[id]) - dt); if (state.skillCds[id] <= 0) delete state.skillCds[id];}
      state.skillCd = 0;
      updateAutoCombat(dt); updateMovement(dt); updateFaceAnimation(dt); updateFloatingMageOrb(dt); updateSpecialEquipmentWings(dt); updateWalkAnimation(dt); updateAttackAnimation(dt); updateEffects(dt); updateEnemies(dt); updateDrops(dt); updateResourceRegen(dt); updateTargetPanel(); updatePortals(dt); dayNight(dt); updateWeather(dt); updateWeatherParticles(dt); updateVolcanoEffects(dt); updateForestRiver(dt); updateCamera(); syncFirstPersonCharacterVisibilityV124(); miniTimer -= dt; if (miniTimer <= 0) {miniTimer = .12; drawMini(); refreshBuffPanel()} saveTimer -= dt; if (saveTimer <= 0) {saveTimer = 3; saveGame()} renderAdapter.renderFrame(renderer, scene, camera)
    }
    /* Input */
    addEventListener('keydown', e => {
      if (e.key === 'Tab') {e.preventDefault(); const m = document.getElementById('modal'); if (m.classList.contains('show')) closeModal(); else openModal('menu'); return }
      if (e.key === 'Escape') {closeModal(); return }
      if (e.key === 'F10') {e.preventDefault(); togglePlayCanvasCharacterVisualFallbackV117(); return;}
      state.keys[e.key] = true;
      const digitMatch = /^(?:Digit|Numpad)([1-8])$/.exec(e.code || '');
      if (digitMatch || /^[1-8]$/.test(e.key)) {
        e.preventDefault();
        if (e.repeat) return;
        activateQuickSlot(Number(digitMatch ? digitMatch[1] : e.key) - 1);
        return;
      }
      const k = e.key.toLowerCase();
      if (k === ' ') {e.preventDefault(); basicAttack()}
      if (k === 'i') openModal('inventory'); if (k === 'e') openModal('equip'); if (k === 'c') openModal('class'); if (k === 'h') openModal('hair'); if (k === 'm') goZone('city'); if (k === 'f') toggleAuto()
    });
    addEventListener('keyup', e => state.keys[e.key] = false);
    renderer.domElement.addEventListener('contextmenu', e => e.preventDefault());

    let mobileTouchCamera = {active: false, lastX: 0, lastY: 0, lastDist: 0};
    function getTouchPairInfo(touches) {
      const a = touches[0], b = touches[1];
      const dx = b.clientX - a.clientX, dy = b.clientY - a.clientY;
      return {cx: (a.clientX + b.clientX) * .5, cy: (a.clientY + b.clientY) * .5, dist: Math.hypot(dx, dy)};
    }
    renderer.domElement.addEventListener('touchstart', e => {
      if (!isMobileMode() || e.touches.length < 2) return;
      const p = getTouchPairInfo(e.touches);
      mobileTouchCamera.active = true;
      mobileTouchCamera.lastX = p.cx;
      mobileTouchCamera.lastY = p.cy;
      mobileTouchCamera.lastDist = Math.max(1, p.dist);
      state.mobileCameraUserAdjusted = true;
      e.preventDefault();
    }, {passive: false});
    renderer.domElement.addEventListener('touchmove', e => {
      if (!isMobileMode() || !mobileTouchCamera.active || e.touches.length < 2) return;
      const p = getTouchPairInfo(e.touches);
      const dx = p.cx - mobileTouchCamera.lastX, dy = p.cy - mobileTouchCamera.lastY;
      // 兩指一起移動＝旋轉鏡頭；兩指距離改變＝縮放鏡頭。
      state.cam.yaw -= dx * .0045;
      state.cam.pitch = Math.max(-1.25, Math.min(1.25, state.cam.pitch + dy * .003));
      if (mobileTouchCamera.lastDist > 1) {
        const zoomScale = mobileTouchCamera.lastDist / Math.max(1, p.dist);
        state.cam.dist = Math.max(5.2, Math.min(26, state.cam.dist * zoomScale));
      }
      mobileTouchCamera.lastX = p.cx;
      mobileTouchCamera.lastY = p.cy;
      mobileTouchCamera.lastDist = Math.max(1, p.dist);
      state.mobileCameraUserAdjusted = true;
      e.preventDefault();
    }, {passive: false});
    renderer.domElement.addEventListener('touchend', e => {
      if (e.touches.length < 2) {mobileTouchCamera.active = false; mobileTouchCamera.lastDist = 0;}
    }, {passive: true});
    renderer.domElement.addEventListener('touchcancel', () => {mobileTouchCamera.active = false; mobileTouchCamera.lastDist = 0;}, {passive: true});

    renderer.domElement.addEventListener('pointerdown', e => {if (e.button === 2) {state.cam.drag = true; state.cam.lastX = e.clientX; state.cam.lastY = e.clientY; renderer.domElement.style.cursor = 'grabbing'} });
    addEventListener('pointerup', e => {if (e.button === 2) {state.cam.drag = false; renderer.domElement.style.cursor = 'default'} });
    addEventListener('pointermove', e => {if (!state.cam.drag) return; const dx = e.clientX - state.cam.lastX, dy = e.clientY - state.cam.lastY; state.cam.lastX = e.clientX; state.cam.lastY = e.clientY; state.cam.yaw -= dx * .006; state.cam.pitch = Math.max(-1.25, Math.min(1.25, state.cam.pitch + dy * .004)); if (isMobileMode()) state.mobileCameraUserAdjusted = true});
    renderer.domElement.addEventListener('wheel', e => {state.cam.dist = Math.max(5, Math.min(25, state.cam.dist + e.deltaY * .012))}, {passive: true});
    renderer.domElement.addEventListener('pointerdown', e => {if (e.button !== 0) return; const rect = renderer.domElement.getBoundingClientRect(), mouse = new THREE.Vector2((e.clientX - rect.left) / rect.width * 2 - 1, -((e.clientY - rect.top) / rect.height) * 2 + 1), ray = new THREE.Raycaster(); ray.setFromCamera(mouse, camera); if (state.dead && state.grave) {const gh = ray.intersectObject(state.grave, true)[0]; if (gh) {document.getElementById('deathOverlay').classList.add('show'); toast('🪦 墓碑：選擇回城復活'); return;} } const ph = ray.intersectObjects(state.portals, true)[0]; if (ph) {let o = ph.object; while (o && (!o.userData || !o.userData.to) && o.parent) o = o.parent; if (o?.userData?.to && !state.dead) {goZone(o.userData.to); return;} } const ground = state.world.find(o => o.isMesh && o.geometry?.type === 'PlaneGeometry'); if (ground) {const hit = ray.intersectObject(ground)[0]; if (hit && !state.dead) state.target = hit.point.clone()} });
    window.addEventListener('resize', () => {syncGameViewport(isMobileMode()); if (isMobileMode()) {applyMobileCameraProfile(true); updateCamera()} }); if (window.visualViewport) {window.visualViewport.addEventListener('resize', () => {syncGameViewport(false); if (isMobileMode()) updateCamera()}); window.visualViewport.addEventListener('scroll', () => {if (isMobileMode()) syncGameViewport(false)})}
    /* ASGARD SIMPLIFIED UI + ROBUST CHARACTER SELECT PREVIEW */
    // V1.01.01 — Legacy Character Model V2 weapon attack test.
    // Uses the original Character Model V2 only; no new Base Mesh / GLTF rig.
    // This is an isolated one-shot visual test and restores the previous
    // character class/equipment after the attack animation finishes.
    window.testLegacyWeaponAttack = function(){
      try {
        if (!state.player || !state.parts) return {ok:false,error:'player not ready'};
        const oldClass = state.classId;
        const oldWeapon = state.equip?.weapon || null;
        const oldVisible = state.player.visible;
        const testWeapon = makeNoviceWoodSword();
        testWeapon.id = 'v10101_test_wood_sword';
        testWeapon.classId = 'warrior';
        state.classId = 'warrior';
        state.player.visible = true;
        state.equip.weapon = testWeapon;
        updateEquipmentVisual();
        // Keep the existing Legacy Character Model V2 idle pose as the base.
        if (state.parts.armR) state.parts.armR.rotation.set(-.38, 0, -.13);
        if (state.parts.armL) state.parts.armL.rotation.set(-.38, 0, .13);
        syncWeaponGrip();
        startAttack('slash');
        const restoreMs = 1050;
        setTimeout(function(){
          try {
            state.classId = oldClass;
            state.equip.weapon = oldWeapon;
            updateEquipmentVisual();
            if (state.parts.armR) state.parts.armR.rotation.set(-.38, 0, -.13);
            if (state.parts.armL) state.parts.armL.rotation.set(-.38, 0, .13);
            syncWeaponGrip();
            if (!oldVisible) state.player.visible = false;
          } catch(e) { console.warn('V1.01.01 weapon test restore failed', e); }
        }, restoreMs);
        return {
          ok:true,
          version:'1.01.01',
          source:'Legacy Character Model V2',
          weapon:'新手木劍',
          action:'attack',
          duration: state.attackAnim?.duration || .78,
          restoredAfterMs: restoreMs
        };
      } catch(e) {
        return {ok:false,version:'1.01.01',error:String(e&&e.message||e)};
      }
    };

    window.testLegacyWeaponIdle = function(){
      try {
        if (!state.player || !state.parts) return {ok:false,error:'player not ready'};
        state.player.visible = true;
        state.attackAnim.active = false;
        state.walkAnim.moving = false;
        if (state.parts.armR) state.parts.armR.rotation.set(-.38,0,-.13);
        if (state.parts.armL) state.parts.armL.rotation.set(-.38,0,.13);
        syncWeaponGrip();
        return {ok:true,version:'1.01.01',source:'Legacy Character Model V2',action:'idle',weapon:state.equip?.weapon?.name||null};
      } catch(e) { return {ok:false,version:'1.01.01',error:String(e&&e.message||e)}; }
    };

    /* Boot */
    async function boot() {
