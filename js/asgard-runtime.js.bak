      u.baseScale = e.scale.clone();
      u.boss = true; u.bossScale = 2; u.stats = d; u.hp = d.hp; u.max = d.hp; u.name = d.name; u.level = d.level; u.attackCd = 1.0; u.bossSkill = cfg.skill; u.bossSkillCd = 2.8; u.bossLastHit = 0; u.aggroed = false; u.dialogueTimer = 4; u.aiGroupId = 'boss_' + state.zone;
      // 王冠固定浮在頭頂，依怪物模型高度略作調整，方便在混戰中一眼辨識 Boss。
      const crownMat = new THREE.MeshBasicMaterial({color: 0xffd54f, transparent: true, opacity: .98, blending: THREE.AdditiveBlending, depthWrite: false});
      const crown = new THREE.Group();
      const crownBase = new THREE.Mesh(new THREE.TorusGeometry(.32, .045, 8, 24), crownMat); crownBase.rotation.x = Math.PI / 2; crown.add(crownBase);
      for (let i = 0; i < 5; i++) {const spike = new THREE.Mesh(new THREE.ConeGeometry(.055, .24, 5), crownMat); const a = -.65 + i * .325; spike.position.set(Math.sin(a) * .25, .13, Math.cos(a) * .25); spike.rotation.z = -Math.sin(a) * .55; spike.rotation.x = Math.cos(a) * .28; crown.add(spike)}
      const crownGem = new THREE.Mesh(new THREE.OctahedronGeometry(.065, 0), new THREE.MeshBasicMaterial({color: 0xffffff, transparent: true, opacity: .95, blending: THREE.AdditiveBlending, depthWrite: false})); crownGem.position.set(0, .20, .22); crown.add(crownGem);
      crown.position.set(0, 2.85, 0); crown.userData.bossCrown = true; e.add(crown); u.bossCrown = crown;
