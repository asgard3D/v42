        const buckle = mesh(new THREE.BoxGeometry(.16, .14, .055), mat(0xd8b75a, .55, .35)); buckle.position.set(0, .96, .48); g.add(buckle);
      } else if (slot === 'earring' || slot === 'earringL' || slot === 'earringR') {
        // V12：耳飾全部使用獨立 3D 外觀，並依款式區分。
        const side = slot === 'earringL' ? -1 : slot === 'earringR' ? 1 : 0;
        const sides = side ? [side] : [-1, 1];

        let ec = 0x72b9ff;
        let drop = 0.12;
        if (it.visual === 'starearring') {ec = 0xffd86a; drop = 0.16;}
        if (it.visual === 'leafearring') {ec = 0x5ad878; drop = 0.18;}

        for (const sx of sides) {
          const hook = mesh(
            new THREE.TorusGeometry(.075, .018, 7, 16),
            new THREE.MeshStandardMaterial({
              color: ec, metalness: .60, roughness: .20,
              emissive: ec, emissiveIntensity: .28
            })
          );
          hook.position.set(sx * .47, .13, .49);
          hook.rotation.x = Math.PI / 2;
          g.add(hook);

          if (it.visual === 'leafearring') {
            const leaf = mesh(
              new THREE.ConeGeometry(.065, .18, 5),
              new THREE.MeshStandardMaterial({
                color: ec, metalness: .20, roughness: .25,
                emissive: ec, emissiveIntensity: .35
              })
            );
            leaf.position.set(sx * .47, .13 - drop, .51);
            leaf.rotation.z = sx * .35;
            g.add(leaf);
          } else {
            const gem = mesh(
              new THREE.OctahedronGeometry(.065, 1),
              new THREE.MeshStandardMaterial({
                color: ec, metalness: .15, roughness: .12,
                emissive: ec, emissiveIntensity: .55
              })
            );
            gem.position.set(sx * .47, .13 - drop, .51);
            gem.scale.set(.85, 1.25, .75);
            g.add(gem);
          }
        }
      } else if (slot === 'necklace') {
        // V12：項鍊恢復為實際 3D 外觀。
        // 不使用整圈脖子環，改成「短鏈 + 中央吊墜」，避免穿過頭髮／下巴。
        const q = weaponQualityStyle(it);
        let metalColor = q.metal;
        let gemColor = q.accent;
        let glowColor = q.glow;

        if (it.specialSeries === 'sacred') {
          metalColor = 0xfff2bd; gemColor = 0xffffff; glowColor = 0xffffc8;
        } else if (it.specialSeries === 'demon') {
          metalColor = 0x1b0a10; gemColor = 0xff1830; glowColor = 0xff1830;
        } else if (it.visual === 'leafneck') {
          metalColor = 0x6a9b58; gemColor = 0x8fd66f; glowColor = 0x58c95c;
        } else if (it.visual === 'crystalneck') {
          metalColor = 0x7b8fd8; gemColor = 0x9ed9ff; glowColor = 0x55bfff;
        }

        // 短鏈：只在胸口上方形成 U 型，不繞到角色後頸。
        const chain = new THREE.Mesh(
          new THREE.TorusGeometry(.33, .018, 7, 28, Math.PI),
          new THREE.MeshStandardMaterial({
            color: metalColor, metalness: .72, roughness: .22,
            emissive: glowColor, emissiveIntensity: it.specialSeries ? .45 : .08
          })
        );
        chain.rotation.x = Math.PI / 2;
        chain.position.set(0, .34, .48);
        chain.scale.set(1, .72, 1);
        g.add(chain);

        // 中央吊墜。
        let pendant;
        if (it.visual === 'goldneck') {
          pendant = mesh(
            new THREE.OctahedronGeometry(.10, 1),
            new THREE.MeshStandardMaterial({
              color: gemColor, metalness: .35, roughness: .16,
              emissive: glowColor, emissiveIntensity: .55
            })
          );
        } else if (it.visual === 'leafneck') {
          pendant = mesh(
            new THREE.ConeGeometry(.105, .22, 5),
            new THREE.MeshStandardMaterial({
              color: gemColor, metalness: .18, roughness: .24,
              emissive: glowColor, emissiveIntensity: .45
            })
          );
          pendant.rotation.z = .18;
        } else {
          pendant = mesh(
            new THREE.OctahedronGeometry(.12, 1),
            new THREE.MeshStandardMaterial({
              color: gemColor, metalness: .18, roughness: .10,
              emissive: glowColor, emissiveIntensity: .85
            })
          );
          pendant.scale.set(.82, 1.25, .82);
        }
        pendant.position.set(0, .08, .52);
        g.add(pendant);

        const aura = mesh(
          new THREE.SphereGeometry(.16, 12, 10),
          new THREE.MeshBasicMaterial({
            color: glowColor, transparent: true,
            opacity: it.specialSeries ? .20 : .055,
            blending: THREE.AdditiveBlending, depthWrite: false
          })
        );
        aura.position.set(0, .08, .51);
        g.add(aura);

        if (it.specialSeries) {
          const light = new THREE.PointLight(
            glowColor, it.specialSeries === 'sacred' ? .55 : .50, 1.35
          );
          light.position.set(0, .08, .52);
          g.add(light);
        }
      } else if (/^ring/.test(slot) || slot === 'ring') {
        // V11：戒指必須有獨立的 3D 外觀。
        // ring1~ring4 之前只進入「ring」分支，實際沒有建立任何模型，
        // 所以裝備欄縮圖會是空白。現在使用戒圈＋戒面寶石。
        const quality = {
          normal: {metal: 0xe8edf2, gem: 0xffffff, glow: 0xffffff},
          good: {metal: 0x4fbd68, gem: 0x72ff8a, glow: 0x55ff78},
          rare: {metal: 0x348cff, gem: 0x8fd2ff, glow: 0x3fa7ff},
          epic: {metal: 0x9a4be8, gem: 0xd3a0ff, glow: 0xb55cff},
          legendary: {metal: 0xffa51f, gem: 0xffe0a0, glow: 0xffa51f}
        }[it.rarity || 'normal'] || {metal: 0xe8edf2, gem: 0xffffff, glow: 0xffffff};

        let metalColor = quality.metal;
        let gemColor = quality.gem;
        let glowColor = quality.glow;

        // 神聖：白黃；惡魔：黑紅。
        if (it.specialSeries === 'sacred') {
          metalColor = 0xfff4c4; gemColor = 0xffffff; glowColor = 0xffffb8;
        } else if (it.specialSeries === 'demon') {
          metalColor = 0x260b12; gemColor = 0xff1830; glowColor = 0xff1830;
        }

        const band = mesh(
          new THREE.TorusGeometry(.30, .065, 10, 24),
          new THREE.MeshStandardMaterial({
            color: metalColor,
            metalness: .72,
            roughness: .22,
            emissive: glowColor,
            emissiveIntensity: it.specialSeries ? 0.65 : .12
          })
        );
        // Torus 預設正面朝鏡頭；稍微傾斜，讓戒圈厚度更立體。
        band.rotation.x = .10;
        band.rotation.y = -.16;
        band.position.set(0, 0, 0);
        g.add(band);

        const stone = mesh(
          new THREE.OctahedronGeometry(.105, 1),
          new THREE.MeshStandardMaterial({
            color: gemColor,
            metalness: .18,
            roughness: .12,
            emissive: glowColor,
            emissiveIntensity: it.specialSeries ? 1.9 : .55
          })
        );
        stone.position.set(0, .285, .045);
        stone.scale.set(1.05, 1.22, .72);
        g.add(stone);

        const stoneHalo = mesh(
          new THREE.SphereGeometry(.17, 12, 10),
          new THREE.MeshBasicMaterial({
            color: glowColor,
            transparent: true,
            opacity: it.specialSeries ? 0.26 : .08,
            blending: THREE.AdditiveBlending,
            depthWrite: false
          })
        );
        stoneHalo.position.set(0, .285, .035);
        g.add(stoneHalo);

        const ringLight = new THREE.PointLight(
          glowColor,
          it.specialSeries === 'sacred' ? .55 :
            it.specialSeries === 'demon' ? .50 : .16,
          1.35
        );
        ringLight.position.set(0, .20, .12);
        g.add(ringLight);
      }
      addClassTierVisual(g, it, slot);
      // 神聖／惡魔裝備：改為背部「虛影光翼／暗翼」。
      // 不再在裝備表面產生網狀白光、環形光圈或線框；特殊套裝只保留背後的半透明翼影。
      g.traverse(o => {if (o.isMesh) {o.renderOrder = 5; o.material.polygonOffset = true; o.material.polygonOffsetFactor = -1; o.material.polygonOffsetUnits = -1} });
      return g
    }
    function makeShieldVisual(it = {}) {
      const g = new THREE.Group();
      const lv = Math.max(1, Number(it.itemLevel) || 1);
      const tier = lv >= 91 ? 'divine' : lv >= 61 ? 'transcendent' : lv >= 41 ? 'sacred' : lv >= 21 ? 'royal' : lv >= 11 ? 'field' : 'starter';
      const cfg = {
        starter: {main: 0x6f5038, dark: 0x34271f, edge: 0xa8b0b8, accent: 0xd0b45d, core: 0xc2c8cf, scale: .62},
        field: {main: 0x294c78, dark: 0x182b48, edge: 0xb7c7d8, accent: 0xe6edf5, core: 0xdce7f3, scale: .64},
        royal: {main: 0x4b2a88, dark: 0x25164d, edge: 0xc7b4e5, accent: 0xf0d66d, core: 0xffffff, scale: .66},
        sacred: {main: 0xf2e6c7, dark: 0xb78a22, edge: 0xffd55f, accent: 0xfff0a0, core: 0xffc83d, scale: .69},
        transcendent: {main: 0x681b35, dark: 0x210d1a, edge: 0xe04b58, accent: 0xff304f, core: 0xff5470, scale: .72},
        divine: {main: 0xdcecff, dark: 0x5474a6, edge: 0xf5fbff, accent: 0x65b9ff, core: 0x9edcff, scale: .75}
      }[tier];

      const shape = new THREE.Shape();
      shape.moveTo(0, .82);
      shape.lineTo(.43, .20);
      shape.lineTo(.34, -.55);
      shape.lineTo(0, -1.02);
      shape.lineTo(-.34, -.55);
      shape.lineTo(-.43, .20);
      shape.closePath();

      const makePlate = (depth, material, z, scale = 1) => {
        const geo = new THREE.ExtrudeGeometry(shape, {depth, bevelEnabled: true, bevelSegments: 1, steps: 1, bevelSize: .025, bevelThickness: .018});
        const o = new THREE.Mesh(geo, material);
        o.position.set(0, -.02, z);
        o.scale.set(scale, scale, 1);
        o.rotation.x = 0;
        return o;
      };

      const back = makePlate(.12, mat(cfg.dark, .38, .30), -.02, cfg.scale);
      g.add(back);

      const face = makePlate(.075, mat(cfg.main, .42, .28), .105, cfg.scale * .94);
      g.add(face);

      // 細緻外框：只有盾牌邊緣，不在正面橫跨金屬條。
      const rimShape = new THREE.Shape();
      const ro = .045;
      rimShape.moveTo(0, .86 + ro);
      rimShape.lineTo(.48, .22);
      rimShape.lineTo(.39, -.57);
      rimShape.lineTo(0, -1.08);
      rimShape.lineTo(-.39, -.57);
      rimShape.lineTo(-.48, .22);
      rimShape.closePath();
      const rimGeo = new THREE.BufferGeometry();
      const pts = [];
      const rpts = [
        new THREE.Vector3(0, .86, .19), new THREE.Vector3(.48, .22, .19),
        new THREE.Vector3(.39, -.57, .19), new THREE.Vector3(0, -1.08, .19),
        new THREE.Vector3(-.39, -.57, .19), new THREE.Vector3(-.48, .22, .19),
        new THREE.Vector3(0, .86, .19)
      ];
      for (let i = 0; i < rpts.length - 1; i++) {pts.push(rpts[i], rpts[i + 1]);}
      rimGeo.setFromPoints(pts);
      const rim = new THREE.LineSegments(rimGeo, new THREE.LineBasicMaterial({color: cfg.edge, transparent: true, opacity: .95}));
      rim.scale.setScalar(cfg.scale);
      g.add(rim);

      // 中央徽章依等級變化；沒有任何橫向金屬條。
      if (tier === 'starter') {
        const plate = mesh(new THREE.CircleGeometry(.15, 16), new THREE.MeshStandardMaterial({color: cfg.accent, metalness: .65, roughness: .28}));
        plate.position.set(0, .02, .20); g.add(plate);
        const boss = mesh(new THREE.SphereGeometry(.075, 10, 8), new THREE.MeshStandardMaterial({color: cfg.core, metalness: .7, roughness: .22}));
        boss.position.set(0, .02, .225); g.add(boss);
      } else if (tier === 'field') {
        const barV = mesh(new THREE.BoxGeometry(.075, .54, .035), new THREE.MeshStandardMaterial({color: cfg.accent, metalness: .55, roughness: .26}));
        barV.position.set(0, .02, .20); g.add(barV);
        const barH = mesh(new THREE.BoxGeometry(.30, .075, .035), new THREE.MeshStandardMaterial({color: cfg.accent, metalness: .55, roughness: .26}));
        barH.position.set(0, .02, .205); g.add(barH);
      } else if (tier === 'royal') {
        const crown = mesh(new THREE.ConeGeometry(.19, .26, 5), new THREE.MeshStandardMaterial({color: cfg.accent, metalness: .7, roughness: .22}));
        crown.position.set(0, .06, .21); crown.rotation.z = Math.PI; g.add(crown);
        const gem = mesh(new THREE.OctahedronGeometry(.075), new THREE.MeshBasicMaterial({color: cfg.core, transparent: true, opacity: .95, blending: THREE.AdditiveBlending, depthWrite: false}));
        gem.position.set(0, -.20, .225); g.add(gem);
      } else if (tier === 'sacred') {
        const sun = mesh(new THREE.SphereGeometry(.12, 12, 8), new THREE.MeshStandardMaterial({color: cfg.core, metalness: .7, roughness: .18, emissive: cfg.core, emissiveIntensity: .45}));
        sun.position.set(0, .02, .23); g.add(sun);
        for (let i = 0; i < 8; i++) {
          const a = i * Math.PI / 4;
          const ray = mesh(new THREE.BoxGeometry(.045, .28, .025), new THREE.MeshStandardMaterial({color: cfg.accent, metalness: .65, roughness: .2}));
          ray.position.set(Math.sin(a) * .16, .02 + Math.cos(a) * .16, .22); ray.rotation.z = -a; g.add(ray);
        }
      } else if (tier === 'transcendent') {
        const core = mesh(new THREE.OctahedronGeometry(.19), new THREE.MeshStandardMaterial({color: cfg.core, metalness: .55, roughness: .2, emissive: cfg.core, emissiveIntensity: .45}));
        core.position.set(0, .02, .235); g.add(core);
        for (const x of [-.22, .22]) {
          const spike = mesh(new THREE.ConeGeometry(.045, .42, 5), new THREE.MeshStandardMaterial({color: cfg.accent, metalness: .55, roughness: .22}));
          spike.position.set(x, .02, .22); spike.rotation.z = x > 0 ? -.42 : .42; g.add(spike);
        }
      } else {
        const core = mesh(new THREE.OctahedronGeometry(.23), new THREE.MeshStandardMaterial({color: cfg.core, metalness: .35, roughness: .16, emissive: cfg.core, emissiveIntensity: 1.0}));
        core.position.set(0, .02, .24); g.add(core);
        const glow = mesh(new THREE.OctahedronGeometry(.30), new THREE.MeshBasicMaterial({color: cfg.accent, transparent: true, opacity: .20, blending: THREE.AdditiveBlending, depthWrite: false}));
        glow.position.set(0, .02, .22); g.add(glow);
      }

      // 盾牌背帶只存在於背面，不會出現在正面。
      const strap = mesh(new THREE.BoxGeometry(.15, .54, .045), mat(0x242a32, .45, .25));
      strap.position.set(0, .02, .02);
      g.add(strap);

      g.rotation.set(0, 0, 0);
      g.userData.shieldFaceForward = true;
      g.userData.isShield = true;
      g.userData.shieldTier = tier;
      return g;
    }
    function makeMageOrb() {const c = (typeof CLASS_CRYSTAL_COLORS !== 'undefined' && CLASS_CRYSTAL_COLORS.mage) || 0xb66cff; const g = new THREE.Group(); const core = mesh(new THREE.SphereGeometry(.18, 16, 12), new THREE.MeshStandardMaterial({color: 0x6a42a8, emissive: c, emissiveIntensity: 2.1, transparent: true, opacity: .92})); const glow = mesh(new THREE.SphereGeometry(.29, 16, 12), new THREE.MeshBasicMaterial({color: c, transparent: true, opacity: .20, blending: THREE.AdditiveBlending, depthWrite: false})); const ring = mesh(new THREE.TorusGeometry(.28, .025, 8, 20), new THREE.MeshBasicMaterial({color: c, transparent: true, opacity: .8})); ring.rotation.x = Math.PI / 2; g.add(core, glow, ring); g.userData.isMageOrb = true; return g;}
    // 劍持握角度：相對原本「劍尖朝下」的姿態翻轉並傾斜 45°，讓劍鋒明確朝上。
    // 135° = 反轉劍尖方向後，再向側方傾斜 45°。
    const SWORD_HOLD_Z = Math.PI / 2;
    // 劍身幾何本身沿 Z 軸建立；將整把劍轉回 Y 軸，使劍鋒在待機時垂直朝上。
    const SWORD_HOLD_X = 0;
    // 劍沿手臂校正後保持水平，並以角色前方(+Z)為劍尖方向；參照盜賊持刀方向。
    const SWORD_FORWARD_Y = 0;
    function isHeldSwordWeapon(visual) {
      if (!visual) return false;
      return visual.family === 'sword' || visual.visual === 'sword' || visual.visual === 'greatsword' || visual.visual === 'noviceWoodSword';
    }
    function mountWeaponToHand(group, visual = {}, hand = 'R') {
      if (!group) return;
      visual = visual || {};
      // WeaponMount 已經與手套中心重合，因此武器根節點固定在 (0,0,0)。
      // 不再額外補 X/Y/Z 位移，所有武器都從手掌同一個握持點開始。
      group.position.set(0, -.78, 0);
      const w = (state.classId === 'mage' && (visual.visual === 'orb' || visual.visual === 'arcaneorb')) ? makeMageOrb() : makeWeaponVisual(visual);
      w.userData.heldWeapon = true;
      w.userData.handGrip = 'gloveCenter';
      w.userData.isHeldSword = isHeldSwordWeapon(visual);
      w.position.set(0, 0, 0);
      const arm = group.parent;
      w.rotation.set((arm ? -(arm.rotation.x || 0) : 0) + (w.userData.isHeldSword ? SWORD_HOLD_X : 0), w.userData.isHeldSword ? SWORD_FORWARD_Y : 0, w.userData.isHeldSword ? SWORD_HOLD_Z : 0);
      const host = group.userData?.weaponVisualRoot || group;
      host.add(w); return w;
    }
    const HELMET_HAIR_MODE = {
      novicecap: 'all', leatherhelm: 'hide', foresthelm: 'hide', silverhelm: 'hide', knighthelm: 'show', flamehelm: 'hide',
      windcap: 'all', wolfcap: 'hide', wizardhat: 'wizard', martialhelm: 'all',
      headband: 'show', moonhelm: 'show', holycrw: 'show'
    };
    function getHatAdjust(visual) {
      const d = state.hatAdjustments?.[visual] || {};
      return {x: Number.isFinite(Number(d.x)) ? Number(d.x) : 0, y: Number.isFinite(Number(d.y)) ? Number(d.y) : 0, z: Number.isFinite(Number(d.z)) ? Number(d.z) : 0, scale: Number.isFinite(Number(d.scale)) ? Number(d.scale) : 1};
    }
    function getHatFit(visual) {
      return {wizardhat: {scale: 1.58, y: .22, z: 0}, knighthelm: {scale: 1.08, y: .02, z: 0}, holycrw: {scale: 1.15, y: .05, z: 0}, headband: {scale: 1.12, y: .04, z: 0}, windcap: {scale: 1.16, y: .03, z: 0}, wolfcap: {scale: 1.08, y: .02, z: -.015}, novicecap: {scale: 1.16, y: .02, z: 0}}[visual] || {scale: 1.14, y: .02, z: 0};
    }
    function applyHatAdjustmentToParts(parts, visual, adjustments) {
      if (!parts?.head || !visual) return;
      const hv = parts.head.children.find(o => o.userData?.isHelmetVisual);
      if (!hv) return;
      const fit = getHatFit(visual), d = adjustments || {};
      const a = {x: Number.isFinite(Number(d.x)) ? Number(d.x) : 0, y: Number.isFinite(Number(d.y)) ? Number(d.y) : 0, z: Number.isFinite(Number(d.z)) ? Number(d.z) : 0, scale: Number.isFinite(Number(d.scale)) ? Number(d.scale) : 1};
      hv.position.set(a.x, fit.y + a.y, fit.z + a.z);
      hv.scale.setScalar(fit.scale * a.scale);
    }
    function applyCurrentHatAdjustment() {
      if (!state.parts?.head) return;
      const visual = state.equip?.helmet?.visual || '';
      applyHatAdjustmentToParts(state.parts, visual, getHatAdjust(visual));
    }
    function setAppearanceAdjustTab(tab) {
      appearanceAdjustTab = ['hat','arms'].includes(tab) ? tab : 'cloak';
      renderModal('appearanceAdjust');
    }
    function resetHatAdjustmentInAppearance() {
      const visual = state.equip?.helmet?.visual; if (!visual) return;
      if (!state.hatAdjustments) state.hatAdjustments = {};
      state.hatAdjustments[visual] = {x: 0, y: 0, z: 0, scale: 1};
      applyCurrentHatAdjustment(); saveGame(); appearanceAdjustTab = 'hat'; renderModal('appearanceAdjust'); toast('🎩 已重設目前帽子的大小與位置');
    }
    function setHatAdjustment(key, value) {
      const visual = state.equip?.helmet?.visual; if (!visual) return;
      if (!state.hatAdjustments) state.hatAdjustments = {};
      if (!state.hatAdjustments[visual]) state.hatAdjustments[visual] = {x: 0, y: 0, z: 0, scale: 1};
      state.hatAdjustments[visual][key] = Number(value);
      applyCurrentHatAdjustment(); saveGame();
      const out = document.getElementById('hat_' + key + 'Value'); if (out) out.textContent = key === 'scale' ? Number(value).toFixed(2) + '×' : Number(value).toFixed(2);
      const cloakOut = document.getElementById('cloakHat_' + key + 'Value'); if (cloakOut) cloakOut.textContent = key === 'scale' ? Number(value).toFixed(2) + '×' : Number(value).toFixed(2);
      if (document.getElementById('cloakAdjustPreviewViewport')) refreshCloakAdjustPreview();
    }
    function resetHatAdjustment() {
      const visual = state.equip?.helmet?.visual; if (!visual) return;
      if (!state.hatAdjustments) state.hatAdjustments = {};
      state.hatAdjustments[visual] = {x: 0, y: 0, z: 0, scale: 1};
      applyCurrentHatAdjustment(); saveGame(); renderModal('hat'); toast('🎩 已重設目前帽子的大小與位置');
    }
    function renderHatAdjustModal(c) {
      const helmet = state.equip?.helmet, visual = helmet?.visual || '';
      if (!helmet) {c.innerHTML = '<h2>🎩 帽子調整</h2><p class="tip">目前沒有裝備頭部裝備。請先裝備帽子／頭盔，再調整大小與位置。</p><div class="menuActions"><button type="button" class="menuBtn" onclick="closeModal()">關閉</button></div>'; return;}
      const a = getHatAdjust(visual);
      const row = (key, label, min, max, step, value) => '<div class="hatAdjustRow"><div class="hatAdjustLabel"><b>' + label + '</b><span id="hat_' + key + 'Value">' + (key === 'scale' ? value.toFixed(2) + '×' : value.toFixed(2)) + '</span></div><input type="range" min="' + min + '" max="' + max + '" step="' + step + '" value="' + value + '" oninput="setHatAdjustment(\'' + key + '\',this.value)"></div>';
      c.innerHTML = '<h2>🎩 帽子位置／大小調整</h2><p class="tip"><b>' + (helmet.name || '目前頭部裝備') + '</b><br>拖曳滑桿即可即時調整。X 左右、Y 上下、Z 前後；大小可獨立調整。每種帽子會記住自己的設定。</p><div class="settingsBlock hatAdjustPanel">' + row('x', '↔ 左右', -0.35, 0.35, 0.01, a.x) + row('y', '↕ 上下', -0.45, 0.45, 0.01, a.y) + row('z', '↕ 前後', -0.45, 0.45, 0.01, a.z) + row('scale', '🔍 大小', 0.75, 2.10, 0.01, a.scale) + '</div><div class="menuActions"><button type="button" class="menuBtn" onclick="resetHatAdjustment()">↺ 重設目前帽子</button><button type="button" class="menuBtn" onclick="closeModal()">完成</button></div>';
    }
    function updateEquipmentVisual() {
      if (!state.player || !state.parts) return;
      const eq = state.parts.equipment, cv = state.parts.classVisuals, wr = state.parts.weaponMountR, wl = state.parts.weaponMountL;
      const wvr = state.parts.weaponVisualRootR || wr, wvl = state.parts.weaponVisualRootL || wl, svl = state.parts.shieldVisualRootL || wl;
      while (eq.children.length) eq.remove(eq.children[0]); while (cv.children.length) cv.remove(cv.children[0]);
      if (wvr) while (wvr.children.length) wvr.remove(wvr.children[0]);
      if (wvl) while (wvl.children.length) wvl.remove(wvl.children[0]);
      if (svl && svl !== wvl) while (svl.children.length) svl.remove(svl.children[0]);
      // 神佑外套的袖子跟隨骨骼手臂：先清除上一件外套留下的手臂外層。
      for (const arm of [state.parts.armL, state.parts.armR]) {
        if (!arm) continue;
        for (const ch of [...arm.children]) if (ch.userData?.divineCloakArmPiece || ch.userData?.classOutfitArmPiece) arm.remove(ch);
      }
      for (const ch of [...state.parts.head.children]) if (ch.userData?.isHelmetVisual) state.parts.head.remove(ch);
      const outfitPreviewActive = typeof ccPreview !== 'undefined' && ccPreview?.player === state.player; const hasClassArmor = !!state.equip?.armor?.classId && PLAYABLE_CLASS_IDS.includes(state.equip.armor.classId); const showCreatorOutfit = (outfitPreviewActive || state._buildingCreatorPreview === true) && creatorClassSelected && creatorOutfitEquipped && !hasClassArmor; if (showCreatorOutfit) cv.add(makeClassOutfit(creatorPreviewClass || state.classId, outfitPreviewActive ? (state.previewOutfitLevel || 1) : (state.level || 1))); else if (!hasClassArmor) cv.add(makeUnderwearOutfit());
      if (state.equip.armor) {const armorVisual = makeArmorVisual(state.equip.armor.visual, state.equip.armor); armorVisual.userData.equipClassId = state.equip.armor.classId; eq.add(armorVisual);}
      // 神佑外長外套是額外裝備：永遠疊在身體裝備外，不佔用 armor slot。
      if (state.equip.cloak) {eq.add(makeDivineBlessingCloakVisual(state.equip.cloak));}
      // 頭髮顯示規則：不是所有頭部裝備都會讓角色變成光頭。
      // 帽／盔類會隱藏頭髮；頭帶／冠類保留頭髮。
      const currentHelmetVisual = state.equip.helmet?.visual || '';
      const hairMode = state.equip.helmet ? (HELMET_HAIR_MODE[currentHelmetVisual] || 'hide') : 'show';
      if (state.parts.hairStyles) state.parts.hairStyles.position.y = (hairMode === 'wizard' ? -0.12 : 0); // 魔導帽下髮型下移，讓前後髮落在帽簷內側
      if (state.parts.hairStyles) syncHeadLocalHairGroups(state.parts.hairStyles);
      state.player.traverse(o => {
        if (o.userData?.isHair) {
          const hairStyleId = o.userData.hairStyleId ? normalizeHairStyleId(o.userData.hairStyleId) : null;
          const selected = hairStyleId ? (hairStyleId === normalizeHairStyleId(state.hairStyle || 'shortCurl')) : true;
          o.visible = selected && hairMode !== 'hide';
          if (hairMode === 'front') o.visible = selected && !!o.userData.isFrontHair;
          if (hairMode === 'all' && o.userData.isHairCap) o.visible = false;
        }
      });
      // Head-bound hair lives under the real head rather than HairStyles.  Keep its
      // root visibility synchronized with the current six-style selection.
      if (state.parts.head) {
        for (const styleId of getHairStyleIds()) {
          const root = state.parts.head.getObjectByName('HeadBoundHair_' + styleId);
          if (!root) continue;
          const selected = normalizeHairStyleId(state.hairStyle || 'shortCurl') === styleId;
          root.visible = selected && hairMode !== 'hide';
          root.traverse(o => {
            if (!o.userData?.isHair) return;
            o.visible = selected && hairMode !== 'hide';
            if (hairMode === 'front') o.visible = selected && !!o.userData.isFrontHair;
          });
        }
      }
      if (state.equip.helmet && state.parts.head) {
        // 使用實際裝備的頭盔類型，不再強制替換成職業預設頭盔。
        const helmetData = {...state.equip.helmet, visual: state.equip.helmet.visual || (CLASS_HELMETS[state.classId] || CLASS_HELMETS.novice).visual};
        const hv = makeEquipVisual('helmet', helmetData);
        // V8.00：重新校正各職業頭盔比例。頭盔以頭部為基準放大並抬高，避免穿入頭髮／頭部；魔導帽最大且最高。
        const helmetFit = {
          wizardhat: {scale: 1.58, y: .22, z: 0},   // 法師：加大帽簷與帽身，完整包覆前後頭髮，避免穿出帽體
          knighthelm: {scale: 1.04, y: .015, z: 0},  // 戰士：V5 狼帽式貓耳兜帽，保留髮型避免光頭
          holycrw: {scale: 1.15, y: .05, z: 0},     // 聖職者：皇冠帽
          headband: {scale: 1.12, y: .04, z: 0},    // 武道家：頭環
          windcap: {scale: 1.16, y: .03, z: 0},      // 盜賊：防風眼鏡／帽具
          novicecap: {scale: 1.16, y: .02, z: 0}
        }[helmetData.visual] || {scale: 1.14, y: .02, z: 0};
        hv.userData.isHelmetVisual = true; state.parts.head.add(hv); applyCurrentHatAdjustment();
      }
      // 飾品外觀規則：戒指、耳環、手套／手鐲只保留裝備數值與裝備欄顯示，
      // 不在角色 3D 身上建立獨立外觀；鞋子與腰帶仍維持正常 3D 外觀。
      for (const slot of ['shoes', 'belt']) if (state.equip[slot]) eq.add(makeEquipVisual(slot, state.equip[slot]));
      // 嚴格規則：只有「目前已裝備」且 specialSeries 明確為 sacred / demon 的裝備，才可以產生背部翼。
      // 普通、稀有、史詩、傳說、天啟、聖耀等階級裝備，即使有發光效果，也不會產生背部翼。
      const specialEquip = EQUIP_SLOTS
        .map(k => state.equip[k])
        .find(it => it && (it.specialSeries === 'sacred' || it.specialSeries === 'demon'));

      if (specialEquip) {
        addSpecialEquipmentWings(eq, specialEquip.specialSeries);
      }
      // V3.6：只有實際裝備 weapon 才建立手持武器。
      // 職業的預設 weapon family 只用於戰鬥數值／技能判定，不能轉成視覺武器。
      // 新角色、Character Creator 與空武器欄位時，雙手必須完全空手。
      const weapon = state.equip?.weapon || null;
      if (weapon) {
        const family = weaponFamilyOf(weapon) || classes[state.classId].weapon;
        if (family === 'orb') {
          const orb = makeMageOrb();
          // 法師寶珠也使用右手／手套中心作為基準，不再漂浮在身體外側。
          orb.position.set(.63, -.04, .18);
          orb.scale.setScalar(.82);
          orb.userData.floatingMageOrb = true;
          orb.userData.heldWeapon = true;
          orb.userData.handGrip = 'gloveCenter';
          (state.parts.weaponVisualRootR || wr).add(orb);
        } else if (family === 'dagger') {
          if (weapon.visual === 'dualblade') {
            const right = makeDagger(); right.position.set(0, 0, 0); right.rotation.set(-(state.parts.armR.rotation.x || 0), 0, -.12); right.userData.heldWeapon = true; right.userData.handGrip = 'gloveCenter'; wr.position.set(0, -.78, 0); (state.parts.weaponVisualRootR || wr).add(right);
            const left = makeDagger(); left.position.set(0, 0, 0); left.rotation.set(-(state.parts.armL.rotation.x || 0), 0, .12); left.userData.heldWeapon = true; left.userData.handGrip = 'gloveCenter'; wl.position.set(0, -.78, 0); (state.parts.weaponVisualRootL || wl).add(left);
          } else mountWeaponToHand(wr, weapon, 'R');
        } else if (family === 'fist') {
          // 武道家：指虎是主武，只裝在右手；左手維持空手／手套。
          // 武器根節點與右手手套中心重合，位置參考 MMORPG 武道家主武。
          mountWeaponToHand(wr, weapon, 'R');
        } else {
          mountWeaponToHand(wr, weapon, 'R');
        }
      }
      if (state.equip.offhand && state.equip.offhand.family === 'shield' && (state.classId === 'warrior' || state.classId === 'thief')) {
        const sh = makeShieldVisual(state.equip.offhand);
        // 左手持盾：稍微抬起，不向角色正前方伸出；盾面向外偏約 23°。
        // V8.31：盾牌向左手外側再拉開一點，保留手掌握持感，但不再緊貼前臂。
        sh.position.set(-.19, .18, .035);
        sh.rotation.set(-.08, -THREE.MathUtils.degToRad(23), .035);
        (state.parts.shieldVisualRootL || wl).add(sh);
      }
      applyShieldArmPose();
    }


    // V7.23：武器握柄穿過手掌中心，手臂向前伸出；待機時刀刃只在手前方，不再經過肩膀。
    // 所有實體武器統一以「手掌 = 原點、角色前方 = +Z」製作。
    // 不再依賴 X 軸 90 度翻轉，避免攻擊結束後武器重新變成插在身體上的姿勢。
    function makeStaff() {
      const s = new THREE.Group(), wood = mat(0x70482d), crystal = mat(0x7fcaff, 0.25, 0.2);
      const grip = mesh(new THREE.CylinderGeometry(.045, .055, .28, 8), wood); grip.rotation.x = Math.PI / 2; grip.position.z = -.14;
      const pole = mesh(new THREE.CylinderGeometry(.045, .065, 1.65, 8), wood); pole.rotation.x = Math.PI / 2; pole.position.z = .78;
      const c = mesh(new THREE.OctahedronGeometry(.18), crystal); c.position.z = 1.62;
      s.add(grip, pole, c); return s;
    }
    function makeDagger() {
      const s = new THREE.Group(), m = mat(0xd6dbe3, .35, .55), handleMat = mat(0x5b3828, .55, .08);
      const handle = mesh(new THREE.CylinderGeometry(.045, .05, .28, 8), handleMat); handle.rotation.x = Math.PI / 2; handle.position.z = -.14;
      const guard = mesh(new THREE.BoxGeometry(.20, .055, .07), mat(0xb58b48, .3, .45)); guard.position.z = .015;
      const b = mesh(new THREE.BoxGeometry(.09, .13, .65), m); b.position.z = .36;
      s.add(handle, guard, b); return s;
    }
    const CLASS_BODY_COLORS = {novice: {main: 0xf1f1ed, dark: 0xc9cdd2, accent: 0xdde7ef, crystal: 0x9fdcff}, warrior: {main: 0x8f2635, dark: 0x541624, accent: 0xffc14d, crystal: 0xff4b45}, mage: {main: 0x4b2f8f, dark: 0x24134f, accent: 0xc5a3ff, crystal: 0xb66cff}, thief: {main: 0x27352f, dark: 0x111b18, accent: 0x68d391, crystal: 0x55e58a}, priest: {main: 0xe9e2d2, dark: 0x9da8bd, accent: 0xffe28a, crystal: 0x69c9ff}, monk: {main: 0x9b4a2f, dark: 0x542317, accent: 0xf3bf5b, crystal: 0xff9f3f}};
    const CLASS_CRYSTAL_COLORS = {novice: 0x8fd8ff, warrior: 0xff4b45, mage: 0xb66cff, thief: 0x55e58a, priest: 0x69c9ff, monk: 0xff9f3f};
    // ============================================================================
    // HAIR SYSTEM V2
    // MMORPG-style modular hairstyle system: one body, many independent hair
    // assets. Each style lives in its own group and visibility is controlled only
    // by this module. Preview and live character use the same selection state.
    // Inspired by common MMORPG creator patterns: selectable hairstyle cards,
    // immediate 3D preview, and a dedicated hair asset per style.
    // ============================================================================
    const HAIR_SYSTEM_VERSION = '12.0-wolf-face-precision';
    // Character appearance data shared by the live model and creator/editor.
    // Restored from the previous working Asgard build so the six-style hair
    // module does not remove unrelated appearance systems.
    const HAIR_COLOR_INFO = {
      black: {name: '曜石黑', hex: 0x171923, highlight: 0x303746},
      chestnut: {name: '栗棕', hex: 0x6a2d25, highlight: 0x9b5543},
      chocolate: {name: '巧克力棕', hex: 0x4b2a22, highlight: 0x7b493b},
      ash: {name: '霧灰', hex: 0x777985, highlight: 0xb2b5c2},
      silver: {name: '銀白', hex: 0xcfd3dc, highlight: 0xf5f6fa},
      blonde: {name: '金色', hex: 0xd5a34e, highlight: 0xffe19a},
      honey: {name: '蜜糖金', hex: 0xc98945, highlight: 0xf1c777},
      red: {name: '赤紅', hex: 0x9f2f2f, highlight: 0xe05a52},
      rose: {name: '玫瑰粉', hex: 0xc66b82, highlight: 0xf1a6ba},
      violet: {name: '紫羅蘭', hex: 0x75558f, highlight: 0xb79ad6},
      blue: {name: '深海藍', hex: 0x31537e, highlight: 0x6e9bd0},
      mint: {name: '薄荷青', hex: 0x4c8e88, highlight: 0x8ed2c9}
    };
    const EYE_STYLE_INFO = {
