            [-.18, -.292, -.558, .105, .47, .025],
            [-.135, -.307, -.566, .116, .50, .017],
            [-.09, -.318, -.573, .126, .53, .010],
            [-.045, -.325, -.578, .136, .56, .004],
            [0, -.330, -.580, .146, .59, 0],
