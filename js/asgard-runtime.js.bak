    const EQUIP_VISUAL_TIERS = {starter: {name: '初心', main: 0x7b6a58, accent: 0xd6c2a0, glow: 0x9a8f7a, metal: .12}, field: {name: '精製', main: 0x4f6f86, accent: 0x9fd6ff, glow: 0x55b9ff, metal: .25}, royal: {name: '王家', main: 0x6e4b8f, accent: 0xe0a8ff, glow: 0xc45cff, metal: .34}, sacred: {name: '神聖', main: 0xb68b32, accent: 0xfff1a8, glow: 0xffd34d, metal: .48}, transcendent: {name: '天啟', main: 0x8b3f62, accent: 0xffd5e8, glow: 0xff6db5, metal: .55}, divine: {name: '聖耀', main: 0xe8dcc4, accent: 0x9fe8ff, glow: 0x78d8ff, metal: .68}};
    function equipmentVisualTier(level) {const n = Number(level) || 1; if (n >= 91) return 'divine'; if (n >= 61) return 'transcendent'; if (n >= 41) return 'sacred'; if (n >= 21) return 'royal'; if (n >= 11) return 'field'; return 'starter'}
    const CLASS_EQUIP_VISUALS = {novice: {main: 0xf0f2f1, accent: 0xd7e0e6, glow: 0xbfd8e8, shape: 'adventurer'}, warrior: {main: 0x8b343d, accent: 0xf0c85a, glow: 0xff654d, shape: 'knight'}, thief: {main: 0x222936, accent: 0x8c5cff, glow: 0xb05cff, shape: 'shadow'}, mage: {main: 0x403a91, accent: 0x78c8ff, glow: 0x5e9dff, shape: 'arcane'}, monk: {main: 0x9a4d32, accent: 0xf2c45f, glow: 0xff8b3d, shape: 'martial'}, priest: {main: 0xcfc7b4, accent: 0xffe98b, glow: 0xffdf55, shape: 'holy'}};
    function equipmentVisualProfile(it) {const cls = CLASS_EQUIP_VISUALS[it?.classId || state.classId] || CLASS_EQUIP_VISUALS.novice; const tier = equipmentVisualTier(it?.itemLevel || 1); return {cls, tier, t: EQUIP_VISUAL_TIERS[tier]}}
    function armorDesignFamily(it) {
