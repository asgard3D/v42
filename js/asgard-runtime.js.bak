          // 關鍵：攻擊期間不抵消 armR 的 X 旋轉。WeaponMount 是手臂子節點，
          // 所以劍會真正跟著「手掌」抬起、向下劈，再收回，而不是只在身體前方平移。
          wr.position.set(0, -.78, 0);
          wr.rotation.set(0, 0, 0);
          for (const o of wr.children) {
            if (o.userData?.isHeldSword) {
              o.position.set(0, 0, 0);
              o.rotation.y = SWORD_FORWARD_Y;
              o.rotation.z = SWORD_HOLD_Z;
            }
          }
        }
        // 下劈瞬間補一條垂直斬擊光，讓命中方向更清楚。
        if (p >= .42 && p < .64 && !a.slashTrailShown) {
          a.slashTrailShown = true;
          const trailPos = state.player.position.clone().add(new THREE.Vector3(0, 1.05, .62).applyAxisAngle(new THREE.Vector3(0, 1, 0), state.player.rotation.y));
          const trail = mesh(new THREE.BoxGeometry(.07, 1.45, .035), new THREE.MeshBasicMaterial({color: 0xffe8a0, transparent: true, opacity: .78}));
          trail.position.copy(trailPos);
          trail.rotation.y = state.player.rotation.y;
          trail.rotation.z = -.28;
          trail.scale.x = .85 + .35 * slashStrength;
          state.player.parent?.add(trail);
          setTimeout(() => {if (trail.parent) trail.parent.remove(trail); trail.material.dispose();}, 150);
        }
      } else if (c === 'mage') {
        // 法師：始終維持 V 字托掌；施法時只抬高上臂，前臂／掌心仍朝上托珠。
        applyMageOrbHandPose();
        state.parts.armR.rotation.x = -.56 - wind * .12;
        state.parts.armR.rotation.z = -.10 - wind * .08;
        if (wr) {wr.rotation.set(0, 0, 0); setHeldWeaponThrust(wr, Math.max(0, hit) * .18);}
      } else if (c === 'thief') {
        // 盜賊：雙短刃向前刺。
        state.parts.armR.rotation.z = -.13;
        state.parts.armR.rotation.x = -.38 + Math.max(0, hit) * 1.15;
        if (hasRaisedShield()) applyShieldArmPose();
        else {
          state.parts.armL.rotation.z = .13;
          state.parts.armL.rotation.x = -.38 - Math.max(0, hit) * 1.15;
        }
        if (wr) setHeldWeaponThrust(wr, Math.max(0, hit) * .42);
        if (wl && !hasRaisedShield()) setHeldWeaponThrust(wl, Math.max(0, hit) * .42);
      } else if (c === 'monk') {
        // 武家：雙拳向前打出。
        state.parts.armR.rotation.z = -.13;
        state.parts.armL.rotation.z = .13;
        state.parts.armR.rotation.x = -.38 + Math.max(0, hit) * 1.05;
        state.parts.armL.rotation.x = -.38 + Math.max(0, hit) * 1.05;
        if (wr) setHeldWeaponThrust(wr, Math.max(0, hit) * .34);
        if (wl) setHeldWeaponThrust(wl, Math.max(0, hit) * .34);
      } else if (c === 'priest') {
        // 聖職者：法杖握在右手，向前揮動。
        state.parts.armR.rotation.z = -.13 - hit * 1.15;
        state.parts.armR.rotation.x = -.38 - wind * .65;
        if (wr) {wr.rotation.set(-state.parts.armR.rotation.x - hit * .85, 0, 0); setHeldWeaponThrust(wr, Math.max(0, hit) * .34);}
      } else {
        state.parts.armR.rotation.z = -.13 - hit * 1.1;
        state.parts.armR.rotation.x = -.38 - wind * .75;
      }
      // 每一幀重新計算握持角度：武器永遠從手掌向前，不會隨手臂前傾而刺進肩膀。
      // 劍系攻擊期間 WeaponMount 必須跟隨手臂，不可用一般待機握持校正抵消手臂抬劍。
      if (c !== 'mage' && c !== 'warrior' && c !== 'novice') syncWeaponGrip();
      if (hasRaisedShield()) applyShieldArmPose();
      if (a.t >= a.duration) {
        a.active = false;
        state.parts.armR.rotation.z = -.13; state.parts.armR.rotation.x = -.38;
        if (hasRaisedShield()) applyShieldArmPose();
        else {state.parts.armL.rotation.z = .13; state.parts.armL.rotation.x = -.38;}
        if (wr) {setHeldWeaponThrust(wr, 0);}
        if (wl) {setHeldWeaponThrust(wl, 0);}
        if (c !== 'mage') syncWeaponGrip();
      }
      applyArmRotationOffsets();
      applyArmWeaponMountAdjustments();
    }
    function updateHolyCrossEffect(f, dt) {
      const g = f.g; if (!g) return;
      const pulse = .78 + .22 * Math.sin(f.t * 7);
      g.scale.setScalar(.96 + .05 * Math.sin(f.t * 4));
      g.traverse(o => {
        if (o.material && 'opacity' in o.material) {o.material.opacity = (o.userData.crossCore ? .55 : .38) * pulse + (o.userData.crossCore ? .18 : .18);}
        if (o.isPointLight) o.intensity = 2.4 + 2.0 * pulse;
      });
    }
    function updateEffects(dt) {
      // 傳說武器持續發光與脈動，不影響武器握持位置。
      if (state.player) {const t = performance.now() * 0.004; state.player.traverse(o => {if (o.userData?.legendaryWeaponGlow) {if (o.isMesh) {o.rotation.z += dt * 2.5; const pulse = .82 + .18 * Math.sin(t + (o.position.z || 0) * 2); o.scale.setScalar(pulse); if (o.material && 'opacity' in o.material) o.material.opacity = .58 + .32 * Math.sin(t + (o.position.z || 0));} else if (o.isLight) {o.intensity = 1.05 + .55 * Math.sin(t);} } });}
      for (const e of state.effects) {
        e.t += dt; const k = Math.min(1, e.t / e.life);
        if (e.type === 'slash') {e.g.scale.setScalar(.3 + k * 1.8); e.g.rotation.y += dt * 8}
        if (e.type === 'magic') {e.g.scale.setScalar(.4 + k * 2.2)}
        if (e.type === 'levelup') {e.g.position.y += dt * .35; e.g.scale.setScalar(1 + k * .9); e.g.rotation.y += dt * .8}
        if (e.type === 'fireball') {
          if (e.from && e.to) {e.g.position.lerpVectors(e.from, e.to, k)}
          e.g.rotation.y += dt * 10; e.g.scale.setScalar(.75 + Math.sin(k * Math.PI) * .35);
        }
        if (e.type === 'magicbolt') {
          if (e.from && e.to) {e.g.position.lerpVectors(e.from, e.to, k)}
          e.g.rotation.y += dt * 12; e.g.scale.setScalar(.75 + Math.sin(k * Math.PI) * .5);
        }
        if (e.type === 'blacksmoke') {e.g.rotation.y += dt * 3; e.g.scale.setScalar(.7 + k * .75)}
        if (e.type === 'whirl') {e.g.rotation.y += dt * 11; e.g.scale.setScalar(.65 + k * 1.35)}
        if (e.type === 'shockwave') {e.g.scale.setScalar(.5 + k * 3.0); e.g.rotation.y += dt * 4}
        if (e.type === 'healBeam') {
          const rise = Math.min(1, k / .34), fade = k < .62 ? 1 : Math.max(0, (1 - k) / .38), pulse = .82 + .18 * Math.sin(e.t * 15);
          e.core.scale.set(1 + Math.sin(e.t * 9) * .10, 1 + rise * .10, 1 + Math.sin(e.t * 9) * .10);
          e.beam.scale.set(.96 + .08 * pulse, 1 + rise * .05, .96 + .08 * pulse);
          e.glow.scale.setScalar(.88 + .22 * pulse);
          e.outer.scale.setScalar(1 + .10 * rise); e.ring2.scale.setScalar(1 + .14 * Math.sin(e.t * 8));
          e.runeRing.scale.setScalar(1 + .10 * Math.sin(e.t * 10 + 1));
          e.outer.rotation.z += dt * 1.5; e.ring2.rotation.z -= dt * 2.0; e.runeRing.rotation.z += dt * 2.8;
          e.light.intensity = (3.8 + 6.0 * pulse) * fade;
          e.core.material.opacity = .52 * fade; e.beam.material.opacity = .12 + .14 * pulse; e.glow.material.opacity = .12 + .10 * pulse;
          e.base.material.opacity = .48 * fade; e.outer.material.opacity = .86 * fade; e.ring2.material.opacity = .72 * fade; e.runeRing.material.opacity = .88 * fade;
          e.flareH.material.opacity = (.30 + .34 * pulse) * fade; e.flareV.material.opacity = (.30 + .34 * pulse) * fade;
          for (const q of e.glyphs || []) {q.rotation.y += dt * (1.5 + (q.userData.speed || 1) * .45); q.scale.setScalar(.72 + .32 * Math.sin(e.t * 8 + q.userData.baseA * 4));}
          for (const q of e.particles || []) {q.position.addScaledVector(q.userData.v, dt); q.position.y += dt * .38; q.userData.v.multiplyScalar(.984); q.material.opacity = .82 * fade * (.65 + .35 * Math.sin(e.t * 10 + (q.userData.phase || 0)));}
        }
        if (e.type === 'holy') {e.g.position.y += dt * .28; e.g.scale.setScalar(.55 + k * 1.35); e.g.rotation.y += dt * 1.5}
        if (e.type === 'holyCross') {
          const pulse = .72 + .28 * Math.sin(e.t * 8), flash = Math.max(0, Math.sin(e.t * 13)) * Math.max(0, 1 - k * .55);
          e.g.scale.setScalar(.97 + .05 * Math.sin(e.t * 3.5)); e.g.rotation.y += dt * .08;
          e.g.traverse(o => {
            if (o.isPointLight) o.intensity = 5.0 + 7.5 * pulse + 10 * flash;
            if (o.material && 'opacity' in o.material) {
              const base = o.userData?.rayBase ?? .22;
              if (o.userData?.holyCore) o.material.opacity = .62 + .28 * pulse;
              else if (o.userData?.holyCoreGlow) o.material.opacity = .12 + .20 * pulse + flash * .18;
              else if (o.userData?.holyStar) o.material.opacity = Math.max(.05, (.45 + .45 * Math.sin(e.t * 10 + (o.userData.phase || 0))) * (1 - k * .92));
              else o.material.opacity = Math.max(.015, base * (.72 + .5 * pulse) * (1 - k * .92));
            }
            if (o.userData?.crossV) {o.position.addScaledVector(o.userData.crossV, dt); o.userData.crossV.multiplyScalar(.975); o.rotation.z += dt * 2.5;}
            if (o.userData?.rayAngle != null) {o.rotation.y = o.userData.rayAngle + Math.sin(e.t * 2.5 + o.userData.rayAngle) * .08;}
          });
        }
        if (e.type === 'skillBurst') {const pulse = Math.sin(k * Math.PI); e.g.scale.setScalar(.65 + 1.7 * pulse); e.g.rotation.y += dt * 8; e.g.traverse(o => {if (o.isPointLight) o.intensity = 1.2 + 4 * pulse; if (o.material && 'opacity' in o.material) o.material.opacity = Math.max(.05, .95 - k * .95)})}
        if (e.type === 'skillName') {
          if (state.player) {e.g.position.x = state.player.position.x; e.g.position.z = state.player.position.z;}
          const rise = Math.min(1, k / .22); e.g.position.y += dt * .18;
          const fade = k < .10 ? k / .10 : (1 - k) / .90;
          const pulse = .92 + .12 * Math.sin(e.t * 22);
          e.sp.scale.set(3.35 * (.95 + .08 * rise), .66 * (.95 + .08 * rise), 1);
          e.ring.scale.setScalar(pulse + rise * .18); e.ring.rotation.z += dt * 3.8;
          e.light.intensity = 1.8 + 4.5 * Math.sin(Math.min(1, k / .18) * Math.PI);
          e.sp.material.opacity = Math.max(0, fade); e.ring.material.opacity = Math.max(0, fade * .68);
        }
        if (e.type === 'chainLightning') {
          const pulse = .5 + .5 * Math.sin(e.t * 30);
          e.g.scale.setScalar(.98 + .06 * pulse);
          e.g.traverse(o => {if (o.isPointLight) o.intensity = 3.5 + 7 * pulse; if (o.material && o.userData?.chainBolt) o.material.opacity = .45 + .55 * pulse;});
        }
        if (e.type === 'mageThunder') {
          const flash = Math.max(0, Math.sin(e.t * 24)) * Math.max(0, 1 - k);
          e.g.scale.setScalar(.95 + flash * .22);
          e.g.traverse(o => {if (o.isPointLight) o.intensity = 4 + 12 * flash; if (o.userData?.thunderBolt && o.material) o.material.opacity = .28 + .72 * Math.max(0, Math.sin(e.t * 32 + o.id));});
        }
        if (e.type === 'meteorRain') {
          e.g.rotation.y += dt * .18;
          for (const r of (e.rocks || [])) {
            r.position.addScaledVector(r.userData.v, dt);
            r.rotation.x += r.userData.spin.x * dt; r.rotation.y += r.userData.spin.y * dt; r.rotation.z += r.userData.spin.z * dt;
            if (r.userData.meteorFlame) r.userData.meteorFlame.scale.setScalar(.8 + .35 * Math.sin(e.t * 22 + r.id));
            // 10 秒持續降落：隕石落地後立即重新從天空生成，形成連續隕石雨。
            if (r.position.y < -.15) {
              const a = Math.random() * Math.PI * 2, radius = .7 + Math.random() * 4.6;
              r.position.set(Math.cos(a) * radius, 7.5 + Math.random() * 5.5, Math.sin(a) * radius);
              r.userData.v.set(-r.position.x * .035, -6.2 - Math.random() * 3.8, -r.position.z * .035);
              r.rotation.set(Math.random() * 3, Math.random() * 3, Math.random() * 3);
            }
          }
          e.g.traverse(o => {if (o.isPointLight) o.intensity = 2.2 + 3 * Math.max(0, Math.sin(e.t * 14));});
        }

        if (e.type === 'simpleCloneController') {
          const target = e.target;
          const p = Math.min(1, e.t / 0.95);
          e.ghosts?.forEach((ghost, i) => {
            if (!ghost) return;
            ghost.visible = true;
            ghost.traverse(o => {
              o.visible = true;
              if (o.isMesh && o.material && 'opacity' in o.material) {
                const fade = e.t > 2.45 ? Math.max(0, (3 - e.t) / .55) : .88;
                o.material.opacity = fade;
              }
            });

            if (target?.userData?.alive) {
              const side = ghost.userData.attackSide || 1;
              const targetPos = target.position.clone();
              const forward = new THREE.Vector3(
                Math.sin(state.player.rotation.y), 0, Math.cos(state.player.rotation.y)
              );
              const right = new THREE.Vector3(forward.z, 0, -forward.x);
              const attackPos = targetPos.clone().add(right.multiplyScalar(side * .9));
              attackPos.y = state.player.position.y;

              if (p < 1) {
                ghost.position.lerpVectors(ghost.userData.attackStart, attackPos, p);
              } else {
                const wobble = Math.sin(e.t * 10 + i * Math.PI) * .18;
                ghost.position.copy(attackPos).addScaledVector(right, wobble);
                ghost.position.y = state.player.position.y;
              }
              ghost.lookAt(targetPos.x, ghost.position.y, targetPos.z);
            }
          });
        }
        if (e.type === 'simpleCloneSlash') {
          const p = Math.sin(Math.min(1, k) * Math.PI);
          e.g.scale.setScalar(.65 + 1.25 * p);
          e.g.rotation.y += dt * 8;
          if (e.ring) e.ring.scale.setScalar(.75 + 1.5 * p);
          if (e.light) e.light.intensity = 1.5 + 5 * p;
          e.g.traverse(o => {
            if (o.material && 'opacity' in o.material)
              o.material.opacity = Math.max(0, .95 - k * 1.15);
          });
        }

        if (e.type === 'blizzard') {
          e.g.rotation.y += dt * .05;
          for (const f of (e.flakes || [])) {f.position.addScaledVector(f.userData.v, dt); f.position.x += Math.sin(e.t * 3 + f.userData.phase) * dt * .45; f.rotation.x += dt * 4; f.rotation.z += dt * 3; if (f.position.y < .1) {f.position.y = 9 + Math.random() * 2; f.position.x = (Math.random() - .5) * 12; f.position.z = (Math.random() - .5) * 12;} }
        }
        for (const q of e.g.children) {if (q.userData.v && e.type !== 'meteorRain' && e.type !== 'blizzard' && e.type !== 'mageThunder') {q.position.addScaledVector(q.userData.v, dt); q.userData.v.y -= 6 * dt} }
        e.g.traverse(o => {if (o.material && 'opacity' in o.material && !o.userData?.persistentSkillVisual && !['mageThunder', 'meteorRain', 'blizzard'].includes(e.type)) o.material.opacity = Math.max(0, 1 - k)})
      }
      state.effects = state.effects.filter(e => {
        if (e.t >= e.life) {
          if (e.type === 'simpleCloneController') {
            (e.ghosts || []).forEach(g => {if (g?.parent) g.parent.remove(g);});
          }
          scene.remove(e.g);
          return false;
        }
        return true
      });
    }
    let combatLogEntries = [];
    let combatLogFilter = 'all';
    let combatLogRightMode = false;
    function getCombatLogCategory(text, kind = 'sys') {
      const t = String(text || '');
      if (/掉落|拾取/.test(t)) return 'drop';
      if (/EXP|經驗/.test(t)) return 'exp';
      return 'battle';
    }
    function renderCombatLog() {
      const box = document.getElementById('combatLogList'); if (!box) return;
      box.innerHTML = '';
      const rows = combatLogEntries.filter(x => combatLogFilter === 'all' || x.category === combatLogFilter).slice(-9);
      rows.forEach(x => {
        const row = document.createElement('div'); row.className = 'combatLine';
        const span = document.createElement('span'); span.className = x.kind || 'sys'; span.textContent = x.text; row.appendChild(span); box.appendChild(row);
      });
      box.scrollTop = box.scrollHeight;
    }
    function addCombatLog(text, kind = 'sys') {
      const entry = {text: String(text || ''), kind, category: getCombatLogCategory(text, kind)};
      combatLogEntries.push(entry);
      if (combatLogEntries.length > 60) combatLogEntries.shift();
      renderCombatLog();
    }
    function setCombatLogFilter(filter) {
      combatLogFilter = filter;
      document.querySelectorAll('.combatTab[data-log-filter]').forEach(b => b.classList.toggle('active', b.dataset.logFilter === filter));
      renderCombatLog();
    }
    function setCombatLogLayout(rightMode) {
      combatLogRightMode = !!rightMode;
      const panel = document.getElementById('combatLog');
      const btn = document.getElementById('combatLogSideBtn');
      if (!panel) return;
      panel.classList.toggle('combatLogRight', combatLogRightMode);
      if (btn) {
        btn.classList.toggle('active', combatLogRightMode);
        btn.title = combatLogRightMode ? '切換到左側固定訊息框' : '切換到右側整頁訊息欄';
        btn.textContent = combatLogRightMode ? '←' : '→';
      }
    }

    document.addEventListener('click', e => {
      const b = e.target.closest?.('.combatTab');
      if (!b) return;
      if (b.id === 'combatLogSideBtn') {
        setCombatLogLayout(!combatLogRightMode);
        return;
      }
      setCombatLogFilter(b.dataset.logFilter || 'all');
    });

    function logDamage(e, dmg, crit = false) {
      if (!e) return;
      addCombatLog((crit ? '💥 暴擊 ' : '⚔️ ') + e.userData.name + ' -' + Math.max(1, Math.round(dmg)) + ' 傷害', crit ? 'crit' : 'dmg');
    }
    function showDamageNumber(e, dmg, crit = false) {
      if (!e || !camera || !document.body) return;
      const value = Math.max(1, Math.round(Number(dmg) || 0));
      const v = e.position.clone().add(new THREE.Vector3(0, e.userData?.boss ? 2.35 : 1.65, 0));
      const el = document.createElement('div');
      el.className = 'damageFloat ' + (crit ? 'crit' : 'normal');
      el.textContent = String(value);
      el.setAttribute('aria-hidden', 'true');
      document.body.appendChild(el);
      const start = performance.now(), life = 950;
      const sx = (Math.random() - .5) * (crit ? 34 : 26);
      const sy = (Math.random() - .5) * 8;
      function frame(now) {
        if (!el.isConnected) return;
        const k = Math.min(1, (now - start) / life), pos = v.clone();
        pos.y += k * (crit ? 1.65 : 1.35);
        pos.x += Math.sin(k * Math.PI) * .45;
        pos.project(camera);
        el.style.left = ((pos.x * .5 + .5) * innerWidth + sx) + 'px';
        el.style.top = ((-pos.y * .5 + .5) * innerHeight + sy) + 'px';
        el.style.opacity = String(k < .72 ? 1 : Math.max(0, (1 - k) / .28));
        const pulse = Math.sin(Math.min(1, k / .22) * Math.PI);
        el.style.transform = 'translate(-50%,-50%) scale(' + (crit ? (1.18 + .20 * pulse) : (1.04 + .10 * pulse)) + ')';
        if (k < 1) requestAnimationFrame(frame); else el.remove();
      }
      requestAnimationFrame(frame);
    }

    function scheduleMonsterRespawn(e) {
      const u = e?.userData; if (!e || !u || u.boss || !u.type) return;
      const zoneId = state.zone;
      const range = Math.max(3, Number(state.autoRangeMeters) || 15);
      const anchorX = Number.isFinite(Number(state.autoAnchorX)) ? Number(state.autoAnchorX) : e.position.x;
      const anchorZ = Number.isFinite(Number(state.autoAnchorZ)) ? Number(state.autoAnchorZ) : e.position.z;
      const queued = countPendingMonsterRespawns(u.type);
      const stagger = Math.min(8, queued * .65);
      const delay = Math.min(MONSTER_RESPAWN_DELAY_MAX + 8, MONSTER_RESPAWN_DELAY_MIN + stagger + Math.random() * 1.4);
      monsterRespawnQueue.push({
        type: u.type, zone: zoneId, x: e.position.x, z: e.position.z,
        at: performance.now() / 1000 + delay,
        anchorX, anchorZ, range,
        retries: 0
      });
    }
    function countPendingMonsterRespawns(type) {
      const zoneId = state.zone;
      return monsterRespawnQueue.filter(q => q.zone === zoneId && q.type === type).length;
    }
    function findRespawnPointNearDeath(q) {
      const zone = zoneData[state.zone] || zoneData.forest;
      const playerPos = state.player?.position;
      const anchor = {x: q.anchorX, z: q.anchorZ};
      const hangRange = Math.max(3, Number(q.range) || 15);
      const minPlayerDist = Math.min(MONSTER_RESPAWN_MIN_DISTANCE, Math.max(2.5, hangRange * .65));
      // 不再死在原地：優先在死亡點周圍 4~10m 的環帶選點，同時遵守掛機中心與不可通行區。
      for (let i = 0; i < 28; i++) {
        const angle = Math.random() * Math.PI * 2;
        const radius = 4 + Math.random() * 6;
        let x = q.x + Math.cos(angle) * radius, z = q.z + Math.sin(angle) * radius;
        if (Number.isFinite(anchor.x) && Number.isFinite(anchor.z)) {
          const ad = Math.hypot(x - anchor.x, z - anchor.z);
          if (ad > hangRange * .88) {
            const towardX = anchor.x - q.x, towardZ = anchor.z - q.z, len = Math.hypot(towardX, towardZ) || 1;
            const blend = Math.min(1, Math.max(0, (ad - hangRange * .72) / (ad || 1)));
            x -= towardX / len * radius * .45 * blend; z -= towardZ / len * radius * .45 * blend;
          }
          if (Math.hypot(x - anchor.x, z - anchor.z) > hangRange) continue;
        }
        if (playerPos && Math.hypot(x - playerPos.x, z - playerPos.z) < minPlayerDist) continue;
        if (!canEntityMoveTo(x, z, .72)) continue;
        return {x, z};
      }
      // 若死亡點附近太擁擠，改用該怪物正常分區的生成點；仍不強制塞在玩家腳下。
      for (let i = 0; i < 18; i++) {
        const p = getMonsterSpawnPoint(q.type);
        if (!p) continue;
        if (playerPos && Math.hypot(p.x - playerPos.x, p.z - playerPos.z) < minPlayerDist) continue;
        if (Math.hypot(p.x - anchor.x, p.z - anchor.z) > hangRange) continue;
        return p;
      }
      return null;
    }
    function processMonsterRespawnQueue() {
      if (!monsterRespawnQueue.length) return;
      const now = performance.now() / 1000;
      for (let i = monsterRespawnQueue.length - 1; i >= 0; i--) {
        const q = monsterRespawnQueue[i];
        if (q.zone !== state.zone) {
          if (now - q.at > 8) monsterRespawnQueue.splice(i, 1);
          continue;
        }
        if (now < q.at) continue;
        const alive = state.enemies.filter(e => e.userData.alive && !e.userData.boss && e.userData.type === q.type).length;
        const pending = countPendingMonsterRespawns(q.type) - 1;
        const cap = getMonsterRegionState(q.type).frenzy ? FRENZY_REGION_CAP : MONSTER_REGION_CAP;
        if (alive >= cap) {monsterRespawnQueue.splice(i, 1); continue;}
        const point = findRespawnPointNearDeath(q);
        if (point) {
          const replacement = spawnEnemy(q.type, point.x, point.z);
          if (replacement) {
            replacement.position.set(point.x, 0, point.z);
            replacement.userData.homeX = point.x; replacement.userData.homeZ = point.z;
            replacement.userData.wanderX = point.x; replacement.userData.wanderZ = point.z;
            replacement.userData.wanderTimer = 1.2 + Math.random() * 2.2;
            replacement.userData.respawnedAfterDelay = true;
            monsterRespawnQueue.splice(i, 1);
            continue;
          }
        }
        q.retries = (q.retries || 0) + 1;
        if (q.retries > 5) {monsterRespawnQueue.splice(i, 1); continue;}
        q.at = now + 1.5 + Math.random() * 2.0;
      }
    }

    function hit(e, dmg, crit = false, damageType = 'physical') {
      if (!e || !e.userData.alive) return;
      const stats = e.userData.stats || monsterTypes[e.userData.type];
      const defense = damageType === 'magic' ? (stats.mdef ?? Math.round((stats.def || 0) * .75)) : (stats.def || 0);
      const finalDmg = Math.max(1, dmg - defense);
      e.userData.hp -= finalDmg;
      // 命中傷害時再播放一次「實際命中」音效，避免普攻動畫有跑但只有升級聲。
      // 測試音效已成功時，這裡一定走同一個 AudioContext。
      try {playGameSound('hit', e.userData.boss ? 'boss' : 'hit', e.userData.boss ? 2.1 : (crit ? 1.65 : 1.35));} catch (_) { }
      if (e.userData.boss) {
        e.userData.aggroed = false;
        e.userData.bossLastHit = 0;
      } else {
        // 路爾斯森林為新手被動區：怪物不主動索敵；但玩家先攻擊後，該怪物立即記仇並反擊。
        e.userData.aggroed = true;
        e.userData.aiAlert = 3.5;
        e.userData.aiThink = 0;
        e.userData.aiOffsetAngle = Math.atan2(state.player.position.x - e.position.x, state.player.position.z - e.position.z);
        e.userData.aiOffsetRadius = 2.5;
      }
      playGameSound(e.userData.boss ? 'hit' : 'hit', e.userData.boss ? 'boss' : 'hit', e.userData.boss ? 1.7 : (crit ? 1.25 : 1));
      logDamage(e, finalDmg, crit);
      showDamageNumber(e, finalDmg, crit);
      e.userData.labelDirty = true;
      const baseScale = e.userData.baseScale || new THREE.Vector3(e.userData.boss ? (e.userData.bossScale || 2) : 1, e.userData.boss ? (e.userData.bossScale || 2) : 1, e.userData.boss ? (e.userData.bossScale || 2) : 1);
      const hitScale = e.userData.boss ? 1.045 : 1.12;
      e.scale.copy(baseScale).multiplyScalar(hitScale);
      const hitToken = (e.userData._hitScaleToken || 0) + 1; e.userData._hitScaleToken = hitToken;
      spawnEffect('hit', e.position.clone().add(new THREE.Vector3(0, 1, 0)), e.userData.boss ? 0xff3344 : 0xffc857);
      setTimeout(() => {if (e.parent && e.userData._hitScaleToken === hitToken && e.userData.alive !== false) e.scale.copy(e.userData.baseScale || baseScale)}, 80);
      if (e.userData.hp <= 0) {
        e.userData.alive = false; e.visible = false; e.userData.removeAt = performance.now() + 900; resetMonsterRegionOnKill(e.userData.type);
        // 非 Boss 怪物擊殺後立即在死亡原地補回同種類怪物；Boss 仍維持原本單隻生成機制。
        scheduleMonsterRespawn(e);
        const gainedXp = e.userData.stats?.exp || monsterTypes[e.userData.type].exp || 0;
        const gainedGold = e.userData.elite ? (30 + Math.floor(Math.random() * 45)) : (10 + Math.floor(Math.random() * 18));
        state.kills++; if (e.userData.elite) state.eliteKills++; state.xp += gainedXp; state.gold += gainedGold;
        addCombatLog('☠️ 擊殺 ' + e.userData.name + (e.userData.elite ? ' ⭐精英' : '') + ' 　+' + gainedXp + ' EXP 　+' + gainedGold + ' 金幣', 'sys');
        spawnDrop(e.position, monsterTypes[e.userData.type].drop, !!e.userData.elite, e.userData.level, !!e.userData.boss);
        let leveled = 0;
        const oldLevel = state.level;
        while (state.level < 100 && state.xp >= xpToNext()) {state.xp -= xpToNext(); state.level++; leveled++}
        if (state.level >= 100) {state.level = 100; state.xp = 0}
        if (leveled > 0) {const gained = addLevelStatPoints(oldLevel, state.level); state.hp = getMaxHP(); state.mp = getMaxMP(); state.sp = getMaxSP(); playLevelUpSound(); spawnLevelUpEffect(state.player.position.clone(), leveled, gained); toast('🎉 升級！ Lv.' + state.level + '　全恢復 HP/MP/SP　+' + gained + ' 配點')}
        updateUI(); saveGame(); if (!leveled) toast('擊敗 ' + e.userData.name + '，獲得戰利品')
      }
    }
    function basicAttack() {
      if (state.attackCd > 0) return;
      const ranged = (state.classId === 'mage' || state.classId === 'priest');
      const e = nearestEnemy(ranged ? 22 : 4.0); if (!e) {toast('附近沒有目標'); return }
      state.autoTarget = e; updateTargetPanel();
      const c = classes[state.classId];
      state.player.rotation.y = Math.atan2(e.position.x - state.player.position.x, e.position.z - state.player.position.z);
      state._soundSkill = null;
      if (state.classId === 'mage') {
        // 法師普攻：遠距離魔法彈，命中時依暴擊率產生暴擊。
        const from = state.player.position.clone().add(new THREE.Vector3(0, 1.35, .65).applyAxisAngle(new THREE.Vector3(0, 1, 0), state.player.rotation.y));
        const to = e.position.clone().add(new THREE.Vector3(0, 1.05, 0));
        startAttack('slash'); spawnSkillPath('magicbolt', from, to, 0x75baff);
        try {playWeaponSound('basic');} catch (_) { }
        const crit = rollCritical(); const ma = getMagicAttack(); const dmg = ma + 6 + (crit ? Math.round(ma * .8) : 0);
        setTimeout(() => {if (e.userData?.alive) {spawnEffect('magic', to, crit ? 0xffe66a : 0x72bfff); hit(e, dmg, crit); if (crit) toast('✨ 魔法彈暴擊！ ' + dmg + ' 傷害')} }, 360);
      } else if (state.classId === 'priest') {
        // 聖職者普攻：遠距神聖光環，怪物腳下出現垂直光柱。
        const to = e.position.clone();
        startAttack('slash'); spawnEffect('holypillar', to, 0xffef9a);
        try {playWeaponSound('basic');} catch (_) { }
        const crit = rollCritical();
        const pd = getMagicAttack() + 7 + (crit ? Math.round(getMagicAttack() * .55) : 0);
        setTimeout(() => {if (e.userData?.alive) {hit(e, pd, crit, 'magic'); spawnEffect('holy', to.clone().add(new THREE.Vector3(0, .1, 0)), crit ? 0xffe36b : 0xfff4b0)} }, 260);
      } else {
        startAttack('slash'); spawnEffect('slash', e.position.clone().add(new THREE.Vector3(0, 1, 0)), 0xffe39a);
        try {playWeaponSound('basic');} catch (_) { }
        const crit = rollCritical();
        const ad = getAttack() + 8 + (crit ? Math.round(getAttack() * .45) : 0);
        hit(e, ad, crit);
      }
      state.attackCd = getBasicAttackInterval();
    }
    function buffVisualConfig(id) {
      const cfg = {
        berserker_wind: {color: 0xff4b32, secondary: 0xffc04a, shape: 'flame', label: '狂戰'},
        shadow_will: {color: 0x9b5cff, secondary: 0x4b2a8f, shape: 'shadow', label: '影意'},
        mana_will: {color: 0x45b9ff, secondary: 0x9de8ff, shape: 'arcane', label: '魔力'},
        war_god_aura: {color: 0xffc84d, secondary: 0xfff1a0, shape: 'martial', label: '武神'},
        divine_domain: {color: 0xffe66d, secondary: 0x9dffdf, shape: 'holy', label: '神域'},
        magic_sword: {color: 0x7ee8ff, secondary: 0x5a83ff, shape: 'magicSword', label: '魔紋'},
        shield: {color: 0x5fc8ff, secondary: 0x9fe8ff, shape: 'shield', label: '護盾'},
        magic_shield: {color: 0x9a7cff, secondary: 0xd5c8ff, shape: 'magicShield', label: '魔盾'},
        wing_of_light: {color: 0xfff1a0, secondary: 0xffffff, shape: 'wings', label: '天翼'},
        holy_body: {color: 0xffdf72, secondary: 0xffffff, shape: 'holyBody', label: '聖護'}
      };
      return cfg[id] || {color: 0xffe58a, secondary: 0xffffff, shape: 'holy', label: 'Buff'};
    }
    function removeBuffVisual(id) {
      const v = state.buffVisuals?.[id];
      if (v) {if (v.group?.parent) v.group.parent.remove(v.group); delete state.buffVisuals[id];}
    }
    function createBuffVisual(id) {
      if (!state.player) return;
      const sk = getSkill(state.classId, id);
      if (!sk || sk.type !== 'buff') return;
      removeBuffVisual(id);
      const cfg = buffVisualConfig(id);
      const group = new THREE.Group();
      group.name = 'BuffGroundRune_' + id;
      group.position.set(0, .025, 0);
      group.renderOrder = 1200;
      const main = new THREE.MeshBasicMaterial({color: cfg.color, transparent: true, opacity: .78, depthWrite: false, side: THREE.DoubleSide, blending: THREE.AdditiveBlending});
      const sec = new THREE.MeshBasicMaterial({color: cfg.secondary, transparent: true, opacity: .55, depthWrite: false, side: THREE.DoubleSide, blending: THREE.AdditiveBlending});
      const outer = new THREE.Mesh(new THREE.TorusGeometry(1.05, .045, 8, 48), main); outer.rotation.x = Math.PI / 2; group.add(outer);
      const mid = new THREE.Mesh(new THREE.TorusGeometry(.72, .026, 6, 36), sec); mid.rotation.x = Math.PI / 2; group.add(mid);
      const inner = new THREE.Mesh(new THREE.TorusGeometry(.34, .018, 6, 28), main); inner.rotation.x = Math.PI / 2; group.add(inner);
      // 8 條放射刻紋，依職業 Buff 顏色呈現。
      for (let i = 0; i < 8; i++) {
        const a = i * Math.PI / 4;
        const line = new THREE.Mesh(new THREE.BoxGeometry(.035, .018, .48), i % 2 ? sec : main);
        line.position.set(Math.cos(a) * .63, .015, Math.sin(a) * .63); line.rotation.y = -a; group.add(line);
      }
      // 四個小型符文節點，讓 Buff 啟動時更容易辨認。
      for (let i = 0; i < 4; i++) {
        const a = i * Math.PI / 2 + Math.PI / 4;
        const node = new THREE.Mesh(new THREE.OctahedronGeometry(.055, 0), sec);
        node.position.set(Math.cos(a) * .88, .045, Math.sin(a) * .88); group.add(node);
      }
      const light = new THREE.PointLight(cfg.color, 1.8, 3.4); light.position.y = .25; group.add(light);
      group.userData = {buffId: id, phase: Math.random() * Math.PI * 2, baseScale: 1};
      state.player.add(group);
      state.buffVisuals[id] = {group, light, phase: group.userData.phase, color: cfg.color, secondary: cfg.secondary};
    }
    function updateBuffVisuals(dt) {
      if (!state.player) return;
      const now = performance.now();
      for (const id of Object.keys(state.buffVisuals || {})) {
        const b = state.buffs?.[id];
        if (!b || Number(b.until) <= now) {removeBuffVisual(id); continue}
        const v = state.buffVisuals[id];
        if (!v?.group) continue;
        const t = now * .001 + (v.phase || 0);
        const pulse = .92 + Math.sin(t * 3.1) * .10;
        v.group.scale.setScalar(pulse);
        v.group.rotation.y = t * .42;
        v.group.position.y = .025 + Math.sin(t * 2.1) * .006;
        if (v.light) v.light.intensity = 1.25 + Math.sin(t * 4.0) * .55;
        v.group.children.forEach((o, i) => {if (o.material && 'opacity' in o.material) o.material.opacity = (i === 0 ? .62 : .42) + Math.max(0, Math.sin(t * 2.7 + i * .4)) * .18;});
      }
      // 舊存檔／熱更新情況：已有 Buff 但沒有視覺時補建。
      for (const id of Object.keys(state.buffs || {})) {
        if (Number(state.buffs[id]?.until) > now && !state.buffVisuals?.[id]) createBuffVisual(id);
      }
    }
    function addBuff(skill) {
      const until = performance.now() + 300000;
      const mult = getSkillAbilityMultiplier(skill.id, state.classId);
      const scaled = {}; for (const [k, v] of Object.entries(skill.buff || {})) scaled[k] = Number(v) * mult;
      state.buffs[skill.id] = {...scaled, until, name: skill.name, skillLevel: getSkillProgress(skill.id).level};
      createBuffVisual(skill.id);
      skillToast('✨ ' + skill.name + '：Buff 啟動（' + skillProgressText(skill.id) + '）');
    }
    function skillNameGlowColor(sk) {
      const map = {
        'thunder': 0x75d9ff, 'chain_lightning': 0xffe36b, 'meteor': 0xff6b35, 'blizzard': 0x8fdcff,
        'wind': 0x9dffcf, 'windblade': 0x9dffcf, 'fireball': 0xff6b35, 'fire': 0xff6b35,
        'heal': 0x8dff9a, 'recovery': 0x8dff9a, 'great_heal': 0x7dffb5, 'holy_cross': 0xffe36b,
        'divine_area': 0xfff1a8, 'magic_sword': 0xd8a7ff, 'shield': 0x73c9ff, 'magic_shield': 0x9b8cff,
        'angel_wing': 0xffffff, 'holy_body': 0xffd98a, 'combo': 0xff9b5b
      };
      if (sk?.id && map[sk.id] != null) return map[sk.id];
      const byType = {buff: 0xcaa8ff, heal: 0x8dff9a, healArea: 0xfff1a8, crossArea: 0xffe36b, area: 0x75d9ff, magic: 0xb9e8ff, ranged: 0x8fdcff, combo: 0xff9b5b, physical: 0xffa45b};
      return byType[sk?.type] ?? 0xffffff;
    }
    function spawnSkillNamePopup(skill) {
      if (!state.player || !skill?.name) return;
      const color = skillNameGlowColor(skill);
      const c = document.createElement('canvas'); c.width = 900; c.height = 180;
      const ctx = c.getContext('2d'); ctx.clearRect(0, 0, c.width, c.height);
      const hex = '#' + color.toString(16).padStart(6, '0');
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.font = '900 84px Microsoft JhengHei, sans-serif';
      ctx.shadowColor = hex; ctx.shadowBlur = 22; ctx.lineWidth = 5; ctx.strokeStyle = 'rgba(255,255,255,.92)'; ctx.strokeText(skill.name, 450, 86);
      ctx.shadowColor = hex; ctx.shadowBlur = 28; ctx.fillStyle = '#ffffff'; ctx.fillText(skill.name, 450, 86);
      ctx.shadowBlur = 12; ctx.fillStyle = hex; ctx.fillText(skill.name, 450, 86);
      const tex = new THREE.CanvasTexture(c); tex.needsUpdate = true;
      const sp = new THREE.Sprite(new THREE.SpriteMaterial({map: tex, transparent: true, depthWrite: false, depthTest: false, blending: THREE.AdditiveBlending}));
      sp.scale.set(5.05, 1.02, 1); sp.position.set(0, 4.65, 0);
      const g = new THREE.Group(); g.position.copy(state.player.position); g.add(sp);
      const ring = mesh(new THREE.TorusGeometry(.48, .025, 6, 24), new THREE.MeshBasicMaterial({color, transparent: true, opacity: .7, depthWrite: false, blending: THREE.AdditiveBlending}));
      ring.rotation.x = Math.PI / 2; ring.position.y = 4.05; g.add(ring);
      const light = new THREE.PointLight(color, 2.6, 6); light.position.y = 4.12; g.add(light);
      scene.add(g);
      state.effects.push({g, type: 'skillName', t: 0, life: .68, sp, ring, light, color});
    }
    function spawnSkillLevelUpEffect(skill, level) {
      if (!state.player || !skill) return;
      // 技能升級：以「藍色光柱」呈現，並在角色上方短暫顯示技能名稱。
      const color = 0x42a5ff;
      const g = new THREE.Group(); g.position.copy(state.player.position); scene.add(g);

      // 向上的藍色光柱
      const beamMat = new THREE.MeshBasicMaterial({color, transparent: true, opacity: .58, depthWrite: false, depthTest: false, blending: THREE.AdditiveBlending, side: THREE.DoubleSide});
      const beam = mesh(new THREE.CylinderGeometry(.28, .7, 4.6, 24, 1, true), beamMat);
      beam.position.y = 2.3; g.add(beam);

      // 光柱核心
      const coreMat = new THREE.MeshBasicMaterial({color: 0xbfe8ff, transparent: true, opacity: .8, depthWrite: false, depthTest: false, blending: THREE.AdditiveBlending});
      const core = mesh(new THREE.CylinderGeometry(.08, .16, 4.9, 12, 1, true), coreMat);
      core.position.y = 2.35; g.add(core);

      // 腳下藍色光環
      const ring = mesh(new THREE.TorusGeometry(.72, .075, 12, 48), new THREE.MeshBasicMaterial({color, transparent: true, opacity: .95, depthWrite: false, blending: THREE.AdditiveBlending}));
      ring.rotation.x = Math.PI / 2; ring.position.y = .05; g.add(ring);
      const ring2 = mesh(new THREE.TorusGeometry(1.05, .035, 10, 48), new THREE.MeshBasicMaterial({color: 0xbfe8ff, transparent: true, opacity: .8, depthWrite: false, blending: THREE.AdditiveBlending}));
      ring2.rotation.x = Math.PI / 2; ring2.position.y = .08; g.add(ring2);

      const light = new THREE.PointLight(color, 6, 11); light.position.y = 2.2; g.add(light);

      // 藍色粒子沿光柱向上升
      for (let i = 0; i < 34; i++) {
        const q = mesh(new THREE.SphereGeometry(.025 + Math.random() * .06, 6, 6), new THREE.MeshBasicMaterial({color: i % 4 === 0 ? 0xffffff : color, transparent: true, opacity: .95, depthWrite: false, blending: THREE.AdditiveBlending}));
        const a = Math.random() * Math.PI * 2, r = .15 + Math.random() * .65;
        q.position.set(Math.cos(a) * r, .15 + Math.random() * 3.7, Math.sin(a) * r);
        q.userData.v = new THREE.Vector3(Math.cos(a) * (.12 + Math.random() * .35), 1.1 + Math.random() * 1.8, Math.sin(a) * (.12 + Math.random() * .35));
        g.add(q);
      }

      const c = document.createElement('canvas'); c.width = 900; c.height = 190; const ctx = c.getContext('2d');
      const hex = '#42a5ff'; ctx.clearRect(0, 0, c.width, c.height); ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.font = '900 58px Microsoft JhengHei, sans-serif'; ctx.shadowColor = hex; ctx.shadowBlur = 32; ctx.lineWidth = 5; ctx.strokeStyle = 'rgba(255,255,255,.95)'; ctx.strokeText('技能升級', 450, 58); ctx.shadowBlur = 30; ctx.fillStyle = '#fff'; ctx.fillText('技能升級', 450, 58);
      ctx.font = '900 50px Microsoft JhengHei, sans-serif'; ctx.shadowBlur = 28; ctx.fillStyle = hex; ctx.fillText(skill.name, 450, 122);
      const tex = new THREE.CanvasTexture(c); tex.needsUpdate = true; const sp = new THREE.Sprite(new THREE.SpriteMaterial({map: tex, transparent: true, depthWrite: false, depthTest: false, blending: THREE.AdditiveBlending}));
      sp.scale.set(4.5, .95, 1); sp.position.y = 4.65; g.add(sp);
      state.effects.push({g, type: 'skillLevelUp', t: 0, life: 1.45, sp, ring, ring2, beam, core, light});
    }

    function spawnSkillBurst(pos, kind = 'magic', power = 1) {
      const palette = {warrior: [0xff6b35, 0xffc857], thief: [0x9b59ff, 0x3b1f70], mage: [0x4aa8ff, 0xb9e8ff], monk: [0xffb52e, 0xffe07a], priest: [0xffe36b, 0xffffff], novice: [0xffd27a, 0xffffff]};
      let [c1, c2] = palette[state.classId] || palette.novice;
      // 爆烈突刺：獨立的橙紅爆炸效果，不沿用盜賊原本紫色技能特效。
      if (kind === 'burst_thrust') {c1 = 0xff3b0a; c2 = 0xffb300;}
      const g = new THREE.Group(); g.position.copy(pos); scene.add(g);
      const ring = mesh(new THREE.TorusGeometry(.45, .055, 8, 28), new THREE.MeshBasicMaterial({color: c1, transparent: true, opacity: .95, depthWrite: false})); ring.rotation.x = Math.PI / 2; g.add(ring);
      const ring2 = mesh(new THREE.TorusGeometry(.72, .035, 8, 28), new THREE.MeshBasicMaterial({color: c2, transparent: true, opacity: .72, depthWrite: false})); ring2.rotation.x = Math.PI / 2; g.add(ring2);
      const core = mesh(new THREE.SphereGeometry(.16, 10, 8), new THREE.MeshBasicMaterial({color: c2, transparent: true, opacity: .95, depthWrite: false})); g.add(core);
      const light = new THREE.PointLight(c1, 2.2, 7); light.position.y = .8; g.add(light);
      if (kind === 'burst_thrust') {
        const shock = mesh(new THREE.RingGeometry(.18, 1.15, 32), new THREE.MeshBasicMaterial({color: 0xff5a00, transparent: true, opacity: .92, side: THREE.DoubleSide, depthWrite: false, blending: THREE.AdditiveBlending}));
        shock.rotation.x = -Math.PI / 2; shock.position.y = .06; g.add(shock);
        const shock2 = mesh(new THREE.TorusGeometry(.62, .10, 8, 28), new THREE.MeshBasicMaterial({color: 0xffd21a, transparent: true, opacity: .95, depthWrite: false, blending: THREE.AdditiveBlending}));
        shock2.rotation.x = Math.PI / 2; shock2.position.y = .18; g.add(shock2);
        for (let i = 0; i < 12; i++) {
          const a = i * Math.PI * 2 / 12, r = .35 + Math.random() * .35;
          const flame = mesh(new THREE.ConeGeometry(.06 + Math.random() * .05, .32 + Math.random() * .35, 6), new THREE.MeshBasicMaterial({color: i % 2 ? 0xff3b0a : 0xffb300, transparent: true, opacity: .95, depthWrite: false, blending: THREE.AdditiveBlending}));
          flame.position.set(Math.cos(a) * r, .15 + Math.random() * .35, Math.sin(a) * r);
          flame.rotation.z = (Math.random() - .5) * .8; flame.rotation.x = (Math.random() - .5) * .8; g.add(flame);
        }
      }
      const n = kind === 'holy' ? 24 : 16;
      for (let i = 0; i < n; i++) {
        const q = mesh(new THREE.SphereGeometry(.025 + Math.random() * .045, 6, 6), new THREE.MeshBasicMaterial({color: i % 2 ? c1 : c2, transparent: true, opacity: .9, depthWrite: false}));
        const a = Math.random() * Math.PI * 2, r = .25 + Math.random() * .65; q.position.set(Math.cos(a) * r, .08 + Math.random() * .55, Math.sin(a) * r);
        q.userData.v = new THREE.Vector3(Math.cos(a) * (1.2 + Math.random() * 2.2) * power, .6 + Math.random() * 1.8, Math.sin(a) * (1.2 + Math.random() * 2.2) * power); g.add(q);
      }
      state.effects.push({g, type: 'skillBurst', t: 0, life: .75, power});
    }
    function spawnHolyCrossZone(pos) {
      const g = new THREE.Group(); g.position.copy(pos); scene.add(g);
      // 不是「一條十字架」：以光暈、散射、放射光束與漂浮粒子構成聖光領域。
      const halo = mesh(new THREE.CircleGeometry(9.8, 64), new THREE.MeshBasicMaterial({color: 0xfff6bd, transparent: true, opacity: .16, side: THREE.DoubleSide, depthWrite: false, blending: THREE.AdditiveBlending}));
      halo.rotation.x = -Math.PI / 2; halo.position.y = .035; g.add(halo);
      const halo2 = mesh(new THREE.RingGeometry(2.0, 8.8, 64), new THREE.MeshBasicMaterial({color: 0xffffff, transparent: true, opacity: .18, side: THREE.DoubleSide, depthWrite: false, blending: THREE.AdditiveBlending}));
      halo2.rotation.x = -Math.PI / 2; halo2.position.y = .055; g.add(halo2);
      for (let i = 0; i < 3; i++) {
        const r = mesh(new THREE.TorusGeometry(2.2 + i * 2.35, .045 + i * .018, 8, 72), new THREE.MeshBasicMaterial({color: i === 1 ? 0xffffff : 0xffdf63, transparent: true, opacity: .45 - i * .07, depthWrite: false, blending: THREE.AdditiveBlending}));
        r.rotation.x = Math.PI / 2; r.position.y = .08 + i * .018; g.add(r);
      }
      // 柔和的十字光影，只作「光路」而非實心十字。
      for (const horizontal of [true, false]) {
        const beam = mesh(new THREE.BoxGeometry(horizontal ? 19.5 : .22, .035, horizontal ? .22 : 19.5), new THREE.MeshBasicMaterial({color: 0xffffff, transparent: true, opacity: .16, depthWrite: false, blending: THREE.AdditiveBlending}));
        beam.position.y = .11; g.add(beam);
      }
      // 中央聖光柱 + 強烈炫光核心。
      const core = mesh(new THREE.SphereGeometry(.75, 20, 16), new THREE.MeshBasicMaterial({color: 0xffffff, transparent: true, opacity: .9, depthWrite: false, blending: THREE.AdditiveBlending})); core.position.y = .7; core.userData.holyCore = true; g.add(core);
      const coreGlow = mesh(new THREE.SphereGeometry(1.45, 20, 16), new THREE.MeshBasicMaterial({color: 0xffe36b, transparent: true, opacity: .2, depthWrite: false, blending: THREE.AdditiveBlending})); coreGlow.position.y = .62; coreGlow.userData.holyCoreGlow = true; g.add(coreGlow);
      const light = new THREE.PointLight(0xffeaa0, 8.5, 34); light.position.y = 1.6; g.add(light);
      // 放射光束：旋轉、淡入淡出，讓畫面呈現「神聖爆發」而非十字圖案。
      const rays = new THREE.Group(); g.add(rays);
      for (let i = 0; i < 20; i++) {
        const len = 2.5 + Math.random() * 8.5;
        const ray = mesh(new THREE.BoxGeometry(.025 + Math.random() * .045, .025 + Math.random() * .045, len), new THREE.MeshBasicMaterial({color: i % 4 === 0 ? 0xffd94a : 0xffffff, transparent: true, opacity: .18 + Math.random() * .32, depthWrite: false, blending: THREE.AdditiveBlending}));
        const a = i / 20 * Math.PI * 2 + (Math.random() - .5) * .12; ray.rotation.y = a; ray.position.y = .22 + Math.random() * .55; ray.userData.rayAngle = a; ray.userData.rayBase = ray.material.opacity; rays.add(ray);
      }
      // 大量散射粒子向外飛散。
      const scatter = new THREE.Group(); g.add(scatter);
      for (let i = 0; i < 96; i++) {
        const q = mesh(new THREE.SphereGeometry(.018 + Math.random() * .055, 6, 6), new THREE.MeshBasicMaterial({color: i % 5 === 0 ? 0xffd94a : (i % 2 ? 0xffffff : 0xfff3a8), transparent: true, opacity: .72 + Math.random() * .28, depthWrite: false, blending: THREE.AdditiveBlending}));
        const a = Math.random() * Math.PI * 2, r = .4 + Math.random() * 7.8; q.position.set(Math.cos(a) * r, .12 + Math.random() * 1.6, Math.sin(a) * r);
        q.userData.crossV = new THREE.Vector3(Math.cos(a) * (1.0 + Math.random() * 2.4), .2 + Math.random() * 1.7, Math.sin(a) * (1.0 + Math.random() * 2.4));
        q.userData.crossPhase = Math.random() * Math.PI * 2; scatter.add(q);
      }
      // 空間中的星芒閃光點。
      for (let i = 0; i < 18; i++) {
        const star = mesh(new THREE.OctahedronGeometry(.08 + Math.random() * .07), new THREE.MeshBasicMaterial({color: i % 3 ? 0xffffff : 0xffd84a, transparent: true, opacity: .85, depthWrite: false, blending: THREE.AdditiveBlending}));
        const a = Math.random() * Math.PI * 2, r = 1.2 + Math.random() * 8; star.position.set(Math.cos(a) * r, .35 + Math.random() * 2.5, Math.sin(a) * r); star.userData.holyStar = true; star.userData.phase = Math.random() * Math.PI * 2; g.add(star);
      }
      state.effects.push({g, type: 'holyCross', t: 0, life: 10, baseScale: 1});
    }

    function spawnMageThunder(pos) {
      const g = new THREE.Group(); g.position.copy(pos); scene.add(g);
      const glow = mesh(new THREE.SphereGeometry(.45, 16, 12), new THREE.MeshBasicMaterial({color: 0xd9b6ff, transparent: true, opacity: .42, depthWrite: false, blending: THREE.AdditiveBlending})); glow.position.y = .2; glow.userData.persistentSkillVisual = true; g.add(glow);
      const flash = mesh(new THREE.SphereGeometry(.9, 16, 12), new THREE.MeshBasicMaterial({color: 0xffe9a8, transparent: true, opacity: .16, depthWrite: false, blending: THREE.AdditiveBlending})); flash.position.y = .25; flash.userData.persistentSkillVisual = true; g.add(flash);
      const branches = [];
      for (let n = 0; n < 5; n++) {
        const pts = []; const topY = 8 + Math.random() * 3; const seg = 7;
        for (let i = 0; i <= seg; i++) {
          const t = i / seg;
          pts.push(new THREE.Vector3((Math.random() - .5) * .9 * (1 - t), topY * (1 - t) + 1.0, (Math.random() - .5) * .9 * (1 - t)));
        }
        const geo = new THREE.BufferGeometry().setFromPoints(pts);
        const bolt = new THREE.Line(geo, new THREE.LineBasicMaterial({color: n % 2 ? 0xffd84a : 0xb56cff, transparent: true, opacity: .92, linewidth: 2, blending: THREE.AdditiveBlending}));
        bolt.userData.thunderBolt = true; bolt.userData.baseY = topY; g.add(bolt); branches.push(bolt);
      }
      for (let i = 0; i < 14; i++) {
        const q = mesh(new THREE.SphereGeometry(.025 + Math.random() * .045, 6, 6), new THREE.MeshBasicMaterial({color: i % 2 ? 0xffdc55 : 0xcfa0ff, transparent: true, opacity: .9, depthWrite: false, blending: THREE.AdditiveBlending})); q.userData.persistentSkillVisual = true;
        const a = Math.random() * Math.PI * 2, r = .3 + Math.random() * 1.1; q.position.set(Math.cos(a) * r, .2 + Math.random() * .5, Math.sin(a) * r); q.userData.v = new THREE.Vector3((Math.random() - .5) * 1.2, .5 + Math.random() * 1.2, (Math.random() - .5) * 1.2); g.add(q);
      }
      const light = new THREE.PointLight(0xffdf7a, 6, 13); light.position.y = 1.0; g.add(light);
      state.effects.push({g, type: 'mageThunder', t: 0, life: .62, bolts: branches});
    }
    function spawnChainLightning(targets, origin = null) {
      const valid = targets.filter(Boolean).filter(e => e.userData?.alive);
      if (!valid.length) return;
      const g = new THREE.Group(); scene.add(g);
      const source = origin || valid[0].position.clone().add(new THREE.Vector3(0, 1.05, 0));
      const links = []; let prev = source;
      for (const e of valid) {const next = e.position.clone().add(new THREE.Vector3(0, 1.05, 0)); links.push([prev, next]); prev = next;}
      for (let i = 0; i < links.length; i++) {
        const [a, b] = links[i], pts = [], seg = 8;
        for (let n = 0; n <= seg; n++) {
          const t = n / seg, p = a.clone().lerp(b, t);
          if (n > 0 && n < seg) {p.x += (Math.random() - .5) * .75; p.y += (Math.random() - .5) * .55; p.z += (Math.random() - .5) * .75;}
          pts.push(p);
        }
        const geo = new THREE.BufferGeometry().setFromPoints(pts);
        const mainColor = i % 2 === 0 ? 0xffe04b : 0x4aa8ff;
        const bolt = new THREE.Line(geo, new THREE.LineBasicMaterial({color: mainColor, transparent: true, opacity: .98, blending: THREE.AdditiveBlending}));
        bolt.userData.chainBolt = true; g.add(bolt);
        const glow = new THREE.Line(geo, new THREE.LineBasicMaterial({color: 0xffffff, transparent: true, opacity: .72, blending: THREE.AdditiveBlending}));
        glow.scale.setScalar(1.8); g.add(glow);
      }
      for (const e of valid) {
        const flash = mesh(new THREE.SphereGeometry(.16, 10, 8), new THREE.MeshBasicMaterial({color: 0xfff2a0, transparent: true, opacity: .95, blending: THREE.AdditiveBlending, depthWrite: false}));
        flash.position.copy(e.position).add(new THREE.Vector3(0, 1.05, 0)); g.add(flash);
      }
      const core = mesh(new THREE.SphereGeometry(.20, 12, 8), new THREE.MeshBasicMaterial({color: 0xffffff, transparent: true, opacity: .9, blending: THREE.AdditiveBlending, depthWrite: false}));
      core.position.copy(source); g.add(core);
      const light = new THREE.PointLight(0x8fc8ff, 7, 16); light.position.copy(source); g.add(light);
      state.effects.push({g, type: 'chainLightning', t: 0, life: .78});
    }
    function spawnMeteorRain(pos) {
      const g = new THREE.Group(); g.position.copy(pos); scene.add(g);
      const ground = mesh(new THREE.RingGeometry(.7, 4.9, 48), new THREE.MeshBasicMaterial({color: 0xff7a22, transparent: true, opacity: .22, side: THREE.DoubleSide, depthWrite: false, blending: THREE.AdditiveBlending})); ground.rotation.x = Math.PI / 2; ground.position.y = .04; g.add(ground);
      const light = new THREE.PointLight(0xff6a1a, 3.5, 11); light.position.y = 1; g.add(light);
      const rocks = [];
      for (let i = 0; i < 12; i++) {
        const rock = mesh(new THREE.IcosahedronGeometry(.18 + Math.random() * .22, 1), new THREE.MeshStandardMaterial({color: 0x5a382b, emissive: 0xff4b16, emissiveIntensity: 2.4, roughness: .9}));
        const a = Math.random() * Math.PI * 2, r = .8 + Math.random() * 4.3; rock.position.set(Math.cos(a) * r, 7 + Math.random() * 5, Math.sin(a) * r); rock.rotation.set(Math.random() * 3, Math.random() * 3, Math.random() * 3);
        const flame = mesh(new THREE.SphereGeometry(.28 + Math.random() * .12, 8, 8), new THREE.MeshBasicMaterial({color: 0xff8a24, transparent: true, opacity: .72, depthWrite: false, blending: THREE.AdditiveBlending})); flame.position.y = -.2; rock.add(flame);
        rock.userData.v = new THREE.Vector3(-rock.position.x * .035, -6.2 - Math.random() * 3.8, -rock.position.z * .035); rock.userData.spin = new THREE.Vector3((Math.random() - .5) * 6, (Math.random() - .5) * 6, (Math.random() - .5) * 6); rock.userData.meteorFlame = flame; g.add(rock); rocks.push(rock);
      }
      state.effects.push({g, type: 'meteorRain', t: 0, life: 10.0, rocks});
    }
    function spawnBlizzard(pos) {
      const g = new THREE.Group(); g.position.copy(pos); scene.add(g);
      const halo = mesh(new THREE.RingGeometry(1, 6, 48), new THREE.MeshBasicMaterial({color: 0xbcecff, transparent: true, opacity: .14, side: THREE.DoubleSide, depthWrite: false, blending: THREE.AdditiveBlending})); halo.rotation.x = Math.PI / 2; halo.position.y = .05; g.add(halo);
      const flakes = [];
      for (let i = 0; i < 130; i++) {
        const q = mesh(new THREE.SphereGeometry(.018 + Math.random() * .035, 5, 5), new THREE.MeshBasicMaterial({color: i % 4 ? 0xffffff : 0xb9eaff, transparent: true, opacity: .75 + Math.random() * .25, depthWrite: false, blending: THREE.AdditiveBlending}));
        q.position.set((Math.random() - .5) * 12, 1 + Math.random() * 9, (Math.random() - .5) * 12); q.userData.v = new THREE.Vector3((Math.random() - .5) * 1.1, -4.5 - Math.random() * 4, (Math.random() - .5) * 1.1); q.userData.phase = Math.random() * Math.PI * 2; g.add(q); flakes.push(q);
      }
      const light = new THREE.PointLight(0xbdeaff, 2.5, 13); light.position.y = 3; g.add(light);
      state.effects.push({g, type: 'blizzard', t: 0, life: 10.0, flakes});
    }
    function castAreaSkill(skill, e) {
      const pos = e ? e.position.clone() : state.player.position.clone();
      const cross = skill.type === 'crossArea';
      state.areaSkills.push({skillId: skill.id, x: pos.x, z: pos.z, radius: skill.radius, width: skill.width || 3, duration: skill.duration, remaining: skill.duration, tick: 0, shape: cross ? 'cross' : 'circle'});
      if (cross) spawnHolyCrossZone(pos);
      else if (skill.id === 'meteor') spawnMeteorRain(pos);
      else if (skill.id === 'blizzard') spawnBlizzard(pos);
      else spawnEffect('holy', pos.clone().add(new THREE.Vector3(0, .15, 0)), 0xa9d8ff);
      addCombatLog('✨ ' + skill.name + '：範圍持續 ' + skill.duration + ' 秒', 'skill');
    }
    function updateBuffs() {
      let changed = false;
      for (const [id, b] of Object.entries(state.buffs || {})) {
        if (Number(b.until) <= performance.now()) {delete state.buffs[id]; removeBuffVisual(id); changed = true}
      }
      if (changed) {renderBuffPanel(); updateUI(); saveGame()}
    }
    function formatBuffTime(ms) {
      const sec = Math.max(0, Math.ceil(ms / 1000));
      const min = Math.floor(sec / 60), rem = sec % 60;
      return min + ':' + String(rem).padStart(2, '0');
    }
    function renderBuffPanel() {
      const panel = document.getElementById('buffPanel');
      const detail = document.getElementById('buffDetail');
      if (!panel) return;
      const entries = Object.entries(state.buffs || {}).filter(([id, b]) => Number(b?.until) > performance.now());
      panel.innerHTML = '';
      if (detail) detail.style.display = 'none';
      for (const [id, b] of entries) {
        const sk = getSkill(state.classId, id);
        const d = document.createElement('button');
        d.type = 'button';
        d.className = 'buffIcon';
        d.title = (sk?.name || b?.name || id) + '｜剩餘 ' + formatBuffTime(Number(b.until) - performance.now());
        d.innerHTML = (sk?.id && skillIconArt(sk) ? '<img src="' + skillIconArt(sk) + '" alt="" style="width:28px;height:28px;object-fit:cover;border-radius:5px;display:block">' : '<span class="buffEmoji">' + (sk?.icon || '✨') + '</span>') + '<span class="buffTime">' + formatBuffTime(Number(b.until) - performance.now()) + '</span>';
        d.onclick = () => showBuffDetail(id);
        panel.appendChild(d);
      }
    }
    function showBuffDetail(id) {
      const b = state.buffs?.[id];
      const sk = getSkill(state.classId, id);
      const detail = document.getElementById('buffDetail');
      if (!detail || !b) return;
      const remain = Math.max(0, Number(b.until) - performance.now());
      const name = sk?.name || b?.name || id;
      const icon = sk?.icon || '✨';
      const desc = sk?.desc || '目前增益效果';
      detail.dataset.buffId = id; const art = sk ? skillIconArt(sk) : ''; detail.innerHTML = '<div class="buffDetailTitle">' + (art ? '<img src="' + art + '" style="width:28px;height:28px;object-fit:cover;border-radius:5px;vertical-align:middle;margin-right:5px">' : icon) + ' ' + name + '</div><div class="buffDetailTime">⏱ 剩餘 ' + formatBuffTime(remain) + '</div><div class="buffDetailDesc">' + desc + '</div>';
      detail.style.display = 'block';
      clearTimeout(detail._hideTimer);
      detail._hideTimer = setTimeout(() => {detail.style.display = 'none'}, 4500);
    }
    function refreshBuffPanel() {
      const panel = document.getElementById('buffPanel');
      if (!panel) return;
      const entries = Object.entries(state.buffs || {}).filter(([id, b]) => Number(b?.until) > performance.now());
      if (entries.length !== panel.children.length) {renderBuffPanel(); return }
      [...panel.children].forEach((el, i) => {
        const b = entries[i]?.[1];
        if (!b) return;
        const t = formatBuffTime(Number(b.until) - performance.now());
        const timeEl = el.querySelector('.buffTime');
        if (timeEl) timeEl.textContent = t;
        el.title = (getSkill(state.classId, entries[i][0])?.name || b?.name || entries[i][0]) + '｜剩餘 ' + t;
      });
      const detail = document.getElementById('buffDetail');
      if (detail && detail.style.display !== 'none' && detail.dataset.buffId) {
        const b = state.buffs[detail.dataset.buffId];
        if (b) {
          const sk = getSkill(state.classId, detail.dataset.buffId);
          detail.querySelector('.buffDetailTime').textContent = '⏱ 剩餘 ' + formatBuffTime(Number(b.until) - performance.now());
        }
      }
    }
    function updateAreaSkills(dt) {
      // 範圍技能不是只鎖定施放當下的怪物；技能存在期間，每一個傷害 tick 都重新掃描目前場上的所有怪物。
      // 因此怪物後來才走進範圍、原本離開後又重新進入，都會受到傷害。
      for (const a of state.areaSkills) {
        a.remaining -= dt; a.tick -= dt;
        if (a.tick <= 0) {
          // 0.35 秒一跳，讓移動中的怪物也能即時被範圍判定。
          a.tick = .35;
          const sk = getSkill(state.classId, a.skillId);
          if (!sk) continue;
          if (sk.type === 'healArea') {
            if (state.player.position.x >= a.x - sk.radius && state.player.position.x <= a.x + sk.radius && state.player.position.z >= a.z - sk.radius && state.player.position.z <= a.z + sk.radius) {
              const heal = Math.round(getMaxHP() * .04 * getSkillAbilityMultiplier(sk.id, state.classId)); state.hp = Math.min(getMaxHP(), state.hp + heal); if (Math.random() < .55) spawnHealBeam(state.player.position.clone(), getSkillAbilityMultiplier(sk.id, state.classId));
            }
          } else {
            // 每個 tick 重新檢查所有存活怪物，而不是只檢查施放時的目標。
            for (const e of state.enemies) {
              if (!e?.userData?.alive) continue;
              const dx = Math.abs(e.position.x - a.x), dz = Math.abs(e.position.z - a.z);
              const inside = a.shape === 'cross'
                ? ((dx <= a.radius && dz <= a.width * .5) || (dz <= a.radius && dx <= a.width * .5))
                : Math.hypot(dx, dz) <= a.radius;
              if (inside) {
                const crit = rollCritical();
                const baseDmg = getMagicAttack() * (sk.power || 1) * getSkillAbilityMultiplier(sk.id, state.classId);
                hit(e, baseDmg + (crit ? Math.round(baseDmg * .45) : 0), crit, 'magic');
                // 讓靠近範圍中的怪物有明確的受擊光效。
                if (Math.random() < .55) spawnEffect('holy', e.position.clone().add(new THREE.Vector3(0, 1, 0)), crit ? 0xffe36b : (sk.element === 'holy' ? 0xffe36b : 0x8fd8ff));
              }
            }
          }
        }
      }
      state.areaSkills = state.areaSkills.filter(a => a.remaining > 0);
    }
    function isSingleTargetAttackSkill(sk) {
      if (!sk) return false;
      return ['attack', 'physical', 'magic', 'ranged', 'combo'].includes(sk.type);
    }
    function isMeleeSPSkill(sk) {
      if (!sk) return false;
      // 所有 Buff 一律消耗 MP；只有真正的近戰攻擊技使用 SP。
      if (sk.type === 'buff') return false;
      if (state.classId === 'warrior') return ['attack', 'physical', 'combo'].includes(sk.type);
      if (state.classId === 'thief') return ['attack', 'physical', 'combo'].includes(sk.type);
      if (state.classId === 'monk') return ['attack', 'physical', 'combo'].includes(sk.type);
      return false;
    }
    function getSkillCostType(sk) {return isMeleeSPSkill(sk) ? 'SP' : 'MP';}
    function getSkillCost(sk) {
      if (isSingleTargetAttackSkill(sk)) return 5;
      if (sk.type === 'buff') return 12;
      if (sk.type === 'heal' || sk.type === 'healArea') return 18;
      return 25;
    }
    function getSkillMpCost(sk) {return getSkillCost(sk);}
    function getAutoSelectedAttackSkills() {
      return getLearnedSkills()
        .filter(sk => isSingleTargetAttackSkill(sk) || ['area', 'crossArea'].includes(sk.type))
        .filter(sk => state.autoSkillSelection?.[sk.id] !== false);
    }
    function skillUseMessage(sk, progress) {
      if (!sk || !progress) return '';
      if (progress.levelUp) return '🌟 技能升級：' + sk.name;
      return '';
    }

    // ============================================================================
    // 分身斬 V3：簡化版
    // 左右各生成一個「角色外型黑色影子」，向目標衝刺並造成 3 連斬。
    // 整個技能效果固定 3 秒，結束後影子自動消失。
    // ============================================================================
    function createSimpleCloneShadow(side, target) {
      if (!state.player || !target) return null;

      // 不再 clone 真正玩家模型，避免 SkinnedMesh / 材質 clone 導致影子不可見。
      // 直接建立一個簡單、一定可見的「黑色角色剪影」。
      const ghost = new THREE.Group();
      ghost.userData.simpleClone = true;
      ghost.userData.side = side;

      const shadowMat = new THREE.MeshBasicMaterial({
        color: 0x050308,
        transparent: true,
        opacity: .96,
        depthWrite: false,
        depthTest: false,
        side: THREE.DoubleSide
      });
      const purpleMat = new THREE.MeshBasicMaterial({
        color: 0x5f1590,
        transparent: true,
        opacity: .72,
        depthWrite: false,
        depthTest: false,
        side: THREE.DoubleSide,
        blending: THREE.AdditiveBlending
      });

      // 頭、身體、手臂、腿：簡單人形即可。
      const head = mesh(new THREE.SphereGeometry(.30, 12, 10), shadowMat.clone());
      head.position.y = 2.08; ghost.add(head);
      const body = mesh(new THREE.CapsuleGeometry(.34, .72, 6, 10), shadowMat.clone());
      body.position.y = 1.28; ghost.add(body);
      const armL = mesh(new THREE.CapsuleGeometry(.105, .58, 5, 8), shadowMat.clone());
      armL.position.set(-.43, 1.38, 0); armL.rotation.z = .28; ghost.add(armL);
      const armR = mesh(new THREE.CapsuleGeometry(.105, .58, 5, 8), shadowMat.clone());
      armR.position.set(.43, 1.38, 0); armR.rotation.z = -.28; ghost.add(armR);
      const legL = mesh(new THREE.CapsuleGeometry(.13, .70, 5, 8), shadowMat.clone());
      legL.position.set(-.18, .62, 0); ghost.add(legL);
      const legR = mesh(new THREE.CapsuleGeometry(.13, .70, 5, 8), shadowMat.clone());
      legR.position.set(.18, .62, 0); ghost.add(legR);

      // 手持一把短黑影劍，讓攻擊方向更容易看懂。
      const sword = mesh(new THREE.BoxGeometry(.09, .09, 1.55), purpleMat.clone());
      sword.position.set(.47, 1.25, .38); sword.rotation.x = -.45; sword.rotation.z = -.35;
      ghost.add(sword);

      // 紫黑外框光暈。
      const aura = mesh(new THREE.SphereGeometry(.72, 12, 10), purpleMat.clone());
      aura.scale.set(.72, 1.55, .48); aura.position.y = 1.2; ghost.add(aura);

      ghost.traverse(o => {o.frustumCulled = false; o.renderOrder = 1501; o.visible = true;});
      ghost.renderOrder = 1500;

      const forward = new THREE.Vector3(
        Math.sin(state.player.rotation.y), 0, Math.cos(state.player.rotation.y)
      );
      const right = new THREE.Vector3(forward.z, 0, -forward.x);
      const start = state.player.position.clone()
        .add(right.clone().multiplyScalar(side * 1.15))
        .add(forward.clone().multiplyScalar(.15));
      ghost.position.copy(start);
      ghost.rotation.y = state.player.rotation.y;
      ghost.userData.start = start.clone();
      ghost.userData.target = target;
      ghost.userData.attackStart = start.clone();
      ghost.userData.attackSide = side;
      scene.add(ghost);
      return ghost;
    }

    function spawnSimpleCloneSlash(target, hitIndex) {
      if (!target) return null;
      const g = new THREE.Group();
      const center = target.position.clone().add(new THREE.Vector3(0, 1.15, 0));
      g.position.copy(center);
      g.renderOrder = 1800;

      // 簡單但非常明顯的三連紫黑斬擊：每次都會出現 3 條刀光。
      const mats = [0x12051c, 0x6d20a8, 0xb75cff];
      for (let i = 0; i < 3; i++) {
        const blade = mesh(new THREE.BoxGeometry(.10, .16, 2.8 + i * .25), new THREE.MeshBasicMaterial({
          color: mats[i], transparent: true, opacity: .98,
          depthWrite: false, depthTest: false, side: THREE.DoubleSide,
          blending: THREE.AdditiveBlending
        }));
        blade.rotation.z = (-.65 + i * .32);
        blade.rotation.y = (i - 1) * .28;
        blade.position.set((i - 1) * .18, .05, (i - 1) * .10);
        g.add(blade);
      }

      const flash = mesh(new THREE.RingGeometry(.32, .72, 24), new THREE.MeshBasicMaterial({
        color: 0x8f2ce0, transparent: true, opacity: .9,
        depthWrite: false, depthTest: false, side: THREE.DoubleSide,
        blending: THREE.AdditiveBlending
      }));
      flash.rotation.x = Math.PI / 2;
      g.add(flash);

      const light = new THREE.PointLight(0x8f2ce0, 3.5, 5);
      light.position.y = .4; g.add(light);
      scene.add(g);
      state.effects.push({g, type: 'simpleCloneSlash', t: 0, life: .32, flash, light, hitIndex});
      return g;
    }

    function startSimpleCloneSlash(target, skill) {
      if (!target?.userData?.alive) return;

      const duration = 3.0;
      const left = createSimpleCloneShadow(-1, target);
      const right = createSimpleCloneShadow(1, target);
      const ghosts = [left, right].filter(Boolean);

      // 快速三連斬：0.35 / 0.95 / 1.55 秒。
      const strikeTimes = [350, 950, 1550];
      strikeTimes.forEach((delay, index) => {
        setTimeout(() => {
          // 即使怪物在中途死亡，也保留斬擊特效；只有存活目標才實際扣血。
          if (!target?.userData?.alive) {
            spawnSimpleCloneSlash(target, index);
            return;
          }
          spawnSimpleCloneSlash(target, index);
          const base = getAttack();
          const crit = rollCritical();
          hit(target,
            base * skill.power * getSkillAbilityMultiplier(skill.id, state.classId) +
            (crit ? base * .35 * getSkillAbilityMultiplier(skill.id, state.classId) : 0),
            crit, 'physical');
          spawnEffect('slash', target.position.clone().add(new THREE.Vector3(0, 1.1, 0)), 0x8e2bd1);
        }, delay);
      });

      // 0~1 秒：影子從左右衝向怪物；1~2.35 秒停在怪物旁攻擊；2.35~3 秒淡出。
      state.effects.push({
        g: new THREE.Group(), type: 'simpleCloneController', t: 0, life: duration, ghosts, target
      });
    }

    function useSkill(skillId) {
      const sk = getSkill(state.classId, skillId);
      if (!sk) {toast('尚未學會此技能'); return false}
      const cd = Math.max(0, Number(state.skillCds?.[skillId] || 0));
      if (cd > 0) {toast(sk.name + ' 冷卻中 ' + cd.toFixed(1) + ' 秒'); return false}
      const cost = getSkillCost(sk), costType = getSkillCostType(sk);
      if ((costType === 'SP' ? state.sp : state.mp) < cost) {toast(costType + ' 不足'); return false}
      const ranged = ['mage', 'priest'].includes(state.classId) || sk.type === 'magic' || sk.type === 'ranged' || sk.type === 'area';
      // 遠程技能保留 20 的正常攻擊距離，並給予少量移動誤差容許，避免怪物移動造成卡住。
      let e = nearestEnemy(ranged ? 21.5 : 7);
      if ((sk.type === 'area' || sk.type === 'crossArea' || sk.type === 'ranged' || sk.type === 'magic' || sk.type === 'physical' || sk.type === 'combo') && !e) {toast('沒有技能目標'); return false}
      (costType === 'SP' ? state.sp -= cost : state.mp -= cost); state.skillCds[skillId] = sk.id === 'clone_slash' ? 3 : ((sk.type === 'buff' || sk.type === 'area' || sk.type === 'crossArea' || sk.type === 'healArea') ? 10 : 1); state._soundSkill = sk; const skillProgress = recordSkillUse(sk); playWeaponSound('skill'); spawnSkillNamePopup(sk);
      if (sk.type === 'buff') {
        addBuff(sk); spawnEffect('holy', state.player.position.clone().add(new THREE.Vector3(0, .15, 0)), 0xffe58a); if (skillProgress?.levelUp) spawnSkillLevelUpEffect(sk, skillProgress.level); skillToast(skillUseMessage(sk, skillProgress)); updateUI(); saveGame(); return true;
      }
      if (sk.type === 'heal') {
        spawnSkillBurst(state.player.position.clone().add(new THREE.Vector3(0, .25, 0)), 'holy', 1.1);
        const heal = Math.round(getMaxHP() * .20 * getSkillAbilityMultiplier(sk.id, state.classId)); state.hp = Math.min(getMaxHP(), state.hp + heal); spawnHealBeam(state.player.position.clone()); if (skillProgress?.levelUp) spawnSkillLevelUpEffect(sk, skillProgress.level); skillToast(skillUseMessage(sk, skillProgress) + ' · 恢復 ' + heal + ' HP'); updateUI(); saveGame(); return true;
      }
      if (sk.type === 'healArea') {
        spawnSkillBurst(state.player.position.clone().add(new THREE.Vector3(0, .2, 0)), 'holy', 1.2);
        spawnHealBeam(state.player.position.clone(), getSkillAbilityMultiplier(sk.id, state.classId));
        castAreaSkill(sk, state.player); if (skillProgress?.levelUp) spawnSkillLevelUpEffect(sk, skillProgress.level); skillToast(skillUseMessage(sk, skillProgress)); updateUI(); saveGame(); return true;
      }
      if ((sk.type === 'area' || sk.type === 'crossArea') && sk.id !== 'chain_lightning') {
        if (!e) {toast('沒有技能目標'); return false}
        spawnSkillBurst(e.position.clone().add(new THREE.Vector3(0, .35, 0)), sk.type === 'crossArea' ? 'holy' : 'magic', 1.35); castAreaSkill(sk, e); state.autoTarget = e; updateTargetPanel(); updateUI(); saveGame(); return true;
      }
      if (!e) {toast('沒有技能目標'); return false}
      state.autoTarget = e; state.player.rotation.y = Math.atan2(e.position.x - state.player.position.x, e.position.z - state.player.position.z);
      const isMagic = ['mage', 'priest'].includes(state.classId) || sk.type === 'magic';
      const base = isMagic ? getMagicAttack() : getAttack();
      spawnSkillBurst(e.position.clone().add(new THREE.Vector3(0, 1, 0)), isMagic ? 'magic' : 'attack', 1.15);
      if (sk.type === 'combo') {
        if (sk.id === 'clone_slash') {
          // 分身斬不使用一般 combo 的瞬間攻擊，改由 3 秒分身演出控制三次命中。
          startSimpleCloneSlash(e, sk);
        } else {
          for (let n = 0; n < sk.hits; n++) {
            setTimeout(() => {if (e.userData?.alive) {const crit = rollCritical(); hit(e, base * sk.power * getSkillAbilityMultiplier(sk.id, state.classId) + (crit ? base * .35 * getSkillAbilityMultiplier(sk.id, state.classId) : 0), crit, isMagic ? 'magic' : 'physical'); spawnEffect('slash', e.position.clone().add(new THREE.Vector3(0, 1, 0)), 0xffd77a)} }, n * 170);
          }
        }
      } else {
        const crit = rollCritical();
        if (sk.type === 'ranged' || isMagic) {
          const from = state.player.position.clone().add(new THREE.Vector3(0, 1.3, .65).applyAxisAngle(new THREE.Vector3(0, 1, 0), state.player.rotation.y));
          const to = e.position.clone().add(new THREE.Vector3(0, 1, 0));
          if (sk.id === 'thunder') {
            spawnMageThunder(e.position.clone());
            setTimeout(() => {if (e.userData?.alive) hit(e, base * sk.power * getSkillAbilityMultiplier(sk.id, state.classId) + (crit ? base * .55 * getSkillAbilityMultiplier(sk.id, state.classId) : 0), crit, 'magic')}, 260);
          } else if (sk.id === 'chain_lightning') {
            // 15×15 範圍技：範圍內所有怪物都會被黃色＋藍色雷電命中。
            const halfW = (Number(sk.areaWidth) || 15) / 2;
            const halfD = (Number(sk.areaDepth) || 15) / 2;
            const center = state.player.position;
            const areaTargets = state.enemies.filter(cand => {
              if (!cand?.userData?.alive) return false;
              const dx = Math.abs(cand.position.x - center.x), dz = Math.abs(cand.position.z - center.z);
              return dx <= halfW && dz <= halfD;
            });
            if (e?.userData?.alive && !areaTargets.includes(e)) areaTargets.unshift(e);
            if (!areaTargets.length) return false;
            areaTargets.sort((a, b) => center.distanceTo(a.position) - center.distanceTo(b.position));
            spawnChainLightning(areaTargets, center.clone().add(new THREE.Vector3(0, 1.2, 0)));
            areaTargets.forEach((target, i) => setTimeout(() => {
              if (target?.userData?.alive) {
                const chainPower = sk.power * Math.pow(.92, Math.min(i, 8));
                const chainCrit = i === 0 && crit;
                hit(target, base * chainPower * getSkillAbilityMultiplier(sk.id, state.classId) + (chainCrit ? base * .55 * getSkillAbilityMultiplier(sk.id, state.classId) : 0), chainCrit, 'magic');
              }
            }, 120 + i * 55));
          } else {
            spawnSkillPath('magicbolt', from, to, isMagic ? 0x75baff : 0xffd15c);
            setTimeout(() => {if (e.userData?.alive) hit(e, base * sk.power * getSkillAbilityMultiplier(sk.id, state.classId) + (crit ? base * .45 * getSkillAbilityMultiplier(sk.id, state.classId) : 0), crit, isMagic ? 'magic' : 'physical')}, 300);
          }
        } else {
          startAttack('slash');
          if (sk.id === 'burst_thrust') {
            spawnSkillBurst(e.position.clone().add(new THREE.Vector3(0, .35, 0)), 'burst_thrust', 1.45);
            spawnEffect('shockwave', e.position.clone().add(new THREE.Vector3(0, .08, 0)), 0xff4a0a);
          } else {
            spawnSkillBurst(e.position.clone().add(new THREE.Vector3(0, 1, 0)), sk.element === 'fire' ? 'attack' : 'attack', 1.0);
            spawnEffect('slash', e.position.clone().add(new THREE.Vector3(0, 1, 0)), sk.element === 'fire' ? 0xff6b35 : 0xe8d1ff);
          }
          hit(e, base * sk.power * getSkillAbilityMultiplier(sk.id, state.classId) + (crit ? base * .45 * getSkillAbilityMultiplier(sk.id, state.classId) : 0), crit, 'physical');
        }
      }
      if (skillProgress?.levelUp) spawnSkillLevelUpEffect(sk, skillProgress.level); skillToast(skillUseMessage(sk, skillProgress)); updateUI(); saveGame(); return true;
    }
    function classSkill() {
      const learned = getLearnedSkills();
      if (!learned.length) {toast('📖 尚未學會職業技能，請打怪取得技能書'); return false}
      return useSkill(learned[0].id);
    }
    function getConsumable(id, name, icon, potion) {let p = state.inventory.find(x => x.id === id); if (!p) {p = {id, name, icon, qty: 0, type: 'consumable', potion}; state.inventory.push(p)} p.qty = Math.max(0, Math.min(999, Number(p.qty) || 0)); return p}
    function addConsumable(id, name, icon, potion, qty = 1) {const p = getConsumable(id, name, icon, potion); p.qty = Math.min(999, p.qty + Math.max(1, qty)); return p}
    function normalizeConsumables() {state.inventory = (Array.isArray(state.inventory) ? state.inventory : []).map(normalizeItemRecord).filter(Boolean); const hp = state.inventory.filter(x => x && x.type === 'consumable' && (x.id === 'potion' || x.potion === 'hp')).reduce((n, x) => n + (Number(x.qty) || 0), 0); const mp = state.inventory.filter(x => x && x.type === 'consumable' && (x.id === 'mp_potion' || x.potion === 'mp')).reduce((n, x) => n + (Number(x.qty) || 0), 0); const sp = state.inventory.filter(x => x && x.type === 'consumable' && (x.id === 'sp_potion' || x.potion === 'sp')).reduce((n, x) => n + (Number(x.qty) || 0), 0); state.inventory = state.inventory.filter(x => x && !(x.type === 'consumable' && (x.id === 'potion' || x.id === 'mp_potion' || x.id === 'sp_potion' || x.potion === 'hp' || x.potion === 'mp' || x.potion === 'sp'))); state.inventory.unshift({id: 'potion', name: 'HP藥水', icon: HP_POTION_ICON_SRC, qty: Math.min(999, Math.max(0, hp)), type: 'consumable', potion: 'hp'}); state.inventory.splice(1, 0, {id: 'mp_potion', name: 'MP藥水', icon: MP_POTION_ICON_SRC, qty: Math.min(999, Math.max(0, mp)), type: 'consumable', potion: 'mp'}); state.inventory.splice(2, 0, {id: 'sp_potion', name: 'SP藥水', icon: SP_POTION_ICON_SRC, qty: Math.min(999, Math.max(0, sp)), type: 'consumable', potion: 'sp'});}
    function usePotion() {const p = getConsumable('potion', 'HP藥水', HP_POTION_ICON_SRC, 'hp'); if (p.qty <= 0) {toast('沒有HP藥水'); return } p.qty--; const max = getMaxHP(); state.hp = Math.min(max, state.hp + 45); updateUI(); saveGame(); toast('🧪 使用HP藥水 +45 HP')}
    function useMpPotion() {const p = getConsumable('mp_potion', 'MP藥水', MP_POTION_ICON_SRC, 'mp'); if (p.qty <= 0) {toast('沒有 MP藥水'); return } p.qty--; const max = getMaxMP(); state.mp = Math.min(max, state.mp + 55); updateUI(); saveGame(); toast('🔵 使用 MP藥水 +55 MP')}
    function useSpPotion() {const p = getConsumable('sp_potion', 'SP藥水', SP_POTION_ICON_SRC, 'sp'); if (p.qty <= 0) {toast('沒有 SP藥水'); return } p.qty--; const max = getMaxSP(); state.sp = Math.min(max, state.sp + 35); updateUI(); saveGame(); toast('🟡 使用 SP藥水 +35 SP')}
    function updateAutoBattleButtons() {const on = !!state.auto; document.getElementById('autoBtn')?.classList.toggle('active', on); document.getElementById('autoBtnMobile')?.classList.toggle('active', on); const d = document.getElementById('autoBtn'); if (d) d.textContent = on ? '🤖 自動戰鬥 ON' : '🤖 自動戰鬥'; const m = document.getElementById('autoBtnMobile'); if (m) m.innerHTML = (on ? '⏹️' : '🤖') + '<span>' + (on ? '停止自動' : '自動戰鬥') + '</span>';}
    function toggleAuto() {if (state.dead) {skillToast('💀 死亡中，請回主城復活'); return } state.auto = !state.auto; state.potionCd = 0; if (!state.auto) {state.autoTarget = null; state.autoRoamTarget = null; state.autoAnchorX = null; state.autoAnchorZ = null; state.autoSkillCursor = 0} else {state.autoTarget = null; state.autoRoamTarget = null; state.autoSearchCd = 0; state.autoSkillCursor = 0; state.autoSkillCursor = 0; state.autoAnchorX = state.player?.position?.x ?? 0; state.autoAnchorZ = state.player?.position?.z ?? 0} saveGame(); updateAutoBattleButtons(); updateUI(); skillToast(state.auto ? '⚔ 自動戰鬥 ON：Lv.' + state.autoMinLevel + '～' + state.autoMaxLevel + ' · 範圍 ' + state.autoRangeMeters + 'm' : '⏹ 自動戰鬥 OFF')}
    function setAutoLevelRange(min, max) {min = Math.max(1, Math.min(100, Number(min) || 1)); max = Math.max(1, Math.min(100, Number(max) || 100)); if (min > max) [min, max] = [max, min]; state.autoMinLevel = min; state.autoMaxLevel = max; state.autoTarget = null; state.autoRoamTarget = null; saveGame(); toast('🎯 自動戰鬥目標：Lv.' + min + '～' + max); openModal('auto')}
    function autoDetourMove(target, step, radius = .48) {
      if (!state.player || !target) return false;
      const p = state.player.position;
      const dx = target.position.x - p.x, dz = target.position.z - p.z;
      const dist = Math.hypot(dx, dz); if (dist < .001) return true;
      const base = Math.atan2(dx, dz);
      // 固定左右繞行方向，避免每幀左右抖動；必要時才反向。
      let side = Number(state.autoDetourSide) || 0;
      if (!side) side = (Math.floor((performance.now() / 700)) % 2 === 0) ? 1 : -1;
      const offsets = [side * .18, side * .35, side * .55, side * .78, side * 1.05, side * 1.35, -side * .55, -side * .9, 0];
      let best = null, bestScore = -Infinity;
      for (const off of offsets) {
        const ang = base + off;
        const ux = Math.sin(ang), uz = Math.cos(ang);
        const test = Math.min(step, Math.max(.75, dist));
        const nx = p.x + ux * test, nz = p.z + uz * test;
        if (!canEntityMoveTo(nx, nz, radius, true)) continue;
        // 再探一步，確保不是「只前進一格就撞牆」的假路線。
        const look = Math.min(1.6, Math.max(.8, step));
        const nx2 = nx + ux * look, nz2 = nz + uz * look;
        const lookOk = canEntityMoveTo(nx2, nz2, radius, true);
        const remain = Math.hypot(target.position.x - nx, target.position.z - nz);
        const progress = dist - remain;
        let clearance = 0;
        for (const c of state.colliders || []) {
          if (!c) continue;
          const dd = Math.hypot(nx - c.x, nz - c.z) - radius - Math.max(.35, Number(c.r) || .35);
          if (dd < 3) clearance += Math.max(0, dd);
        }
        const score = progress + (lookOk ? 1.5 : -.8) + clearance * .05 - Math.abs(off) * .12;
        if (score > bestScore) {bestScore = score; best = {x: ux * test, z: uz * test, side: off > 0 ? side : -side, lookOk};}
      }
      if (best) {
        state.autoDetourSide = best.side;
        state.autoDetourTime = (state.autoDetourTime || 0) + .08;
        return tryMoveEntity(state.player, best.x, best.z, radius, true);
      }
      state.autoDetourSide = -side;
      return false;
    }
    function updateAutoCombat(dt) {
      if (!state.auto || !state.player || state.dead) return;
      // 自動戰鬥 watchdog：避免目標失效、卡住或換圖後長時間站著。
      state.autoSearchCd = Math.max(0, (state.autoSearchCd || 0) - dt);
      state.autoStuckTime = Math.max(0, (state.autoStuckTime || 0) - dt);
      state.autoLastX = Number.isFinite(state.autoLastX) ? state.autoLastX : state.player.position.x;
      state.autoLastZ = Number.isFinite(state.autoLastZ) ? state.autoLastZ : state.player.position.z;
      state.potionCd = Math.max(0, (state.potionCd || 0) - dt);
      if (state.potionCd <= 0) {
        const hpPct = getMaxHP() > 0 ? state.hp / getMaxHP() * 100 : 100;
        const mpPct = getMaxMP() > 0 ? state.mp / getMaxMP() * 100 : 100;
        const spPct = getMaxSP() > 0 ? state.sp / getMaxSP() * 100 : 100;
        let used = false;
        if (state.autoUseRecoverySkill && hpPct <= state.autoRecoveryThreshold) {
          const learned = getLearnedSkills(); let recovery = null;
          if (state.autoRecoverySkillId && state.autoRecoverySkillId !== 'auto') recovery = learned.find(sk => sk.id === state.autoRecoverySkillId && ['heal', 'healArea'].includes(sk.type));
          if (!recovery) recovery = learned.find(sk => sk.type === 'heal') || learned.find(sk => sk.type === 'healArea');
          if (recovery) {used = useSkill(recovery.id) || false; if (used) addCombatLog('🤖 自動使用回復技能：' + recovery.name, 'sys');}
        }
        if (!used && state.autoUseHpPotion && hpPct <= state.autoHpThreshold) {const p = getConsumable('potion', 'HP藥水', HP_POTION_ICON_SRC, 'hp'); if (p.qty > 0) {usePotion(); used = true; addCombatLog('🤖 自動使用HP藥水', 'sys');} }
        if (!used && state.autoUseMpPotion && mpPct <= state.autoMpThreshold) {const p = getConsumable('mp_potion', 'MP藥水', MP_POTION_ICON_SRC, 'mp'); if (p.qty > 0) {useMpPotion(); used = true; addCombatLog('🤖 自動使用 MP藥水', 'sys');} }
        if (!used && state.autoUseSpPotion && spPct <= state.autoSpThreshold) {const p = getConsumable('sp_potion', 'SP藥水', SP_POTION_ICON_SRC, 'sp'); if (p.qty > 0) {useSpPotion(); used = true; addCombatLog('🤖 自動使用 SP藥水', 'sys');} }
        if (used) state.potionCd = 1.2;
      }
      const zoneRange = zoneData[state.zone]?.range || [1, 100];
      // 掛機範圍以啟動自動戰鬥時的位置為中心，單位為米／世界座標。
      if (!Number.isFinite(Number(state.autoAnchorX)) || !Number.isFinite(Number(state.autoAnchorZ))) {state.autoAnchorX = state.player.position.x; state.autoAnchorZ = state.player.position.z;}
      const anchor = {x: Number(state.autoAnchorX), z: Number(state.autoAnchorZ)};
      const autoRange = Math.max(3, Math.min(200, Number(state.autoRangeMeters) || 15));
      const distanceFromAnchor = obj => Math.hypot(obj.position.x - anchor.x, obj.position.z - anchor.z);
      const validTarget = e => e && state.enemies.includes(e) && e.userData?.alive && (!e.userData.boss) && e.userData.level >= state.autoMinLevel && e.userData.level <= state.autoMaxLevel && distanceFromAnchor(e) <= autoRange + 1.0;
      let e = state.autoTarget;
      if (!state.autoFightBoss && e?.userData?.boss) e = null;
      const mapSearchRange = Math.min(Math.max(8, autoRange + 2), Math.max(8, (zoneData[state.zone]?.size || 200) * .72));
      if (!validTarget(e) || (e.position.distanceTo(state.player.position) > mapSearchRange) || state.autoSearchCd <= 0) {
        // 直接在掛機圓形範圍內排序，避免「最近怪在範圍外」時錯過範圍內另一隻怪。
        const candidates = state.enemies.filter(cand => cand?.userData?.alive && !cand.userData.boss && cand.userData.level >= state.autoMinLevel && cand.userData.level <= state.autoMaxLevel && distanceFromAnchor(cand) <= autoRange + 1.0 && cand.position.distanceTo(state.player.position) <= mapSearchRange);
        candidates.sort((a, b) => a.position.distanceToSquared(state.player.position) - b.position.distanceToSquared(state.player.position));
        e = candidates[0] || null;
        state.autoTarget = e || null;
        state.autoDetourSide = 0; state.autoDetourTime = 0;
        state.autoSearchCd = e?.userData?.boss ? 1.2 : .45;
      }
      // 主城沒有怪物時，自動戰鬥只保持啟動狀態，不自動巡邏。
      // 城內是安全／生活區，避免開啟自動戰鬥後人物無目的地走來走去。
      const hasLivingEnemies = state.enemies.some(enemy => enemy?.userData?.alive);
      if (!e && state.zone === 'city' && !hasLivingEnemies) {
        state.autoRoamTarget = null;
        state.autoRoamTimer = 0;
        state.walkAnim.moving = false;
        state.walkAnim.speed = 0;
        return;
      }
      // 沒有目標時只在掛機半徑內巡邏；離開範圍會回到啟動位置。
      if (!e) {
        state.autoRoamTimer = Math.max(0, (state.autoRoamTimer || 0) - dt);
        const p = state.player.position;
        const anchorDist = Math.hypot(p.x - anchor.x, p.z - anchor.z);
        if (anchorDist > Math.max(1, autoRange * .86)) {
          const dx = anchor.x - p.x, dz = anchor.z - p.z, d = Math.hypot(dx, dz);
          if (d > .7) {
            state.player.rotation.y = Math.atan2(dx, dz);
            const speed = 10.5, step = Math.min(speed * dt, Math.max(0, d - .45));
            const moved = step > 0 && navMoveEntity(state.player, anchor.x, anchor.z, step, .48, true);
            state.walkAnim.moving = !!moved; state.walkAnim.speed = speed;
          } else state.walkAnim.moving = false;
          return;
        }
        if (!state.autoRoamTarget || state.autoRoamTimer <= 0 || Math.hypot(state.autoRoamTarget.x - p.x, state.autoRoamTarget.z - p.z) < 2) {
          let found = null;
          for (let i = 0; i < 24; i++) {
            const a = Math.random() * Math.PI * 2, r = Math.max(1.5, autoRange * .18) + Math.random() * Math.max(1, autoRange * .58);
            const x = anchor.x + Math.cos(a) * r, z = anchor.z + Math.sin(a) * r;
            if (Math.hypot(x - anchor.x, z - anchor.z) > autoRange * .78) continue;
            if (canEntityMoveTo(x, z, .48, true)) {found = {x, z}; break;}
          }
          state.autoRoamTarget = found || {x: anchor.x, z: anchor.z}; state.autoRoamTimer = 5 + Math.random() * 5;
        }
        const dx = state.autoRoamTarget.x - p.x, dz = state.autoRoamTarget.z - p.z, d = Math.hypot(dx, dz);
        if (d > .8) {
          state.player.rotation.y = Math.atan2(dx, dz);
          const speed = 10.5, step = Math.min(speed * dt, Math.max(0, d - .5));
          const moved = step > 0 && navMoveEntity(state.player, state.autoRoamTarget.x, state.autoRoamTarget.z, step, .48, true);
          state.walkAnim.moving = !!moved; state.walkAnim.speed = speed;
        } else state.walkAnim.moving = false;
        return;
      }
      if (distanceFromAnchor(e) > autoRange + 1.0) {state.autoTarget = null; state.autoSearchCd = 0; return;}
      const dx = e.position.x - state.player.position.x, dz = e.position.z - state.player.position.z, dist = Math.hypot(dx, dz);
      const isRanged = !!classes[state.classId]?.ranged;
      // 遠程角色使用較寬的攻擊區間：21.5 格內可攻擊，追怪時則主動靠到約 17.5 格，
      // 避免怪物一移動就反覆前後走動。
      const desiredRange = isRanged ? 17.5 : 3.0;
      if (dist > desiredRange) {
        state.player.rotation.y = Math.atan2(dx, dz);
        // 距離越遠速度越快；遠程角色特別加速，快速進入合適的施法距離。
        let chaseSpeed = e.userData?.boss ? 10.5 : (isRanged ? 13.5 : 9.5);
        if (isRanged && dist > 32) chaseSpeed = 17.5;
        else if (isRanged && dist > 24) chaseSpeed = 15.5;
        if (!isRanged && dist > 14) chaseSpeed = 12.5;
        // 怪物會持續移動，所以每一幀重新計算方向，不追舊座標。
        const ux = dx / Math.max(dist, .001), uz = dz / Math.max(dist, .001);
        const stopBuffer = isRanged ? 17.0 : 2.9;
        const step = Math.min(chaseSpeed * dt, Math.max(0, dist - stopBuffer));
        let movedByNav = false;
        if (step > 0) movedByNav = navMoveEntity(state.player, e.position.x, e.position.z, step, .48, true);
        // 靠近障礙物／不可進區域時，不只原地側移：持續沿障礙物左右繞行，並用前方預判避免撞回原路。
        if (step > 0 && !movedByNav) {
          if (isAutoTargetTerrainBlocked(e)) {
            const blockedTarget = e;
            const next = findAutoAlternativeTarget(blockedTarget);
            state.autoTarget = next || null;
            state.autoSearchCd = 0;
            state.autoStuckTime = 0;
            if (next) {
              state.target = null;
              updateTargetPanel(true);
              addCombatLog('🤖 目標被樹木／地形阻擋，立即切換至：' + (next.userData?.name || '附近怪物'), 'sys');
              toast('🌳 目標被阻擋，已立即換目標');
              e = next;
            }
          }
          if (state.autoTarget === e) movedByNav = autoDetourMove(e, Math.max(step, 1.0), .48);
          state.autoDetourTime = (state.autoDetourTime || 0) + dt;
        } else if (movedByNav) {
          state.autoDetourTime = Math.max(0, (state.autoDetourTime || 0) - dt * 2.2);
        }
        state.walkAnim.moving = true; state.walkAnim.speed = chaseSpeed;
        const moved = Math.hypot(state.player.position.x - state.autoLastX, state.player.position.z - state.autoLastZ);
        if (moved < .012) state.autoStuckTime += dt; else state.autoStuckTime = Math.max(0, state.autoStuckTime - dt * 1.4);
        state.autoLastX = state.player.position.x; state.autoLastZ = state.player.position.z;
        // 真正卡住時持續嘗試左右繞行；若確認目標被地形／不可進區域隔離，就立刻找新的可達目標。
        if (state.autoStuckTime > .32) {
          autoDetourMove(e, Math.max(1.15, chaseSpeed * dt * 1.35), .48);
          if (state.autoStuckTime > .72) {
            const reachable = autoTargetPathExists(e, 75);
            if (!reachable) {
              const oldTarget = e;
              const next = findAutoAlternativeTarget(oldTarget);
              state.autoTarget = next || null;
              state.autoSearchCd = 0;
              state.autoStuckTime = 0;
              if (next) {
                state.target = null;
                updateTargetPanel(true);
                addCombatLog('🤖 目標被地形阻擋，已自動切換至：' + (next.userData?.name || '附近怪物'), 'sys');
                toast('🎯 地形阻擋，已自動換目標');
                e = next;
              } else {
                addCombatLog('🤖 目前目標無法到達，等待重新搜尋可達目標', 'sys');
              }
            } else {
              state.autoStuckTime = .35;
            }
          } else {
            state.autoSearchCd = 0;
          }
        }
        // 遠程怪物如果長時間拉開距離，額外快速拉近一小段，避免永遠追不到。
        if (isRanged && dist > 42) {
          const burst = Math.min(3.2, Math.max(0, dist - 20));
          navMoveEntity(state.player, e.position.x, e.position.z, burst, .48, true);
        }
      } else {
        state.autoStuckTime = 0; state.autoLastX = state.player.position.x; state.autoLastZ = state.player.position.z;
        state.walkAnim.moving = false; state.player.rotation.y = Math.atan2(dx, dz);
        let usedSkill = false;
        const learned = getLearnedSkills();
        let attackSkillConfigured = false;
        let attackSkillAttempted = false;
        let attackSkillCanUse = false;
        if (learned.length) {
          if (state.autoUseBuffSkill) {
            const buffSkill = learned.find(sk => sk.type === 'buff' && state.autoSkillSelection?.[sk.id] !== false && !state.buffs?.[sk.id]);
            if (buffSkill) usedSkill = useSkill(buffSkill.id) || false;
          }
          if (!usedSkill && state.autoUseAttackSkill) {
            const attackSkills = getAutoSelectedAttackSkills();
            attackSkillConfigured = attackSkills.length > 0;
            if (attackSkills.length) {
              // 每個技能有自己的 CD；自動戰鬥不再永遠挑第一個技能。
              // 從上一個技能之後繼續往下輪替，哪個技能先可用就獨立施放哪個。
              const start = Math.max(0, Number(state.autoSkillCursor) || 0) % attackSkills.length;
              let affordableReady = null, readyIndex = -1;
              for (let n = 0; n < attackSkills.length; n++) {
                const idx = (start + n) % attackSkills.length;
                const sk = attackSkills[idx];
                const cost = getSkillCost(sk), costType = getSkillCostType(sk);
                if (Number(state.skillCds?.[sk.id] || 0) <= 0 && (costType === 'SP' ? state.sp : state.mp) >= cost) {
                  affordableReady = sk; readyIndex = idx; break;
                }
              }
              if (affordableReady) {
                attackSkillCanUse = true;
                attackSkillAttempted = true;
                usedSkill = useSkill(affordableReady.id) || false;
                if (usedSkill) state.autoSkillCursor = (readyIndex + 1) % attackSkills.length;
              } else if (attackSkills.some(sk => (getSkillCostType(sk) === 'SP' ? state.sp : state.mp) < getSkillCost(sk))) {
                // 所有可用技能都因 SP／MP 不足時，才退回普攻。
                attackSkillCanUse = false;
              } else {
                // 技能各自都在 CD 時，允許普攻等待下一個獨立技能。
                attackSkillCanUse = true;
              }
            }
          }
        }
        if (usedSkill) state.attackCd = getBasicAttackInterval();
        else if (state.attackCd <= 0) {
          // 攻擊技能冷卻中時，不停手：直接使用普攻補傷害。
          // 只有技能真的成功施放時才跳過這一輪普攻。
          basicAttack();
        }
      }
      if (!e.userData.alive) state.autoTarget = null;
    }
    function createGrave(pos) {
      const g = new THREE.Group(); g.userData.isGrave = true; g.userData.clickable = true;
      const base = mesh(new THREE.CylinderGeometry(.78, .9, .18, 10), mat(0x454a50, .98)); base.position.y = .09;
      const slab = mesh(new THREE.BoxGeometry(1.22, 1.28, .28), mat(0x666b72, .96)); slab.position.set(0, .70, 0); slab.rotation.y = .015;
      const rim = mesh(new THREE.BoxGeometry(1.34, 1.38, .10), mat(0x30343a, .7)); rim.position.set(0, .70, .16);
      const plate = makeLabel('RIP'); plate.position.set(0, .83, .19); plate.scale.set(1.55, .42, 1);
      const bat = new THREE.Group(); bat.position.set(0, 1.82, .08);
      const body = mesh(new THREE.SphereGeometry(.13, 10, 8), mat(0x0b0d12, .98)); body.scale.set(.85, 1.25, .7);
      const head = mesh(new THREE.SphereGeometry(.10, 10, 8), mat(0x0b0d12, .98)); head.position.y = .13; bat.add(body, head);
      for (const side of [-1, 1]) {
        const wing = mesh(new THREE.ConeGeometry(.23, .55, 3), mat(0x090b10, .98)); wing.position.set(side * .28, .02, 0); wing.rotation.z = side > 0 ? -.72 : .72; wing.rotation.x = .08; wing.scale.set(1, .7, .35); bat.add(wing);
        const ear = mesh(new THREE.ConeGeometry(.035, .11, 5), mat(0x090b10, .98)); ear.position.set(side * .055, .23, 0); ear.rotation.z = side * .18; bat.add(ear);
      }
      const eyeMat = new THREE.MeshBasicMaterial({color: 0xe64a4a});
      for (const side of [-1, 1]) {const eye = mesh(new THREE.SphereGeometry(.018, 6, 6), eyeMat); eye.position.set(side * .035, .145, .085); bat.add(eye)}
      g.add(base, slab, rim, plate, bat); g.position.copy(pos); g.position.y = 0; scene.add(g); return g
    }
    function diePlayer(source) {if (state.dead) return; state.dead = true; state.auto = false; state.autoTarget = null; state.target = null; state.player.visible = false; state.walkAnim.moving = false; if (state.grave) {scene.remove(state.grave); state.grave = null} state.grave = createGrave(state.player.position.clone()); document.getElementById('deathOverlay').classList.remove('show'); updateAutoBattleButtons(); toast('💀 ' + (source || '怪物') + ' 擊倒了你：請點擊墓碑選擇回城復活'); saveGame()}
    function returnToTownAndRevive() {if (!state.dead) return; state.dead = false; if (state.grave) {scene.remove(state.grave); state.grave = null} document.getElementById('deathOverlay').classList.remove('show'); state.hp = getMaxHP(); state.mp = getMaxMP(); state.sp = getMaxSP(); state.zone = 'city'; clearWorld(); scene.background = new THREE.Color(zoneData.city.sky); scene.fog = new THREE.Fog(zoneData.city.sky, 55, 190); buildGround(zoneData.city); buildNPCs(); buildPortals(); state.player.visible = true; const safe = getSafeZoneSpawn('city'); state.player.position.set(safe.x, 0, safe.z); updateUI(); saveGame(); toast('🏰 已回到路爾斯城，復活成功')}
    let targetPanelTimer = 0;

    function monsterHudIcon(e) {
      const type = e?.userData?.type || '';
      const map = {slime: '🟢', wolf: '🐺', goblin: '👺', scorpion: '🦂', skeleton: '💀', dragon: '🐉', mushroom: '🍄', bandit: '🏹', sandworm: '🪱', ghost: '👻', golem: '🗿', ram: '🐏', treant: '🌳', fairy: '🧚', imp: '😈', bat: '🦇', icewolf: '🐺', crystalbeast: '💎', lava: '🔥', firebat: '🦇', snowknight: '🧥', snowmage: '🧙', snowwolf: '🐺', beastknight: '🐱', beastmage: '🐱', beastclaw: '🐾', cardSoldier: '🃏', cardKnight: '❤️', cardLancer: '♠️', cardQueen: '👑'};
      return e?.userData?.boss ? '👑' : map[type] || '👾';
    }
    function updateTargetOrb() {
      const orb = document.getElementById('hudTargetOrb'); if (!orb) return;
      const e = (state.target && state.target.userData?.alive) ? state.target : ((state.autoTarget && state.autoTarget.userData?.alive) ? state.autoTarget : null);
      if (!e || !e.userData?.alive) {
        orb.classList.add('empty'); orb.classList.remove('boss', 'elite');
        const icon = document.getElementById('hudTargetIcon'); if (icon) icon.textContent = '🎯';
        const name = document.getElementById('hudTargetName'); if (name) name.textContent = '未鎖定目標';
        const hp = document.getElementById('hudTargetHp'); if (hp) hp.style.width = '0%';
        const meta = document.getElementById('hudTargetMeta'); if (meta) meta.textContent = '-- / --'; return;
      }
      const u = e.userData, hpPct = Math.max(0, Math.min(100, u.hp / u.max * 100));
      orb.classList.remove('empty'); orb.classList.toggle('boss', !!u.boss); orb.classList.toggle('elite', !!u.elite && !u.boss);
      const icon = document.getElementById('hudTargetIcon'); if (icon) icon.textContent = monsterHudIcon(e);
      const name = document.getElementById('hudTargetName'); if (name) name.textContent = 'Lv.' + u.level + ' ' + u.name;
      const hp = document.getElementById('hudTargetHp'); if (hp) hp.style.width = hpPct + '%';
      const meta = document.getElementById('hudTargetMeta'); if (meta) meta.textContent = Math.ceil(Math.max(0, u.hp)) + ' / ' + Math.ceil(u.max);
    }
    function updateTargetPanel(force = false) {
      updateTargetOrb();
      targetPanelTimer -= .016;
      if (!force && targetPanelTimer > 0) return;
      targetPanelTimer = .12;
      const panel = document.getElementById('targetPanel');
      if (!panel) return;
      const e = state.autoTarget && state.autoTarget.userData.alive ? state.autoTarget : null;
      if (!e) {document.getElementById('targetName').textContent = '未鎖定目標'; document.getElementById('targetHpFill').style.width = '0%'; document.getElementById('targetHpFill').style.background = 'linear-gradient(90deg,#b51f32,#ff5d5d)'; document.getElementById('targetHpText').textContent = '-- / --'; return }
      document.getElementById('targetName').textContent = 'Lv.' + e.userData.level + ' ' + e.userData.name;
      const hpPct = Math.max(0, Math.min(100, e.userData.hp / e.userData.max * 100)); document.getElementById('targetHpFill').style.width = hpPct + '%'; document.getElementById('targetHpFill').style.background = e.userData.boss ? (hpPct > 75 ? '#ff8a00' : hpPct > 50 ? '#ffd21a' : hpPct > 25 ? '#48c95a' : '#e53935') : 'linear-gradient(90deg,#b51f32,#ff5d5d)';
      document.getElementById('targetHpText').textContent = Math.max(0, Math.ceil(e.userData.hp)) + ' / ' + e.userData.max;
    }
    // 輕量技能圖示：改用純 SVG 即時繪製，不再嵌入大型 PNG/Base64。
    // 好處：檔案大幅縮小、瀏覽器不用解碼大型圖片，測試啟動不會被圖示載入拖慢。
    const SKILL_ICON_CACHE = Object.create(null);
    const SKILL_ICON_THEME = {
      berserker_wind: ['#42e6a4', '#075c43', 'wind'], flame_slash: ['#ff7a2f', '#8f1600', 'fire'], moon_slash: ['#e7d7ff', '#542a91', 'moon'], moon_combo: ['#d4b7ff', '#45206f', 'combo'],
      shadow_will: ['#8d8aa8', '#161525', 'shadow'], burst_thrust: ['#ffcf72', '#7b3210', 'blade'], clone_slash: ['#bca8ff', '#38206e', 'clone'], clone_combo: ['#d6c8ff', '#25134f', 'clone'],
      mana_will: ['#73e9ff', '#1552a5', 'mana'], recovery: ['#8dffb4', '#167442', 'heal'], wind_blade: ['#8deaff', '#116f91', 'wind'], thunder: ['#f0d6ff', '#6541bd', 'lightning'], chain_lightning: ['#aee9ff', '#2869c7', 'lightning'], meteor: ['#ffb35c', '#7d230b', 'meteor'], blizzard: ['#d5f8ff', '#3c79b0', 'ice'],
      war_god_aura: ['#ffd46e', '#8b4d10', 'aura'], qi_bullet: ['#ffb26d', '#8f3210', 'energy'], multi_combo: ['#ffe08a', '#7d4210', 'fist'], hundred_kick: ['#ffb56b', '#7d2b10', 'kick'],
      divine_domain: ['#fff2a5', '#b18700', 'holy'], holy_cross_judgment: ['#fff4d0', '#a13c3c', 'cross'], magic_sword: ['#b8e7ff', '#2855a0', 'sword'], great_heal: ['#9dffb9', '#168348', 'heal'], shield: ['#a9d9ff', '#2b6295', 'shield'], magic_shield: ['#a8c7ff', '#3f54a8', 'shield'], wing_of_light: ['#fff4cf', '#8e6a2a', 'wing'], holy_body: ['#ffe9a8', '#8c6820', 'cross'], attack: ['#f4f4f4', '#3b4657', 'sword']
    };
    function skillIconArt(sk) {
      const id = typeof sk === 'string' ? sk : (sk?.id || 'attack');
      if (SKILL_ICON_CACHE[id]) return SKILL_ICON_CACHE[id];
      const [a, b, kind] = SKILL_ICON_THEME[id] || ['#d9e2f2', '#38465c', 'spark'];
      let body = '';
      const stroke = 'stroke="' + a + '" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"';
      if (kind === 'fire' || kind === 'meteor') body = '<path d="M32 8 C24 20 38 20 27 33 C19 43 25 55 34 56 C46 56 52 46 47 36 C44 29 37 28 40 16 C34 20 31 15 32 8Z" fill="' + a + '"/><path d="M32 27 C27 35 32 37 30 44 C38 43 41 38 37 32 C35 29 34 28 32 27Z" fill="' + b + '"/>';
      else if (kind === 'wind') body = '<path d="M9 24h34c8 0 10-10 3-12-4-1-7 1-8 4" ' + stroke + ' fill="none"/><path d="M7 34h38c8 0 10 10 3 12-4 1-7-1-8-4" ' + stroke + ' fill="none"/><path d="M15 44h13" ' + stroke + ' fill="none"/>';
      else if (kind === 'moon') body = '<path d="M45 10a22 22 0 1 0 9 39A23 23 0 0 1 45 10Z" fill="' + a + '"/><circle cx="25" cy="23" r="2" fill="' + b + '"/><circle cx="34" cy="34" r="2" fill="' + b + '"/>';
      else if (kind === 'blade' || kind === 'sword') body = '<path d="M15 47L43 13l8 8-28 28z" fill="' + a + '"/><path d="M18 44l-6 8 10-5" fill="' + b + '"/><path d="M36 22l7 7" ' + stroke + ' fill="none"/>';
      else if (kind === 'shadow') body = '<path d="M32 7l8 14 15 4-11 10 3 16-15-7-15 7 3-16-11-10 15-4z" fill="' + b + '" ' + stroke + '/><circle cx="32" cy="31" r="7" fill="' + a + '" opacity=".75"/>';
      else if (kind === 'clone') body = '<path d="M19 16h24v24H19z" fill="none" ' + stroke + ' opacity=".65"/><path d="M27 24h24v24H27z" fill="' + b + '" ' + stroke + '/><path d="M34 31h10M39 26v10" ' + stroke + ' fill="none"/>';
      else if (kind === 'mana' || kind === 'energy' || kind === 'aura' || kind === 'spark') body = '<circle cx="32" cy="32" r="22" fill="' + b + '"/><circle cx="32" cy="32" r="14" fill="' + a + '" opacity=".9"/><path d="M32 16v32M16 32h32" ' + stroke + ' opacity=".75"/>';
      else if (kind === 'heal') body = '<path d="M25 10h14v15h15v14H39v15H25V39H10V25h15z" fill="' + a + '"/><path d="M32 17v30M17 32h30" stroke="' + b + '" stroke-width="4"/>';
      else if (kind === 'lightning') body = '<path d="M37 6L14 35h14l-4 23 25-32H35z" fill="' + a + '"/><path d="M37 6L14 35h14" fill="none" ' + stroke + '/>';
      else if (kind === 'ice') body = '<path d="M32 7v50M10 20l44 24M10 44l44-24M19 13l13 19 13-19M19 51l13-19 13 19" ' + stroke + ' fill="none"/><circle cx="32" cy="32" r="7" fill="' + a + '"/>';
