    let renderer; try {renderer = renderAdapter.createRenderer({antialias: true, powerPreference: 'high-performance'});} catch (err) {const l = document.getElementById('loading'); if (l) {l.innerHTML = '<div class="loadbox"><b>WebGL 無法啟動</b><p style="font-size:13px;color:#ffd6d6">' + String(err && err.message || err).replace(/</g, '&lt;') + '</p></div>'; l.style.display = 'grid'} throw err;}
