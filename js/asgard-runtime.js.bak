    function auditEquipmentSystem() {
      const issues = [];
      const requiredDropKinds = ['armor', 'gloves', 'pants', 'shoes', 'belt', 'helmet', 'weapon', 'ring', 'earring', 'necklace'];
      for (const cls of Object.keys(CLASS_GEAR_TEMPLATES)) {
        for (const kind of requiredDropKinds) {
          if (!CLASS_GEAR_TEMPLATES[cls]?.[kind] && !equipmentVariants[kind]?.length) issues.push(cls + ':' + kind + ' template missing');
        }
      }
      if (!INVENTORY_CATEGORIES.some(x => x.id === 'gloves')) issues.push('gloves inventory category missing');
      if (typeof isTwoHandedWeapon !== 'function') issues.push('two-handed detector missing');
      return issues;
    }

    function classGearTemplate(kind) {const c = CLASS_GEAR_TEMPLATES[state.classId] || CLASS_GEAR_TEMPLATES.novice; return c[kind] || null}

    function validEquipmentDropKinds() {
