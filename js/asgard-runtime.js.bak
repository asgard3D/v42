        const wrap = new THREE.Group(); wrap.userData.classOutfitArmPiece = true;
        const shoulder = mesh(new THREE.CapsuleGeometry(.17, .24, 7, 12), main); shoulder.position.set(0, -.03, .025); shoulder.scale.set(.82, .62, .74); shoulder.userData.classOutfitArmPiece = true; wrap.add(shoulder);
        const sleeve = mesh(new THREE.CapsuleGeometry(.115, .56, 7, 12), dark); sleeve.position.set(0, -.36, .045); sleeve.scale.set(.76, 1.0, .70); sleeve.userData.classOutfitArmPiece = true; wrap.add(sleeve);
        const sleeveMid = mesh(new THREE.CapsuleGeometry(.095, .48, 7, 12), cls === 'priest' ? main : deep); sleeveMid.position.set(0, -.39, .09); sleeveMid.scale.set(.70, 1, .60); sleeveMid.userData.classOutfitArmPiece = true; wrap.add(sleeveMid);
