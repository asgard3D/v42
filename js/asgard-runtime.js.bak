      thief: {torso: .76, shoulder: .72, upperArm: .74, forearm: .76, hand: .85, pelvis: .81, thigh: .84, calf: .82, foot: .86, outfit: .76},
      mage: {torso: .75, shoulder: .71, upperArm: .74, forearm: .75, hand: .84, pelvis: .80, thigh: .83, calf: .81, foot: .85, outfit: .74},
      monk: {torso: .78, shoulder: .75, upperArm: .79, forearm: .79, hand: .87, pelvis: .84, thigh: .87, calf: .85, foot: .89, outfit: .80},
      priest: {torso: .77, shoulder: .73, upperArm: .75, forearm: .77, hand: .86, pelvis: .82, thigh: .85, calf: .83, foot: .87, outfit: .76}
