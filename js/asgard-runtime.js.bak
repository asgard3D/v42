) || 1)); state.autoMaxLevel = Math.max(state.autoMinLevel, Math.min(100, Number(d.autoMaxLevel) || 100)); state.autoRangeMeters = Math.max(3, Math.min(200, Number(d.autoRangeMeters) || 15)); state.autoAnchorX = Number.isFinite(Number(d.autoAnchorX)) ? Number(d.autoAnchorX) : null; state.autoAnchorZ = Number.isFinite(Number(d.autoAnchorZ)) ? Number(d.autoAnchorZ) : null; state.autoUseBuffSkill = d.autoUseBuffSkill !== false; state.autoUseAttackSkill = d.autoUseAttackSkill !== false; state.autoUseSkill = d.autoUseSkill !== false; state.autoSkillSelection = (d.autoSkillSelection && typeof d.autoSkillSelection === 'object') ? d.autoSkillSelection : {}; state.autoUseHpPotion = d.autoUseHpPotion === true; state.autoUseMpPotion = d.autoUseMpPotion === true; state.autoUseSpPotion = d.autoUseSpPotion === true; state.autoSpThreshold = Math.max(10, Math.min(90, Number(d.autoSpThreshold) || 30)); state.autoUseRecoverySkill = d.autoUseRecoverySkill === true; state.autoFightBoss = d.autoFightBoss !== false; state.autoRecoveryThreshold = Math.max(10, Math.min(90, Number(d.autoRecoveryThreshold) || 50)); state.autoRecoverySkillId = String(d.autoRecoverySkillId || 'auto'); state.learnedSkills = {warrior: [], thief: [], mage: [], monk: [], priest: [], ...(d.learnedSkills || {})}; for (const cid of Object.keys(state.learnedSkills)) state.learnedSkills[cid] = (state.learnedSkills[cid] || []).filter(id => !!getSkill(cid, id)); state.skillLevels = {warrior: {}, thief: {}, mage: {}, monk: {}, priest: {}, ...(d.skillLevels || {})}; for (const cid of Object.keys(state.learnedSkills)) {if (!state.skillLevels[cid]) state.skillLevels[cid] = {}; for (const sid of state.learnedSkills[cid]) ensureSkillProgress(cid, sid);}
