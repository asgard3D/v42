    };
    const RARITY_ORDER = {normal: 0, good: 1, rare: 2, epic: 3, legendary: 4};
    // 裝備名稱只顯示本體；階級／特殊系列改以顏色辨識，不再顯示「稀有／史詩／傳說／神聖／惡魔」前綴。
    function equipmentDisplayName(it) {
      return String(it?.name || '裝備').replace(/^(?:精良|稀有|史詩|傳說|神聖|惡魔|天使)[·\s]*/, '');
    }
    function equipmentNameClass(it) {
      if (it?.specialSeries === 'sacred') return 'equip-special-sacred';
      if (it?.specialSeries === 'demon') return 'equip-special-demon';
      if (it?.specialSeries === 'divineBlessing') return 'equip-special-blessed';
      return 'rarity-' + (it?.rarity || 'normal');
    }

    const PICKUP_RARITY_LABELS = {normal: '全部裝備', rare: '稀有以上', epic: '史詩以上', legendary: '傳說以上'};
    function isEquipmentRecord(it) {
      return !!it && it.type !== 'consumable' && it.type !== 'material' && it.type !== 'skillbook' && !!(it.slot || it.type);
    }
    function isAllowedEquipmentLevel(level) {return EQUIPMENT_ALLOWED_LEVELS.includes(Number(level));}
    function equipmentTierAtOrBelow(level) {
      const n = Math.max(1, Number(level) || 1);
      let out = EQUIPMENT_ALLOWED_LEVELS[0];
      for (const lv of EQUIPMENT_ALLOWED_LEVELS) {if (n >= lv) out = lv; else break;}
      return out;
    }
    function equipmentDropLevel(enemyLevel) {
      const z = zoneData[state.zone], base = enemyLevel || z?.range?.[0] || 1;
      return equipmentTierAtOrBelow(base);
    }
    function equipmentMeetsLevelRequirement(it, level = state.level) {
      if (!isEquipmentRecord(it)) return true;
      const req = Number(it.itemLevel);
      return Number.isFinite(req) && isAllowedEquipmentLevel(req) && req <= Number(level || 1);
    }
    function sanitizeEquipmentLevelRules() {
      let removed = 0;
      const inv = [];
      for (const raw of Array.isArray(state.inventory) ? state.inventory : []) {
        const it = normalizeItemRecord(raw);
        if (!it) {continue;}
        if (isEquipmentRecord(it) && (!isAllowedEquipmentLevel(it.itemLevel) || it.visual === 'dualblade' || it.visual === 'greatsword' || String(it.name || '').includes('雙影刃') || String(it.name || '').includes('闊劍'))) {removed++; continue;}
        inv.push(it);
      }
      state.inventory = inv;
      for (const k of EQUIP_SLOTS) {
        const it = state.equip?.[k];
        if (it && isEquipmentRecord(it) && (!isAllowedEquipmentLevel(it.itemLevel) || it.visual === 'dualblade' || it.visual === 'greatsword' || String(it.name || '').includes('雙影刃') || String(it.name || '').includes('闊劍'))) {state.equip[k] = null; removed++;}
      }
      return removed;
    }
    function equipmentTheme(kind) {
      const direct = ZONE_EQUIPMENT_THEME[state.zone];
      const fallback = state.zone?.startsWith('beast') ? ZONE_EQUIPMENT_THEME.beast : state.zone?.startsWith('alice') ? ZONE_EQUIPMENT_THEME.alice : ZONE_EQUIPMENT_THEME.forest;
      const z = direct || fallback || ZONE_EQUIPMENT_THEME.forest;
      const list = z[kind] || ZONE_EQUIPMENT_THEME.forest[kind] || [];
      return list.length ? list[Math.floor(Math.random() * list.length)] : null;
    }
