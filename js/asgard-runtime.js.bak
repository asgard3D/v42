      const accentColor = it.specialSeries === 'sacred' ? 0xfffff2 : it.specialSeries === 'demon' ? 0xff334c : slot === 'weapon' ? quality.accent : cls.accent;
      const mainColor = it.specialSeries === 'sacred' ? 0xfff8df : it.specialSeries === 'demon' ? 0x160b10 : slot === 'weapon' ? quality.main : cls.main;
      const mk = (geo, material, x, y, z, scale = 1) => {const o = mesh(geo, material); o.position.set(x, y, z); o.scale.setScalar(scale); o.userData.equipmentTierVisual = true; g.add(o); return o};
      const metal = mat(mainColor, t.metal, .22), accent = mat(accentColor, .25, .52);
      if (slot === 'armor') {
