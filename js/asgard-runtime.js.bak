        else if (cls.shape === 'shadow') {for (const sx of [-1, 1]) {const horn = mk(new THREE.ConeGeometry(.055, .22, 7), accent, sx * .36, y, -.04); horn.rotation.z = sx * .28} }
        else if (cls.shape === 'arcane') mk(new THREE.OctahedronGeometry(.085), new THREE.MeshBasicMaterial({color: glowColor, transparent: true, opacity: .95, blending: THREE.AdditiveBlending, depthWrite: false}), 0, y, .63)
        else if (cls.shape === 'martial') {const knot = mk(new THREE.SphereGeometry(.085, 9, 7), accent, .55, .25, -.02); knot.scale.set(1, .8, .8)}
