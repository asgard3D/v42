        {id: 'burst_thrust', name: '爆烈突刺', icon: '🗡️', type: 'attack', power: 2.10, desc: '高速爆發突刺'},
        {id: 'clone_slash', name: '分身斬', icon: '👤', type: 'combo', hits: 3, power: 1.15, desc: '左右生成黑色角色影子，三連斬，持續3秒'},
        {id: 'clone_combo', name: '分身連斬', icon: '👥', type: 'combo', hits: 4, power: .78, desc: '分身連續四擊'}
      ],
      mage: [
        {id: 'mana_will', name: '魔力意志', icon: '◉', type: 'buff', desc: '回魔 +50%、魔攻 +25%', buff: {mpRegen: 0.50, matk: 0.25}},
        {id: 'recovery', name: '回復術', icon: '✚', type: 'heal', desc: '回復自身最大 HP 的 20%'},
        {id: 'wind_blade', name: '風刃術', icon: '🌪️', type: 'magic', power: 1.70, desc: '遠距風刃魔法'},
        {id: 'thunder', name: '落雷', icon: '⚡', type: 'magic', power: 2.20, desc: '黃紫色雷電從天空降下'},
        {id: 'chain_lightning', name: '連鎖閃電', icon: '⛓️⚡', type: 'area', power: 1.85, areaWidth: 15, areaDepth: 15, chainCount: 99, chainRadius: 7.5, desc: '黃色＋藍色連鎖閃電，15×15 範圍攻擊'},
        {id: 'meteor', name: '隕石術', icon: '☄️', type: 'area', power: .75, radius: 5, duration: 10, desc: '持續 10 秒降下燃燒隕石'},
        {id: 'blizzard', name: '暴風雪', icon: '❄️', type: 'area', power: .62, radius: 6, duration: 10, desc: '持續範圍冰雪攻擊 10 秒'}
      ],
      monk: [
        {id: 'war_god_aura', name: '武神鬥氣', icon: '🥋', type: 'buff', desc: '物防 +18%、魔防 +18%、物攻 +20%', buff: {def: 0.18, mdef: 0.18, atk: 0.20}},
        {id: 'qi_bullet', name: '氣功彈', icon: '💥', type: 'ranged', power: 1.65, desc: '遠距離氣勁攻擊'},
        {id: 'multi_combo', name: '多重連擊', icon: '👊', type: 'combo', hits: 3, power: .82, desc: '連續三段拳擊'},
        {id: 'hundred_kick', name: '百烈踼', icon: '🦵', type: 'combo', hits: 5, power: .56, desc: '高速連續踢擊'}
      ],
      priest: [
        {id: 'divine_domain', name: '神之領域', icon: '✨', type: 'healArea', radius: 5, duration: 10, desc: '範圍持續回血 10 秒'},
        {id: 'holy_cross_judgment', name: '神聖十字審判', icon: '✝️', type: 'crossArea', radius: 10, width: 3, duration: 10, power: 1.15, element: 'holy', desc: '20×20 十字發光範圍攻擊，持續 10 秒'},
        {id: 'magic_sword', name: '魔紋之劍', icon: '⚔️', type: 'buff', desc: '物攻 +20%、魔攻 +20%', buff: {atk: 0.20, matk: 0.20}},
        {id: 'great_heal', name: '大回復術', icon: '💚', type: 'heal', desc: '單體／自身恢復最大 HP 的 20%'},
        {id: 'shield', name: '護盾術', icon: '🛡️', type: 'buff', desc: '物防 +25%', buff: {def: 0.25}},
        {id: 'magic_shield', name: '魔法護盾', icon: '🔷', type: 'buff', desc: '魔防 +25%', buff: {mdef: 0.25}},
        {id: 'wing_of_light', name: '天翼術', icon: '🪽', type: 'buff', desc: '攻速 +35%', buff: {attackSpeed: 0.35}},
        {id: 'holy_body', name: '神聖護體', icon: '✝️', type: 'buff', desc: '物防 +20%、魔防 +20%', buff: {def: 0.20, mdef: 0.20}}
      ]
    };
    const SKILL_BOOK_CLASSES = ['warrior', 'thief', 'mage', 'monk', 'priest'];
    function getClassSkills(classId = state.classId) {return SKILLS[classId] || []}
    function getSkill(classId, skillId) {return getClassSkills(classId).find(x => x.id === skillId) || null}
    function getLearnedSkills(classId = state.classId) {return (state.learnedSkills?.[classId] || []).map(id => getSkill(classId, id)).filter(Boolean)}
    function ensureSkillProgress(classId = state.classId, skillId) {
      if (!state.skillLevels) state.skillLevels = {warrior: {}, thief: {}, mage: {}, monk: {}, priest: {}};
      if (!state.skillLevels[classId]) state.skillLevels[classId] = {};
      const cur = state.skillLevels[classId][skillId];
      if (!cur || typeof cur !== 'object') state.skillLevels[classId][skillId] = {level: 1, proficiency: 0, useCount: 0};
      else {cur.useCount = Math.max(0, Number(cur.useCount) || 0); cur.level = Math.max(1, Math.min(99, Number(cur.level) || 1)); cur.proficiency = Math.max(0, Number(cur.proficiency) || 0);}
      return state.skillLevels[classId][skillId];
    }
    function getSkillProgress(skillId, classId = state.classId) {return ensureSkillProgress(classId, skillId)}
    function skillProficiencyRequired(level) {return level >= 99 ? 0 : (10 + level * 2) * 30}
    function getSkillAbilityMultiplier(skillId, classId = state.classId) {const p = getSkillProgress(skillId, classId); return 1 + (Math.max(1, p.level) - 1) * 0.005}
    function skillProgressText(skillId, classId = state.classId) {const p = getSkillProgress(skillId, classId); return p.level >= 99 ? 'Lv.99 MAX' : ('Lv.' + p.level + '　熟練 ' + p.proficiency + '/' + skillProficiencyRequired(p.level))}
    function recordSkillUse(skill) {
      if (!skill?.id) return null;
      const p = getSkillProgress(skill.id, state.classId);
      p.useCount = (Number(p.useCount) || 0) + 1;
      if (p.level >= 99) return {levelUp: false, level: 99, useCount: p.useCount, max: true};
      p.proficiency++;
      const need = skillProficiencyRequired(p.level);
      if (p.proficiency >= need) {
        p.proficiency -= need; p.level = Math.min(99, p.level + 1);
        const bonus = Math.round((p.level - 1) * 0.5 * 10) / 10;
        addCombatLog('📚 ' + skill.name + ' 熟練度提升至 Lv.' + p.level + '（能力 +' + bonus + '%）', 'skill');
        return {levelUp: true, level: p.level, bonus, useCount: p.useCount};
      }
      return {levelUp: false, level: p.level, useCount: p.useCount};
    }
    function getSkillCooldownSeconds(sk) {return (sk?.type === 'buff' || sk?.type === 'area' || sk?.type === 'crossArea' || sk?.type === 'healArea') ? 10 : 1}
    function skillCooldownText(sk) {return 'CD ' + getSkillCooldownSeconds(sk) + ' 秒'}
    function hasSkill(skillId, classId = state.classId) {return (state.learnedSkills?.[classId] || []).includes(skillId)}
    function learnSkill(skillId) {
      const sk = getSkill(state.classId, skillId); if (!sk) return;
      if (!state.learnedSkills[state.classId]) state.learnedSkills[state.classId] = [];
      if (hasSkill(skillId)) {toast('📖 已學會：' + sk.name); return }
      state.learnedSkills[state.classId].push(skillId);
      ensureSkillProgress(state.classId, skillId);
      saveGame(); updateUI(); toast('📖 學會技能：' + sk.name);
    }
    function getSkillBookDrop() {
      // 技能書只能從「目前角色職業」的技能池抽取；禁止跨職業技能書掉落。
      const classId = PLAYABLE_CLASS_IDS.includes(state.classId) ? state.classId : null;
      if (!classId || !SKILL_BOOK_CLASSES.includes(classId)) return null;
      const pool = getClassSkills(classId).filter(sk => !hasSkill(sk.id, classId));
      if (!pool.length) return null;
      const sk = pool[Math.floor(Math.random() * pool.length)];
      return {id: 'book_' + Date.now() + '_' + Math.floor(Math.random() * 9999), name: sk.name + '技能書', icon: '📖', qty: 1, type: 'skillbook', rarity: 'rare', dropable: true, classId, skillId: sk.id, skillName: sk.name};
    }

    // 職業專用武器：掉落與裝備都會依職業限制，並使用不同模型外觀。
    const weaponFamilies = {
      sword: {name: '單手劍', visuals: ['sword'], classes: ['novice', 'warrior']},
