      // 項鍊已恢復為獨立掉落與裝備部位，並與戒指／耳環一樣不綁定職業。
      const kinds = ['armor', 'shoes', 'pants', 'belt', 'ring', 'earring', 'necklace', 'helmet', 'gloves', 'weapon'];
      if (cls === 'warrior' || cls === 'thief') kinds.push('shield');
      if (cls === 'priest') kinds.push('offhand');
      return kinds;
    }
