        out.type = 'cloak'; out.slot = 'cloak'; out.visual = 'divineCloak'; out.specialSeries = 'divineBlessing'; out.divineBlessing = true;
        out.classId = cls; out.allowedClasses = [cls]; out.rarity = 'normal'; out.itemLevel = divineCloakLevelForCharacter(out.itemLevel || 1);
