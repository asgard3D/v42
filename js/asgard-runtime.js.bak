        highPony: {name: '高馬尾', icon: '♧', desc: '髮套底層・可自行設計', category: '高馬尾'},
        mediumLayer: {name: '中長層次', icon: '✦', desc: '髮套底層・可自行設計', category: '中長層次'},
        buzzCut: {name: '短寸頭', icon: '▦', desc: '髮套底層・可自行設計', category: '短寸頭'},
