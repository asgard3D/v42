    function mat(c, rough = .8, metal = 0) {return new THREE.MeshStandardMaterial({color: c, roughness: rough, metalness: metal})}
    function mesh(g, m) {const o = new THREE.Mesh(g, m); o.castShadow = false; o.receiveShadow = true; return o}
    function enableCharacterShadows(root) {root.traverse(o => {if (o.isMesh) {o.castShadow = true; o.receiveShadow = true} })}
    function disposeObject3D(root) {
      if (!root) return;
      root.traverse(o => {
        if (o.geometry && o.geometry.dispose) o.geometry.dispose();
        if (o.material) {
          const ms = Array.isArray(o.material) ? o.material : [o.material];
          for (const m of ms) {
            if (m.map && m.map.dispose) m.map.dispose();
            if (m.alphaMap && m.alphaMap.dispose) m.alphaMap.dispose();
            if (m.normalMap && m.normalMap.dispose) m.normalMap.dispose();
            if (m.roughnessMap && m.roughnessMap.dispose) m.roughnessMap.dispose();
            if (m.metalnessMap && m.metalnessMap.dispose) m.metalnessMap.dispose();
            if (m.dispose) m.dispose();
          }
        }
      });
    }
    function clearWorld() {
      for (const o of state.world) {window.AsgardEngineBridge.removeWorldObject(terrainRoot, o); window.AsgardEngineBridge.removeWorldObject(staticRoot, o); window.AsgardEngineBridge.removeWorldObject(worldRoot, o); disposeObject3D(o)}
      for (const e of state.enemies) {e.userData.alive = false; window.AsgardEngineBridge.removeWorldObject(monsterRoot, e); disposeObject3D(e)}
      for (const d of state.drops) {scene.remove(d); disposeObject3D(d)}
      for (const n of state.npcs) {window.AsgardEngineBridge.removeWorldObject(npcRoot, n); disposeObject3D(n)}
      for (const p of state.portals) {window.AsgardEngineBridge.removeWorldObject(portalRoot, p); disposeObject3D(p)}
      for (const fx of state.effects || []) {scene.remove(fx.g); disposeObject3D(fx.g)}
      state.world = []; clearColliders(); state.enemies = []; state.drops = []; state.npcs = []; state.portals = []; state.effects = []; state.forestRiver = null; state.forestRiverFlow = [];
      state.areaSkills = []; state.cityLights = [];
      if (weatherObj) {scene.remove(weatherObj); disposeObject3D(weatherObj); weatherObj = null}
      weatherTimer = 0;
    }
    function addWorld(o) {
      state.world.push(o); window.AsgardEngineBridge.addWorldObject(activeWorldRoot, o);
      if (o?.userData?.collisionRadius) {
        state.colliders.push({x: o.position.x, z: o.position.z, r: Math.max(.45, Number(o.userData.collisionRadius) || .8), y: o.position.y || 0, object: o});
      }
      return o
    }
    function addCollider(o, r) {
      o.userData = o.userData || {};
      o.userData.collisionRadius = r;
      // 小地圖障礙物：預設沿用實際物件材質顏色；BoxGeometry 使用矩形，其餘使用圓／近似形狀。
      if (!o.userData.miniMap) {
        let sample = null;
        o.traverse?.(q => {if (!sample && q.isMesh && q.material?.color) sample = q});
        const color = sample?.material?.color?.getHexString?.() || '555b63';
        const geo = sample?.geometry;
        const params = geo?.parameters || {};
        if (geo?.type === 'BoxGeometry' && Number(params.width) > 0 && Number(params.depth) > 0) {
          o.userData.miniMap = {shape: 'rect', w: Number(params.width), d: Number(params.depth), color: '#' + color};
        } else {
          o.userData.miniMap = {shape: 'circle', color: '#' + color};
        }
      }
      return o;
    }
    function addRectCollider(o, w, d, inset = 0) {
      o.userData = o.userData || {};
      o.userData.collisionShape = 'rect';
      const wi = Math.max(.1, (Number(w) || .1) - (Number(inset) || 0) * 2);
      const di = Math.max(.1, (Number(d) || .1) - (Number(inset) || 0) * 2);
      state.colliders.push({x: o.position.x, z: o.position.z, r: Math.max(.1, Math.min(wi, di) * .5), w: wi, d: di, shape: 'rect', y: o.position.y || 0, object: o});
      return o;
    }
    function clearColliders() {state.colliders = []}
    function isAutoPortalBlocked(x, z, radius = .48) {
      const rr = Math.max(.35, Number(radius) || .48) + 1.9;
      for (const p of state.portals || []) {
        if (!p?.parent) continue;
        if (Math.hypot(x - p.position.x, z - p.position.z) < rr) return true;
      }
      return false;
    }
    function canEntityMoveTo(x, z, radius = .48, avoidPortals = false) {
      const r = Math.max(.28, Number(radius) || .48);
      // 路爾斯城是封閉城塞：城牆外的森林只能看到，不能步行進入。
      // 傳送點位於城內，因此不影響正常使用傳點離開城市。
      if (state.zone === 'city') {
        // 路爾斯城採封閉方形城塞輪廓；城牆外整圈是森林，只能看到，不能步行離開。
        // 城門開口只允許看到門外森林，不能步行穿出；邊界與城牆開口共同形成城門阻隔。
        const cityPlayableHalf = 52.0;
        if (Math.abs(x) > cityPlayableHalf - r || Math.abs(z) > cityPlayableHalf - r) return false;
      }
      const mapSize = Math.max(40, Number(zoneData[state.zone]?.size) || 200);
      const half = mapSize * .5 - 1.5;
      if (x < -half + r || x > half - r || z < -half + r || z > half - r) return false;
      // 斯歐米森林中央裂冰湖是不可到達區：玩家、怪物、Boss、生成點一律不能進入。
      if (isSeomiFrozenLakeBlocked(x, z, r)) return false;
      if (avoidPortals && isAutoPortalBlocked(x, z, r)) return false;
      // 路爾斯森林河流：河面本身不可通行，只有中央木橋可渡河。
      if (state.zone === 'forest' && state.forestRiver) {
        const river = state.forestRiver;
        let minDist = Infinity;
        const pts = river.points || [];
        for (let i = 0; i < pts.length - 1; i++) {
          const ax = pts[i][0], az = pts[i][1], bx = pts[i + 1][0], bz = pts[i + 1][1];
          const vx = bx - ax, vz = bz - az, wx = x - ax, wz = z - az;
          const vv = vx * vx + vz * vz;
          const t = vv > 0 ? Math.max(0, Math.min(1, (wx * vx + wz * vz) / vv)) : 0;
          const px = ax + vx * t, pz = az + vz * t;
          minDist = Math.min(minDist, Math.hypot(x - px, z - pz));
        }
        if (minDist <= river.width * .5 + r) {
          const b = river.bridge;
          const onBridge = b && Math.abs(x - b.x) <= b.w * .5 + r && Math.abs(z - b.z) <= b.d * .5 + r;
          if (!onBridge) return false;
        }
      }
      for (const c of state.colliders) {
        if (!c || !c.object || !c.object.parent) continue;
        if (c.shape === 'rect') {
          const halfW = Math.max(.05, Number(c.w) || 0) * .5;
          const halfD = Math.max(.05, Number(c.d) || 0) * .5;
          if (Math.abs(x - c.x) < halfW + r && Math.abs(z - c.z) < halfD + r) return false;
          continue;
        }
        const cr = Math.min(30, Math.max(.35, Number(c.r) || .35));
        const dx = x - c.x, dz = z - c.z, rr = r + cr;
        if (dx * dx + dz * dz < rr * rr) return false;
      }
      return true;
    }
    function canPlayerMoveTo(x, z) {return canEntityMoveTo(x, z, .48)}
    function forestRiverPointOnBridge(x, z, r = .0) {
      if (state.zone !== 'forest' || !state.forestRiver?.bridge) return false;
      const b = state.forestRiver.bridge;
      return Math.abs(x - b.x) <= b.w * .5 + r && Math.abs(z - b.z) <= b.d * .5 + r;
    }
    function forestRiverSegmentBlocked(x1, z1, x2, z2, r = .48) {
      if (state.zone !== 'forest' || !state.forestRiver) return false;
      const river = state.forestRiver, pts = river.points || [];
      // 先判定起點／終點是否在橋上；橋是河流唯一合法的跨越位置。
      if (forestRiverPointOnBridge(x1, z1, r) && forestRiverPointOnBridge(x2, z2, r)) return false;
      // 以多點取樣檢查整段位移，避免高速怪物「跳過」河面只檢查終點而穿河。
      const dist = Math.hypot(x2 - x1, z2 - z1);
      const samples = Math.max(3, Math.ceil(dist / .35));
      for (let n = 1; n <= samples; n++) {
        const t = n / samples, x = x1 + (x2 - x1) * t, z = z1 + (z2 - z1) * t;
        let minDist = Infinity;
        for (let i = 0; i < pts.length - 1; i++) {
          const ax = pts[i][0], az = pts[i][1], bx = pts[i + 1][0], bz = pts[i + 1][1];
          const vx = bx - ax, vz = bz - az, wx = x - ax, wz = z - az, vv = vx * vx + vz * vz;
          const q = vv > 0 ? Math.max(0, Math.min(1, (wx * vx + wz * vz) / vv)) : 0;
          minDist = Math.min(minDist, Math.hypot(x - (ax + vx * q), z - (az + vz * q)));
        }
        if (minDist <= river.width * .5 + r && !forestRiverPointOnBridge(x, z, r)) return true;
      }
      return false;
    }
    function tryMoveEntity(entity, dx, dz, radius, avoidPortals = false) {
      if (!entity) return false;
      const r = radius == null ? (entity === state.player ? .48 : Math.max(.48, Number(entity.userData?.collisionRadius) || .62)) : radius;
      const p = entity.position;
      if (Math.abs(dx) < 1e-8 && Math.abs(dz) < 1e-8) return true;
      const nx = p.x + dx, nz = p.z + dz;
      // 河流是實體地形障礙：整段移動路徑都不能穿越水面，只有木橋可通過。
      if (forestRiverSegmentBlocked(p.x, p.z, nx, nz, r)) return false;
      if (canEntityMoveTo(nx, nz, r, avoidPortals)) {p.x = nx; p.z = nz; return true;}
      // 允許沿障礙物邊緣滑動，避免角色／怪物在斜角完全卡死。
      if (Math.abs(dx) > 1e-8 && !forestRiverSegmentBlocked(p.x, p.z, p.x + dx, p.z, r) && canEntityMoveTo(p.x + dx, p.z, r, avoidPortals)) {p.x += dx; return true;}
