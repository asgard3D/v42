    function autoTargetPathExists(target, maxDistance = 75) {
      if (!state.player || !target || !target.userData?.alive) return false;
      const sx = state.player.position.x, sz = state.player.position.z;
      const tx = target.position.x, tz = target.position.z;
      const direct = Math.hypot(tx - sx, tz - sz);
      if (direct < 3) return true;
      if (direct > maxDistance) return false;
