      const minX = Math.max(-zoneData[state.zone].size * .5 + 1, Math.min(sx, tx) - 8);
      const maxX = Math.min(zoneData[state.zone].size * .5 - 1, Math.max(sx, tx) + 8);
      const minZ = Math.max(-zoneData[state.zone].size * .5 + 1, Math.min(sz, tz) - 8);
      const maxZ = Math.min(zoneData[state.zone].size * .5 - 1, Math.max(sz, tz) + 8);
      const cols = Math.ceil((maxX - minX) / step) + 1, rows = Math.ceil((maxZ - minZ) / step) + 1;
      if (cols * rows > 2600) return true; // 太大時交給原本的導航，避免造成卡頓。
