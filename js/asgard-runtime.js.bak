      if (v === 'leather') return 'traveler';
      if (v === 'redleather') return 'war';
      if (v === 'forestguard') return 'forest';
      if (v === 'silverlight') return 'moon';
      if (v === 'knight') return 'royal';
      return 'traveler';
    }
    function addClassTierVisual(g, it, slot) {
