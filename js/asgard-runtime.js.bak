        const tail = mesh(new THREE.CapsuleGeometry(.07, .78, 6, 8), fur); tail.position.set(0, .95, -.55); tail.rotation.x = -.92; tail.rotation.z = .08; g.add(tail);
        // 職業裝備：狂戰士、咒術師、獵殺者各自一套
        if (type === 'beastknight') {
          const chest = mesh(new THREE.BoxGeometry(.78, .62, .18), metal); chest.position.set(0, 1.02, .39); g.add(chest);
          for (const sx of [-.43, .43]) {const pa = mesh(new THREE.SphereGeometry(.17, 9, 7), metal); pa.scale.set(1, .72, 1); pa.position.set(sx, .99, .04); g.add(pa)}
          const helm = mesh(new THREE.CylinderGeometry(.42, .48, .34, 10, 1, true), metal); helm.position.set(0, 2.03, .02); g.add(helm);
          const crest = mesh(new THREE.ConeGeometry(.10, .30, 6), mat(0xcdd7e2, .2, .6)); crest.position.set(0, 2.34, .02); g.add(crest);
          const blade = mesh(new THREE.BoxGeometry(.10, 1.48, .12), mat(0xd7dbe4, .2, .7)); blade.position.set(.72, 1.24, .12); blade.rotation.z = -.18; g.add(blade);
          const guard = mesh(new THREE.BoxGeometry(.44, .075, .14), mat(0xb58a4e, .45, .3)); guard.position.set(.72, .55, .12); guard.rotation.z = -.18; g.add(guard);
          const shield = mesh(new THREE.CylinderGeometry(.28, .28, .10, 10), mat(0x596777, .35, .35)); shield.rotation.x = Math.PI / 2; shield.position.set(-.56, .96, .26); g.add(shield);
          const shieldGem = mesh(new THREE.SphereGeometry(.07, 8, 6), mat(0xffa15c, .2, .8)); shieldGem.position.set(-.56, .96, .33); g.add(shieldGem);
        } else if (type === 'beastmage') {
          const robe = mesh(new THREE.CylinderGeometry(.30, .58, .95, 10, 1, true), cloth); robe.position.set(0, .92, .03); g.add(robe);
          const belt = mesh(new THREE.TorusGeometry(.40, .045, 6, 18), leather); belt.rotation.x = Math.PI / 2; belt.position.set(0, .78, .02); g.add(belt);
          const hat = mesh(new THREE.ConeGeometry(.38, .65, 12), mat(0x0b0c0f, .72, .12)); hat.position.set(0, 2.45, .02); g.add(hat);
          const brim = mesh(new THREE.CylinderGeometry(.52, .52, .09, 14), mat(0x08090b, .72, .1)); brim.position.set(0, 2.17, .02); g.add(brim);
          const gem = mesh(new THREE.SphereGeometry(.07, 8, 6), mat(0x4e8cff, .12, .9)); gem.position.set(0, 2.39, .35); g.add(gem);
          const staff = mesh(new THREE.CylinderGeometry(.045, .065, 1.72, 8), leather); staff.position.set(.67, .98, .04); staff.userData.enemyAttackWeapon = true; staff.userData.enemyAttackSide = 1; g.add(staff);
          const orb = mesh(new THREE.SphereGeometry(.18, 14, 10), mat(0x4b7dff, .12, .85)); orb.position.set(.67, 1.88, .04); g.add(orb);
          const aura = mesh(new THREE.TorusGeometry(.20, .025, 6, 18), mat(0x6d9cff, .18, .7)); aura.rotation.x = Math.PI / 2; aura.position.set(.67, 1.88, .04); g.add(aura);
        } else {
          const vest = mesh(new THREE.BoxGeometry(.68, .60, .16), leather); vest.position.set(0, 1.02, .34); g.add(vest);
          const goggles = mesh(new THREE.TorusGeometry(.13, .035, 6, 16), mat(0x4b392e, .3, .3)); goggles.position.set(-.16, 1.76, .51); goggles.rotation.x = Math.PI / 2; g.add(goggles); const goggles2 = goggles.clone(); goggles2.position.x = .16; g.add(goggles2);
          const strap = mesh(new THREE.BoxGeometry(.46, .035, .035), mat(0x2a2525, .4)); strap.position.set(0, 1.76, .49); g.add(strap);
          for (const sx of [-.46, .46]) {const dagger = mesh(new THREE.BoxGeometry(.08, .65, .09), mat(0xdfe5eb, .18, .65)); dagger.position.set(sx, .90, .27); dagger.rotation.z = sx < 0 ? .42 : -.42; g.add(dagger); const h = mesh(new THREE.BoxGeometry(.13, .24, .12), leather); h.position.set(sx, .55, .25); g.add(h)}
          const belt = mesh(new THREE.TorusGeometry(.40, .045, 6, 18), leather); belt.rotation.x = Math.PI / 2; belt.position.set(0, .80, .02); g.add(belt);
        }
      } else if (['potterWater', 'potterSailor', 'potterHedgehog', 'potterKnight', 'potterGeneral'].includes(type)) {
        // 波特族 V3：完全以使用者提供的參考圖為基準。
        // 五種都是「水藍色、無腳、漂浮的小水滴」；只有裝備武器的種類才使用近戰。
        const waterBlue = mat(0x42bfe8, .12, .16);
        const waterLight = mat(0x78e7ff, .08, .12);
        const waterDark = mat(0x2499cf, .16, .12);
        const black = mat(0x11151b, .30, .20);
        const yellow = mat(0xf4c51b, .18, .48);
        const wood = mat(0x8b5a32, .88, .04);
        const woodDark = mat(0x5d3924, .94, .02);
        const red = mat(0xc9343b, .42, .04);

        const makeDrop = (material, scale = 1, withRearTail = true) => {
          // 波特族：正面是圓潤水滴頭，水滴尖尾固定朝「後方」(-Z)。
          // 絕不在前方建立尖錐，避免出現「倒水滴」。
          const group = new THREE.Group();
          const core = mesh(new THREE.SphereGeometry(.60, 28, 20), material);
          core.scale.set(1.02, .96, 1.08);
          core.position.set(0, 1.02, .08);
          group.add(core);

          // 後方水滴尾：從身體後側收尖，方向固定 -Z。
          // 將軍有披風，因此由呼叫端關閉水滴尾。
          if (withRearTail) {
            const rearTip = mesh(new THREE.ConeGeometry(.36, .82, 24), material);
            rearTip.rotation.x = -Math.PI / 2;
            rearTip.scale.set(1, .92, 1);
            rearTip.position.set(0, 1.03, -.62);
            group.add(rearTip);

            const rearSoft = mesh(new THREE.SphereGeometry(.22, 18, 12), waterLight);
            rearSoft.scale.set(1, .72, .82);
            rearSoft.position.set(0, 1.03, -.98);
            group.add(rearSoft);
          }

          group.scale.set(scale, scale, scale);
          return group;
        };
        const addFace = (armored = false) => {
          // 眼睛：一般波特為黑色；刺蝟／騎士／將軍使用紅黑色。
          const eyeOuter = armored ? mat(0x5b0b0d, .22, .12) : black;
          for (const sx of [-.18, .18]) {
            const eye = mesh(new THREE.SphereGeometry(.105, 14, 10), eyeOuter);
            eye.position.set(sx, 1.34, .61); g.add(eye);
            const pupil = mesh(new THREE.SphereGeometry(.052, 12, 9), black);
            pupil.position.set(sx, 1.34, .708); g.add(pupil);
            const shine = mesh(new THREE.SphereGeometry(.014, 8, 6), mat(0xffffff, .04, .05));
            shine.position.set(sx - .018, 1.365, .75); g.add(shine);
          }
          const mouth = mesh(new THREE.SphereGeometry(.065, 10, 8), black);
          mouth.scale.set(1, .52, .35); mouth.position.set(0, 1.04, .67); g.add(mouth);
        };
        const addRaisedArms = (weaponType = 'none') => {
          // 波特族手臂固定「向前上舉」：沒有向下垂手。手掌在身體前方，肉色。
          const skin = mat(0xf0a57e, .58, .02);
          const armL = mesh(new THREE.CapsuleGeometry(.065, .30, 7, 9), skin);
          armL.position.set(-.38, 1.23, .56);
          armL.rotation.x = -1.05; armL.rotation.z = -.12;
          armL.userData.potterArm = true; armL.userData.enemyArm = true; armL.userData.enemyArmSide = -1; g.add(armL);
          const handL = mesh(new THREE.SphereGeometry(.115, 14, 10), skin);
          handL.scale.set(.78, .86, .58); handL.position.set(-.42, 1.25, .80);
          handL.userData.potterHand = true; g.add(handL);

          const armR = mesh(new THREE.CapsuleGeometry(.065, .30, 7, 9), skin);
          armR.position.set(.38, 1.23, .56);
          armR.rotation.x = -1.05; armR.rotation.z = .12;
          armR.userData.potterArm = true; armR.userData.enemyArm = true; armR.userData.enemyArmSide = 1; g.add(armR);
          const handR = mesh(new THREE.SphereGeometry(.115, 14, 10), skin);
          handR.scale.set(.78, .86, .58); handR.position.set(.42, 1.25, .80);
          handR.userData.potterHand = true; g.add(handR);

          g.userData.potterArms = [armL, armR]; g.userData.potterHands = [handL, handR];
          return {armL, armR, handL, handR};
        };
        const addTail = () => {
          // 尾巴只在背後：從 -Z 向後伸出，與正面完全相反。
          const tail = mesh(new THREE.ConeGeometry(.18, .72, 14), waterDark);
          tail.position.set(0, 1.03, -.90);
          tail.rotation.x = -Math.PI / 2;
          tail.scale.set(1, .78, 1);
          tail.userData.potterTail = true;
          g.add(tail);
          const tip = mesh(new THREE.SphereGeometry(.095, 12, 8), waterLight);
          tip.position.set(0, 1.03, -1.25);
          tip.userData.potterTail = true;
          g.add(tip);
        };
        const addHelmet = () => {
          // 波特族黑色重型尖刺頭盔：
          // 參考圖重點：大圓頂、前額厚護片、密集大型黃金三角尖刺；
          // 頭盔包覆頭頂與後腦，但眼睛與水滴臉仍完整露出。
          const cap = mesh(new THREE.SphereGeometry(.66, 28, 20), black);
          cap.scale.set(1.16, .98, 1.10);
          cap.position.set(0, 1.69, -.045);
          g.add(cap);

          // 前額黑色護片／眉甲，讓頭盔不再像單純黑色圓球。
          const brow = mesh(new THREE.BoxGeometry(1.00, .18, .11), black);
          brow.position.set(0, 1.49, .535);
          brow.rotation.x = -.08;
          g.add(brow);

          // 左右延伸的側邊護甲，貼合頭盔輪廓。
          const sideL = mesh(new THREE.BoxGeometry(.13, .34, .20), black);
          sideL.position.set(-.52, 1.47, .43);
          sideL.rotation.z = -.18;
          g.add(sideL);
          const sideR = mesh(new THREE.BoxGeometry(.13, .34, .20), black);
          sideR.position.set(.52, 1.47, .43);
          sideR.rotation.z = .18;
          g.add(sideR);

          // 頭盔下緣：只壓住額頭，不遮住黑／紅眼睛。
          const rim = mesh(new THREE.TorusGeometry(.605, .072, 10, 32), black);
          rim.rotation.x = Math.PI / 2;
          rim.position.set(0, 1.47, .055);
          rim.scale.set(1.03, .90, 1);
          g.add(rim);

          // 密集黃金三角尖刺：
          // 以多圈沿著球形頭盔分布，頂部尖刺最大，前後左右均有，
          // 讓輪廓接近參考圖的「滿頭黑甲＋密集黃金尖刺」。
          const spikeRows = [
            // 參考圖風格：尖刺數量減少，但平均尺寸明顯放大，避免「細小而密集」。
            // 頭頂中央：最大主尖刺。
            {y: 2.39, rx: .00, rz: .00, count: 1, h: .78, r: .17, phase: 0},
            // 頭頂第二圈：大型、間距明確。
            {y: 2.27, rx: .22, rz: .15, count: 5, h: .70, r: .16, phase: Math.PI / 2},
            // 中上圈：保持大型金色三角柱。
            {y: 2.08, rx: .43, rz: .28, count: 8, h: .62, r: .15, phase: Math.PI / 8},
            // 中圈：不再塞滿，讓每根尖刺都有清楚輪廓。
            {y: 1.88, rx: .59, rz: .40, count: 10, h: .55, r: .14, phase: Math.PI / 10},
            // 下側少量環繞，只保留較大的視覺節點。
            {y: 1.72, rx: .65, rz: .48, count: 8, h: .48, r: .13, phase: 0}
          ];

          for (const row of spikeRows) {
            for (let i = 0; i < row.count; i++) {
              const a = row.phase + i * Math.PI * 2 / row.count;
              const sx = row.rx === 0 ? 0 : Math.cos(a) * row.rx;
              const sz = row.rz === 0 ? -.02 : -.04 + Math.sin(a) * row.rz;
              const sy = row.y + (row.count > 1 ? Math.cos(a) * .025 : 0);

              const spike = mesh(new THREE.ConeGeometry(row.r, row.h, 7), yellow);
              spike.position.set(sx, sy, sz);

              // 尖刺由頭盔表面向外／向上指，避免全部垂直朝天。
              const dir = new THREE.Vector3(
                sx * .90,
                .30 + (row.y - 1.70) * .55,
                sz * 1.12
              );
              if (dir.lengthSq() > .0001) {
                dir.normalize();
                spike.quaternion.setFromUnitVectors(
                  new THREE.Vector3(0, 1, 0),
                  dir
                );
              }
              g.add(spike);
            }
          }
        };
        const addWoodShieldAndSword = () => {
          // 武器與盾牌的握持點直接對準肉色手掌。
          const handLX = -.42, handRX = .42, handY = 1.25, handZ = .82;
          if (type === 'potterGeneral') {
            // 將軍專用盾牌：完全依照參考圖重做。
            // 盾牌必須位於「左手掌正面」，不是身體左側；盾面正對前方。
            // 外形為直立五邊形：黑色厚金屬外框＋藍色中央盾面＋中央黑色盾釘。
            const shieldGroup = new THREE.Group();
            shieldGroup.position.set(handLX - .015, handY + .015, handZ + .15);
            shieldGroup.rotation.set(0, 0, 0);

            const makePentagon = (r, h, depth, material, bevel = .025) => {
              const sh = new THREE.Shape();
              sh.moveTo(0, h * .52);
              sh.lineTo(r * .50, h * .18);
              sh.lineTo(r * .39, -h * .52);
              sh.lineTo(-r * .39, -h * .52);
              sh.lineTo(-r * .50, h * .18);
              sh.closePath();
              const geo = new THREE.ExtrudeGeometry(sh, {depth, bevelEnabled: bevel > 0, bevelSegments: 2, bevelSize: bevel, bevelThickness: bevel * .7, curveSegments: 2});
              geo.center();
              return mesh(geo, material);
            };

            // 厚黑色外框。盾牌中心略偏向左手，保持手掌在盾牌後方。
            const shield = makePentagon(.98, 1.18, .13, black, .045);
            shield.position.set(0, 0, 0);
            shield.userData.potterShield = true;
            shieldGroup.add(shield);

            // 藍色中央面，縮進黑色外框內，與參考圖相同。
            const face = makePentagon(.78, .94, .055, waterDark, .018);
            face.position.set(0, 0, .095);
            face.userData.potterShield = true;
            shieldGroup.add(face);

            // 中央黑色金屬盾釘。
            const boss = mesh(new THREE.CylinderGeometry(.105, .105, .07, 12), black);
            boss.rotation.x = Math.PI / 2;
            boss.position.set(0, 0, .15);
            boss.scale.set(1, 1, 1.05);
            boss.userData.potterShield = true;
            shieldGroup.add(boss);

            // 盾牌直接貼在左手掌前方，避免再漂到身體側邊。
            shieldGroup.userData.potterShieldGroup = true;
            g.add(shieldGroup);
            g.userData.potterShieldGroup = shieldGroup;
          } else {
            const shield = mesh(new THREE.CylinderGeometry(.31, .31, .12, 10), wood);
            shield.rotation.x = Math.PI / 2; shield.position.set(handLX, handY, handZ); g.add(shield);
            const rim = mesh(new THREE.TorusGeometry(.265, .036, 7, 16), woodDark);
            rim.rotation.x = Math.PI / 2; rim.position.set(handLX, handY, handZ + .075); g.add(rim);
          }
          const swordGroup = new THREE.Group();
          swordGroup.position.set(handRX, handY, handZ);
          const blade = mesh(new THREE.BoxGeometry(.078, .86, .078), wood);
          blade.position.set(0, .34, .01); blade.rotation.z = -.10; swordGroup.add(blade);
          const guard = mesh(new THREE.BoxGeometry(.27, .065, .09), woodDark);
          guard.position.set(0, -.02, .01); guard.rotation.z = -.10; swordGroup.add(guard);
          const grip = mesh(new THREE.BoxGeometry(.08, .24, .09), woodDark);
          grip.position.set(0, -.15, .01); swordGroup.add(grip);
          g.add(swordGroup); g.userData.potterWeaponGroup = swordGroup;
        };

        if (type === 'potterWater') {
          body = add(makeDrop(waterBlue, 1.0), 0, .16, 0);
          addFace(false); addRaisedArms('none');
          // 漂浮水滴：完全無腳。
          g.position.y += .12;
        } else if (type === 'potterSailor') {
          body = add(makeDrop(waterBlue, 1.0), 0, .16, 0);
          addFace(false);
          const sailorArms = addRaisedArms('saw');
          // 水兵波特：小水滴＋向前伸出的黑色「電鋸手」，不使用帽子、不加腿。
          const saw = new THREE.Group();
          const sawBody = mesh(new THREE.BoxGeometry(.38, .16, .18), black); sawBody.position.set(.69, 1.37, .68); saw.add(sawBody);
          const sawBlade = mesh(new THREE.BoxGeometry(.40, .055, .11), mat(0x252a31, .48, .32)); sawBlade.position.set(.69, 1.43, .79); saw.add(sawBlade);
          for (let i = 0; i < 7; i++) {
            const tooth = mesh(new THREE.ConeGeometry(.028, .09, 4), yellow);
            tooth.position.set(.52 + i * .055, 1.47, .79); tooth.rotation.z = Math.PI; g.add(tooth);
          }
          g.add(saw); g.userData.potterWeaponGroup = saw;
          // 電鋸直接位於右手掌前方，不再使用黑色手臂。
          sailorArms.armR.position.set(.38, 1.23, .56); sailorArms.armR.rotation.x = -1.05; sailorArms.handR.position.set(.42, 1.25, .80);
        } else if (type === 'potterHedgehog') {
          body = add(makeDrop(waterBlue, 1.0), 0, .16, 0);
          addFace(true); addRaisedArms('none'); addHelmet(); addTail();
          // 無武器，使用遠距水滴魔彈。
        } else if (type === 'potterKnight') {
          body = add(makeDrop(waterBlue, 1.0), 0, .16, 0);
          addFace(true); addRaisedArms('swordshield'); addHelmet(); addTail(); addWoodShieldAndSword();
        } else if (type === 'potterGeneral') {
          body = add(makeDrop(waterBlue, 1.0, false), 0, .16, 0);
          addFace(true); addRaisedArms('swordshield'); addHelmet(); addWoodShieldAndSword();
          // 將軍波特「有披風就不使用尾巴」。
          // 披風放在水滴身體後方，放大並向後上方約 45° 展開；保持很薄，移動時產生柔軟飄動。
          const capeMat = new THREE.MeshStandardMaterial({
            color: 0xc9343b, roughness: .62, side: THREE.DoubleSide, transparent: true, opacity: .96
          });
          const cape = mesh(new THREE.PlaneGeometry(.82, 1.00, 10, 12), capeMat);
          // 背部參考：披風貼住身體後方，由背部向後下方垂落，順時針約 60°。
          // 小而厚實，連接點靠近水滴背面，不再平躺在地面或飄離身體。
          cape.position.set(0, 1.18, -.69);
          cape.rotation.set(Math.PI / 3, Math.PI, 0);
          cape.scale.set(1.30, 1.30, 1.00);
          cape.userData.potterCape = true;
          cape.userData.capeBaseRotX = cape.rotation.x;
          cape.userData.capeBaseRotY = cape.rotation.y;
          cape.userData.capeBaseRotZ = cape.rotation.z;
          cape.userData.capeBasePosX = cape.position.x;
          cape.userData.capeBasePosY = cape.position.y;
          cape.userData.capeBasePosZ = cape.position.z;
          g.add(cape);
          g.userData.potterCape = cape;
        }

        g.userData._potter = true;
        g.userData._potterNoLegs = true;
        g.userData._potterRanged = ['potterWater', 'potterHedgehog'].includes(type);
        g.userData._potterBlue = true;
        g.userData._potterNoFeet = true;
        g.userData._potterTailBack = type !== 'potterGeneral';
        g.userData._potterNoTail = type === 'potterGeneral';
        g.userData._potterRaisedHands = true;
        if (type === 'potterGeneral') {
          const stray = [];
          g.traverse(o => {if (o !== g && o.userData?.potterTail === true) stray.push(o);});
          stray.forEach(o => o.parent?.remove(o));
        }
      } else if (type === 'cardSoldier' || type === 'cardKnight' || type === 'cardLancer' || type === 'cardQueen') {
        body = add(mesh(new THREE.BoxGeometry(.72, .95, .22), bodyMat), 0, 1.15, 0); head = add(mesh(new THREE.SphereGeometry(.42, 14, 10), mat(0xf0c7a5, .6)), 0, 2.0, .02); const card = mesh(new THREE.BoxGeometry(.52, .70, .035), mat(type === 'cardSoldier' ? 0xf5f0df : type === 'cardKnight' ? 0xc94352 : type === 'cardLancer' ? 0x303746 : 0x8a5ab0, .6)); card.position.set(0, 1.15, .16); g.add(card);
        const spearGroup = new THREE.Group(); const spear = mesh(new THREE.CylinderGeometry(.035, .045, 1.9, 8), mat(0x6b5037, .6, .2)); spear.rotation.x = Math.PI / 2; spear.position.z = .90; spearGroup.add(spear); const tip = mesh(new THREE.ConeGeometry(.11, .28, 5), mat(0xd6dbe2, .25, .65)); tip.rotation.x = Math.PI / 2; tip.position.z = 1.99; spearGroup.add(tip); spearGroup.position.set(.45, 1.05, .28); g.add(spearGroup);
        for (const sx of [-.16, .16]) {const leg = mesh(new THREE.CapsuleGeometry(.09, .42, 5, 8), bodyMat); leg.position.set(sx, .48, .02); leg.userData.enemyLeg = true; leg.userData.enemyLegSide = leg.position.x < 0 ? -1 : 1; g.add(leg); const boot = mesh(new THREE.SphereGeometry(.13, 8, 6), dark); boot.scale.set(1, .55, 1.25); boot.position.set(sx, .20, .10); boot.userData.enemyLeg = true; boot.userData.enemyLegSide = boot.position.x < 0 ? -1 : 1; g.add(boot)}
        g.userData = {...(g.userData || {}), _pendingAliceSpear: spearGroup};
      } else if (type === 'ram') {
        body = add(mesh(new THREE.CapsuleGeometry(.55, .70, 7, 12), bodyMat), 0, .78, 0); body.scale.set(1.05, .92, .88);
        head = add(mesh(new THREE.SphereGeometry(.56, 18, 14), bodyMat), 0, 1.48, .18); head.scale.set(1, .95, .9);
        for (const sx of [-.22, .22]) add(mesh(new THREE.SphereGeometry(.10, 9, 7), eyeMat), sx, 1.50, .67);
        // 參考圖片的 Q 版卷角：兩個彎曲角環。
        for (const sx of [-.38, .38]) {
          const horn = mesh(new THREE.TorusGeometry(.29, .085, 8, 18, Math.PI * 1.45), mat(0x514b49, .58));
          horn.position.set(sx, 1.72, .16); horn.rotation.z = sx < 0 ? .35 : -.35; horn.rotation.x = Math.PI / 2; g.add(horn);
          const ear = mesh(new THREE.SphereGeometry(.14, 10, 7), bodyMat); ear.scale.set(1, .65, 1.4); ear.position.set(sx * .95, 1.58, .15); g.add(ear);
        }
        for (let i = -2; i <= 2; i++) {const fluff = mesh(new THREE.SphereGeometry(.18, 9, 7), white); fluff.scale.set(1, .65, .8); fluff.position.set(i * .16, 1.20, .12); g.add(fluff)}
        for (const sx of [-.34, .34]) {const arm = mesh(new THREE.CapsuleGeometry(.11, .30, 5, 8), bodyMat); arm.position.set(sx, 1.02, .02); arm.rotation.z = sx < 0 ? -.45 : .45; g.add(arm)}
