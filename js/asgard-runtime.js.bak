    function makeSkillBookDropVisual() {const g = new THREE.Group(); const cover = mat(0x5c2b7d, .35, .35), page = mat(0xf0e2b8, .8, .05), gold = mat(0xe0b84c, .25, .5); const book = mesh(new THREE.BoxGeometry(.38, .46, .12), cover); book.position.y = .30; g.add(book); const pages = mesh(new THREE.BoxGeometry(.30, .38, .13), page); pages.position.set(0, .30, .015); g.add(pages); const seal = mesh(new THREE.OctahedronGeometry(.07), gold); seal.position.set(0, .30, .09); g.add(seal); return g}
