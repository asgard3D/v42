      } catch (err) {console.warn('loadGame failed', err); return false}
    }
    function equipmentScore(it) {
      if (!it) return -Infinity;
      return (Number(it.atk) || 0) * 1.35 + (Number(it.def) || 0) * 1.15 + (Number(it.matk) || 0) * 1.45 + (Number(it.mdef) || 0) * 1.25 + (Number(it.crit) || 0) * .8 + (Number(it.attackSpeed) || 0) * .35 + (Number(it.itemLevel) || 0) * .12 + ({normal: 0, rare: 8, epic: 18, legendary: 32}[it.rarity || 'normal'] || 0);
    }
    function autoEquipBest(slot) {
      let candidates = state.inventory.filter(it => itemFitsEquipSlot(it, slot) && equipmentMeetsLevelRequirement(it, state.level) && classEquipCanUse(it) && (slot !== 'weapon' || weaponCanEquip(it)) && (slot !== 'helmet' || helmetCanEquip(it)));
      if (slot === 'weapon') candidates = candidates.filter(it => !isTwoHandedWeapon(it) || state.equip.offhand?.family !== 'shield');
      if (slot === 'offhand') candidates = candidates.filter(it => !(it.family === 'shield' && isTwoHandedWeapon(state.equip.weapon)));
      if (!candidates.length) {toast('🎒 沒有可更換的 ' + (EQUIP_LABELS[slot] || slot)); return false}
      candidates.sort((a, b) => equipmentScore(b) - equipmentScore(a));
      const best = candidates[0], old = state.equip[slot];
      if (old && equipmentScore(best) <= equipmentScore(old)) {toast('✨ 目前 ' + EQUIP_LABELS[slot] + ' 已不低於背包裝備'); return false}
      const idx = state.inventory.findIndex(x => x.id === best.id); if (idx < 0) return false;
      if (old) state.inventory.push(old);
      state.equip[slot] = best;
      state.inventory.splice(idx, 1);
      return true;
    }
    function autoEquipAllBest() {
      let changed = 0; for (const slot of EQUIP_SLOTS) if (autoEquipBest(slot)) changed++;
      updateEquipmentVisual(); saveGame(); updateUI(); toast(changed ? '⚡ 已一鍵換上 ' + changed + ' 件能力較高裝備' : '✨ 沒有更適合的裝備可更換'); openModal('equip');
    }
    function resolveEquipSlot(it) {
      const sl = it?.slot || it?.type;
      if (sl === 'ring') {const free = EQUIP_SLOTS.find(k => k.startsWith('ring') && !state.equip[k]); return free || null}
      if (sl === 'earring') {if (!state.equip.earringL) return 'earringL'; if (!state.equip.earringR) return 'earringR'; return null}
      if (sl === 'gloves') {if (!state.equip.glovesL) return 'glovesL'; if (!state.equip.glovesR) return 'glovesR'; return null}
      if (sl === 'armor') return 'armor';
      if (sl === 'pants') return 'pants';
      return sl;
    }
    function itemFitsEquipSlot(it, slot) {
      const sl = it?.slot || it?.type;
      if (['ring1', 'ring2', 'ring3', 'ring4'].includes(slot)) return sl === 'ring' || sl === slot;
      if (['earringL', 'earringR'].includes(slot)) return sl === 'earring' || sl === slot;
      if (['glovesL', 'glovesR'].includes(slot)) return sl === 'gloves' || sl === slot;
      return sl === slot;
    }
    function equipItem(id) {
      const idx = state.inventory.findIndex(x => x.id === id);
      if (idx < 0) return;
      const it = state.inventory[idx], rawSlot = it.slot || it.type, slot = resolveEquipSlot(it);
      // 裝備可以正常使用；怪物掉落規則與裝備使用規則分離。
      // 允許背包內既有、歷史存檔及新手裝備正常更換，避免「只能卸下、不能重新裝備」。
      if (!slot) {toast('此類裝備的欄位已全部裝滿'); return }
      if (!EQUIP_SLOTS.includes(slot)) {
        if (it.type === 'consumable' && it.potion === 'hp') usePotion();
        else if (it.type === 'consumable' && it.potion === 'mp') useMpPotion();
        else if (it.type === 'consumable' && it.potion === 'sp') useSpPotion();
        else toast('此物品不能裝備');
        return;
      }
      if (!equipmentMeetsLevelRequirement(it, state.level)) {
        const req = Number(it.itemLevel) || 1;
        toast('🔒 需要 Lv.' + req + ' 才能裝備「' + equipmentDisplayName(it) + '」');
        return;
      }
      if (!classEquipCanUse(it)) {
        toast('🔒 ' + (classes[state.classId]?.name || '目前職業') + ' 無法裝備「' + equipmentDisplayName(it) + '」');
        return;
      }

      // 嚴格副手規則：雙手武器與盾牌不能同時存在。
      if (slot === 'offhand' && it.family === 'shield' && isTwoHandedWeapon(state.equip.weapon)) {
        toast('⚔️ 目前主武器為雙手武器，副手無法裝備盾牌');
        return;
      }
      if (slot === 'weapon' && isTwoHandedWeapon(it) && state.equip.offhand?.family === 'shield') {
        toast('🛡️ 目前裝備盾牌，無法裝備雙手武器；請先卸下盾牌');
        return;
      }

      if (slot === 'weapon' && it.dualWield) {
        if (state.equip.weapon) state.inventory.push(state.equip.weapon);
        if (state.equip.offhand) state.inventory.push(state.equip.offhand);
        state.equip.weapon = it;
        state.equip.offhand = {...it, id: it.id + '_off', slot: 'offhand', type: 'weapon', dualWieldPartner: it.id};
        state.inventory.splice(idx, 1);
        updateEquipmentVisual(); saveGame(); toast('⚔️ 雙持裝備 ' + it.name + '！'); openModal('inventory'); return;
      }

      if (slot === 'offhand' && state.equip.weapon && state.equip.weapon.dualWield) {
        toast('此副手已被雙持武器占用');
        return;
      }

      // 原子化交換：先從背包取走新裝備，再把舊裝備放回背包。
      // 因此即使背包已達 60 格，也能正常「換裝」同一部位。
      const oldEquipped = state.equip[slot] ? {...state.equip[slot]} : null;
      state.inventory.splice(idx, 1);
      if (oldEquipped) state.inventory.push(oldEquipped);
      state.equip[slot] = {...it, slot: rawSlot};
      updateEquipmentVisual(); saveGame();
      toast('裝備 ' + equipmentDisplayName(it) + '！');
      openModal('inventory');
    }
    function unequipItem(slot) {
      const it = state.equip[slot];
      if (!it) return;
      // 卸下裝備本身就是「裝備欄 → 背包」的移動，不再被固定 60 格容量阻擋。
      if (slot === 'weapon' && it.dualWield && state.equip.offhand?.dualWieldPartner === it.id) {
        state.equip.offhand = null;
      }
      state.inventory.push({...it});
      state.equip[slot] = null;
      normalizeEquipmentForClass();
      updateEquipmentVisual();
      saveGame();
      toast('卸下 ' + equipmentDisplayName(it));
      openModal('equip');
    }
    function isStarterEquipment(it) {return !!it && (it.classSet === true || String(it.id || '').startsWith('starter_') || it.id === 'starter_novice_wood_sword');}
    function deleteInventoryItem(id) {
      const idx = state.inventory.findIndex(x => x.id === id);
      if (idx < 0) return;
      const it = state.inventory[idx];
      if (!isStarterEquipment(it)) {toast('只有新手裝備可以直接刪除'); return }
      if (!confirm('確定刪除「' + equipmentDisplayName(it) + '」？\n刪除後無法復原。')) return;
      state.inventory.splice(idx, 1);
      saveGame(); updateUI();
      skillToast('🗑 已刪除 ' + equipmentDisplayName(it));
      openModal('inventory');
    }
    function sellItem(id) {const idx = state.inventory.findIndex(x => x.id === id); if (idx < 0) return; const it = state.inventory[idx]; if (!it.dropable && !isStarterEquipment(it)) {toast('此物品不能販賣'); return } const price = rarityPrice(it); state.gold += price; state.inventory.splice(idx, 1); saveGame(); updateUI(); toast('💰 賣出 ' + equipmentDisplayName(it) + ' +' + price + ' 金幣'); openModal('inventory')}
    function sellAllByRarity(rarity) {let total = 0, count = 0; state.inventory = state.inventory.filter(it => {if ((it.dropable || isStarterEquipment(it)) && it.rarity === rarity && it.type !== 'consumable') {total += rarityPrice(it); count++; return false} return true}); if (count) {state.gold += total; saveGame(); updateUI(); toast('💰 販賣 ' + count + ' 件裝備，獲得 ' + total + ' 金幣')} else toast('沒有可販賣的裝備'); openModal('inventory')}
    function sellAllEquipment() {let total = 0, count = 0; state.inventory = state.inventory.filter(it => {if ((it.dropable || isStarterEquipment(it)) && it.type !== 'consumable') {total += rarityPrice(it); count++; return false} return true}); if (count) {state.gold += total; saveGame(); updateUI(); toast('💰 一鍵販賣 ' + count + ' 件裝備，獲得 ' + total + ' 金幣')} else toast('沒有可販賣的裝備'); openModal('inventory')}
    function seasonInfo() {
      return {
        spring: {name: '春季', foliage: 0x3f9a4b, ground: 0x69a857},
        summer: {name: '夏季', foliage: 0x2f8a3f, ground: 0x69a857},
        autumn: {name: '秋季', foliage: 0xa85a32, ground: 0x8a6b45},
        winter: {name: '冬季', foliage: 0x9fc5ad, ground: 0xdfe8e5}
      };
    }
    function getSeasonId() {
      const e = state.environment || {};
      if (e.seasons === false) return 'none';
      if (e.seasonMode === 'manual' && ['spring', 'summer', 'autumn', 'winter'].includes(e.season)) return e.season;
      const m = new Date().getMonth() + 1;
      return m <= 2 || m === 12 ? 'winter' : m <= 5 ? 'spring' : m <= 8 ? 'summer' : 'autumn';
    }
    function seasonalGroundColor(base) {
      const id = getSeasonId(), info = seasonInfo()[id];
      if (!info) return base;
      const c = new THREE.Color(base);
      const g = new THREE.Color(info.ground);
      c.lerp(g, .18);
      return c.getHex();
    }
    function getZoneSkyColor(zoneId, daylight = 1) {
      const base = (zoneData[zoneId]?.sky ?? 0x86c9f3);
      const c = new THREE.Color(base);
      const d = Math.max(0, Math.min(1, daylight));
      // 白天維持原地圖天空；入夜時天空本身轉為深黑藍，讓「黑」只發生在天空，
      // 城鎮地面則由環境／月光／街燈維持可見度。
      const isOutdoor = !['beastcave'].includes(zoneId);
      if (isOutdoor) {
        const night = 1 - d;
        // 夜晚天空可以真正接近黑色；天空顏色與城鎮物件亮度完全分離。
        // 城鎮仍由環境光、月光、窗燈與街燈提供可見度。
        const target = new THREE.Color(zoneId === 'city' ? 0x000000 : 0x01030a);
        const skyMix = Math.min(1, Math.pow(night, .58) * 1.18);
        c.lerp(target, skyMix);
      }
      return c;
    }

    function getSafeZoneSpawn(zoneId) {
      // 地圖切換後不要固定出生在 (0,0)：火山中央大火山、茶桌、岩石等都可能佔據中心。
      // 先嘗試地圖常用安全點，再用環狀搜尋找出真正沒有碰撞的點。
      const preferred = {
        city: [[0, 0], [0, -12], [0, 12], [-12, 0], [12, 0]],
        snowcity: [[0, 0], [0, -14], [14, 0], [-14, 0], [0, 14]],
        volcano: [[42, -78], [-42, -78], [70, 0], [-70, 0], [0, 78]],
        demon: [[0, -34], [34, 0], [-34, 0], [0, 34], [0, 0]],
        alice1: [[0, -30], [30, 0], [-30, 0], [0, 30], [0, 0]],
        alice2: [[0, -30], [30, 0], [-30, 0], [0, 30], [0, 0]],
        alice3: [[0, -30], [30, 0], [-30, 0], [0, 30], [0, 0]],
        forest: [[0, -30], [30, 0], [-30, 0], [0, 30], [0, 0]],
        miluris: [[0, -30], [30, 0], [-30, 0], [0, 30], [0, 0]],
        seomi: [[0, -30], [30, 0], [-30, 0], [0, 30], [0, 0]]
      }[zoneId] || [[0, -30], [30, 0], [-30, 0], [0, 30], [0, 0]];
      for (const [x, z] of preferred) {if (canEntityMoveTo(x, z, .48)) return {x, z};}
      return findFreeSpawnPosition(0, 0, .48);
    }
    function validatePlayerPosition() {
      if (!state.player) return;
      const p = state.player.position;
      if (!canEntityMoveTo(p.x, p.z, .48)) {
        const safe = getSafeZoneSpawn(state.zone); p.set(safe.x, 0, safe.z);
      }
    }
    function ensureCityMobileWorld() {
      if (state.zone !== 'city') return;
      // 城市正常建造後一定會有 citySurface；若某些 Android Chrome/WebGL 情況下
      // 建造流程被中斷，至少建立一個非常簡單的白色道路＋石地底板，避免只看到天空。
      const hasSurface = state.world.some(o => o?.userData?.citySurface);
      if (!hasSurface) {
        console.warn('City surface missing; creating simplified mobile-safe city floor.');
        const g = new THREE.Group(); g.userData.citySurface = true;
        const ground = new THREE.Mesh(new THREE.PlaneGeometry(109, 109), new THREE.MeshBasicMaterial({color: 0xcfcac0, side: THREE.DoubleSide}));
        ground.rotation.x = -Math.PI / 2; ground.position.y = 0; g.add(ground);
        const roadMat = new THREE.MeshBasicMaterial({color: 0xf4f1e8, side: THREE.DoubleSide});
        for (const z of [-46, -24, 0, 24, 46]) {const r = new THREE.Mesh(new THREE.PlaneGeometry(109, z === 0 ? 7.2 : 4.6), roadMat); r.rotation.x = -Math.PI / 2; r.position.set(0, .012, z); g.add(r)}
        for (const x of [-46, -27, 0, 27, 46]) {const r = new THREE.Mesh(new THREE.PlaneGeometry(x === 0 ? 7.2 : 4.6, 109), roadMat); r.rotation.x = -Math.PI / 2; r.position.set(x, .013, 0); g.add(r)}
        addWorld(g);
      }
      // 手機主城不使用藍色霧把地面洗掉；白天／夜晚的明暗仍由 dayNight() 控制。
      if (isMobileMode() && scene.fog) {scene.fog.near = 55; scene.fog.far = 210;}
    }

    async function goZone(z, opts = {}) {
      if (!zoneData[z] || state.dead) return false;
      if (worldLoadingPromise && opts.loading !== false) return false;
      const started = performance.now();
      const useLoading = opts.loading !== false && shouldShowWorldLoading(z);
      const progressUI = opts.progressUI === true;
      try {
        if (useLoading) {
          showWorldLoading(z === 'city' ? '正在進入阿斯加德 · 路爾斯城……' : '正在載入 ' + zoneData[z].name + ' ……', z);
          await paintWorldProgress(5, '正在切換世界區域……');
        }
        // 換地圖時一定清除舊目標，避免自動戰鬥繼續鎖定已被移除的舊怪物。
        state.zone = z; state.target = null; state.autoTarget = null; state.autoRoamTarget = null; state.autoRoamTimer = 0; state.attackCd = 0; state.potionCd = 0; monsterRespawnTimer = MONSTER_RESPAWN_INTERVAL;
        clearWorld();
        scene.background = getZoneSkyColor(z, 1);
        scene.fog = new THREE.Fog(getZoneSkyColor(z, 1), z === 'city' ? (isMobileMode() ? 55 : 55) : (zoneData[z].snow ? 18 : 45), z === 'city' ? (isMobileMode() ? 210 : 190) : (zoneData[z].snow ? 125 : 210));
        if (useLoading || progressUI) await paintWorldProgress(28, '正在建立地面與道路……');
        buildGround(zoneData[z]);
        ensureCityMobileWorld();
        if (useLoading || progressUI) await paintWorldProgress(52, z === 'city' ? '正在建立阿斯加德 · 路爾斯城建築與森林……' : '正在建立建築與場景物件……');
        buildNPCs(); buildPortals();
        if (z === 'snowcity') {setWeather('snow'); weatherTimer = 99999;} else {weatherTimer = 0;}
        if (useLoading || progressUI) await paintWorldProgress(70, z === 'city' ? '正在整理城市場景與光照……' : '正在配置怪物與出生位置……');
        const safe = getSafeZoneSpawn(z);
        state.player.position.set(safe.x, 0, safe.z);
        if (state.auto) {state.autoAnchorX = safe.x; state.autoAnchorZ = safe.z; state.autoRoamTarget = null;}
        spawnEnemies();
        // Full-map hand-off: mirror the entire generated map hierarchy into PlayCanvas.
        if (window.AsgardPlayCanvasAdapter && fullMapBridge && window.__ASGARD_PC_APP__) {
          fullMapBridge.zone = z;
          // V1.01.19: large maps are mirrored to PlayCanvas over multiple frames.
          // Keep the proven Three.js world visible while the mirror is prepared,
          // then atomically hand visibility to PlayCanvas. This removes the long
          // single-threaded pause without reducing map geometry/material quality.
          if (z === 'city' && typeof window.AsgardPlayCanvasAdapter.syncFullMapV130Async === 'function') {
            worldRoot.visible = true;
            if (pcMapContext?.ok) window.AsgardPlayCanvasAdapter.setFullMapVisibleV104(false);
            const pcSync = await window.AsgardPlayCanvasAdapter.syncFullMapV130Async(fullMapBridge, worldRoot, window.__ASGARD_PC_APP__, {batch: 55});
            if (pcSync?.ok && pcMapContext?.ok) {
              window.AsgardPlayCanvasAdapter.setFullMapVisibleV104(true);
              pcMapVisible = true;
              worldRoot.visible = false;
            }
          } else {
            const pcSync = window.AsgardPlayCanvasAdapter.syncFullMapV130(fullMapBridge, worldRoot, window.__ASGARD_PC_APP__);
            if (pcSync?.ok && pcMapContext?.ok) {
              window.AsgardPlayCanvasAdapter.setFullMapVisibleV104(true);
              pcMapVisible = true;
              worldRoot.visible = false;
            }
          }
        }
        if (state.auto && !state.dead) {
          const zr = zoneData[z]?.range || [1, 100];
          state.autoTarget = nearestEnemy(999, state.autoMinLevel, state.autoMaxLevel, false) || nearestEnemy(999, zr[0], zr[1], false) || null;
          if (!state.autoFightBoss && state.autoTarget?.userData?.boss) state.autoTarget = null;
          state.attackCd = 0;
          if (state.autoTarget) state.target = null;
        }
        updateFrenzyZoneNotice();
        updateTargetPanel(true);
        // 立即套用一次日夜光照與天空，避免主城切換時先露出舊的藍天／未初始化畫面。
        dayNight(0);
        syncGameViewport(isMobileMode());
        if (isMobileMode()) applyMobileCameraProfile(true);
        updateCamera();
        const elapsed = performance.now() - started;
        writeWorldLoadTiming(z, elapsed);
        if (useLoading || progressUI) await paintWorldProgress(88, '正在完成角色、光照與鏡頭設定……');
        // 直接由傳送點／世界地圖切換時，goZone 自己負責完成讀條；
        // 由角色選擇進入遊戲時則交給 startGameFromSelectedCharacter 顯示 100%。
        if (useLoading && !progressUI) {
          await paintWorldProgress(100, zoneData[z].name + ' 已載入完成');
          await waitMs(180);
          hideWorldLoading();
        }
        toast('前往 ' + zoneData[z].name);
        return true;
      } catch (err) {
        console.error('Map change failed', z, err);
        hideWorldLoading();
        throw err;
      }
    }

    function syncPlayCanvasMapCameraV104(){
      if(!pcMapVisible || !pcMapContext?.ok || !window.AsgardPlayCanvasAdapter) return;
      window.AsgardPlayCanvasAdapter.syncFullMapCameraV104(pcMapContext, camera);
    }

    // V1.01.06: passive Character Model V2 transform/walk sync. The Three.js
    // character remains visible and authoritative; PlayCanvas receives only a
    // disabled transform mirror for migration validation.
    let pcCharacterTransformSyncV106=null;
    function syncPlayCanvasCharacterTransformV106(){
      if(!window.AsgardPlayCanvasAdapter || !window.__ASGARD_PC_APP__ || !state.player) return;
      try {
        if(!pcCharacterTransformSyncV106) pcCharacterTransformSyncV106=window.AsgardPlayCanvasAdapter.createCharacterTransformSyncV106(window.__ASGARD_PC_APP__,{name:'AsgardCharacterTransformMirror'});
        if(pcCharacterTransformSyncV106?.ok) window.AsgardPlayCanvasAdapter.syncCharacterTransformV106(pcCharacterTransformSyncV106,state.player,{moving:!!state.walkAnim?.moving,speed:Number(state.walkAnim?.speed)||0});
      } catch(e) { console.warn('V1.01.06 Character Transform sync skipped',e); }
    }

    // V1.01.08: passive weapon/attack-state sync. Three.js Character Model V2 remains authoritative.
    let pcCharacterWeaponAttackSyncV108=null;
    let pcCharacterWeaponAttackVisualTestV115=false;
    function syncPlayCanvasCharacterWeaponAttackV108(){
      if(!window.AsgardPlayCanvasAdapter || !window.__ASGARD_PC_APP__ || !state.player) return;
      try {
        if(!pcCharacterWeaponAttackSyncV108) pcCharacterWeaponAttackSyncV108=window.AsgardPlayCanvasAdapter.createCharacterWeaponAttackSyncV108(window.__ASGARD_PC_APP__,{name:'AsgardCharacterWeaponAttackMirror',visible:false});
        if(pcCharacterWeaponAttackSyncV108?.ok) window.AsgardPlayCanvasAdapter.syncCharacterWeaponAttackV108(pcCharacterWeaponAttackSyncV108,state.player,{equipment:state.equip||{},attack:state.attackAnim||{},moving:!!state.walkAnim?.moving,speed:Number(state.walkAnim?.speed)||0});
      } catch(e) { console.warn('V1.01.08 Character Weapon/Attack sync skipped',e); }
    }


    // V1.01.16: PlayCanvas weapon visuals default; F10 is Three.js fallback.
    function togglePlayCanvasWeaponVisualTestV115(){
      pcCharacterWeaponAttackVisualTestV115=!pcCharacterWeaponAttackVisualTestV115;
      try{
        if(window.AsgardPlayCanvasAdapter&&pcCharacterWeaponAttackSyncV108){
          window.AsgardPlayCanvasAdapter.setCharacterWeaponAttackVisualTestV115(pcCharacterWeaponAttackSyncV108,pcCharacterWeaponAttackVisualTestV115);
        }
      }catch(e){console.warn('V1.01.15 visual test toggle skipped',e);}
      toast(pcCharacterWeaponAttackVisualTestV115?'🟢 PlayCanvas 武器／攻擊 A/B 測試開啟':'⚪ PlayCanvas 武器／攻擊 A/B 測試關閉');
      return pcCharacterWeaponAttackVisualTestV115;
    }
    window.togglePlayCanvasWeaponVisualTestV115=togglePlayCanvasWeaponVisualTestV115;


    // V1.01.17: PlayCanvas Character Model V2 body + class equipment visual integration.
    // The live Three.js model remains authoritative; PlayCanvas mirrors the complete
    // current hierarchy and becomes visible only after a successful frame sync.
    let pcCharacterVisualIntegrationV117=null;
    let pcCharacterVisualFallbackV117=false;
    function syncPlayCanvasCharacterVisualV117(){
      if(!window.AsgardPlayCanvasAdapter || !window.__ASGARD_PC_APP__ || !state.player) return;
      try {
        if(!pcCharacterVisualIntegrationV117) pcCharacterVisualIntegrationV117=window.AsgardPlayCanvasAdapter.createCharacterVisualIntegrationV117(window.__ASGARD_PC_APP__,{name:'AsgardCharacterVisualV117',visible:true});
        if(!pcCharacterVisualIntegrationV117?.ok) return;
        const result=window.AsgardPlayCanvasAdapter.syncCharacterVisualIntegrationV117(
          pcCharacterVisualIntegrationV117,state.player,
          {classId:state.classId,level:state.level,hairStyle:state.hairStyle,armor:state.equip?.armor||null,helmet:state.equip?.helmet||null,cloak:state.equip?.cloak||null,weapon:state.equip?.weapon||null,offhand:state.equip?.offhand||null,moving:!!state.walkAnim?.moving,attack:state.attackAnim||null}
        );
        if(result?.ok && window.AsgardPlayCanvasAdapter.syncCharacterVisualStateV118){
          window.AsgardPlayCanvasAdapter.syncCharacterVisualStateV118(pcCharacterVisualIntegrationV117,{moving:!!state.walkAnim?.moving,speed:Number(state.walkAnim?.speed)||0,attack:state.attackAnim||{}});
        }
        if(result?.ok && !pcCharacterVisualFallbackV117) state.player.visible=false;
      } catch(e) { console.warn('V1.01.17 Character Visual sync skipped',e); if(state.player) state.player.visible=true; }
    }
    // V1.01.24: true first-person visual penetration. When the camera reaches
    // the first-person state, hide the complete Character Model V2 visual stack
    // in BOTH renderers so hair, hat/helmet, body, clothes, cloak, weapon and
    // offhand cannot occlude the view. Restoring third-person re-enables the
    // active renderer without changing equipment or materials.
    let firstPersonVisualStateV124 = null;
    function syncFirstPersonCharacterVisibilityV124(){
      const fp=!!state.cameraFirstPerson;
      if (fp === firstPersonVisualStateV124) return;
      firstPersonVisualStateV124 = fp;
      if(state.player) state.player.visible=fp ? false : !!pcCharacterVisualFallbackV117;
      try{
        if(window.AsgardPlayCanvasAdapter && pcCharacterVisualIntegrationV117){
          window.AsgardPlayCanvasAdapter.setCharacterVisualIntegrationV117(pcCharacterVisualIntegrationV117, fp ? false : !pcCharacterVisualFallbackV117);
        }
      }catch(e){ console.warn('V1.01.24 first-person character visibility skipped',e); }
    }

    function togglePlayCanvasCharacterVisualFallbackV117(){
      pcCharacterVisualFallbackV117=!pcCharacterVisualFallbackV117;
      try{
        if(window.AsgardPlayCanvasAdapter&&pcCharacterVisualIntegrationV117){
          window.AsgardPlayCanvasAdapter.setCharacterVisualIntegrationV117(pcCharacterVisualIntegrationV117,!pcCharacterVisualFallbackV117);
        }
      }catch(e){console.warn('V1.01.17 visual fallback toggle skipped',e);}
      if(state.player) state.player.visible=pcCharacterVisualFallbackV117;
      toast(pcCharacterVisualFallbackV117?'🟡 Three.js Character Model V2 顯示':'🟢 PlayCanvas Character Model V2 顯示');
      return pcCharacterVisualFallbackV117;
    }
    window.togglePlayCanvasCharacterVisualFallbackV117=togglePlayCanvasCharacterVisualFallbackV117;

    // V1.01.10: renderer-neutral attack timeline for the next visible PlayCanvas weapon stage.
    function syncPlayCanvasCharacterAttackTimelineV110(){
      if(!window.AsgardPlayCanvasAdapter || !pcCharacterWeaponAttackSyncV108 || !state.player) return;
      try {
        const weaponFamily = state.equip?.weapon?.family || null;
        window.AsgardPlayCanvasAdapter.syncCharacterAttackTimelineV110(
          pcCharacterWeaponAttackSyncV108,
          state.player,
          {attack:state.attackAnim||{}, weaponFamily, moving:!!state.walkAnim?.moving, speed:Number(state.walkAnim?.speed)||0}
        );
      } catch(e) { console.warn('V1.01.10 Attack timeline sync skipped',e); }
    }

    function renderStatsPanel(tab = 'base') {
      const c = document.getElementById('modalContent');
      // 角色資料只保留「基礎屬性／詳細屬性」兩頁。
      // 所有頁籤按鈕明確指定 type=button，避免任何表單環境觸發重新載入遊戲。
      const maxHp = getMaxHP(), maxMp = getMaxMP(), maxSp = getMaxSP();
      const need = xpToNext();
      const s = state.stats || {str: 0, int: 0, vit: 0, dex: 0, luk: 0};
      const statRows = [['str', '力量', '⚔️', '攻擊 +2 / 點'], ['dex', '敏捷', '💨', '攻速、攻擊提升'], ['vit', '體質', '❤️', '最大HP、防禦、HP回復'], ['int', '智力', '🔮', '最大MP、MP回復'], ['luk', '幸運', '🍀', '暴擊、SP回復']];
      const nav = '<div class="statsTabs">' +
        '<button type="button" class="statsTab ' + (tab === 'base' ? 'active' : '') + '" onclick="renderStatsPanel(\'base\');return false;">基礎屬性</button>' +
        '<button type="button" class="statsTab ' + (tab === 'detail' ? 'active' : '') + '" onclick="renderStatsPanel(\'detail\');return false;">詳細屬性</button>' +
        '</div>';
      let body = '';
      if (tab === 'detail') {
        // 詳細屬性採固定兩欄簡潔排列，純 DOM 更新，不重新開啟遊戲或重新初始化 Three.js。
        const rows = [
          ['物理攻擊', getAttack()], ['魔法攻擊', getMagicAttack()], ['物理防禦', getDefense()], ['魔法防禦', getMagicDefense()],
          ['攻擊速度', getAttackSpeed().toFixed(2) + ' / 秒'], ['暴擊率', getCritRate().toFixed(1) + ' %'],
          ['生命回復', '+' + getHpRegen() + ' / 秒'], ['魔力回復', '+' + getMpRegen() + ' / 秒'],
          ['SP回復', '+' + getSpRegen() + ' / 秒'], ['最大HP', maxHp],
          ['最大MP', maxMp], ['最大SP', maxSp]
        ];
        body = '<div class="statsBlock"><div class="statsInfoGrid">' + rows.map(r =>
          '<div class="statsRow"><span class="statsTag">' + r[0] + '</span><span class="statsValue" style="grid-column:2/4">' + r[1] + '</span></div>'
        ).join('') + '</div></div>';
      } else {
        body = '<div class="statsBlock">' +
          '<div class="statsSectionTitle">Base Lv. <b>Lv.' + state.level + '</b><span style="float:right">' + (state.level >= 100 ? 'MAX' : Math.round(state.xp) + ' / ' + need) + '</span></div>' +
          '<div class="statsProgress"><div class="track"><div class="fill xp" style="width:' + (state.level >= 100 ? 100 : Math.min(100, state.xp / need * 100)) + '%"></div></div></div>' +
          '<div class="statsSectionTitle">❤️ HP <span style="float:right">' + Math.round(state.hp) + ' / ' + maxHp + '</span></div><div class="statsProgress"><div class="track"><div class="fill hp" style="width:' + Math.min(100, state.hp / maxHp * 100) + '%"></div></div></div>' +
          '<div class="statsSectionTitle">🔵 MP <span style="float:right">' + Math.round(state.mp) + ' / ' + maxMp + '</span></div><div class="statsProgress"><div class="track"><div class="fill mp" style="width:' + Math.min(100, state.mp / maxMp * 100) + '%"></div></div></div>' +
          '<div class="statsSectionTitle">🟣 SP <span style="float:right">' + Math.round(state.sp) + ' / ' + maxSp + '</span></div><div class="statsProgress"><div class="track"><div class="fill sp" style="width:' + Math.min(100, state.sp / maxSp * 100) + '%"></div></div></div>' +
          '<div class="statsInfoGrid">' + statRows.map(r =>
            '<div class="statsRow"><span class="statsTag">' + r[2] + ' ' + r[1] + '</span><span class="statsValue">' + (Number(s[r[0]]) || 0) + '</span><button type="button" class="statsAdd" onclick="spendStat(\'' + r[0] + '\');return false;" ' + (state.statPoints <= 0 ? 'disabled' : '') + '>＋</button></div>'
          ).join('') + '</div>' +
          '<div class="statsNote">可用配點：<b style="color:#c28a16;font-size:16px">' + state.statPoints + '</b>　｜　升級配點：Lv.1～49 每級 3 點、Lv.50～79 每級 5 點、Lv.80～100 每級 9 點。</div>' +
          '</div>';
      }
      c.innerHTML = '<div class="statsWindow"><h2>📊 角色資料</h2>' + nav + body + '</div>';
    }

    function skillCooldownText(sk) {const cd = (sk?.type === 'buff' || ['area', 'crossArea', 'healArea'].includes(sk?.type)) ? 10 : 1; return 'CD ' + cd + ' 秒'}
    function renderAutoSettings(c) {
      c.innerHTML = '';
      const wrap = document.createElement('div'); wrap.className = 'autoSettings';
      const title = document.createElement('h2'); title.textContent = '🎯 自動戰鬥設定'; wrap.appendChild(title);
      const intro = document.createElement('p'); intro.className = 'tip'; intro.textContent = '設定完成後按「套用並開始」即可進入自動戰鬥；設定會自動儲存。'; wrap.appendChild(intro);

      const target = document.createElement('div'); target.className = 'autoSection';
      target.innerHTML = '<div class="autoSectionTitle">🎯 目標怪物／掛機範圍</div><div class="autoGrid"><label class="autoField"><span>最低等級</span><input id="autoMin" type="number" min="1" max="100"></label><label class="autoField"><span>最高等級</span><input id="autoMax" type="number" min="1" max="100"></label><label class="autoField"><span>掛機範圍（米）</span><input id="autoRange" type="number" min="3" max="200" step="1"></label></div><div class="autoHint" style="margin-top:8px">以啟動自動戰鬥時的人物位置為中心，只在設定米數內尋找、追擊及巡邏；超出範圍會自動返回中心。</div>';
      wrap.appendChild(target);

      const combat = document.createElement('div'); combat.className = 'autoSection';
      combat.innerHTML = '<div class="autoSectionTitle">⚔️ 戰鬥行為</div><div class="autoGrid"><label class="autoCheck"><input id="autoBuffCheck" type="checkbox"><span>使用 Buff 技能 <small>（Buff 消耗 MP）</small></span></label><label class="autoCheck"><input id="autoAttackSkillCheck" type="checkbox"><span>使用攻擊技能 <small>（近戰攻擊消耗 SP，魔法／遠程消耗 MP）</small></span></label><label class="autoCheck"><input id="autoFightBossCheck" type="checkbox"><span>自動挑戰 Boss</span></label><label class="autoCheck"><input id="autoRecoveryCheck" type="checkbox"><span>HP 低於比例時使用回復技能</span></label><label class="autoField"><span>回復技能 HP 閾值</span><select id="autoRecoverySelect"><option value="30">30%</option><option value="40">40%</option><option value="50">50%</option><option value="60">60%</option><option value="70">70%</option><option value="80">80%</option></select></label></div><div class="autoHint" style="margin-top:8px">回復技能只會使用已學會的「治療／範圍治療」技能；達到 HP 閾值時優先使用回復技能，技能冷卻或 MP 不足時才會改用HP藥水。</div>';
      wrap.appendChild(combat);

      const skillPanel = document.createElement('div'); skillPanel.className = 'autoSection';
      const learnedNow = getLearnedSkills();
      const attackNow = learnedNow.filter(sk => ['attack', 'physical', 'magic', 'ranged', 'combo', 'area', 'crossArea'].includes(sk.type));
      const buffNow = learnedNow.filter(sk => sk.type === 'buff');
      let skillHtml = '<div class="autoSectionTitle">✨ 掛機技能選擇</div><div class="autoHint">勾選的技能才會在自動掛機時使用；取消勾選即可停用該技能。未勾選任何攻擊技能時，會改用普通攻擊。</div><div class="autoSkillGrid">';
      if (!attackNow.length && !buffNow.length) skillHtml += '<div class="autoHint">尚未學會可用於掛機的技能，請先取得技能書。</div>';
      if (attackNow.length) {skillHtml += '<div class="autoSkillGroupTitle">⚔️ 攻擊技能</div>'; for (const sk of attackNow) {const checked = state.autoSkillSelection?.[sk.id] !== false; skillHtml += '<label class="autoSkillCheck"><input class="autoSkillToggle" data-skill-id="' + sk.id + '" type="checkbox" ' + (checked ? 'checked' : '') + '><span>' + hotIconHtml({icon: sk.icon, name: sk.name, art: skillIconArt(sk)}) + ' <b>' + sk.name + '</b><small>' + skillProgressText(sk.id) + ' · ' + getSkillCostType(sk) + ' ' + getSkillCost(sk) + ' · ' + skillCooldownText(sk) + '</small></span></label>';} }
      if (buffNow.length) {skillHtml += '<div class="autoSkillGroupTitle">✨ Buff 技能</div>'; for (const sk of buffNow) {const checked = state.autoSkillSelection?.[sk.id] !== false; skillHtml += '<label class="autoSkillCheck"><input class="autoSkillToggle" data-skill-id="' + sk.id + '" type="checkbox" ' + (checked ? 'checked' : '') + '><span>' + hotIconHtml({icon: sk.icon, name: sk.name, art: skillIconArt(sk)}) + ' <b>' + sk.name + '</b><small>' + skillProgressText(sk.id) + ' · Buff · ' + skillCooldownText(sk) + '</small></span></label>';} }
      skillHtml += '</div><div style="margin-top:8px"><button type="button" class="menuBtn" id="autoSkillAll">☑ 全選</button><button type="button" class="menuBtn" id="autoSkillNone">☐ 全不選</button></div>';
      skillPanel.innerHTML = skillHtml; wrap.appendChild(skillPanel);
      const pickup = document.createElement('div'); pickup.className = 'autoSection'; pickup.innerHTML = '<div class="autoSectionTitle">🎒 撿取設定</div><div class="autoGrid"><label class="autoField"><span>裝備最低品質</span><select id="pickupRarity"><option value="normal">全部裝備</option><option value="rare">稀有以上</option><option value="epic">史詩以上</option><option value="legendary">傳說以上</option></select></label></div><div class="autoHint" style="margin-top:8px">低於設定品質的裝備會留在地上；藥水、魔石、技能書不受此設定影響。</div>'; c.appendChild(pickup);
      const pots = document.createElement('div'); pots.className = 'autoSection';
      pots.innerHTML = '<div class="autoSectionTitle">🧪 自動使用藥水</div><div class="autoGrid"><label class="autoCheck"><input id="autoHpCheck" type="checkbox"><span>自動HP藥水</span></label><label class="autoField"><span>HP 低於</span><select id="autoHpSelect"><option value="30">30%</option><option value="50">50%</option><option value="70">70%</option><option value="80">80%</option></select></label><label class="autoCheck"><input id="autoMpCheck" type="checkbox"><span>自動 MP藥水</span></label><label class="autoField"><span>MP 低於</span><select id="autoMpSelect"><option value="20">20%</option><option value="30">30%</option><option value="50">50%</option><option value="70">70%</option></select></label><label class="autoCheck"><input id="autoSpCheck" type="checkbox"><span>自動 SP藥水</span></label><label class="autoField"><span>SP 低於</span><select id="autoSpSelect"><option value="20">20%</option><option value="30">30%</option><option value="50">50%</option><option value="70">70%</option><option value="80">80%</option></select></label></div><div class="autoHint" style="margin-top:8px">藥水不足時不會消耗；每種藥水最多堆疊 999。</div>';
      wrap.appendChild(pots);

      const status = document.createElement('div'); status.className = 'autoStatus';
      const updateStatus = () => {status.innerHTML = '目前：技能 <b>' + ((state.autoUseBuffSkill ? 'Buff ON' : 'Buff OFF') + ' / ' + (state.autoUseAttackSkill ? '攻擊 ON' : '攻擊 OFF')) + '</b>　·　Boss <b>' + (state.autoFightBoss ? 'ON' : 'OFF') + '</b>　·　回復技 <b>' + (state.autoUseRecoverySkill ? 'ON ≤ ' + state.autoRecoveryThreshold + '%' : 'OFF') + '</b>　·　HP藥水 <b>' + (state.autoUseHpPotion ? 'ON ≤ ' + state.autoHpThreshold + '%' : 'OFF') + '</b>　·　MP藥水 <b>' + (state.autoUseMpPotion ? 'ON ≤ ' + state.autoMpThreshold + '%' : 'OFF') + '</b>　·　目標 Lv.<b>' + state.autoMinLevel + '～' + state.autoMaxLevel + '</b>　·　掛機範圍 <b>' + state.autoRangeMeters + 'm</b>';};
      wrap.appendChild(status);

      const actions = document.createElement('div'); actions.className = 'autoActions';
      const apply = document.createElement('button'); apply.type = 'button'; apply.className = 'menuBtn'; apply.textContent = '💾 套用設定';
      const start = document.createElement('button'); start.type = 'button'; start.className = 'menuBtn ' + (state.auto ? 'stop' : 'start'); start.textContent = state.auto ? '⏹ 停止自動戰鬥' : '▶ 套用並開始';
      const close = document.createElement('button'); close.type = 'button'; close.className = 'menuBtn'; close.textContent = '關閉';
      actions.append(apply, start, close); wrap.appendChild(actions);
      c.appendChild(wrap);

      const pickupEl = document.getElementById('pickupRarity'), minEl = document.getElementById('autoMin'), maxEl = document.getElementById('autoMax'), rangeEl = document.getElementById('autoRange'), buffEl = document.getElementById('autoBuffCheck'), attackSkillEl = document.getElementById('autoAttackSkillCheck'), bossEl = document.getElementById('autoFightBossCheck'), recoveryEl = document.getElementById('autoRecoveryCheck'), recoverySel = document.getElementById('autoRecoverySelect'), hpEl = document.getElementById('autoHpCheck'), hpSel = document.getElementById('autoHpSelect'), mpEl = document.getElementById('autoMpCheck'), mpSel = document.getElementById('autoMpSelect'), spEl = document.getElementById('autoSpCheck'), spSel = document.getElementById('autoSpSelect');
      pickupEl.value = state.pickupMinRarity; minEl.value = state.autoMinLevel; maxEl.value = state.autoMaxLevel; rangeEl.value = state.autoRangeMeters; buffEl.checked = state.autoUseBuffSkill; attackSkillEl.checked = state.autoUseAttackSkill; bossEl.checked = state.autoFightBoss; recoveryEl.checked = state.autoUseRecoverySkill; recoverySel.value = String(state.autoRecoveryThreshold); hpEl.checked = state.autoUseHpPotion; mpEl.checked = state.autoUseMpPotion; spEl.checked = state.autoUseSpPotion; hpSel.value = String(state.autoHpThreshold); mpSel.value = String(state.autoMpThreshold); spSel.value = String(state.autoSpThreshold);
      const skillToggles = [...c.querySelectorAll('.autoSkillToggle')];
      const syncSkillSelection = () => {for (const el of skillToggles) state.autoSkillSelection[el.dataset.skillId] = el.checked;};
      document.getElementById('autoSkillAll')?.addEventListener('click', () => {skillToggles.forEach(el => el.checked = true); syncSkillSelection(); saveGame(); updateStatus();});
      document.getElementById('autoSkillNone')?.addEventListener('click', () => {skillToggles.forEach(el => el.checked = false); syncSkillSelection(); saveGame(); updateStatus();});
      const applySettings = () => {syncSkillSelection(); let min = Math.max(1, Math.min(100, Number(minEl.value) || 1)), max = Math.max(1, Math.min(100, Number(maxEl.value) || 100)); if (min > max) [min, max] = [max, min]; state.autoMinLevel = min; state.autoMaxLevel = max; state.autoRangeMeters = Math.max(3, Math.min(200, Number(rangeEl.value) || 15)); state.autoTarget = null; state.autoUseBuffSkill = buffEl.checked; state.autoUseAttackSkill = attackSkillEl.checked; state.autoFightBoss = bossEl.checked; state.autoTarget = null; state.autoSearchCd = 0; state.autoUseSkill = (buffEl.checked || attackSkillEl.checked); state.autoUseRecoverySkill = recoveryEl.checked; state.autoRecoveryThreshold = Number(recoverySel.value); state.autoRecoverySkillId = 'auto'; state.autoUseHpPotion = hpEl.checked; state.autoUseMpPotion = mpEl.checked; state.autoUseSpPotion = spEl.checked; state.autoHpThreshold = Number(hpSel.value); state.autoMpThreshold = Number(mpSel.value); state.autoSpThreshold = Number(spSel.value); state.pickupMinRarity = pickupEl.value; state.potionCd = 0; saveGame(); updateStatus(); toast('⚙️ 自動戰鬥設定已套用');};
      apply.onclick = () => applySettings();
      start.onclick = () => {applySettings(); if (state.auto) {state.auto = false; state.autoTarget = null; state.autoRoamTarget = null; state.autoAnchorX = null; state.autoAnchorZ = null; saveGame(); toast('⏹ 自動戰鬥 OFF'); renderAutoSettings(c)} else {state.auto = true; state.autoTarget = null; state.autoRoamTarget = null; state.autoSearchCd = 0; state.autoAnchorX = state.player?.position?.x ?? 0; state.autoAnchorZ = state.player?.position?.z ?? 0; saveGame(); toast('⚔ 自動戰鬥 ON · 掛機範圍 ' + state.autoRangeMeters + 'm'); renderAutoSettings(c)} };
      close.onclick = () => closeModal();
    }


    function inventoryCategory(it) {
      if (!it) return 'other';
      const slot = it.slot || it.type;
      if (it.type === 'skillbook') return 'skill';
      if (slot === 'weapon' || it.type === 'weapon') return 'weapon';
      if (slot === 'offhand' || it.type === 'shield' || it.family === 'shield') return 'offhand';
      if (slot === 'helmet' || it.type === 'helmet') return 'helmet';
      if (slot === 'gloves' || it.type === 'gloves') return 'gloves';
      if (slot === 'armor' || it.type === 'armor') return 'armor';
      if (slot === 'shoes' || it.type === 'shoes') return 'shoes';
      if (slot === 'belt' || it.type === 'belt') return 'belt';
      if (slot === 'pants' || it.type === 'pants') return 'pants';
      if (slot === 'cloak' || it.type === 'cloak' || it.divineBlessing) return 'cloak';
      if (slot === 'ring' || slot === 'necklace' || it.type === 'ring' || it.type === 'necklace') return 'accessory';
      return 'other';
    }
    const INVENTORY_CATEGORIES = [
      {id: 'all', label: '全部', icon: '🎒'},
      {id: 'weapon', label: '武器', icon: '⚔️'},
      {id: 'offhand', label: '盾牌', icon: '🛡️'},
      {id: 'helmet', label: '頭盔', icon: '⛑️'},
      {id: 'armor', label: '衣服', icon: '👕'},
      {id: 'gloves', label: '護手', icon: '🧤'},
      {id: 'shoes', label: '鞋子', icon: '🥾'},
      {id: 'belt', label: '腰帶', icon: '🧷'},
      {id: 'pants', label: '腿', icon: '🦵'},
      {id: 'cloak', label: '外套', icon: '🧥'},
      {id: 'accessory', label: '飾品', icon: '💍'},
      {id: 'skill', label: '技能', icon: '📖'},
      {id: 'other', label: '其他', icon: '🧪'}
    ];
    function getEquipmentCompareSlot(it) {
      const sl = it?.slot || it?.type;
      if (['ring1', 'ring2', 'ring3', 'ring4'].includes(sl)) return sl;
      if (sl === 'ring') {
        const equippedRing = ['ring1', 'ring2', 'ring3', 'ring4'].find(k => state.equip[k]);
        return equippedRing || 'ring1';
      }
      if (sl === 'earringL' || sl === 'earringR' || sl === 'earring') return sl === 'earring' ? (state.equip.earringL ? 'earringL' : 'earringR') : sl;
      if (sl === 'glovesL' || sl === 'glovesR' || sl === 'gloves') {
        if (sl === 'glovesL' || sl === 'glovesR') return sl;
        return state.equip.glovesL ? 'glovesL' : 'glovesR';
      }
      if (['armor', 'pants', 'cloak', 'helmet', 'weapon', 'offhand', 'shoes', 'belt', 'necklace'].includes(sl)) return sl;
      return null;
    }
    function compareStatValue(item, key) {return Number(item?.[key] || 0)}
    function compareItem(id) {
      const item = state.inventory.find(x => x.id === id);
      if (!item) {toast('找不到此裝備'); return }
      const slot = getEquipmentCompareSlot(item);
      if (!slot || !EQUIP_SLOTS.includes(slot)) {toast('只有裝備可以比較'); return }
      const equipped = state.equip[slot] || null;
      const c = document.getElementById('modalContent');
      const statDefs = [
        ['攻擊力', 'atk'], ['防禦力', 'def'], ['魔法攻擊', 'matk'], ['魔法防禦', 'mdef'],
        ['暴擊', 'crit'], ['攻擊速度', 'attackSpeed']
      ];
      const label = EQUIP_LABELS[slot] || slot;
      const val = (it, key) => {const n = compareStatValue(it, key); return key === 'attackSpeed' && n ? ((n > 1 ? '+' : '') + n + '%') : String(n)};
      const diff = (key) => compareStatValue(item, key) - compareStatValue(equipped, key);
      const statRows = statDefs.filter(([name, key]) => compareStatValue(item, key) !== 0 || compareStatValue(equipped, key) !== 0).map(([name, key]) => {
        const d = diff(key), cls = d > 0 ? 'up' : d < 0 ? 'down' : 'same', sign = d > 0 ? '+' : '';
        return '<div class="compareStat"><span>' + name + '</span><span class="' + cls + '">' + sign + d + '</span></div>';
      }).join('');
      const rarityName = '';
      const equipText = equipped ? ('<div class="compareCard"><h3>👕 目前裝備 · ' + label + '</h3><div class="compareIcon">' + equipmentIcon(equipped) + '</div><b>' + equipmentDisplayName(equipped) + '</b><div class="compareMeta">' + (equipped.itemLevel ? 'Lv.' + equipped.itemLevel : '') + '</div><div class="compareStats">' + statDefs.filter(([name, key]) => compareStatValue(equipped, key) !== 0).map(([name, key]) => '<div class="compareStat"><span>' + name + '</span><span>' + val(equipped, key) + '</span></div>').join('') + '</div></div>') :
        '<div class="compareCard"><h3>👕 目前裝備</h3><div class="compareIcon">—</div><div class="compareMeta">目前沒有裝備 ' + label + '</div></div>';
      const newText = '<div class="compareCard new"><h3>✨ 新獲得裝備</h3><div class="compareIcon">' + equipmentIcon(item) + '</div><b>' + equipmentDisplayName(item) + '</b><div class="compareMeta">' + rarityName + (item.itemLevel ? ' · Lv.' + item.itemLevel : '') + '</div><div class="compareStats">' + statDefs.filter(([name, key]) => compareStatValue(item, key) !== 0).map(([name, key]) => '<div class="compareStat"><span>' + name + '</span><span>' + val(item, key) + '</span></div>').join('') + '</div></div>';
      const summary = equipped ? ('與目前 ' + label + ' 比較：' + (statRows || '沒有可比較的數值屬性。')) : ('目前沒有裝備同部位物品，這件裝備可直接作為 ' + label + ' 使用。');
      c.innerHTML = '<h2>⚖️ 裝備比較</h2><p class="tip">比較「新獲得裝備」與角色目前同部位裝備的屬性差異。綠色為增加，紅色為減少。</p><div class="compareGrid">' + equipText + '<div class="compareArrow">⇄</div>' + newText + '</div><div class="compareSummary">' + summary + '</div><div class="compareActions"><button id="compareEquipBtn">⚡ 立即換裝</button><button id="compareCloseBtn">關閉</button></div>';
      document.getElementById('compareEquipBtn').onclick = () => {equipItem(item.id);};
      document.getElementById('compareCloseBtn').onclick = () => openModal('inventory');
    }

    function renderInventoryModal(c, selected = 'all', query = '', sort = 'default') {
      hideEquipmentHoverTip();
      const categoryCounts = {all: state.inventory.length};
      for (const cat of INVENTORY_CATEGORIES) {if (cat.id !== 'all') categoryCounts[cat.id] = state.inventory.filter(it => inventoryCategory(it) === cat.id).length;}
      const selectedCat = INVENTORY_CATEGORIES.find(x => x.id === selected) || INVENTORY_CATEGORIES[0];
      let filtered = selected === 'all' ? [...state.inventory] : state.inventory.filter(it => inventoryCategory(it) === selected);
      const q = String(query || '').trim().toLowerCase();
      if (q) filtered = filtered.filter(it => {const n = equipmentDisplayName(it).toLowerCase(), v = String(it.visual || '').toLowerCase(), type = String(it.type || '').toLowerCase(); return n.includes(q) || v.includes(q) || type.includes(q)});
      const rarityOrder = {legendary: 5, epic: 4, rare: 3, good: 2, normal: 1};
      if (sort === 'rarity') filtered.sort((a, b) => (rarityOrder[b.rarity || 'normal'] || 1) - (rarityOrder[a.rarity || 'normal'] || 1));
      else if (sort === 'level') filtered.sort((a, b) => Number(b.itemLevel || 0) - Number(a.itemLevel || 0));
      else if (sort === 'name') filtered.sort((a, b) => equipmentDisplayName(a).localeCompare(equipmentDisplayName(b), 'zh-Hant'));
      else if (sort === 'value') filtered.sort((a, b) => rarityPrice(b) - rarityPrice(a));
      c.innerHTML = '<div class="inventoryHeaderRow"><div><h2>🎒 背包</h2><p class="tip">裝備、藥水、技能書與材料分開管理；腰帶為獨立部位，不會歸入飾品。<span style="opacity:.72">　容量 ' + state.inventory.length + '/60</span></p></div><div class="inventoryGold">💰 ' + state.gold.toLocaleString() + '</div></div>' +
        '<div class="sellAllBar"><b>一鍵販賣：</b><button onclick="sellAllEquipment()">全部裝備</button><button onclick="sellAllByRarity(\'normal\')">普通</button><button onclick="sellAllByRarity(\'rare\')">稀有</button><button onclick="sellAllByRarity(\'epic\')">史詩</button><button onclick="sellAllByRarity(\'legendary\')">傳奇</button></div>' +
        '<div class="inventoryToolbar"><input id="inventorySearchBox" class="inventorySearch" placeholder="🔎 搜尋物品名稱、類型..." value="' + String(query).replace(/"/g, '&quot;') + '"><select id="inventorySortBox" class="inventorySort"><option value="default" ' + (sort === 'default' ? 'selected' : '') + '>排序：最新</option><option value="rarity" ' + (sort === 'rarity' ? 'selected' : '') + '>排序：稀有度</option><option value="level" ' + (sort === 'level' ? 'selected' : '') + '>排序：裝備等級</option><option value="value" ' + (sort === 'value' ? 'selected' : '') + '>排序：販售價</option><option value="name" ' + (sort === 'name' ? 'selected' : '') + '>排序：名稱</option></select></div>' +
        '<div class="inventoryLayout"><aside class="inventorySide"><div class="inventorySideTitle">物品分類</div><div id="inventoryCategoryList"></div></aside><section class="inventoryMain"><div class="inventoryMainHeader"><b>' + selectedCat.icon + ' ' + selectedCat.label + '</b><span class="inventoryCount">顯示 ' + filtered.length + ' / ' + state.inventory.length + ' 件</span></div><div class="bagGrid" id="invgrid"></div></section></div>';
      const tabs = document.getElementById('inventoryCategoryList');
      for (const cat of INVENTORY_CATEGORIES) {const b = document.createElement('button'); b.type = 'button'; b.className = 'invTab' + (cat.id === selected ? ' active' : ''); b.innerHTML = cat.icon + ' ' + cat.label + ' <small>' + categoryCounts[cat.id] + '</small>'; b.title = cat.id === 'belt' ? '腰帶是獨立裝備部位，不屬於飾品' : cat.label; b.onclick = () => renderInventoryModal(c, cat.id, query, sort); tabs.appendChild(b);}
      const search = document.getElementById('inventorySearchBox'); search.oninput = () => renderInventoryModal(c, selected, search.value, document.getElementById('inventorySortBox').value); document.getElementById('inventorySortBox').onchange = e => renderInventoryModal(c, selected, search.value, e.target.value);
      const g = document.getElementById('invgrid'); if (!filtered.length) {g.innerHTML = '<div class="inventoryEmpty">📦 此分類沒有符合條件的物品</div>'; return;}
      for (const it of filtered) {
        const d = document.createElement('div'), rc = equipmentNameClass(it); d.className = 'bagItem rarity-' + (it.rarity || 'normal'); const slot = it.slot || it.type; const categoryText = slot === 'belt' ? '腰帶' : (EQUIP_LABELS[slot] || (it.type === 'skillbook' ? '技能書' : inventoryCategory(it))); const stats = []; if (it.itemLevel) stats.push('Lv.' + it.itemLevel); if (it.atk) stats.push('攻+' + it.atk); if (it.def) stats.push('防+' + it.def); if (it.matk) stats.push('魔攻+' + it.matk); if (it.dropable) stats.push('💰' + rarityPrice(it)); const levelLock = isEquipmentRecord(it) && Number(it.itemLevel) > Number(state.level || 1); if (levelLock) stats.push('🔒 需要Lv.' + it.itemLevel); d.innerHTML = '<div class="icon ' + rc + '">' + equipmentIcon(it) + '</div><b class="' + rc + '">' + equipmentDisplayName(it) + '</b><small>' + categoryText + (it.qty > 1 ? ' · x' + it.qty : '') + (stats.length ? ' · ' + stats.join(' · ') : '') + '</small>'; const btns = document.createElement('div'); btns.className = 'itemBtns';
        if (it.type === 'skillbook') {const lb = document.createElement('button'); lb.textContent = hasSkill(it.skillId, it.classId) ? '已學習' : '學習'; lb.disabled = hasSkill(it.skillId, it.classId); lb.onclick = () => {learnSkill(it.skillId); if (hasSkill(it.skillId, it.classId)) {it.qty--; if (it.qty <= 0) state.inventory = state.inventory.filter(x => x !== it); saveGame(); renderInventoryModal(c, selected, query, sort);} }; btns.appendChild(lb);}
        if (EQUIP_SLOTS.includes(slot)) {const cb = document.createElement('button'); cb.textContent = '比較'; cb.onclick = () => compareItem(it.id); btns.appendChild(cb); const eb = document.createElement('button'); eb.textContent = '裝備'; eb.onclick = () => equipItem(it.id); btns.appendChild(eb);}
        if (it.dropable || isStarterEquipment(it)) {const sb = document.createElement('button'); sb.className = 'sellBtn'; sb.textContent = '販賣'; sb.onclick = () => sellItem(it.id); btns.appendChild(sb);} if (isStarterEquipment(it)) {const db = document.createElement('button'); db.className = 'deleteBtn'; db.textContent = '刪除'; db.onclick = () => deleteInventoryItem(it.id); btns.appendChild(db);} d.appendChild(btns); g.appendChild(d);
      }
    }
    function monsterMoveText(move) {return ({bounce: '跳躍移動', pack: '群體追擊／步行', scout: '巡邏步行', scuttle: '快速爬行', patrol: '巡邏步行', glide: '滑翔', hop: '跳躍', burrow: '鑽地移動', float: '漂浮', heavy: '沉重步行', charge: '衝鋒步行', rooted: '緩慢步行', flutter: '飛行', zigzag: '蛇行追擊'})[move] || move || '一般移動'}
    function monsterAbilityText(type) {const m = {slime: '近距離黏液攻擊。', wolf: '會呼叫附近同族協同追擊。', goblin: '發現玩家後會通知附近同伴。', scorpion: '近距離快速攻擊。', skeleton: '高防禦型近戰亡靈。', dragon: '飛行型龍族，擅長追擊。', mushroom: '低速跳躍型怪物。', bandit: '人型近戰怪物，會主動追擊。', sandworm: '鑽地型蟲族，靠近後攻擊。', ghost: '漂浮型亡靈。', golem: '高防禦、低速的重型怪物。', ram: '會使用衝鋒接近玩家。', treant: '緩慢但耐久的守衛型怪物。', fairy: '高速飛行。', imp: '蛇行追擊並快速接近。', bat: '高速飛行追擊。', icewolf: '會與附近雪狼協同追擊。', crystalbeast: '高防禦重型晶獸。', lava: '高生命重型熔岩怪物。', firebat: '高速飛行型火焰怪物。', snowknight: '冰系近戰步行怪物。', snowmage: '冰系漂浮施法怪物。', snowwolf: '雪狼族群體追擊。', beastknight: '妖貓族近戰步行怪物。', beastmage: '妖貓術士型怪物，蛇行接近。', beastclaw: '妖貓獵手，會與同伴協同追擊。', cardSoldier: '紙牌族長矛兵，使用長矛向前突刺。', cardKnight: '紙牌騎士，近戰追擊並包圍玩家。', cardLancer: '紙牌槍騎兵，使用長矛向前突刺。', cardQueen: '紙牌皇族，巡邏型守衛。', potterWater: '向前尖出的水滴型波特族，漂浮不落地，使用遠距水滴魔彈。', potterSailor: '向前尖出的水滴型波特族，使用黑色電鋸手近戰攻擊。', potterHedgehog: '戴黑黃尖刺頭盔的水滴型波特族，保持水滴身體與尾巴，使用遠距水滴魔彈。', potterKnight: '重裝波特騎士，持盾近戰並穩定追擊。', potterGeneral: '波特族將軍，重裝甲、高攻防近戰怪物。'}; return m[type] || '一般怪物。'}
    function getMonsterDisplayStats(type, level, zoneId) {const base = monsterTypes[type], zone = zoneData[zoneId] || zoneData[state.zone], lv = level || zone?.range?.[0] || base.level || 1; const scale = 1 + Math.max(0, lv - (base.level || 1)) * .085, zonePower = zone?.power || 1, hpMultiplier = zone?.hpMultiplier || 1; return {hp: Math.round(base.hp * scale * zonePower * hpMultiplier * MONSTER_HP_MULTIPLIER), atk: Math.round(base.atk * scale * zonePower), def: Math.round((base.def + Math.max(0, lv - (base.level || 1)) * .35) * zonePower), exp: monsterExpForLevel(lv, zonePower, false, zoneId)}}
    function renderMonsterDex(c, zoneId = state.zone) {const z = zoneData[zoneId], ids = z?.types || [], bossCfg = BOSS_CONFIG[zoneId]; const opts = Object.entries(zoneData).filter(([id, v]) => v.types?.length || BOSS_CONFIG[id]).map(([id, v]) => '<option value="' + id + '" ' + (id === zoneId ? 'selected' : '') + '>' + v.name + (v.range ? ' · Lv.' + v.range[0] + '-' + v.range[1] : '') + '</option>').join(''); let html = '<div class="monsterDexWindow"><h2>📖 怪物圖鑑</h2><p class="tip">查看各地圖怪物的等級、生命、攻擊、防禦、移動方式、仇恨距離、經驗與特殊能力。</p><div class="dexToolbar"><span>地圖：</span><select id="dexZoneSelect">' + opts + '</select></div>'; if (!ids.length && !bossCfg) {html += '<div class="dexEmpty">此地圖沒有怪物。</div></div>'; c.innerHTML = html; return } html += '<div class="dexGrid">'; for (const type of ids) {const base = monsterTypes[type], race = MONSTER_RACE[type] || {}, range = z.range || [base.level, base.level], lo = getMonsterDisplayStats(type, range[0], zoneId), hi = getMonsterDisplayStats(type, range[1], zoneId); html += '<div class="dexCard"><div class="dexHead"><span class="dexName">' + base.name + '</span><span class="dexLevel">Lv.' + range[0] + '～' + range[1] + '</span></div><div class="dexTags"><span class="dexTag">' + (race.race || '未知種族') + '</span><span class="dexTag">' + monsterMoveText(race.move) + '</span></div><div class="dexStats"><span>❤️ HP：<b>' + lo.hp + (lo.hp !== hi.hp ? ' ～ ' + hi.hp : '') + '</b></span><span>⚔️ 攻擊：<b>' + lo.atk + (lo.atk !== hi.atk ? ' ～ ' + hi.atk : '') + '</b></span><span>🛡️ 防禦：<b>' + lo.def + (lo.def !== hi.def ? ' ～ ' + hi.def : '') + '</b></span><span>✨ 經驗：<b>' + lo.exp + (lo.exp !== hi.exp ? ' ～ ' + hi.exp : '') + '</b></span><span>🏃 速度：<b>' + base.speed + '</b></span><span>🎯 仇恨：<b>' + (race.aggro || 0) + ' 格</b></span></div><div class="dexDesc">' + monsterAbilityText(type) + '<br>掉落：' + (base.drop || '一般掉落') + '</div></div>'} if (bossCfg) {const base = monsterTypes[z.types?.[0]] || monsterTypes.slime, top = z.range?.[1] || base.level || 1; html += '<div class="dexCard boss"><div class="dexHead"><span class="dexName">👑 ' + bossCfg.name + '</span><span class="dexLevel">Boss · Lv.' + top + '</span></div><div class="dexTags"><span class="dexTag">Boss</span><span class="dexTag">2×體型</span><span class="dexTag">20×基礎HP</span></div><div class="dexStats"><span>❤️ HP：<b>' + Math.round(base.hp * 20 * MONSTER_HP_MULTIPLIER) + '</b></span><span>⚔️ 攻擊：<b>' + Math.round(base.atk * 1.8) + '</b></span><span>🛡️ 防禦：<b>' + Math.round(base.def * 1.7) + '</b></span><span>✨ 經驗：<b>' + Math.max(1, Math.round(base.exp * 8 * MONSTER_EXP_RATE)) + '</b></span><span>🎯 主動距離：<b>32 格</b></span><span>💎 掉落：<b>傳說裝備</b></span></div><div class="dexDesc"><span class="dexBossSkill">👑 Boss 技能：' + bossCfg.skill.name + '</span><br>倍率 ' + bossCfg.skill.mult + '× · CD ' + bossCfg.skill.cooldown + ' 秒 · 距離 ' + bossCfg.skill.range + ' 格。<br>Boss 會主動接近玩家並攻擊。</div></div>'} html += '</div></div>'; c.innerHTML = html; document.getElementById('dexZoneSelect').onchange = e => renderMonsterDex(c, e.target.value)}
    function showEquipmentDetail(it, slot) {const c = document.getElementById('modalContent'); const stat = [['攻擊力', 'atk'], ['防禦力', 'def'], ['魔法攻擊', 'matk'], ['魔法防禦', 'mdef'], ['暴擊', 'crit'], ['攻速', 'attackSpeed']].filter(x => Number(it?.[x[1]] || 0) !== 0); c.innerHTML = '<h2>⚔️ ' + equipmentDisplayName(it) + '</h2><div class="card"><div style="font-size:46px;text-align:center">' + equipmentIcon(it) + '</div><h3 style="color:#ffe39a">' + (EQUIP_LABELS[slot] || slot) + ' · Lv.' + (it.itemLevel || 1) + '</h3><div class="equipInfoGrid">' + stat.map(x => '<div class="equipInfoStat"><span>' + x[0] + '</span><b>' + it[x[1]] + '</b></div>').join('') + '</div></div><div class="menuActions"><button class="menuBtn" onclick="openModal(\'equip\')">返回裝備欄</button></div>'}

    // 裝備欄實際外觀縮圖：直接使用角色身上相同的 Three.js 裝備模型。
    // 品質／階級造成的形狀、材質、裝飾與特殊效果會反映在縮圖中。
    let equipThumbRenderer = null;
    let equipThumbScene = null;
    let equipThumbCamera = null;
    let equipThumbCanvas = null;

    function ensureEquipmentThumbRenderer() {
      if (equipThumbRenderer) return;
      equipThumbCanvas = document.createElement('canvas');
      equipThumbCanvas.width = 96;
      equipThumbCanvas.height = 96;
      equipThumbRenderer = new THREE.WebGLRenderer({
        canvas: equipThumbCanvas,
        alpha: true,
        antialias: true,
        preserveDrawingBuffer: true
      });
      equipThumbRenderer.setPixelRatio(1);
      equipThumbRenderer.setSize(96, 96, false);
      equipThumbRenderer.setClearColor(0x000000, 0);

      equipThumbScene = new THREE.Scene();
      equipThumbCamera = new THREE.PerspectiveCamera(24, 1, .05, 50);

      equipThumbScene.add(new THREE.AmbientLight(0xffffff, 2.8));
      const key = new THREE.DirectionalLight(0xffffff, 4.0);
      key.position.set(3, 5, 6);
      equipThumbScene.add(key);

      const fill = new THREE.DirectionalLight(0xffffff, 2.2);
      fill.position.set(-4, 2, 4);
      equipThumbScene.add(fill);

      const rim = new THREE.DirectionalLight(0xffe5b5, 1.8);
      rim.position.set(1, 2, -4);
      equipThumbScene.add(rim);
    }

    function buildEquipmentThumbGroup(it, slot) {
      if (!it) return null;

      if (slot === 'weapon') return makeWeaponVisual(it);

      if (slot === 'offhand') {
        if (it.type === 'shield' || it.visual === 'shield' || it.visual === 'towerShield') return makeShieldVisual(it);
        if (it.type === 'weapon') return makeWeaponVisual(it);
        return makeEquipVisual(slot, it);
      }

      if (slot === 'armor') return makeArmorVisual(it.visual || 'leather', it);
      if (slot === 'pants') return makeEquipVisual('pants', it);
      if (slot === 'helmet') return makeEquipVisual('helmet', it);
      if (slot === 'glovesL' || slot === 'glovesR') return makeEquipVisual(slot, it);
      if (slot === 'shoes') return makeEquipVisual('shoes', it);
      if (slot === 'belt') return makeEquipVisual('belt', it);
      if (slot === 'earringL' || slot === 'earringR') return makeEquipVisual(slot, it);
      if (slot === 'necklace' || /^ring/.test(slot)) return makeEquipVisual(slot, it);

      return makeEquipVisual(slot, it);
    }

    function equipmentThumbDataURL(it, slot) {
      try {
        ensureEquipmentThumbRenderer();

        const group = buildEquipmentThumbGroup(it, slot);
        if (!group) return '';

        if (slot === 'armor' && group.userData?.specialEquipmentWings) {
          const wg = group.userData.specialEquipmentWings;
          wg.scale.setScalar(.42);
          wg.position.y -= .18;
        }

        if (slot === 'weapon') group.rotation.y = -Math.PI / 2;
        if (slot === 'offhand' && it.type === 'weapon') group.rotation.y = -Math.PI / 2;

        equipThumbScene.add(group);
        equipThumbScene.updateMatrixWorld(true);

        let box = new THREE.Box3().setFromObject(group);
        let center = box.getCenter(new THREE.Vector3());
        let size = box.getSize(new THREE.Vector3());
        let maxDim = Math.max(size.x, size.y, size.z, .25);

        if ((/^ring/.test(slot) || slot === 'necklace') && maxDim < .90) {
          const boost = .90 / maxDim;
          group.scale.multiplyScalar(boost);
          equipThumbScene.updateMatrixWorld(true);
          box = new THREE.Box3().setFromObject(group);
          center = box.getCenter(new THREE.Vector3());
          size = box.getSize(new THREE.Vector3());
          maxDim = Math.max(size.x, size.y, size.z, .25);
        } else if (maxDim < .62) {
          const boost = .62 / maxDim;
          group.scale.multiplyScalar(boost);
          equipThumbScene.updateMatrixWorld(true);
          box = new THREE.Box3().setFromObject(group);
          center = box.getCenter(new THREE.Vector3());
          size = box.getSize(new THREE.Vector3());
          maxDim = Math.max(size.x, size.y, size.z, .25);
        }

        const distance = maxDim / (2 * Math.tan(THREE.MathUtils.degToRad(13))) + .72;
        equipThumbCamera.position.set(
          center.x + maxDim * .18,
          center.y + maxDim * .10,
          center.z + distance
        );
        equipThumbCamera.lookAt(center);
        equipThumbCamera.near = .01;
        equipThumbCamera.far = Math.max(20, distance + maxDim * 5);
        equipThumbCamera.updateProjectionMatrix();

        equipThumbRenderer.clear();
        equipThumbRenderer.render(equipThumbScene, equipThumbCamera);
        const url = equipThumbCanvas.toDataURL('image/png');

        equipThumbScene.remove(group);

        group.traverse(o => {
          if (o.geometry) o.geometry.dispose();
          if (o.material) {
            if (Array.isArray(o.material)) o.material.forEach(m => m.dispose());
            else o.material.dispose();
          }
        });

        return url;
      } catch (err) {
        console.warn('equipment thumbnail render failed', err);
        return '';
      }
    }


    function equipmentRarityLabel(it) {
      if (it?.specialSeries === 'sacred') return {text: '神聖', cls: 'tipSacred'};
      if (it?.specialSeries === 'demon') return {text: '惡魔', cls: 'tipDemon'};
      const map = {
        normal: {text: '普通', cls: 'tipNormal'},
        good: {text: '精良', cls: 'tipGood'},
        rare: {text: '稀有', cls: 'tipRare'},
        epic: {text: '史詩', cls: 'tipEpic'},
        legendary: {text: '傳說', cls: 'tipLegendary'}
      };
      return map[it?.rarity || 'normal'] || map.normal;
    }
    let equipmentHoverTip = null;
    let equipmentHoverSource = null;
    function ensureEquipmentHoverTip() {
      if (equipmentHoverTip) return equipmentHoverTip;
      equipmentHoverTip = document.createElement('div');
      equipmentHoverTip.className = 'equipHoverTip';
      document.body.appendChild(equipmentHoverTip);
      return equipmentHoverTip;
    }
    function showEquipmentHoverTip(it, slot, e) {
      if (!it) return;
      const tip = ensureEquipmentHoverTip();
      const r = equipmentRarityLabel(it);
      const name = equipmentDisplayName(it);
      const lv = it.itemLevel ? 'Lv.' + it.itemLevel : '';
      tip.innerHTML =
        '<div class="tipName">' + name + '</div>' +
        '<div class="tipRarity ' + r.cls + '">階級：' + r.text + '</div>' +
        (lv ? '<div>' + lv + '</div>' : '') +
        '<div>' + EQUIP_LABELS[slot] + '</div>';
      equipmentHoverSource = e?.currentTarget || e?.target || null;
      tip.style.display = 'block';
      moveEquipmentHoverTip(e);
    }
    function moveEquipmentHoverTip(e) {
      if (!equipmentHoverTip || equipmentHoverTip.style.display === 'none') return;
      const gap = 14;
      let x = e.clientX + gap, y = e.clientY + gap;
      const rect = equipmentHoverTip.getBoundingClientRect();
      if (x + rect.width > window.innerWidth - 8) x = e.clientX - rect.width - gap;
      if (y + rect.height > window.innerHeight - 8) y = e.clientY - rect.height - gap;
      equipmentHoverTip.style.left = Math.max(8, x) + 'px';
      equipmentHoverTip.style.top = Math.max(8, y) + 'px';
    }
    function hideEquipmentHoverTip() {
      equipmentHoverSource = null;
      if (equipmentHoverTip) equipmentHoverTip.style.display = 'none';
    }
    function updateEquipmentHoverFromPointer(e) {
      if (!equipmentHoverTip || equipmentHoverTip.style.display === 'none' || !equipmentHoverSource) return;
      if (!equipmentHoverSource.isConnected) {hideEquipmentHoverTip(); return }
      const r = equipmentHoverSource.getBoundingClientRect();
      const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      if (!inside) {hideEquipmentHoverTip(); return }
      moveEquipmentHoverTip(e);
    }
    document.addEventListener('pointermove', updateEquipmentHoverFromPointer, true);
    document.addEventListener('pointerdown', () => hideEquipmentHoverTip(), true);
    window.addEventListener('blur', hideEquipmentHoverTip);



    let gpt3dViewerObjectUrl = null;
    let gpt3dRotateState = true;
    let gpt3dModelViewerPromise = null;
    function ensureGpt3dModelViewer() {
      if (window.customElements?.get('model-viewer')) return Promise.resolve(true);
      if (gpt3dModelViewerPromise) return gpt3dModelViewerPromise;
      gpt3dModelViewerPromise = import('https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js')
        .then(() => !!window.customElements?.get('model-viewer'))
        .catch(err => {console.warn('Optional model-viewer unavailable:', err); return false;});
      return gpt3dModelViewerPromise;
    }
    let gpt3dEnvironmentState = 0;
    const gpt3dEnvironments = ['neutral', 'legacy', 'https://modelviewer.dev/shared-assets/environments/neutral.hdr'];
    function gpt3dInitViewer() {
      const viewer = document.getElementById('gpt3dViewer');
      const fileInput = document.getElementById('gpt3dFileInput');
      const error = document.getElementById('gpt3dViewerError');
      const status = document.getElementById('gpt3dModelStatus');
      if (!viewer) return;
      gpt3dRotateState = true;
      const btn = document.getElementById('gpt3dRotateBtn');
      if (btn) btn.textContent = '🔄 停止旋轉';
      viewer.addEventListener('progress', e => {
        const bar = viewer.querySelector('.gpt3d-progress i');
        if (bar) bar.style.width = ((e.detail?.totalProgress || 0) * 100) + '%';
      });
      viewer.addEventListener('load', () => {if (error) error.classList.remove('show'); if (status) status.textContent = '模型：' + (viewer.dataset.fileName || 'gpt3D.glb')});
      viewer.addEventListener('error', () => {if (error) error.classList.add('show');});
      if (fileInput) {
        fileInput.onchange = () => {
          const file = fileInput.files?.[0];
          if (!file) return;
          if (gpt3dViewerObjectUrl) URL.revokeObjectURL(gpt3dViewerObjectUrl);
          gpt3dViewerObjectUrl = URL.createObjectURL(file);
          viewer.dataset.fileName = file.name;
          viewer.src = gpt3dViewerObjectUrl;
          if (error) error.classList.remove('show');
          if (status) status.textContent = '模型：' + file.name;
        };
      }
    }
    function gpt3dResetCamera() {
      const v = document.getElementById('gpt3dViewer'); if (!v) return;
      v.cameraOrbit = '0deg 75deg auto'; v.fieldOfView = 'auto';
      if (typeof v.jumpCameraToGoal === 'function') v.jumpCameraToGoal();
    }
    function gpt3dToggleRotate() {
      const v = document.getElementById('gpt3dViewer'); if (!v) return;
      gpt3dRotateState = !gpt3dRotateState; v.autoRotate = gpt3dRotateState;
      const b = document.getElementById('gpt3dRotateBtn'); if (b) b.textContent = gpt3dRotateState ? '🔄 停止旋轉' : '▶️ 開始旋轉';
    }
    function gpt3dToggleLight() {
      const v = document.getElementById('gpt3dViewer'); if (!v) return;
      gpt3dEnvironmentState = (gpt3dEnvironmentState + 1) % 2;
      v.environmentImage = gpt3dEnvironmentState === 0 ? 'neutral' : 'legacy';
      v.exposure = gpt3dEnvironmentState === 0 ? '1.0' : '1.25';
    }


    // ============================================================================
    // MOBILE MODE
    // ============================================================================
    const MOBILE_MODE_KEY = 'aier_3d_mmo_mobile_mode_v1';
    function isMobileMode() {return document.body.classList.contains('mobileMode')}
    function updateMobileModeMenu() {
      const on = isMobileMode();
      const t = document.getElementById('mobileModeMenuText');
      const h = document.getElementById('mobileModeMenuHint');
      const c = document.getElementById('mobileModeMenuCard');
      if (t) t.textContent = on ? '手機模式：開' : '手機模式：關';
      if (h) h.textContent = on ? '觸控版介面已啟用' : '切換手機版操作與介面';
      if (c) c.classList.toggle('active', on);
    }
    function applyMobileCameraProfile(force = false) {
      if (!isMobileMode() || !state.player) return;
      const vw = window.visualViewport?.width || window.innerWidth || 1;
      const vh = window.visualViewport?.height || window.innerHeight || 1;
      const portrait = vh > vw;
      // Chrome Android 直向畫面需要真正的「地面優先」MMORPG 鏡頭。
      // 不再沿用桌面鏡頭距離，避免鏡頭在城鎮上空只看到天空。
      // 手機版回復為一般 MMORPG 自由鏡頭。
      // 初次進入不主動拉近人物，沿用較寬的觀察距離。
      const desiredPitch = portrait ? .72 : .62;
      const desiredDist = 12.5;
      if (force || !state.mobileCameraUserAdjusted) {
        state.cam.pitch = desiredPitch;
        state.cam.dist = desiredDist;
        state.cam.yaw = .55;
        state.mobileCameraUserAdjusted = false;
      }
    }
    function getGameViewportSize() {
      const vv = window.visualViewport;
      const w = Math.max(1, Math.round(vv?.width || window.innerWidth || document.documentElement.clientWidth || 1));
      const h = Math.max(1, Math.round(vv?.height || window.innerHeight || document.documentElement.clientHeight || 1));
      return {w, h};
    }
    function syncGameViewport(forceMobileCamera = false) {
      const {w, h} = getGameViewportSize();
      try {
        const dpr = renderAdapter.getRecommendedPixelRatio
          ? renderAdapter.getRecommendedPixelRatio({profile: 'ultra', mobile: isMobileMode(), devicePixelRatio: window.devicePixelRatio || 1})
          : Math.min(window.devicePixelRatio || 1, 1.5);
        renderAdapter.resizeMainRenderer(renderer, w, h, dpr);
        renderer.domElement.width = Math.max(1, Math.round(w * dpr));
        renderer.domElement.height = Math.max(1, Math.round(h * dpr));
        renderer.domElement.style.width = w + 'px';
        renderer.domElement.style.height = h + 'px';
        renderer.domElement.style.position = 'fixed';
        renderer.domElement.style.left = '0';
        renderer.domElement.style.top = '0';
        renderer.domElement.style.right = 'auto';
        renderer.domElement.style.bottom = 'auto';
        renderer.domElement.style.display = 'block';
        renderer.domElement.style.touchAction = isMobileMode() ? 'none' : 'auto';
        camera.aspect = w / h;
        camera.fov = isMobileMode() ? (h > w ? 48 : 50) : 52;
        camera.updateProjectionMatrix();
        if (forceMobileCamera && isMobileMode()) applyMobileCameraProfile(true);
        if (state.player?.visible) {
          updateCamera();
          dayNight(0);
        }
      } catch (e) {console.warn('viewport sync failed', e)}
    }
    function applyMobileMode(enabled, notify = false) {
      enabled = !!enabled;
      document.body.classList.toggle('mobileMode', enabled);
      try {localStorage.setItem(MOBILE_MODE_KEY, enabled ? '1' : '0')} catch (e) { }
      if (enabled) state.mobileCameraUserAdjusted = false;
      updateMobileModeMenu();
      syncGameViewport(enabled);
      if (notify) skillToast(enabled ? '📱 已切換為手機模式' : '🖥️ 已切換為桌面模式');
    }
    function toggleMobileMode() {applyMobileMode(!isMobileMode(), true)}
    function initMobileMode() {
      let saved = null; try {saved = localStorage.getItem(MOBILE_MODE_KEY)} catch (e) { }
      const touchDevice = ('ontouchstart' in window) || navigator.maxTouchPoints > 0;
      const enabled = saved === null ? touchDevice : saved === '1';
      applyMobileMode(enabled, false);
    }
    function isGameFullscreen() {
      return !!(document.fullscreenElement || document.webkitFullscreenElement);
    }
    async function toggleGameFullscreen() {
      try {
        if (isGameFullscreen()) {
          if (document.exitFullscreen) await document.exitFullscreen();
          else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
        } else {
          const target = document.documentElement;
          if (target.requestFullscreen) await target.requestFullscreen({navigationUI: 'hide'});
          else if (target.webkitRequestFullscreen) target.webkitRequestFullscreen();
          else {
            toast('📱 此瀏覽器不支援網頁全螢幕；iPhone Safari 請使用「加入主畫面」後以 App 模式開啟。');
            return;
          }
        }
      } catch (e) {
        console.warn('fullscreen failed', e);
        toast('⚠️ 瀏覽器拒絕全螢幕，請先點擊遊戲畫面後再按一次「全螢幕」。');
      }
      updateFullscreenUI();
      setTimeout(() => syncGameViewport(false), 120);
    }
    function updateFullscreenUI() {
      const on = isGameFullscreen();
      document.body.classList.toggle('isFullscreen', on);
      const b = document.getElementById('fullscreenBtnMobile');
      if (b) b.innerHTML = on ? '⛶<span>退出全螢幕</span>' : '⛶<span>全螢幕</span>';
      setTimeout(() => syncGameViewport(false), 80);
    }
    document.addEventListener('fullscreenchange', updateFullscreenUI);
    document.addEventListener('webkitfullscreenchange', updateFullscreenUI);

    function mobileCameraNudge(dir) {
      if (!isMobileMode()) return;
      state.cam.yaw += (dir > 0 ? .20 : -.20);
      state.mobileCameraUserAdjusted = true;
      updateCamera();
    }

    function renderModal(type) {openModal(type);}
    function openModal(type) {
      if (type !== 'characterCreate' && type !== 'appearanceAdjust' && type !== 'cloakAdjust' && type !== 'appearanceTransfer') stopCharacterPreview(); const m = document.getElementById('modal'), c = document.getElementById('modalContent'), w = c.parentElement; w.classList.toggle('menuWindow', type === 'menu'); m.classList.add('show');
      if (type === 'quickAssign') {
        const i = Number(window.quickAssignIndex ?? 1); if (i <= 0) {closeModal(); toast('🔒 第1格固定為普攻'); return }
        c.innerHTML = '<h2>⌨ 快捷鍵 ' + (i + 1) + ' 設定</h2><p class="tip">第1格固定為普攻。第2～8格可設定已學會的技能，以及背包中實際擁有的 HP／MP／SP 藥水。技能會使用新版 MMORPG 圖示。</p><div class="quickAssignSection">✨ 已學會技能</div><div id="quickSkillList" class="quickAssignGrid"></div><div class="quickAssignSection">🧪 背包藥水</div><div id="quickPotionList" class="quickAssignGrid"></div><div class="quickAssignSection">🧹 清除</div><div id="quickClearList" class="quickAssignGrid"></div>';
        const skillBox = document.getElementById('quickSkillList'), potionBox = document.getElementById('quickPotionList'), clearBox = document.getElementById('quickClearList');
        const addCard = (box, action, icon, name, sub, art) => {const b = document.createElement('button'); b.type = 'button'; b.className = 'quickAssignCard'; const imgSrc = (typeof icon === 'string' && icon.startsWith('data:image/')) ? icon : null; const visual = art ? '<span class="big quickIconImage"><img src="' + art + '" alt=""></span>' : imgSrc ? '<span class="big quickIconImage"><img src="' + imgSrc + '" alt=""></span>' : '<span class="big">' + icon + '</span>'; b.innerHTML = visual + name + (sub ? '<small>' + sub + '</small>' : ''); b.onclick = () => assignQuickSlot(action); box.appendChild(b)};
        const learned = getLearnedSkills();
        if (!learned.length) skillBox.innerHTML = '<div class="tip">目前沒有已學會技能。請打怪取得 📖 技能書，於背包按「學習」。</div>';
        else learned.forEach(sk => addCard(skillBox, 'skill:' + sk.id, sk.icon || '✨', sk.name, sk.desc + ' · ' + skillProgressText(sk.id) + ' · ' + skillCooldownText(sk), skillIconArt(sk)));
        const potions = state.inventory.filter(it => it.type === 'consumable' && (it.potion === 'hp' || it.potion === 'mp' || it.potion === 'sp') && (it.qty || 0) > 0);
        if (!potions.length) potionBox.innerHTML = '<div class="tip">背包目前沒有可使用的藥水。</div>';
        else potions.forEach(it => addCard(potionBox, 'item:' + it.id, it.icon || '🧪', it.name, '數量：' + (it.qty || 0) + ' / 999'));
        addCard(clearBox, 'empty', '✕', '清空', '移除第' + (i + 1) + '格設定'); return
      }
      if (type === 'rename') {openRenameDialog(); return }
      if (type === 'appearanceTransfer') {renderCharacterAppearanceTransferModal(c); return }
      if (type === 'menu') {c.innerHTML = '<h2>☰ 遊戲功能表</h2><p class="tip">集中管理遊戲系統。</p><div class="menuGrid"><button class="menuCard" onclick="openModal(\'inventory\')"><span class="big">🎒</span>背包<small>I</small></button><button class="menuCard" onclick="openModal(\'equip\')"><span class="big">🛡️</span>裝備欄<small>E</small></button><button class="menuCard" onclick="openModal(\'class\')"><span class="big">⚔️</span>職業資訊<small>C</small></button><button class="menuCard" onclick="openModal(\'map\')"><span class="big">🗺️</span>世界地圖<small>N</small></button><button type="button" class="menuCard" onclick="openModal(\'stats\');return false;"><span class="big">📊</span>角色資料／配點</button><button type="button" class="menuCard" onclick="openModal(\'auto\')"><span class="big">🤖</span>自動戰鬥設定<small>技能／HP藥水／MP藥水／目標等級</small></button><button type="button" class="menuCard" onclick="openModal(\'monsterDex\')"><span class="big">📖</span>怪物圖鑑<small>查看怪物詳細能力</small></button><button type="button" class="menuCard" onclick="openModal(\'characterCreate\')"><span class="big">🧬</span>角色創建<small>男女／身體比例／骨架</small></button><button type="button" class="menuCard" onclick="openModal(\'appearanceTransfer\')"><span class="big">🎨</span>外觀匯出／匯入<small>跨 Browser 搬移自建人物參數</small></button><button type="button" class="menuCard" onclick="openModal(\'hair\')"><span class="big">💇</span>髮型變更<small>六種固定髮型／即時 3D 預覽</small></button><button type="button" class="menuCard" onclick="appearanceAdjustTab=\'cloak\';openModal(\'appearanceAdjust\')"><span class="big">🎨</span>角色外觀調整<small>神佑外套／帽子／手臂武器／3D檢視</small></button><button type="button" class="menuCard" onclick="openModal(\'audio\')"><span class="big">🔊</span>音效設定<small>開關／測試音效</small></button><button type="button" class="menuCard" onclick="openModal(\'environment\')"><span class="big">🌍</span>場景設定<small>日夜／四季變化</small></button><button type="button" class="menuCard mobileModeCard" id="mobileModeMenuCard" onclick="toggleMobileMode();openModal(\'menu\')"><span class="big">📱</span><span id="mobileModeMenuText">手機模式</span><small id="mobileModeMenuHint">切換手機版操作與介面</small></button><button class="menuCard" onclick="saveGame();toast(\'💾 人物進度已儲存\');openModal(\'menu\')"><span class="big">💾</span>儲存進度</button><button class="menuCard" onclick="goZone(\'city\');closeModal()"><span class="big">🏰</span>回主城</button><button class="menuCard" onclick="closeModal()"><span class="big">↩</span>關閉</button></div>'; return }
      if (type === 'characterCreate') {openCharacterCreatorFromMenu(); return }
      if (type === 'armWeaponAdjust') {renderArmWeaponAdjustModal(c); return }
      if (type === 'gpt3d') {
        c.innerHTML = `
 <div id="gpt3dViewerWindow" class="statsWindow">
   <h2>🧍 gpt3D 人物模型</h2>
   <div id="gpt3dViewerWrap">
     <model-viewer id="gpt3dViewer"
       src="gpt3D.glb"
       alt="gpt3D 人物模型"
       camera-controls
       auto-rotate
       rotation-per-second="22deg"
       shadow-intensity="1.5"
       environment-image="neutral"
       exposure="1.0"
       interaction-prompt="auto"
       camera-orbit="0deg 75deg auto"
       min-camera-orbit="auto auto 3m"
       max-camera-orbit="auto auto 30m">
       <div class="gpt3d-progress" slot="progress-bar"><i></i></div>
     </model-viewer>
     <div id="gpt3dViewerError">
       <div class="gpt3d-error-card">
         <div class="big">⚠️</div>
         <h3 style="margin:0 0 7px;color:#ffe39a">找不到 gpt3D.glb</h3>
         <p style="margin:0;color:#bfcbd8;font-size:12px;line-height:1.6">請把 <b style="color:#fff">gpt3D.glb</b> 放在這個 HTML 同一個資料夾，或直接使用下面的「載入 GLB / GLTF」選擇檔案。</p>
       </div>
     </div>
   </div>
   <div class="gpt3d-toolbar">
     <button type="button" onclick="gpt3dResetCamera()">🎯 重設視角</button>
     <button type="button" onclick="gpt3dToggleRotate()" id="gpt3dRotateBtn">🔄 停止旋轉</button>
     <button type="button" onclick="gpt3dToggleLight()">💡 切換照明</button>
     <label>📂 載入 GLB / GLTF<input id="gpt3dFileInput" type="file" accept=".glb,.gltf,model/gltf-binary,model/gltf+json"></label>
     <span id="gpt3dModelStatus" class="model-status">模型：gpt3D.glb</span>
   </div>
   <div class="gpt3d-hint">左鍵拖曳旋轉 · 滾輪縮放 · 右鍵／雙指可平移 · 此預視器獨立於遊戲 Three.js 人物，不會影響戰鬥與裝備系統。</div>
   <div class="menuActions"><button class="menuBtn" onclick="openModal('menu')">↩ 返回功能表</button></div>
 </div>`;
        const wrap = document.getElementById('gpt3dViewerWrap');
        const toolbar = document.querySelector('#gpt3dViewerWindow .gpt3d-toolbar');
        ensureGpt3dModelViewer().then(ok => {
          if (ok) {gpt3dInitViewer(); return;}
          if (wrap) wrap.innerHTML = '<div class="gpt3d-load-fallback"><div class="big">🧍</div><h3>GLB / GLTF 預覽器未載入</h3><p>目前遊戲人物不受影響。你仍可使用「角色創建」直接調整 Character Model V2。</p><p style="font-size:12px;color:#9eacbd">如果需要 GLB 預覽，請確認網路可以載入 model-viewer 元件。</p></div>';
          if (toolbar) toolbar.style.display = 'none';
        });
        return;
      }
      if (type === 'monsterDex') {renderMonsterDex(c, state.zone); return }
      if (type === 'audio') {
        c.innerHTML = '<h2>🔊 音效設定</h2>' + '<p class="tip">如果遊戲內完全沒有聲音，請先按「🔊 開啟並測試」。瀏覽器通常需要一次實際的滑鼠點擊才能允許網頁播放聲音。</p>' + '<div class="settingsBlock">' + '<label class="settingRow"><span><b>🔊 遊戲音效</b><small>控制普攻、技能、怪物受擊、Boss 與升級音效。</small></span><input id="audioEnabled" type="checkbox" ' + (gameAudioEnabled ? 'checked' : '') + '></label>' + '</div><div class="menuActions"><button type="button" class="menuBtn start" id="audioTest">🔊 開啟並測試</button><button type="button" class="menuBtn" id="audioApply">💾 套用</button><button type="button" class="menuBtn" onclick="closeModal()">關閉</button></div>';
        const audioEl = document.getElementById('audioEnabled');
        document.getElementById('audioApply').onclick = () => {gameAudioEnabled = audioEl.checked; if (gameAudioEnabled) enableAndTestGameAudio(); else toast('🔇 遊戲音效已關閉');};
        document.getElementById('audioTest').onclick = () => {audioEl.checked = true; enableAndTestGameAudio();};
        return
      }
      if (type === 'environment') {
        const e = state.environment || {dayNight: true, seasons: true, seasonMode: 'auto', season: 'summer'};
        c.innerHTML = '<h2>🌍 場景設定</h2>' +
          '<p class="tip">控制世界是否顯示日夜與四季場景變化。日夜會依目前時間循環；四季可跟隨現實月份或手動指定。</p>' +
          '<div class="settingsBlock">' +
          '<label class="settingRow"><span><b>🌗 日夜場景變化</b><small>依時間自動切換白天、黃昏與夜晚</small></span><input id="envDayNight" type="checkbox" ' + (e.dayNight !== false ? 'checked' : '') + '></label>' +
          '<label class="settingRow"><span><b>🌸 四季場景變化</b><small>改變樹木、地面及季節特效</small></span><input id="envSeasons" type="checkbox" ' + (e.seasons !== false ? 'checked' : '') + '></label>' +
          '<div class="settingRow"><span><b>📅 四季模式</b><small>自動依月份：春3–5月、夏6–8月、秋9–11月、冬12–2月</small></span><select id="envSeasonMode"><option value="auto">跟隨現實月份</option><option value="manual">手動指定</option></select></div>' +
          '<div class="settingRow"><span><b>🍃 指定季節</b><small>只有選擇「手動指定」時生效</small></span><select id="envSeason"><option value="spring">🌸 春季</option><option value="summer">☀️ 夏季</option><option value="autumn">🍂 秋季</option><option value="winter">❄️ 冬季</option></select></div>' +
          '</div><div class="menuActions"><button type="button" class="menuBtn" id="envApply">💾 套用設定</button><button type="button" class="menuBtn" onclick="closeModal()">關閉</button></div>';
        const dn = document.getElementById('envDayNight'), se = document.getElementById('envSeasons'), mode = document.getElementById('envSeasonMode'), season = document.getElementById('envSeason');
        mode.value = e.seasonMode || 'auto'; season.value = e.season || 'summer'; mode.onchange = () => {season.disabled = mode.value !== 'manual'}; season.disabled = mode.value !== 'manual';
        document.getElementById('envApply').onclick = () => {
          state.environment = {dayNight: dn.checked, seasons: se.checked, seasonMode: mode.value, season: season.value};
          const pos = state.player ? state.player.position.clone() : new THREE.Vector3(0, 0, 0);
          clearWorld(); scene.background = getZoneSkyColor(state.zone, 1); scene.fog = new THREE.Fog(getZoneSkyColor(state.zone, 1), state.zone === 'city' ? 55 : 45, state.zone === 'city' ? 190 : 210);
          buildGround(zoneData[state.zone]); buildNPCs(); buildPortals(); if (state.player) state.player.position.copy(pos); spawnEnemies();
          weatherObj = null; weatherTimer = 0; updateWeather(0); dayNight(); saveGame(); updateUI(); closeModal();
          toast('🌍 場景設定已套用：' + (state.environment.dayNight ? '日夜 ON' : '日夜 OFF') + ' · ' + (state.environment.seasons ? (seasonInfo()[getSeasonId()]?.name || '四季 ON') : '四季 OFF'));
        };
        return;
      }
      if (type === 'inventory') {renderInventoryModal(c, 'all'); return }
      if (type === 'equip') {
        normalizeEquipmentForClass(); updateEquipmentVisual(); c.innerHTML = '<h2>🛡 裝備欄</h2><p class="tip">全新 MMORPG 裝備配置。支援 <b>項鍊、左耳、帽、右耳、主武、身、副武、4 個戒指、腰帶、腿、外套、手套1、鞋、手套2</b>。裝備欄目前全部清空，可使用「一鍵換裝最佳裝備」從背包重新配置。</p><div class="equipActionBar"><button id="autoEquipAllBtn">⚡ 一鍵換裝最佳裝備</button></div><div class="equipScreen"><div class="equipBoard"><div class="equipCenterMark">♙</div><div class="equipGrid" id="equipGrid"></div></div><div class="bagPanel"><h3>角色裝備資訊</h3><div class="equipInfoGrid"><div class="equipInfoStat"><span>攻擊</span><b>' + getAttack() + '</b></div><div class="equipInfoStat"><span>防禦</span><b>' + getDefense() + '</b></div><div class="equipInfoStat"><span>裝備數量</span><b>' + EQUIP_SLOTS.filter(k => state.equip[k]).length + ' / ' + EQUIP_SLOTS.length + '</b></div><div class="equipInfoStat"><span>職業</span><b>' + ((classes[state.classId]?.name) || '初心者') + '</b></div></div><div class="equipInfoNote">🎩 頭部：帽<br>⚔️ 武器：主武／副武<br>🥋 身體：身／腿<br>🧥 額外：神佑外長外套（獨立於身體裝備）<br>🧤 手部：手套1／手套2<br>👢 腳部：鞋<br>🧷 腰部：腰帶<br>📿 頸部：項鍊<br>💎 耳部：左耳／右耳<br>💍 戒指：戒1～戒4</div></div></div>'; document.getElementById('autoEquipAllBtn').onclick = autoEquipAllBest; const eg = document.getElementById('equipGrid'); for (const slot of EQUIP_SLOTS) {
          const it = state.equip[slot], d = document.createElement('div'); d.className = 'equipSlot' + (it ? '' : ' empty') +
            (it?.rarity ? ' rarity-' + it.rarity : '') +
            (it?.specialSeries === 'sacred' ? ' special-sacred' : it?.specialSeries === 'demon' ? ' special-demon' : it?.specialSeries === 'divineBlessing' ? ' special-blessed' : ''); d.title = it ? '' : EQUIP_LABELS[slot];
          const offhandBlocked = (slot === 'offhand' && isTwoHandedWeapon(state.equip.weapon) && !it);
          if (offhandBlocked) d.classList.add('disabled');
          d.onmouseenter = e => {if (it) showEquipmentHoverTip(it, slot, e)};
          d.onmousemove = e => {if (it) moveEquipmentHoverTip(e)};
          d.onmouseleave = hideEquipmentHoverTip;
          const thumb = it ? equipmentThumbDataURL(it, slot) : '';
          d.innerHTML = (it?.specialSeries === 'sacred'
            ? '<span class="equipSpecialBadge sacred" title="神聖裝備">✦</span>'
            : it?.specialSeries === 'demon'
              ? '<span class="equipSpecialBadge demon" title="惡魔裝備">☠</span>'
              : it?.specialSeries === 'divineBlessing'
                ? '<span class="equipSpecialBadge sacred" title="神佑裝備">✦</span>'
                : '') +
            '<div class="slotLabel">' + EQUIP_LABELS[slot] + '</div>' +
            (it && thumb
              ? '<div class="equipThumbWrap"><img class="equipThumb" src="' + thumb + '" alt="' + equipmentDisplayName(it) + '"></div>'
              : '<div class="icon">' + (it ? equipmentIcon(it) : EQUIP_ICONS[slot]) + '</div>') +
            '<b>' + (it ? equipmentDisplayName(it) : '空') + '</b><small>' +
            (it ? ((it.itemLevel ? 'Lv.' + it.itemLevel : '') + ' ' + (it.atk ? '攻+' + it.atk + ' ' : '') + (it.def ? '防+' + it.def : '')) : '') +
            '</small>'; if (it) {const b = document.createElement('button'); b.className = 'unequip'; b.textContent = '卸'; b.title = '卸下裝備'; b.onclick = e => {e.stopPropagation(); unequipItem(slot)}; d.appendChild(b)} d.onclick = () => {if (it) showEquipmentDetail(it, slot); else if (offhandBlocked) toast('⚔️ 雙手武器使用中：副手不可裝備')}; eg.appendChild(d)
        } return
      }
      if (type === 'hair') {renderHairModal(c); return }
      if (type === 'hat') {renderHatAdjustModal(c); return }
      if (type === 'cloakAdjust') type = 'appearanceAdjust';
      if (type === 'appearanceAdjust') {
        const a = getCloakAdjustments();
        const row = (key, label, min, max, step, val, unit = '×') => '<div class="hatAdjustRow"><div class="hatAdjustLabel"><b>' + label + '</b><span id="cloak_' + key + 'Value">' + Number(val).toFixed(2) + (unit === '×' ? '×' : '') + '</span></div><input type="range" min="' + min + '" max="' + max + '" step="' + step + '" value="' + val + '" oninput="setCloakAdjustment(\'' + key + '\',this.value)"></div>';
        const cloakPanel = '<div class="settingsBlock hatAdjustPanel">' + row('scale', '🔍 整體大小', .90, 1.80, .01, a.scale) + row('width', '↔ 外套寬度', .85, 1.55, .01, a.width) + row('height', '↕ 外套高度', .90, 1.55, .01, a.height) + row('depth', '◈ 前後厚度', .80, 1.45, .01, a.depth) + row('z', '↔ 前後位置', -.60, .60, .01, a.z, '') + row('y', '⬍ 上下位置', -.30, .20, .01, a.y, '') + '<div class="tip" style="margin-top:8px">預設：0.97×／0.89×／1.13×／1.45×／-0.08／-0.09。外套、披肩與長袖會跟著人物骨骼。</div></div>' +
          '<div class="menuActions" style="margin-top:10px"><button type="button" class="menuBtn" onclick="resetCloakAdjustments()">↺ 還原外套預設</button></div>';
        const helmet = state.equip?.helmet, visual = helmet?.visual || '';
        let hatPanel = '';
        if (!helmet) {
          hatPanel = '<div class="settingsBlock"><div class="tip">目前沒有裝備帽子／頭盔，因此沒有可調整的帽子。</div></div>';
        } else {
          const h = getHatAdjust(visual);
          const hrow = (key, label, min, max, step, value) => '<div class="hatAdjustRow"><div class="hatAdjustLabel"><b>' + label + '</b><span id="cloakHat_' + key + 'Value">' + (key === 'scale' ? Number(value).toFixed(2) + '×' : Number(value).toFixed(2)) + '</span></div><input type="range" min="' + min + '" max="' + max + '" step="' + step + '" value="' + value + '" oninput="setHatAdjustment(\'' + key + '\',this.value)"></div>';
          hatPanel = '<div class="settingsBlock hatAdjustPanel">' + hrow('x', '↔ 左右', -.35, .35, .01, h.x) + hrow('y', '↕ 上下', -.45, .45, .01, h.y) + hrow('z', '↕ 前後', -.45, .45, .01, h.z) + hrow('scale', '🔍 大小', .75, 2.10, .01, h.scale) + '<div class="tip" style="margin-top:8px">目前帽子：<b>' + ((helmet.name || '頭部裝備')) + '</b><br>調整會即時同步到遊戲人物與此 3D 預覽。</div></div><div class="menuActions" style="margin-top:10px"><button type="button" class="menuBtn" onclick="resetHatAdjustmentInAppearance()">↺ 還原帽子預設</button></div>';
        }
        const active = ['hat','arms'].includes(appearanceAdjustTab) ? appearanceAdjustTab : 'cloak';
        const tabStyle = 'display:flex;gap:8px;margin:8px 0 12px;';
        const tabBtn = (id, label) => '<button type="button" class="menuBtn" style="flex:1;border-color:' + (active === id ? '#e8bd54' : '#3d5066') + ';background:' + (active === id ? 'rgba(232,189,84,.16)' : 'rgba(16,27,40,.75)') + '" onclick="setAppearanceAdjustTab(\'' + id + '\')">' + label + '</button>';
        const armsCid = ARM_WEAPON_ADJUST_CLASSES.includes(window.armWeaponAdjustEditorClass) ? window.armWeaponAdjustEditorClass : (ARM_WEAPON_ADJUST_CLASSES.includes(state.classId) ? state.classId : 'warrior');
        window.armWeaponAdjustEditorClass = armsCid;
        window.armWeaponAdjustActiveTab = ['armL','armR','weaponL','weaponR'].includes(window.armWeaponAdjustActiveTab) ? window.armWeaponAdjustActiveTab : 'armL';
        const ap = getArmWeaponProfile(armsCid);
        const ar = (path,label,min,max,step,val) => awSlider(path,label,min,max,step,val);
        const armPanel = '<div class="settingsBlock">' +
          '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px">' +
          ARM_WEAPON_ADJUST_CLASSES.map(id => '<button type="button" class="menuBtn" style="flex:1;min-width:80px;border-color:'+(id===armsCid?'#e8bd54':'#3d5066')+'" onclick="window.armWeaponAdjustEditorClass=\''+id+'\';renderModal(\'appearanceAdjust\')">'+(classes[id]?.name||id)+'</button>').join('') +
          '</div>' + getArmWeaponCurrentEquipmentMarkup(armsCid) +
          '<p class="tip">目前角色 Character Model V2 預覽。以下四個 Tab 一次只調整一個部位；滑桿會即時同步正式人物。</p>' +
          '<div style="display:flex;gap:6px;margin:10px 0 12px;flex-wrap:nowrap">' +
          ['armL','armR','weaponL','weaponR'].map((id,i)=>{const labels=['⬅ 左手臂','➡ 右手臂','🛡 左手武器／盾','⚔ 右手武器'];return '<button type="button" class="menuBtn" style="flex:1;min-width:0;padding:10px 6px;border-color:'+(window.armWeaponAdjustActiveTab===id?'#e8bd54':'#3d5066')+';background:'+(window.armWeaponAdjustActiveTab===id?'rgba(232,189,84,.14)':'rgba(15,24,36,.72)')+';color:'+(window.armWeaponAdjustActiveTab===id?'#f2d88a':'#c8d5e4')+'" onclick="window.armWeaponAdjustActiveTab=\''+id+'\';renderModal(\'appearanceAdjust\')">'+labels[i]+'</button>';}).join('') +
          '</div>' +
          (function(){
            const part=window.armWeaponAdjustActiveTab;
