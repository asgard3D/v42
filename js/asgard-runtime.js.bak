    function statPointsForLevel(lv) {return lv <= 49 ? 3 : (lv <= 79 ? 5 : 9)}
    function addLevelStatPoints(fromLevel, toLevel) {let gained = 0; for (let lv = fromLevel + 1; lv <= toLevel; lv++)gained += statPointsForLevel(lv); state.statPoints += gained; return gained}
    function spendStat(stat) {if (!['str', 'int', 'vit', 'dex', 'luk'].includes(stat) || state.statPoints <= 0) return; if (state.stats[stat] >= 999) return; state.stats[stat]++; state.statPoints--; state.hp = Math.min(state.hp, getMaxHP()); state.mp = Math.min(state.mp, getMaxMP()); state.sp = Math.min(state.sp, getMaxSP()); updateUI(); saveGame(); openModal('stats')}
