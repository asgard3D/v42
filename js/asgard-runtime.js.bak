        const pupil = mesh(new THREE.CircleGeometry(.028, 20), hexMat(0x17202c, .30, .01));
        pupil.position.set(0, -.004, .009);
        pupil.userData.eyePart = 'pupil';
        eg.add(pupil);
        const hi = mesh(new THREE.CircleGeometry(.018, 12), white);
        hi.position.set(-.030, .032, .014);
        hi.scale.set(1, .92, 1);
        hi.userData.eyePart = 'highlight';
        eg.add(hi);
        const hi2 = mesh(new THREE.CircleGeometry(.007, 10), white);
        hi2.position.set(.030, -.025, .014);
        hi2.userData.eyePart = 'highlight2';
        eg.add(hi2);
        eg.userData.faceEye = true;
        eg.userData.eyeIndex = idx;
        eg.userData.eyeParts = {sclera, iris, pupil, hi, hi2};
        faceEyes.push(eg);
        add(eg);
      });
      // V8.12：嘴巴改成貼臉的「微笑弧線」，位置下移；不使用凸出的圓環。
      const mouth = mesh(new THREE.TorusGeometry(.070, .014, 6, 14, Math.PI), new THREE.MeshBasicMaterial({color: 0x7b3540, transparent: true, opacity: .9, depthWrite: false}));
      mouth.position.set(0, 1.93, .519);
      mouth.rotation.set(0, 0, Math.PI);
      mouth.scale.set(.78, -.50, 1);
      mouth.userData.faceMouth = true;
      add(mouth);
      // V37：眉毛獨立建模，之後可用精調參數改長度／厚度／弧度／位置／角度。
      const makeBrow = (side) => {
        const pts = [new THREE.Vector3(-.082, 0, 0), new THREE.Vector3(0, .010, 0), new THREE.Vector3(.082, 0, 0)];
        const cv = new THREE.CatmullRomCurve3(pts, false, 'catmullrom', .65);
        const tube = new THREE.TubeGeometry(cv, 10, .007, 6, false);
        const bg = new THREE.Group(); bg.name = side < 0 ? 'BrowL' : 'BrowR';
        const bm = mesh(tube, hexMat(0x33272b, .55, .01));
        bm.userData.faceBrow = true; bm.userData.browSide = side; bm.renderOrder = 21; bg.add(bm);
        bg.userData.faceBrowGroup = true; bg.userData.browSide = side; bg.userData.browMesh = bm; return bg;
      };
      const browL = makeBrow(-1), browR = makeBrow(1); add(browL); add(browR);
      // 頸部與短版胸甲：不再使用藍色圓筒。
      const neck = add(mesh(new THREE.CylinderGeometry(.17, .19, .20, 12), skin)); neck.position.y = 1.70;
      // V8.00：身體改為貼身的漏斗型輪廓，上寬下窄，不再使用胸口方塊。
      // 這個基礎身體只負責角色輪廓；胸口只由實際職業裝備的水晶呈現。
      // V8.20：初心者基礎胸身改為窄身圓筒，移除原本 ConeGeometry 造成的下方三角錐。
      const torso = add(mesh(new THREE.CylinderGeometry(.40, .44, .72, 18), ivory)); torso.position.y = 1.37; torso.scale.set(.96, 1, .72);
      // V8.24：將原本落在雙腿中間的腰身件上移，正式作為初心者裙甲／下擺甲。
      const waistShape = add(mesh(new THREE.CylinderGeometry(.38, .43, .24, 16), ivory));
      // V8.30：初心者裙甲固定在上身下緣／腰部，絕不落到膝下。
      waistShape.position.set(0, 1.24, .02);
      waistShape.scale.set(.94, .78, .72);
      waistShape.userData.noviceWaistArmor = true;
      // 肩甲與短袖。
      const shoulderL = add(mesh(new THREE.SphereGeometry(.23, 12, 10), green)); shoulderL.scale.set(.96, .66, .78); shoulderL.position.set(-.51, 1.55, 0);
      const shoulderR = shoulderL.clone(); shoulderR.position.x = .55; add(shoulderR);
      // 腰帶與中央掛飾。
      const belt = add(mesh(new THREE.CylinderGeometry(.43, .46, .13, 16), leather)); belt.position.y = .91;
      const buckle = add(mesh(new THREE.BoxGeometry(.18, .18, .07), gold)); buckle.position.set(0, .91, .53);
      // 不再使用中央方形掛片，避免衣服中央看起來像方塊。
      // 貼身褲／腿甲：沿腿形包覆，不再使用粗圓筒。
      const legL = new THREE.Group(), legR = new THREE.Group(); legL.position.set(-.205, .78, 0); legR.position.set(.205, .78, 0);
      const thighMat = mat(0x4b3030, .62), tightArmor = mat(0x6b6e73, .42, .25), trim = mat(0xc2a15b, .38, .42);
      // V8.31：腿部改成較厚的褲筒輪廓，讓內部骨架／白色方塊不會從褲子接縫露出。
      const thighL = mesh(new THREE.CapsuleGeometry(.175, .48, 8, 12), thighMat); thighL.position.y = -.11; thighL.scale.set(1.02, 1, .96); legL.add(thighL);
      const thighR = thighL.clone(); legR.add(thighR);
      const armorL = mesh(new THREE.CapsuleGeometry(.17, .42, 8, 12), tightArmor); armorL.position.y = -.04; armorL.scale.set(1.00, 1, .90); legL.add(armorL);
      const armorR = armorL.clone(); legR.add(armorR);
      const trimL = mesh(new THREE.TorusGeometry(.145, .025, 6, 12), trim); trimL.position.set(0, .14, 0); trimL.rotation.x = Math.PI / 2; legL.add(trimL); const trimR = trimL.clone(); legR.add(trimR);
      const shinL = mesh(new THREE.CapsuleGeometry(.15, .43, 8, 12), leather2); shinL.position.y = -.47; shinL.scale.set(1.02, 1, .94); legL.add(shinL); const shinR = shinL.clone(); legR.add(shinR);
      const shoeL = mesh(new THREE.SphereGeometry(.235, 16, 11), boots); shoeL.scale.set(1.15, .66, 1.65); shoeL.position.set(0, -.80, .20); legL.add(shoeL); const shoeR = shoeL.clone(); legR.add(shoeR);
      const soleL = mesh(new THREE.BoxGeometry(.40, .075, .58), mat(0x171515, .9)); soleL.position.set(0, -.92, .15); legL.add(soleL); const soleR = soleL.clone(); legR.add(soleR);
      // 手臂：上臂、護腕、手掌分離，武器掛在手掌。
      const armL = new THREE.Group(), armR = new THREE.Group(); armL.position.set(-.49, 1.50, 0); armR.position.set(.49, 1.50, 0);
      const upperL = mesh(new THREE.CapsuleGeometry(.105, .30, 7, 10), leather2); upperL.position.y = -.17; armL.add(upperL); const upperR = upperL.clone(); armR.add(upperR);
      const foreL = mesh(new THREE.CapsuleGeometry(.092, .31, 7, 10), leather); foreL.position.y = -.49; armL.add(foreL); const foreR = foreL.clone(); armR.add(foreR);
      const gloveL = mesh(new THREE.SphereGeometry(.14, 12, 9), boots); gloveL.position.y = -.78; armL.add(gloveL); const gloveR = gloveL.clone(); armR.add(gloveR);
      // HUMAN BODY SKIN SHELL V1：以肉色關節外殼遮蔽上臂／前臂、手腕與腿部接縫。
      // 外殼跟隨現有 arm/leg Group，不新增骨架，也不改變原本動畫。
      const skinShell = new THREE.Group(); skinShell.name = 'SkinJointShell';
      const skinJointMat = mat(0xd9a17f, .72, .02);
      const makeSkinJoint = (radius, scaleY = 1) => {const m = mesh(new THREE.SphereGeometry(radius, 14, 10), skinJointMat); m.scale.set(1, scaleY, 1); m.userData.skinJointShell = true; return m;};
      const elbowSkinL = makeSkinJoint(.125, 1.05); elbowSkinL.position.set(0, -.34, .01); armL.add(elbowSkinL);
      const elbowSkinR = elbowSkinL.clone(); elbowSkinR.position.copy(elbowSkinL.position); armR.add(elbowSkinR);
      const wristSkinL = makeSkinJoint(.105, .92); wristSkinL.position.set(0, -.665, .015); armL.add(wristSkinL);
      const wristSkinR = wristSkinL.clone(); wristSkinR.position.copy(wristSkinL.position); armR.add(wristSkinR);
      const hipSkinL = makeSkinJoint(.145, 1.12); hipSkinL.position.set(0, .03, .0); legL.add(hipSkinL);
      const hipSkinR = hipSkinL.clone(); hipSkinR.position.copy(hipSkinL.position); legR.add(hipSkinR);
      const kneeSkinL = makeSkinJoint(.135, 1.08); kneeSkinL.position.set(0, -.34, .015); legL.add(kneeSkinL);
      const kneeSkinR = kneeSkinL.clone(); kneeSkinR.position.copy(kneeSkinL.position); legR.add(kneeSkinR);
      const ankleSkinL = makeSkinJoint(.11, .95); ankleSkinL.position.set(0, -.69, .04); legL.add(ankleSkinL);
      const ankleSkinR = ankleSkinL.clone(); ankleSkinR.position.copy(ankleSkinL.position); legR.add(ankleSkinR);
      const guardL = mesh(new THREE.BoxGeometry(.18, .20, .22), steel); guardL.position.set(0, -.58, .02); armL.add(guardL); const guardR = guardL.clone(); armR.add(guardR);
      armL.rotation.set(-.58, .0, .13); armR.rotation.set(-.38, .0, -.13);
      // 武器握持點與手套中心完全共用同一個位置，避免武器漂浮／偏離手掌。
      // 手套中心：local (0,-.78,0)；WeaponMount 只負責承載武器，不再自行偏移。
      const weaponMountR = new THREE.Group(); weaponMountR.name = 'WeaponHandR'; weaponMountR.position.set(0, -.78, 0); armR.add(weaponMountR);
      const weaponMountL = new THREE.Group(); weaponMountL.name = 'WeaponHandL'; weaponMountL.position.set(0, -.78, 0); armL.add(weaponMountL);
      weaponMountR.userData.handGrip = 'gloveCenter';
      weaponMountL.userData.handGrip = 'gloveCenter';
      // V1.01.21: explicit renderer ownership roots for hand-held weapon/shield visuals.
      const weaponVisualRootR = window.AsgardEngineBridge.createWeaponVisualRoot(weaponMountR, 'R');
      const weaponVisualRootL = window.AsgardEngineBridge.createWeaponVisualRoot(weaponMountL, 'L');
      const shieldVisualRootL = window.AsgardEngineBridge.createShieldVisualRoot(weaponMountL, 'L');
      weaponMountR.userData.weaponVisualRoot = weaponVisualRootR;
      weaponMountL.userData.weaponVisualRoot = weaponVisualRootL;
      weaponMountL.userData.shieldVisualRoot = shieldVisualRootL;
      const sword = mesh(new THREE.BoxGeometry(.10, 1.0, .14), gold); sword.visible = false; sword.position.set(0, .45, 0);
      const classVisuals = new THREE.Group(); classVisuals.name = 'ClassVisuals';
      const equipment = new THREE.Group(); equipment.name = 'EquipmentVisuals';
      // V1.01.21：手持武器／盾牌視覺由 Engine Bridge 管理 ownership。
      // EquipmentVisuals 本身保持原有 local transform 與資料引用，避免改變
      // 頭盔、衣服、翅膀、鞋子、腰帶等既有外觀與裝備規則。
      const equipmentRoot = window.AsgardEngineBridge.createEquipmentRoot(g);
      equipmentRoot.add(equipment);
      // haircap 已經屬於 HairStyles，絕對不能再次 g.add(haircap)，否則會脫離髮型模組。
      g.add(head, neck, torso, shoulderL, shoulderR, belt, buckle, legL, legR, armL, armR, sword, skinShell, classVisuals);
      skinShell.userData.isHumanOnlySkinShell = true;
      g.userData.parts = {body: torso, head, neck, haircap, hairStyles, earL, earR, armL, armR, foreL, foreR, gloveL, gloveR, wristSkinL, wristSkinR, guardL, guardR, legL, legR, skinShell, shortL: armorL, shortR: armorR, shoeL, shoeR, soleL, soleR, sword, classVisuals, equipmentRoot, equipment, weaponMountR, weaponMountL, weaponVisualRootR, weaponVisualRootL, shieldVisualRootL, animationRoot: characterAnimationRoot, animationController: characterAnimationController, faceEyes, mouth, faceBrows: [browL, browR], classBase: [torso, waistShape, shoulderL, shoulderR, belt, upperL, upperR, foreL, foreR, gloveL, gloveR, thighL, thighR, armorL, armorR, shinL, shinR, shoeL, shoeR], noviceWaistArmor: waistShape};
      // V8.27：初心者裙甲保留並上移到腰部，避免落到雙腿之間。
      if (state.classId === 'novice') {waistShape.visible = true; waistShape.userData.noviceWaistArmor = true;}
      g.userData.faceAnim = {timer: 1.6 + Math.random() * 2.8, blink: 0};
      g.position.set(0, 0, 0); scene.add(g); enableCharacterShadows(g); state.parts = g.userData.parts; markCharacterModelV2(g); return g;
    }

    // V14 FIX: global helper. The previous build accidentally nested this
    // function inside buildLegacyCharacterModelV2(), so startup calls could not
    // resolve it and stopped with "syncHeadLocalHairGroups is not defined".
    function syncHeadLocalHairGroups(hairStyles) {
      if (!hairStyles) return;
      const sy = Number.isFinite(hairStyles.scale?.y) && hairStyles.scale.y > 0 ? hairStyles.scale.y : 1;
      hairStyles.children.forEach(group => {
        if (!group?.userData?.hairHeadLocal) return;
        group.position.set(0, 2.18 * (1 - sy), 0);
        group.scale.set(.73, .84, .70);
      });
    }
    /* ============================================================================
       CHARACTER MODEL V2 — CANONICAL FACTORY
       The creator preview and the live RPG player MUST come from this factory.
       The legacy body builder above only supplies the low-level geometry; this
       layer owns the canonical profile, rig references, starter appearance and
       all transform baselines.
       ============================================================================ */
    const CHARACTER_MODEL_V2_PROFILE = {
      version: '2.2',
      rootScale: .88,
      preview: {distance: 5.35, lookY: 1.28, fov: 30},
      gender: {
        male: {shoulder: .93, chest: .94, waist: .91, hip: .93, upperArm: .90, forearm: .88, thigh: .94, calf: .92, foot: .95, headWidth: .96, headHeight: .94, headDepth: .94},
        female: {shoulder: .92, chest: 1.00, waist: .94, hip: 1.08, upperArm: .94, forearm: .96, thigh: 1.04, calf: .97, foot: .96, headWidth: .96, headHeight: .96, headDepth: .94}
      }
    };
    function canonicalCharacterProfile(gender = 'male') {
      const base = {...CHARACTER_CUSTOM_DEFAULTS};
      Object.assign(base, CHARACTER_MODEL_V2_PROFILE.gender[gender === 'female' ? 'female' : 'male']);
      return base;
    }
    function clearStarterEquipmentForCharacterCreation() {
      if (!state.equip) return;
      // V2 baseline is the clean creator body: no armor/helmet/accessories.
      // The beginner wooden sword is starter inventory only; no weapon is equipped by default.
      for (const slot of EQUIP_SLOTS) {
        if (slot !== 'weapon' && state.equip[slot]) {
          const it = state.equip[slot];
          if (it && state.inventory && state.inventory.length < 60) state.inventory.push(it);
          state.equip[slot] = null;
        }
      }
      ensureNoviceStarterGear();
    }
    function finalizeCharacterModelV2(g) {
      if (!g?.userData?.parts) return g;
      g.userData.characterModelVersion = CHARACTER_MODEL_V2_PROFILE.version;
      g.userData.characterRig = {
        root: g,
        head: g.userData.parts.head || null,
        neck: g.userData.parts.neck || null,
        chest: g.userData.parts.body || null,
        pelvis: g.userData.parts.noviceWaistArmor || null,
        leftArm: g.userData.parts.armL || null,
        rightArm: g.userData.parts.armR || null,
        leftLeg: g.userData.parts.legL || null,
        rightLeg: g.userData.parts.legR || null,
        leftHand: g.userData.parts.armL?.userData?.hand || null,
        rightHand: g.userData.parts.armR?.userData?.hand || null,
        weaponMountR: g.userData.parts.weaponMountR || null,
        weaponMountL: g.userData.parts.weaponMountL || null,
        weaponVisualRootR: g.userData.parts.weaponVisualRootR || null,
        weaponVisualRootL: g.userData.parts.weaponVisualRootL || null,
        shieldVisualRootL: g.userData.parts.shieldVisualRootL || null,
        hair: g.userData.parts.hairStyles || null,
        equipment: g.userData.parts.equipment || null,
        classVisuals: g.userData.parts.classVisuals || null
      };
      return g;
    }
    function makePlayer() {
      const g = buildLegacyCharacterModelV2();
      finalizeCharacterModelV2(g);
      applyArmWeaponAdjustmentsToModel();
      // Canonical V2 root scale. All later customization is relative to this.
      g.scale.setScalar(CHARACTER_MODEL_V2_PROFILE.rootScale);
      g.userData.characterCustomization = {...canonicalCharacterProfile(state.gender || 'male'), gender: state.gender || 'male'};
      return g;
    }
    function makeUnderwearOutfit() {
      const g = new THREE.Group(); g.name = 'UnderwearOutfit';
      const white = mat(0xf4f5f1, .78, .02), white2 = mat(0xdfe4e7, .72, .04), trim = mat(0xffffff, .62, .01);
      const add = (o, x = 0, y = 0, z = 0) => {o.position.set(x, y, z); g.add(o); return o};
      // MMORPG 基礎內衣：乾淨、貼身、無職業識別，男女共用同一套基礎服裝。
      const top = add(mesh(new THREE.CapsuleGeometry(.43, .44, 6, 12), white), 0, 1.36, .02); top.scale.set(1.00, .80, .74);
      const collar = add(new THREE.Mesh(new THREE.TorusGeometry(.285, .025, 7, 20), trim), 0, 1.69, .015); collar.rotation.x = Math.PI / 2;
      const waist = add(mesh(new THREE.CylinderGeometry(.36, .39, .12, 14), white2)); waist.scale.set(1, .82, .76); waist.position.set(0, 1.08, .02);
      const waistband = add(new THREE.Mesh(new THREE.TorusGeometry(.405, .028, 7, 24), white2), 0, 1.00, .02); waistband.rotation.x = Math.PI / 2; waistband.scale.set(1, .76, 1);
      for (const sx of [-1, 1]) {
        const sleeve = add(mesh(new THREE.CapsuleGeometry(.105, .30, 6, 9), white), sx * .50, 1.39, .01); sleeve.scale.set(1, .92, .88); sleeve.rotation.z = sx * .08;
        const cuff = add(mesh(new THREE.CylinderGeometry(.115, .115, .10, 10), white2), sx * .51, 1.18, .01); cuff.rotation.z = sx * .08;
        const shorts = add(mesh(new THREE.BoxGeometry(.30, .25, .34), white), sx * .23, .88, .02); shorts.scale.set(.95, 1, .82);
        const legBand = add(new THREE.Mesh(new THREE.TorusGeometry(.17, .022, 6, 16), trim), sx * .23, .76, .03); legBand.rotation.x = Math.PI / 2; legBand.scale.set(1, .82, 1);
      }
      g.userData.underwearOutfit = true;
      return g;
    }

    function makeClassOutfit(type, level = state.previewOutfitLevel || state.level || 1) {
      const g = new THREE.Group(); g.name = 'ClassOutfit_' + (type || 'warrior');
      const cls = PLAYABLE_CLASS_IDS.includes(type) ? type : 'warrior';
      const idx = classOutfitTierIndex(level);
      const palettes = {
        warrior: {base: 0x111116, dark: 0x07080b, deep: 0x241016, accent: 0x7f1828, accent2: 0xb52b3b, trim: 0xc99a35, gem: 0xe43b50},
        priest: {base: 0xe8e8e2, dark: 0x202733, deep: 0x111823, accent: 0x284f87, accent2: 0x477fba, trim: 0xd5ae4b, gem: 0x54a7e8},
        mage: {base: 0x15161b, dark: 0x080a0d, deep: 0x13271d, accent: 0x1e6b45, accent2: 0x3aa76c, trim: 0xc79b39, gem: 0x4edc82},
        thief: {base: 0x121419, dark: 0x07080c, deep: 0x21142a, accent: 0x633a93, accent2: 0x9b61d0, trim: 0xc59a3e, gem: 0xb178ff},
        monk: {base: 0x131417, dark: 0x09090b, deep: 0x2a1718, accent: 0x8a272d, accent2: 0xb84237, trim: 0xd1a13c, gem: 0xffc43e}
      };
      const p = palettes[cls];
      const main = mat(p.base, .86, .10), dark = mat(p.dark, .92, .08), deep = mat(p.deep, .84, .08), accent = mat(p.accent, .72, .12), accent2 = mat(p.accent2, .64, .16), trim = mat(p.trim, .28, .55);
      const gemMat = new THREE.MeshStandardMaterial({color: p.gem, emissive: p.gem, emissiveIntensity: .85 + idx * .08, roughness: .20, metalness: .10});
      const add = (o) => {o.userData.classOutfit = true; g.add(o); return o};
      const cloth = (geo, m, x, y, z, sx = 1, sy = 1, sz = 1, rz = 0) => {const o = add(mesh(geo, m)); o.position.set(x, y, z); o.scale.set(sx, sy, sz); o.rotation.z = rz; return o;};
      const capsule = (r, l, m, x, y, z, sx = 1, sy = 1, sz = 1, rz = 0) => cloth(new THREE.CapsuleGeometry(r, l, 8, 16), m, x, y, z, sx, sy, sz, rz);
      const panel = (m, x, y, z, topW, bottomW, h, depth = .045, rz = 0) => {
        const sh = new THREE.Shape(); sh.moveTo(-topW / 2, h / 2); sh.quadraticCurveTo(-bottomW * .44, 0, -bottomW / 2, -h / 2); sh.lineTo(bottomW / 2, -h / 2); sh.quadraticCurveTo(bottomW * .44, 0, topW / 2, h / 2); sh.closePath();
        const geo = new THREE.ExtrudeGeometry(sh, {depth, bevelEnabled: true, bevelSegments: 1, bevelSize: .006, bevelThickness: .004, curveSegments: 2});
        const o = cloth(geo, m, x, y, z, 1, 1, 1, rz); o.userData.classClothPanel = true; return o;
      };
      const gem = (x, y, z, size = .075) => {const o = add(mesh(new THREE.OctahedronGeometry(size, 1), gemMat)); o.position.set(x, y, z); o.rotation.set(.2, Math.PI / 4, .08); o.userData.classCrystal = true; return o;};
      const diamond = (x, y, z, w, h, m = trim) => {const sh = new THREE.Shape(); sh.moveTo(0, h / 2); sh.lineTo(w / 2, 0); sh.lineTo(0, -h / 2); sh.lineTo(-w / 2, 0); sh.closePath(); const o = add(mesh(new THREE.ShapeGeometry(sh), m)); o.position.set(x, y, z); o.userData.classInsetTrim = true; return o;};
      const emblem = () => {
        const root = new THREE.Group(); root.position.set(0, 1.34, .40); root.userData.classEmblem = true; g.add(root);
        const ring = new THREE.Mesh(new THREE.TorusGeometry(.105, .012, 6, 24), trim); root.add(ring);
        if (cls === 'warrior') {
          const shield = mesh(new THREE.OctahedronGeometry(.065, 0), accent2); shield.scale.set(.75, 1.2, .30); shield.position.z = .008; root.add(shield);
          const s1 = mesh(new THREE.BoxGeometry(.025, .18, .018), trim); s1.rotation.z = .55; root.add(s1); const s2 = s1.clone(); s2.rotation.z = -.55; root.add(s2);
        } else if (cls === 'priest') {
          const v = mesh(new THREE.BoxGeometry(.032, .20, .018), trim); root.add(v); const h = mesh(new THREE.BoxGeometry(.16, .032, .018), trim); h.position.y = .02; root.add(h);
        } else if (cls === 'mage') {
          const r = new THREE.Mesh(new THREE.TorusGeometry(.06, .012, 6, 18), accent2); r.rotation.x = Math.PI / 2; root.add(r);
          const dot = mesh(new THREE.OctahedronGeometry(.035, 0), gemMat); dot.position.z = .015; root.add(dot);
        } else if (cls === 'thief') {
