      if (out.type === 'weapon' && !out.slot) out.slot = 'weapon'; if (out.type === 'shield') out.slot = 'offhand'; if (out.type === 'offhand') out.slot = 'offhand'; if (out.type === 'helmet') out.slot = 'helmet'; if (out.type === 'armor') out.slot = 'armor'; if (out.type === 'pants') out.slot = 'pants'; if (out.type === 'gloves') out.slot = 'gloves'; if (out.type === 'shoes') out.slot = 'shoes'; if (out.type === 'belt') out.slot = 'belt'; if (out.type === 'earring') out.slot = 'earring'; if (out.type === 'ring') out.slot = 'ring'; if (out.type === 'necklace') out.slot = 'necklace'; if (out.type === 'cloak') out.slot = 'cloak'; if (out.divineBlessing || out.slot === 'cloak') {out.type = 'cloak'; out.slot = 'cloak'; out.specialSeries = 'divineBlessing'; out.rarity = 'normal'; out.itemLevel = divineCloakLevelForCharacter(out.itemLevel || 1); out.visual = 'divineCloak';}
      return out;
