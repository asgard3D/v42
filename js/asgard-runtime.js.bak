    const LEGACY_BAG_IDS = new Set(['sword1', 'sword2', 'staff1', 'armor1', 'armor2', 'armor3', 'ring1', 'monk_glove_start', 'helmet_start', 'glove_start', 'pants_start', 'boots_start', 'neck_start']);
    function isWindGlasses(it) {
