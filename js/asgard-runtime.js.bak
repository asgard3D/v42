          const whiteLongHairMat = mat(0xf7f8f5, .90, .012);
          const whiteHairShadeMat = mat(0xd8dee5, .84, .018);

          // 白色狼尾：髮根真正藏進狼帽後下緣，只讓下半段露出；維持目前長度，增加束數並集中成自然尖尾。
          // z 值向帽體內收，避免髮束像獨立物件浮在帽子外面。
          const wolfTailLocks = [
            [-.27, -.255, -.535, .082, .39, .040],
