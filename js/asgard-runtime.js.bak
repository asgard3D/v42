        if (Array.isArray(d.quickSlots)) {state.quickSlots = d.quickSlots.slice(0, 8).concat(Array(8).fill(null)).slice(0, 8); state.quickSlots[0] = 'attack';}
        state.inventory = Array.isArray(d.inventory) ? d.inventory.map(normalizeItemRecord).filter(Boolean) : [];
