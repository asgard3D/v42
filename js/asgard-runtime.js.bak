    function renderCharacterCreatePreviewValues() {const c = getCharacterCustomization(); for (const [k, v] of Object.entries(c)) {const el = document.getElementById('ccv_' + k); if (el) el.textContent = Number(v).toFixed(2) + '×'; const r = document.getElementById('ccr_' + k); if (r) r.value = v;} const g = document.getElementById('ccGenderLabel'); if (g) g.textContent = state.gender === 'female' ? '♀ 女性' : '♂ 男性';}
    let ccPreview = {active: false, renderer: null, scene: null, root: null, camera: null, raf: 0, player: null, host: null, yaw: 0, pitch: .08, dist: 4.1, drag: false, lastX: 0, lastY: 0, modelYaw: 0, autoRotate: false};
