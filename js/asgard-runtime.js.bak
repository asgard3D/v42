        for (let i = 0; i < 10; i++) {const q = mesh(new THREE.BoxGeometry(.08, .08, .26), new THREE.MeshBasicMaterial({color, transparent: true})); const a = i * Math.PI * 2 / 10; q.position.set(Math.cos(a) * .45, .02, Math.sin(a) * .45); q.rotation.y = a; g.add(q)}
