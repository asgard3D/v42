      const base = pool.filter(Boolean).find(x => x.visual === gear.visual) || pool.find(Boolean) || {};
      const gearVisual = (gear.visual || base.visual || 'sword');
      // 戰士從 Lv.1 起只使用單手劍；不再產生任何雙手劍／闊劍。
      if (kind === 'weapon' && cls === 'warrior') {
        gear = {name: dropLevel <= 1 ? '戰士單手劍' : (gear.name || '戰士單手劍'), icon: '🗡️', visual: 'sword', family: 'sword', twoHanded: false, atk: gear.atk || 8};
      }
