      const light = liquid === '#ef3340' ? '#ff5a62' : '#4aa5ff';
      return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">' +
        '<path d="M25 7h14v8H25z" fill="#c79a55" stroke="#3b2a16" stroke-width="2"/>' +
        '<path d="M21 14h22v7H21z" fill="#e5d5b5" stroke="#3b2a16" stroke-width="2"/>' +
        '<path d="M18 21h28c3 0 5 3 5 6v18c0 8-7 13-19 13S13 53 13 45V27c0-3 2-6 5-6z" fill="' + liquid + '" stroke="#2b2430" stroke-width="3"/>' +
        '<path d="M19 30c6-4 20-4 27 0v13c0 6-5 9-14 9s-13-3-13-9z" fill="' + dark + '" opacity=".65"/>' +
        '<path d="M22 27c3-3 7-4 10-4" stroke="' + light + '" stroke-width="4" stroke-linecap="round" fill="none"/>' +
        '<circle cx="24" cy="31" r="3" fill="#fff" opacity=".8"/>' +
        '</svg>'
      );
    }
    let HP_POTION_ICON_SRC = simplePotionIconSvg('#ef3340');
    let MP_POTION_ICON_SRC = simplePotionIconSvg('#2f80ed');
    let SP_POTION_ICON_SRC = simplePotionIconSvg('#f2c500');
    // ============================================================================
    // V1.01.31 — CHARACTER ARM / WEAPON ADJUSTER
    // 每個職業獨立保存：左右手臂 + 左右武器/盾牌的位置與旋轉。
    // 設定只作用於 Character Model V2，不更換人物模型。
    // ============================================================================
    const ARM_WEAPON_ADJUST_VERSION = 1;
    const ARM_WEAPON_ADJUST_CLASSES = ['warrior','monk','mage','priest','thief'];
    const ARM_WEAPON_ADJUST_DEFAULT = {position:{x:0,y:0,z:0},rotation:{x:0,y:0,z:0}};
    // V1.01.38: Mage adjustment baseline imported from the user's V1.01.35 JSON.
    // These are adjustment offsets, not a replacement character pose.
    const MAGE_ARM_WEAPON_JSON_BASELINE = {
      armL:{position:{x:-0.04,y:-0.07,z:-0.02},rotation:{x:0.59,y:-1.52,z:0}},
      armR:{position:{x:0.02,y:-0.03,z:0},rotation:{x:-1.81,y:-0.75,z:0}},
      weaponL:{position:{x:0,y:0,z:0},rotation:{x:0,y:0,z:0}},
      weaponR:{position:{x:0,y:0,z:0},rotation:{x:0,y:0,z:0}}
    };
    // V1.01.30 R2 mage orb pose — shared by live Character Model V2 and 3D appearance preview.
