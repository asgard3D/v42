lls: state.learnedSkills, skillLevels: state.skillLevels, buffs: Object.fromEntries(Object.entries(state.buffs || {}).map(([id, b]) => [id, {...b, remaining: Math.max(0, Number(b.until) - performance.now()), until: undefined}])), eliteKills: state.eliteKills, inventory: state.inventory.map(serializeItem), equip: Object.fromEntries(EQUIP_SLOTS.map(k => [k, serializeItem(state.equip[k])])), position: state.player ? {x: state.player.position.x, y: state.player.position.y, z: state.player.position.z} : null};
    }
    function saveGame() {
      if (!activeCharacterSlot || !state.characterCreated) return;
      try {sanitizeEquipmentLevelRules(); const data = buildSaveData(); writeCharacterSlot(activeCharacterSlot, data); localStorage.setItem(SAVE_KEY, JSON.stringify(data)); localStorage.setItem(ACTIVE_CHARACTER_SLOT_KEY, String(activeCharacterSlot));} catch (err) {console.warn('saveGame failed', err)}
    }
    function loadGame(slot = activeCharacterSlot) {
