      : Math.min(devicePixelRatio, 1.5);
    renderAdapter.configureMainRenderer(renderer, {width: innerWidth, height: innerHeight, pixelRatio: initialDpr, shadows: true, toneMapping: true, exposure: 1.0});
    renderer.domElement.style.width = '100%'; renderer.domElement.style.height = '100%'; renderer.domElement.style.zIndex = '2'; document.getElementById('game').appendChild(renderer.domElement);
    // V1.01.27: keep the renderer at maximum practical fidelity while
    // automatically protecting frame pacing during heavy scenes/effects.
    const renderPerformanceGovernor = renderAdapter.createRenderPerformanceGovernor
      ? renderAdapter.createRenderPerformanceGovernor({mobile: /Android|iPhone|iPad|iPod/i.test(navigator.userAgent), devicePixelRatio: devicePixelRatio})
      : null;
    const clock = new THREE.Clock();
    const hemi = new THREE.HemisphereLight(0xb9e6ff, 0x35562e, 1.65); scene.add(hemi);
    const sun = new THREE.DirectionalLight(0xffffff, 2.4); sun.castShadow = true; sun.shadow.mapSize.set(1024, 1024); sun.shadow.camera.near = 1; sun.shadow.camera.far = 180; sun.shadow.camera.left = -70; sun.shadow.camera.right = 70; sun.shadow.camera.top = 70; sun.shadow.camera.bottom = -70; sun.shadow.bias = -0.0005; scene.add(sun);
    const moon = new THREE.DirectionalLight(0x8db9ff, 0.15); scene.add(moon);

    // 夜空視覺：黑色天空＋少量星光＋柔和月亮。物件獨立於地面 world，換地圖不會重複累積。
    const nightSkyGroup = new THREE.Group(); nightSkyGroup.name = 'NightSky'; nightSkyGroup.renderOrder = -100; scene.add(nightSkyGroup);
    const nightStars = [];
    for (let i = 0; i < 34; i++) {
      const star = mesh(new THREE.SphereGeometry(.075 + Math.random() * .045, 6, 5), new THREE.MeshBasicMaterial({color: i % 7 === 0 ? 0xffe8a6 : 0xffffff, transparent: true, opacity: .28 + Math.random() * .38, depthWrite: false}));
      star.userData.baseOpacity = star.material.opacity; star.userData.phase = Math.random() * Math.PI * 2; star.userData.radius = 58 + Math.random() * 42;
      nightStars.push(star); nightSkyGroup.add(star);
    }
    const moonVisual = new THREE.Group(); moonVisual.name = 'MoonVisual';
    const moonDisc = mesh(new THREE.SphereGeometry(2.8, 24, 16), new THREE.MeshBasicMaterial({color: 0xf5f3dd, transparent: true, opacity: .88, depthWrite: false}));
    moonDisc.renderOrder = -90; moonVisual.add(moonDisc);
    const moonHalo = mesh(new THREE.SphereGeometry(4.8, 20, 14), new THREE.MeshBasicMaterial({color: 0xbfd7ff, transparent: true, opacity: .09, blending: THREE.AdditiveBlending, depthWrite: false}));
    moonHalo.renderOrder = -89; moonVisual.add(moonHalo);
    nightSkyGroup.add(moonVisual);
    function updateNightSky(daylight, night) {
      const enabled = state.environment?.dayNight !== false;
      const visible = enabled && night > .22 && !['demon', 'volcano'].includes(state.zone);
      nightSkyGroup.visible = visible;
      if (!visible) return;
      const p = state.player?.position || new THREE.Vector3();
      const t = performance.now() * .00045;
      for (let i = 0; i < nightStars.length; i++) {
        const s = nightStars[i], a = (i / nightStars.length) * Math.PI * 2 + (i % 3) * .17;
        const r = s.userData.radius;
        s.position.set(p.x + Math.cos(a) * r, p.y + 12 + ((i * 1.73) % 32), p.z + Math.sin(a) * r);
        s.material.opacity = Math.min(.9, s.userData.baseOpacity * (.55 + .45 * Math.sin(t + s.userData.phase)));
      }
      const ang = (state.time / 24) * Math.PI * 2 - Math.PI / 2;
      moonVisual.position.set(p.x - Math.cos(ang) * 76, p.y + 38 + Math.max(4, -Math.sin(ang) * 18), p.z - Math.sin(ang) * 76);
      const moonScale = .92 + .08 * Math.sin(t * 1.8); moonVisual.scale.setScalar(moonScale);
      moonHalo.material.opacity = .07 + .07 * night;
      moonDisc.material.opacity = .72 + .18 * night;
    }
    function simplePotionIconSvg(liquid) {
      // 極簡、輕量 SVG：避免大型 Base64 PNG 造成預覽器無法載入／顯示 data:image。
