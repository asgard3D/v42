      else if (out.type === 'consumable' && (out.id === 'sp_potion' || out.potion === 'sp')) {out.id = 'sp_potion'; out.potion = 'sp'; out.name = 'SP藥水'; out.icon = SP_POTION_ICON_SRC;}
