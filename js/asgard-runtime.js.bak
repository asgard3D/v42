      const delay = ac.createDelay(.6), feedback = ac.createGain(), echoGain = ac.createGain();
      delay.delayTime.value = kind === 'hit' ? .105 : .12; feedback.gain.value = kind === 'hit' ? .34 : .20; echoGain.gain.value = kind === 'hit' ? .48 : .25;
      const master = ensureGameAudioMaster(ac) || ac.destination; g.connect(master); g.connect(delay); delay.connect(echoGain).connect(master); delay.connect(feedback).connect(delay);
      o.start(now); o.stop(now + p.dur + .02);
      setTimeout(() => {try {delay.disconnect(); feedback.disconnect(); echoGain.disconnect()} catch (_) { } }, 700);
      if (kind === 'sword' || kind === 'dagger') {
        const o2 = ac.createOscillator(), g2 = ac.createGain(); o2.type = 'triangle'; o2.frequency.setValueAtTime(p.freq * 1.8, now);
        g2.gain.setValueAtTime(.0001, now); g2.gain.exponentialRampToValueAtTime(.045 * intensity, now + .008); g2.gain.exponentialRampToValueAtTime(.0001, now + p.dur * .8);
        const d2 = ac.createDelay(.5), e2 = ac.createGain(); d2.delayTime.value = .09; e2.gain.value = .18; g2.connect(master); g2.connect(d2); d2.connect(e2).connect(master);
        o2.connect(g2); o2.start(now); o2.stop(now + p.dur); setTimeout(() => {try {d2.disconnect(); e2.disconnect()} catch (_) { } }, 550);
      }
    }
    function playWeaponSound(action = 'basic') {const family = state.equip.weapon?.family || classWeaponFamily(); if (action === 'skill') {const sk = state._soundSkill; const el = sk?.element; if (el === 'fire') return playGameSound('fire', family, 1.05); if (el === 'ice' || sk?.name?.includes('冰')) return playGameSound('ice', family, 1); if (el === 'light' || sk?.type === 'heal' || sk?.type === 'healArea') return playGameSound('holy', family, 1); if (['magic', 'ranged'].includes(sk?.type) || ['mage', 'priest'].includes(state.classId)) return playGameSound('magic', family, 1); return playGameSound(family === 'dagger' ? 'dagger' : family === 'fist' ? 'fist' : family === 'staff' ? 'staff' : 'sword', family, 1)} return playGameSound(family === 'dagger' ? 'dagger' : family === 'fist' ? 'fist' : family === 'staff' ? 'staff' : 'sword', family, .9)}
    function playPlayerHurtSound(strength = 1) {playGameSound('hurt', 'hurt', Math.max(1, strength));}

    function spawnLevelUpEffect(pos, levels = 1, gained = 0) {const g = new THREE.Group(); g.position.copy(pos); g.position.y = .05; scene.add(g); const glow = new THREE.PointLight(0xffdf72, 5.5, 10); glow.position.y = 1.4; g.add(glow); for (let i = 0; i < 4; i++) {const beam = mesh(new THREE.BoxGeometry(.07, 3.8, .07), new THREE.MeshBasicMaterial({color: i % 2 ? 0x8fe9ff : 0xffe27a, transparent: true, opacity: .72})); beam.position.set(Math.cos(i * Math.PI / 2) * .65, 1.9, Math.sin(i * Math.PI / 2) * .65); beam.rotation.z = (i % 2 ? -.12 : .12); g.add(beam)} const ring = new THREE.Mesh(new THREE.TorusGeometry(.55, .065, 8, 32), new THREE.MeshBasicMaterial({color: 0xffdf63, transparent: true, opacity: .95})); ring.rotation.x = Math.PI / 2; g.add(ring); const ring2 = new THREE.Mesh(new THREE.TorusGeometry(.35, .035, 8, 24), new THREE.MeshBasicMaterial({color: 0x8fe9ff, transparent: true, opacity: .9})); ring2.rotation.x = Math.PI / 2; g.add(ring2); for (let i = 0; i < 18; i++) {const q = mesh(new THREE.SphereGeometry(.045, 6, 6), new THREE.MeshBasicMaterial({color: i % 2 ? 0xffdf63 : 0x8fe9ff, transparent: true})); const a = Math.random() * Math.PI * 2, r = .25 + Math.random() * .45; q.position.set(Math.cos(a) * r, .05, Math.sin(a) * r); q.userData.v = new THREE.Vector3(Math.cos(a) * (1 + Math.random()), 2 + Math.random() * 2, Math.sin(a) * (1 + Math.random())); g.add(q)} const label = makeLabel('LEVEL UP!'); label.position.y = 1.9; label.scale.set(2.5, .62, 1); g.add(label); state.effects.push({g, type: 'levelup', t: 0, life: 1.65})}
