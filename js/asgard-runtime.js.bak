        const m = parts[name]; if (!m) continue;
        const d = p[key];
        if (!m.userData.awPreviewBase) m.userData.awPreviewBase = {position:m.position.clone(),rotation:m.rotation.clone()};
        const b = m.userData.awPreviewBase;
        m.position.set(b.position.x+d.position.x,b.position.y+d.position.y,b.position.z+d.position.z);
        m.rotation.set(b.rotation.x+d.rotation.x,b.rotation.y+d.rotation.y,b.rotation.z+d.rotation.z);
      }
    }
    function syncCurrentWeaponsToPreviewModel(model, classId = state.classId) {
      const parts = model?.userData?.parts;
      if (!parts) return;
      const sameClass = classId === state.classId;
      const starter = CLASS_STARTER_GEAR?.[classId] || {};
      const main = sameClass ? (state.equip?.weapon || null) : (starter.weapon || null);
      const off = sameClass ? (state.equip?.offhand || null) : (starter.offhand || null);
      const wr = parts.weaponVisualRootR || parts.weaponMountR;
      const wl = parts.weaponVisualRootL || parts.weaponMountL;
      const shieldL = parts.shieldVisualRootL || wl;
      if (!wr || !wl) return;
      // Preview must explicitly rebuild the visible weapon meshes. Cloning the live
      // model is not sufficient because the PlayCanvas bridge may own the visible
      // weapon while the legacy Three.js Character Model only keeps the mount node.
      for (const root of [wr, wl, shieldL]) {
        if (!root) continue;
        for (const ch of [...root.children]) {
          if (ch.userData?.heldWeapon || ch.userData?.isMageOrb || ch.userData?.isShieldVisual || ch.userData?.weaponVisual) root.remove(ch);
        }
      }
      if (main) {
        const family = weaponFamilyOf(main) || classes[classId]?.weapon;
        if (family === 'orb') {
          const orb = makeMageOrb();
          orb.position.set(.63, -.04, .18);
          orb.scale.setScalar(.82);
          orb.userData.floatingMageOrb = true;
          orb.userData.heldWeapon = true;
          orb.userData.handGrip = 'gloveCenter';
          wr.add(orb);
        } else if (family === 'dagger' && main.visual === 'dualblade') {
          const right = makeDagger();
          right.position.set(0,0,0);
          right.rotation.set(-(parts.armR?.rotation.x || 0),0,-.12);
          right.userData.heldWeapon = true; right.userData.handGrip = 'gloveCenter';
          wr.position.set(0,-.78,0); wr.add(right);
          const left = makeDagger();
          left.position.set(0,0,0);
          left.rotation.set(-(parts.armL?.rotation.x || 0),0,.12);
          left.userData.heldWeapon = true; left.userData.handGrip = 'gloveCenter';
          wl.position.set(0,-.78,0); wl.add(left);
        } else {
          const w = makeWeaponVisual(main);
          w.userData.heldWeapon = true;
          w.userData.handGrip = 'gloveCenter';
          w.userData.isHeldSword = isHeldSwordWeapon(main);
          w.position.set(0,0,0);
          w.rotation.set(-(parts.armR?.rotation.x || 0) + (w.userData.isHeldSword ? SWORD_HOLD_X : 0), w.userData.isHeldSword ? SWORD_FORWARD_Y : 0, w.userData.isHeldSword ? SWORD_HOLD_Z : 0);
          wr.position.set(0,-.78,0);
          wr.add(w);
        }
      }
      if (off && weaponFamilyOf(off) === 'shield') {
        const sh = makeShieldVisual(off);
        sh.userData.isShieldVisual = true;
        sh.position.set(-.19,.18,.035);
        sh.rotation.set(-.08,-THREE.MathUtils.degToRad(23),.035);
        shieldL.add(sh);
      }
    }

    function refreshArmWeaponPreviewOnly() {
      if (document.getElementById('cloakAdjustPreviewViewport') && cloakAdjustPreview.player) {
        const cid = window.armWeaponAdjustEditorClass || state.classId;
        syncCurrentWeaponsToPreviewModel(cloakAdjustPreview.player, cid);
        applyArmWeaponAdjustmentsToPreviewModel(cloakAdjustPreview.player, cid);
      }
    }
    function refreshCloakAdjustPreview() {
      const host = document.getElementById('cloakAdjustPreviewViewport'); if (!host) return;
      const old = cloakAdjustPreview; const yaw = old.yaw || 0; stopCloakAdjustPreview();
      if (!THREE) {host.innerHTML = '<div style="height:100%;display:grid;place-items:center;color:#ffcf9a;font-size:13px">⚠️ Three.js 尚未載入</div>'; return;}
      host.innerHTML = '<div style="height:100%;display:grid;place-items:center;color:#9eacbd;font-size:13px">載入 3D 人物…</div>';
      requestAnimationFrame(() => {
        try {
          const canvas = document.createElement('canvas');
          canvas.style.width = '100%'; canvas.style.height = '100%'; canvas.style.display = 'block'; canvas.style.touchAction = 'none';
          host.innerHTML = ''; host.appendChild(canvas);
          const rect = host.getBoundingClientRect();
          const w = Math.max(280, Math.round(rect.width || host.clientWidth || 520));
          const h = Math.max(360, Math.round(rect.height || host.clientHeight || 520));
          const r = new THREE.WebGLRenderer({canvas, antialias: true, alpha: false, powerPreference: 'high-performance'});
          r.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5)); r.setSize(w, h, false); r.outputColorSpace = THREE.SRGBColorSpace;

          const sc = new THREE.Scene(); sc.background = new THREE.Color(0x0d1520);
          sc.add(new THREE.HemisphereLight(0xdcecff, 0x182230, 2.35));
          const key = new THREE.DirectionalLight(0xfff0c2, 3.0); key.position.set(3, 6, 4); sc.add(key);
          const rim = new THREE.DirectionalLight(0x83c8ff, 1.45); rim.position.set(-4, 3, -3); sc.add(rim);
          const floor = new THREE.Mesh(new THREE.CircleGeometry(1.65, 64), new THREE.MeshStandardMaterial({color: 0x172230, roughness: .8, metalness: .08}));
          floor.rotation.x = -Math.PI / 2; floor.position.y = .01; sc.add(floor);
          const cam = new THREE.PerspectiveCamera(28, w / h, .05, 100);

          // 優先從目前正式角色建立「完全獨立的深拷貝」，避免預覽器建立人物時暫時改動全域 state。
          // 這可避免開啟神佑外套調整器後，正式場景只剩天空背景。若目前尚未有正式角色，再使用獨立 V2 建立流程。
          let model = null;
          if (state.player?.userData?.parts) {
            try {model = clonePreviewPlayer(state.player);} catch (e) {console.warn('神佑外套預覽 clone fallback:', e); model = null;}
          }
          if (!model) {
            const oldCreatorSelected = creatorClassSelected, oldCreatorClass = creatorPreviewClass, oldCreatorLevel = creatorPreviewOutfitLevel;
            const oldPlayer = state.player, oldParts = state.parts, oldClass = state.classId, oldEquip = state.equip, oldHair = state.hairStyle, oldCustomization = state.characterCustomization, oldPreviewLevel = state.previewOutfitLevel, oldCloak = state.cloakAdjustments;
            try {
              creatorClassSelected = true;
              creatorPreviewClass = PLAYABLE_CLASS_IDS.includes(state.classId) ? state.classId : 'warrior';
              creatorPreviewOutfitLevel = divineCloakLevelForCharacter(state.level || 1);
              model = createCharacterPreviewModel();
            } finally {
              state.player = oldPlayer; state.parts = oldParts; state.classId = oldClass; state.equip = oldEquip; state.hairStyle = oldHair; state.characterCustomization = oldCustomization; state.previewOutfitLevel = oldPreviewLevel; state.cloakAdjustments = oldCloak;
              creatorClassSelected = oldCreatorSelected; creatorPreviewClass = oldCreatorClass; creatorPreviewOutfitLevel = oldCreatorLevel;
            }
          }
          if (!model) throw new Error('Character Model V2 預覽模型建立失敗');

          model.position.set(0, 0, 0); model.rotation.y = yaw;
          const parts = model.userData?.parts;
          if (!parts) throw new Error('預覽模型缺少 Character Model V2 parts');

          // V1.01.35：明確把目前實際武器／盾牌建立到 Preview。
          // PlayCanvas 可能負責遊戲中的可見武器，因此不能只 clone Three.js mount。
          syncCurrentWeaponsToPreviewModel(model, window.armWeaponAdjustEditorClass || state.classId);
          applyArmWeaponAdjustmentsToPreviewModel(model, window.armWeaponAdjustEditorClass || state.classId);

          // 角色外觀調整器：帽子、狼帽白色長髮與目前實體人物完全同步。
          // Clone 有時只複製到 head/parts 參考，但沒有保留最新的 helmet visual，
          // 因此這裡明確依照正式角色的帽子重新建立一次，確保 3D 預覽一定看得到。
          const previewHelmet = state.equip?.helmet || null;
          const previewHelmetVisual = previewHelmet?.visual || '';
          if (parts.head) {
            for (const ch of [...parts.head.children]) if (ch.userData?.isHelmetVisual) parts.head.remove(ch);
            if (previewHelmet) {
              const helmetData = {...previewHelmet, visual: previewHelmetVisual || (CLASS_HELMETS[state.classId] || CLASS_HELMETS.novice).visual};
              const hv = makeEquipVisual('helmet', helmetData);
              if (hv) {
                parts.head.add(hv);
                const v = helmetData.visual;
                applyHatAdjustmentToParts(parts, v, getHatAdjust(v));
              }
              const hairMode = HELMET_HAIR_MODE[helmetData.visual] || 'hide';
              if (parts.hairStyles) parts.hairStyles.position.y = (hairMode === 'wizard' ? -0.12 : 0);
              model.traverse(o => {
                if (o.userData?.isHair) {
                  o.visible = hairMode !== 'hide';
                  if (hairMode === 'front') o.visible = !!o.userData.isFrontHair;
                  if (hairMode === 'all' && o.userData.isHairCap) o.visible = false;
                }
              });
            }
          }
          if (parts.equipment) {
            // 先移除 clone 裡原本的神佑外套，避免舊袖子／披肩與調整中的新外套重疊。
            for (const ch of [...parts.equipment.children]) {
              if (ch.userData?.isDivineBlessingCloak || ch.userData?.divineBlessingCloak) parts.equipment.remove(ch);
            }
            // 真正遊戲人物的袖子現在直接掛在 armL/armR；預覽必須同樣使用這兩個 clone 後的骨骼。
            for (const arm of [parts.armL, parts.armR]) {
              if (!arm) continue;
              for (const ch of [...arm.children]) if (ch.userData?.divineCloakArmPiece || ch.userData?.classOutfitArmPiece) arm.remove(ch);
            }
            // 調整器使用「目前實體人物」的 Character Model V2 clone：頭、髮型、身體比例、手腳與現有裝備都保持一致。
            // 神佑外套也必須使用「目前實際裝備的外套」；不能再用 state.level 重新產生另一件，
            // 否則人物穿著 Lv.41 外套時，調整器可能會錯套成目前等級的外觀。
            // 同時保留目前的 cloakAdjustments，讓預覽與正式人物尺寸完全一致。
            const actualCloak = state.equip?.cloak || null;
            const previewCloakItem = actualCloak
              ? {...actualCloak, slot: 'cloak', type: 'cloak', visual: 'divineCloak', divineBlessing: true, classId: actualCloak.classId || state.classId, itemLevel: actualCloak.itemLevel || divineCloakLevelForCharacter(state.level || 1)}
              : makeDivineBlessingCloakItem(state.classId, state.level || 1);
            // 以目前實體人物的神佑外套重新建立預覽版，確保上身、肩、披肩、長袖與下擺全部同步。
            const previewCloak = makeDivineBlessingCloakVisual(previewCloakItem, parts);
            previewCloak.userData.isCurrentCharacterCloakPreview = true;
            parts.equipment.add(previewCloak);
            // 一般身體裝備留在內層；神佑外套作為外層，避免白色肩甲／胸甲視覺穿透。
            parts.equipment.traverse(o => {
              if (o === previewCloak || o.userData?.divineBlessingCloak) return;
              if (o.isMesh) o.renderOrder = Math.min(Number(o.renderOrder) || 0, 2);
            });
          } else {
            throw new Error('預覽模型缺少 equipment layer');
          }
          // Rebuild the visible weapon once more after helmet/cloak reconstruction,
          // then apply only the saved adjustment offsets.
          syncCurrentWeaponsToPreviewModel(model, window.armWeaponAdjustEditorClass || state.classId);
          applyArmWeaponAdjustmentsToPreviewModel(model, window.armWeaponAdjustEditorClass || state.classId);
          sc.add(model);

          // 以完整人物（含神佑外套）包圍盒取景，避免模型被裁切或跑出畫面。
          const box = new THREE.Box3().setFromObject(model);
          const center = box.getCenter(new THREE.Vector3());
          const size = box.getSize(new THREE.Vector3());
          const maxDim = Math.max(size.x, size.y, size.z, 1.8);
          const targetY = Math.max(.75, Math.min(1.65, center.y));
          const distance = Math.max(3.1, maxDim * 2.35);
          cam.position.set(0, targetY + maxDim * .05, distance); cam.lookAt(0, targetY, 0);

          cloakAdjustPreview = {renderer: r, scene: sc, camera: cam, player: model, raf: 0, host, drag: false, lastX: 0, lastY: 0, yaw};
          const onDown = e => {cloakAdjustPreview.drag = true; cloakAdjustPreview.lastX = e.clientX ?? 0; cloakAdjustPreview.lastY = e.clientY ?? 0; canvas.setPointerCapture?.(e.pointerId);};
          const onMove = e => {
            if (!cloakAdjustPreview.drag) return;
            const x = e.clientX ?? 0;
            cloakAdjustPreview.yaw += (x - cloakAdjustPreview.lastX) * .012;
            cloakAdjustPreview.lastX = x; cloakAdjustPreview.lastY = e.clientY ?? 0;
            if (cloakAdjustPreview.player) cloakAdjustPreview.player.rotation.y = cloakAdjustPreview.yaw;
          };
          const onUp = () => {cloakAdjustPreview.drag = false;};
          canvas.onpointerdown = onDown; canvas.onpointermove = onMove; canvas.onpointerup = onUp; canvas.onpointercancel = onUp; canvas.onpointerleave = onUp;
          const resize = () => {
            if (!cloakAdjustPreview.renderer || !cloakAdjustPreview.host) return;
            const rr = cloakAdjustPreview.host.getBoundingClientRect();
            const nw = Math.max(280, Math.round(rr.width || w)), nh = Math.max(360, Math.round(rr.height || h));
            cloakAdjustPreview.renderer.setSize(nw, nh, false); cam.aspect = nw / nh; cam.updateProjectionMatrix();
          };
          window.addEventListener('resize', resize, {passive: true}); cloakAdjustPreview._resize = resize; resize();
          const animate = () => {if (!cloakAdjustPreview.renderer) return; cloakAdjustPreview.raf = requestAnimationFrame(animate); r.render(sc, cam);};
          animate();
        } catch (err) {
          console.error('神佑外套 3D 預覽建立失敗:', err);
          try {cloakAdjustPreview.renderer?.dispose();} catch (e) { }
          host.innerHTML = '<div style="height:100%;display:grid;place-items:center;padding:24px;text-align:center;color:#ffcf9a;font-size:13px;line-height:1.7">⚠️ 3D 人物預覽載入失敗<br><small style="color:#9eacbd">' + String(err?.message || err).replace(/[<>&]/g, m => ({'<': '&lt;', '>': '&gt;', '&': '&amp;'}[m])) + '</small></div>';
        }
      });
    }
    function disposeRenderer(r) {if (!r) return; try {r.dispose();} catch (e) { } }
    function syncCharacterModelV2(target) {
      if (!target?.userData?.parts) return target;
      const oldP = state.player, oldParts = state.parts;
      state.player = target; state.parts = target.userData.parts;
      try {
        applyClassVisual();
        applyHairStyle(state.hairStyle || 'shortCurl');
        updateEquipmentVisual();
        applyCharacterCustomization();
        applyHairDesignToTarget(target);
        if (state.parts?.hairStyles) syncHeadLocalHairGroups(state.parts.hairStyles);
      } catch (e) {console.warn('Character Model V2 sync:', e)}
      state.player = oldP; state.parts = oldParts;
      target.userData.characterModelVersion = CHARACTER_MODEL_V2.version;
      return target;
    }
    function clonePreviewPlayer(source) {
      if (!source) return null;
      const clone = source.clone(true);
      const srcNodes = [], cloneNodes = [];
      source.traverse(o => srcNodes.push(o));
      clone.traverse(o => cloneNodes.push(o));
      const map = new Map();
      for (let i = 0; i < Math.min(srcNodes.length, cloneNodes.length); i++)map.set(srcNodes[i], cloneNodes[i]);
      const remap = v => {
        if (v && v.isObject3D) return map.get(v) || v;
        if (Array.isArray(v)) return v.map(remap);
        if (v && typeof v === 'object') {
          const out = {};
          for (const [k, x] of Object.entries(v)) out[k] = remap(x);
          return out;
        }
        return v;
      };
      clone.userData = {...source.userData};
      clone.userData.parts = remap(source.userData?.parts || {});
      clone.userData.weaponExtra = [];
      if (clone.userData.parts?.hairStyles) {
        clone.userData.parts.hairStyles.userData.hairSystemVersion = HAIR_SYSTEM_VERSION;
        clone.userData.parts.hairStyles.userData.activeStyle = state.hairStyle || 'shortCurl';
      }
      if (clone.userData.parts?.head) {
        clone.userData.parts.head.traverse(o => {
          if (o.userData?.isHeadBoundHair) o.visible = false;
        });
      }
      // 重要：不要把 source 的 visibility 全部強制設為 true。
      // 真正遊戲人物的髮型／頭盔／裝備有自己的顯示規則，
      // 角色創建預覽必須保留完全相同的可見狀態，否則會出現「左邊預覽」
      // 與「建立後實際人物」外觀不同。
      clone.visible = true;
      applyCharacterAppearance(clone);
      return clone;
    }
    function createCharacterPreviewModel() {
      // Build a completely independent Character Model V2 instance.
      // Do not clone state.player: the live player contains gameplay-only
      // references and equipment state that can make a preview incomplete.
      const savedPlayer = state.player;
      const savedParts = state.parts;
      const savedClass = state.classId;
      const savedEquip = state.equip;
      const savedHair = state.hairStyle;
      const savedCustomization = state.characterCustomization;
      const savedPreviewLevel = state.previewOutfitLevel;
      const savedCloakAdjustments = state.cloakAdjustments;
      let preview = null;
      try {
        preview = makePlayer();
        if (preview?.parent) preview.parent.remove(preview);
        state.player = preview;
        state.parts = preview?.userData?.parts || null;
        state.classId = creatorClassSelected && PLAYABLE_CLASS_IDS.includes(creatorPreviewClass) ? creatorPreviewClass : 'novice';
        state.previewOutfitLevel = creatorPreviewOutfitLevel || 1;
        state._buildingCreatorPreview = true;
        state.equip = {necklace: null, earringL: null, helmet: null, earringR: null, weapon: null, armor: null, offhand: null, ring1: null, ring2: null, belt: null, ring3: null, ring4: null, pants: null, glovesL: null, shoes: null, glovesR: null, cloak: null};
        // 建立新角色預覽時，神佑外套本身也是預設外觀的一部分。
        // 之前只呼叫 applyClassVisual()，沒有重新建立 equipment layer，
        // 因此外套雖然按鈕顯示「顯示」，3D 人物上身仍只有內層衣服。
        if (creatorCloakEquipped) {
          state.equip.cloak = makeDivineBlessingCloakItem(creatorPreviewClass || state.classId, creatorPreviewOutfitLevel || 1);
        }
        applyClassVisual();
        applyHairStyle(state.hairStyle || 'shortCurl', false);
        updateEquipmentVisual();
        applyCharacterCustomization();
        preview.visible = true;
        preview.traverse(o => {
          // Never force every hair group visible. The previous implementation
          // made all hairstyle assets visible at once, so every hairstyle looked
          // identical in the creator. Hair visibility is owned by HAIR SYSTEM V2.
          if (!isHairObject(o)) o.visible = true;
          if (o.isMesh) {o.castShadow = true; o.receiveShadow = true;}
        });
        applyHairStyle(state.hairStyle || 'shortCurl', false);
        if (preview?.userData?.parts?.hairStyles) syncHeadLocalHairGroups(preview.userData.parts.hairStyles);
        applyCharacterAppearance(preview);
        return preview;
      } catch (e) {
        console.error('createCharacterPreviewModel failed', e);
        if (preview?.parent) preview.parent.remove(preview);
        return null;
      } finally {
        state._buildingCreatorPreview = false;
        state.player = savedPlayer;
        state.parts = savedParts;
        state.classId = savedClass;
        state.equip = savedEquip;
        state.hairStyle = savedHair;
        state.characterCustomization = savedCustomization;
        state.previewOutfitLevel = savedPreviewLevel; state.cloakAdjustments = savedCloakAdjustments;
      }
    }
    function setCreatorPreviewArmsVertical(model) {
      const parts = model?.userData?.parts;
      if (!parts) return;
      // Character creator preview uses a neutral mannequin pose: both arms hang
      // straight down beside the body. This is preview-only; live combat animation
      // keeps its own arm rotations.
      if (parts.armL) {parts.armL.rotation.set(0, 0, 0);}
      if (parts.armR) {parts.armR.rotation.set(0, 0, 0);}
    }
    function startCharacterPreview() {
      stopCharacterPreview();
      const host = document.getElementById('ccPreviewViewport');
      if (!host || !THREE || !state.player) return;
      ccPreview.host = host;
      ccPreview.active = true;
      ccPreview.yaw = 0;
      ccPreview.pitch = .04;
      ccPreview.dist = CHARACTER_MODEL_V2.camera.previewDistance;
      const loadingHint = host.querySelector('.creatorPreviewLoading');
      if (loadingHint) loadingHint.style.display = 'block';

      requestAnimationFrame(() => {
        if (!ccPreview.active || ccPreview.host !== host) return;
        const rect = host.getBoundingClientRect();
        const w = Math.max(320, Math.round(rect.width || host.clientWidth || 640));
        const h = Math.max(360, Math.round(rect.height || host.clientHeight || 520));
        let preview = null;
        try {
          preview = createCharacterPreviewModel();
          if (!preview) throw new Error('Character Model V2 預覽模型建立失敗');

          const canvas = document.createElement('canvas');
          canvas.className = 'characterPreviewCanvas';
          canvas.setAttribute('aria-label', '角色3D預覽');
          canvas.style.cssText = 'width:100%;height:100%;display:block;touch-action:none;position:absolute;inset:0;';
          host.appendChild(canvas);

          const r = new THREE.WebGLRenderer({canvas, antialias: true, alpha: false, powerPreference: 'high-performance'});
          r.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));
          r.setSize(w, h, false);
          r.outputColorSpace = THREE.SRGBColorSpace;
          r.shadowMap.enabled = true;
          r.shadowMap.type = THREE.PCFSoftShadowMap;
          ccPreview.renderer = r;

          const ps = new THREE.Scene();
          ps.background = new THREE.Color(0x0a1018);
          ccPreview.scene = ps;
          // V1.01.25: creator preview gets its own renderer ownership root.
          // The Character Model V2 hierarchy itself remains untouched.
          const previewRoot = window.AsgardEngineBridge?.createPreviewRoot
            ? AsgardEngineBridge.createPreviewRoot(ps, 'AsgardCharacterCreationPreviewRoot')
            : ps;
          ccPreview.root = previewRoot;

          const cam = new THREE.PerspectiveCamera(CHARACTER_MODEL_V2.camera.fov, w / h, .1, 100);
          ccPreview.camera = cam;
          cam.position.set(0, 1.92, ccPreview.dist);

          const hemi = new THREE.HemisphereLight(0xdcecff, 0x182230, 2.35);
          ps.add(hemi);
          const key = new THREE.DirectionalLight(0xfff0c2, 3.0);
          key.position.set(3, 6, 4);
          key.castShadow = true;
          ps.add(key);
          const rim = new THREE.DirectionalLight(0x83c8ff, 1.45);
          rim.position.set(-4, 3, -3);
          ps.add(rim);

          const floor = new THREE.Mesh(
            new THREE.CircleGeometry(1.65, 64),
            new THREE.MeshStandardMaterial({color: 0x182330, metalness: .12, roughness: .72})
          );
          floor.rotation.x = -Math.PI / 2;
          floor.position.y = .01;
          floor.receiveShadow = true;
          ps.add(floor);

          ccPreview.player = preview;
          setCreatorPreviewArmsVertical(preview);
          previewRoot.add(preview);
          preview.position.set(0, 0, 0);
          preview.rotation.set(0, 0, 0);
          preview.visible = true;
          cam.lookAt(0, CHARACTER_MODEL_V2.camera.lookY, 0);

          if (loadingHint) loadingHint.style.display = 'none';

          const onResize = () => {
            if (!ccPreview.active || !ccPreview.renderer) return;
            const rr = host.getBoundingClientRect();
            const nw = Math.max(320, Math.round(rr.width || host.clientWidth || 640));
            const nh = Math.max(360, Math.round(rr.height || host.clientHeight || 520));
            ccPreview.renderer.setSize(nw, nh, false);
            ccPreview.camera.aspect = nw / nh;
            ccPreview.camera.updateProjectionMatrix();
          };
          ccPreview._resize = onResize;
          window.addEventListener('resize', onResize);
          onResize();

          canvas.addEventListener('pointerdown', e => {
            ccPreview.drag = true;
            ccPreview.lastX = e.clientX;
            ccPreview.lastY = e.clientY;
            canvas.setPointerCapture?.(e.pointerId);
          });
          canvas.addEventListener('pointerup', e => {
            ccPreview.drag = false;
            canvas.releasePointerCapture?.(e.pointerId);
          });
          canvas.addEventListener('pointercancel', () => {ccPreview.drag = false});
          canvas.addEventListener('pointermove', e => {
            if (!ccPreview.drag) return;
            ccPreview.modelYaw -= (e.clientX - ccPreview.lastX) * .012;
            ccPreview.pitch = Math.max(-.25, Math.min(.35, ccPreview.pitch + (e.clientY - ccPreview.lastY) * .006));
            if (ccPreview.player) ccPreview.player.rotation.y = ccPreview.modelYaw;
            ccPreview.lastX = e.clientX;
            ccPreview.lastY = e.clientY;
          });
          canvas.addEventListener('wheel', e => {
            e.preventDefault();
            ccPreview.dist = Math.max(2.8, Math.min(6.5, ccPreview.dist + e.deltaY * .004));
          }, {passive: false});

          const animate = () => {
            if (!ccPreview.active || !ccPreview.renderer) return;
            ccPreview.raf = requestAnimationFrame(animate);
            const z = ccPreview.dist * Math.cos(ccPreview.pitch);
            const cy = ccPreview.dist * Math.sin(ccPreview.pitch);
            const y = 1.92 + ccPreview.pitch * .36;
            cam.position.set(Math.sin(ccPreview.yaw) * z, y + cy, Math.cos(ccPreview.yaw) * z);
            cam.lookAt(0, CHARACTER_MODEL_V2.camera.lookY, 0);
            if (ccPreview.autoRotate) ccPreview.modelYaw += .006;
            preview.rotation.y = ccPreview.modelYaw;
            r.render(ps, cam);
          };
          animate();

        } catch (e) {
          console.error('Character preview initialization failed', e);
          if (loadingHint) {
            loadingHint.style.display = 'block';
            loadingHint.innerHTML = '⚠️ 3D 人物預覽建立失敗<br><small style="color:#aebdcc">' + String(e?.message || e).replace(/</g, '&lt;') + '</small>';
          }
          if (ccPreview.renderer) disposeRenderer(ccPreview.renderer);
          host.querySelectorAll('canvas.characterPreviewCanvas').forEach(c => c.remove());
          if (preview?.parent) preview.parent.remove(preview);
          ccPreview.active = false;
          ccPreview.renderer = null;
          ccPreview.player = null;
        }
      });
    }
    function ccPreviewSync() {
      if (!ccPreview.active || !ccPreview.player) return;
      const oldPlayer = state.player, oldParts = state.parts, oldClass = state.classId, oldEquip = state.equip;
      state.player = ccPreview.player; state.parts = ccPreview.player.userData.parts; state.classId = creatorPreviewClass || 'novice';
      state.equip = {necklace: null, earringL: null, helmet: null, earringR: null, weapon: null, armor: null, offhand: null, ring1: null, ring2: null, belt: null, ring3: null, ring4: null, pants: null, glovesL: null, shoes: null, glovesR: null, cloak: null};
      try {applyClassVisual(); applyHairStyle(state.hairStyle || 'shortCurl', false); applyCharacterCustomization();} catch (e) {console.warn('creator preview update failed', e)}
      state.player = oldPlayer; state.parts = oldParts; state.classId = oldClass; state.equip = oldEquip;
    }
    function stopCharacterPreview() {
      const host = ccPreview.host || document.getElementById('ccPreviewViewport');
      ccPreview.active = false;
      cancelAnimationFrame(ccPreview.raf);
      if (ccPreview._resize) window.removeEventListener('resize', ccPreview._resize);
      if (ccPreview.player?.parent) ccPreview.player.parent.remove(ccPreview.player);
      disposeRenderer(ccPreview.renderer);
      if (host) host.querySelectorAll('canvas.characterPreviewCanvas').forEach(c => c.remove());
      ccPreview = {active: false, renderer: null, scene: null, root: null, camera: null, raf: 0, player: null, host: null, yaw: 0, pitch: .08, dist: CHARACTER_MODEL_V2.camera.previewDistance, drag: false, lastX: 0, lastY: 0, modelYaw: 0, autoRotate: false};
    }
    function setCharacterPreviewRotation(deg) {
      if (!ccPreview.active) return;
      ccPreview.modelYaw = Number(deg) * Math.PI / 180;
      if (ccPreview.player) ccPreview.player.rotation.y = ccPreview.modelYaw;
    }
    function rotateCharacterPreview(deltaDeg) {
      if (!ccPreview.active) return;
      ccPreview.modelYaw += Number(deltaDeg) * Math.PI / 180;
      if (ccPreview.player) ccPreview.player.rotation.y = ccPreview.modelYaw;
    }
    function toggleCharacterPreviewAutoRotate() {
