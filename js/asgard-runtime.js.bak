      if (type === 'slash') {const ring = mesh(new THREE.TorusGeometry(.75, .055, 8, 24), new THREE.MeshBasicMaterial({color, transparent: true, opacity: .95})); ring.rotation.x = Math.PI / 2; g.add(ring); g.scale.set(.3, .3, .3)}
      if (type === 'hit') {for (let i = 0; i < 12; i++) {const q = mesh(new THREE.SphereGeometry(.055, 6, 6), new THREE.MeshBasicMaterial({color, transparent: true})); q.position.set((Math.random() - .5) * .35, Math.random() * .7, (Math.random() - .5) * .35); q.userData.v = new THREE.Vector3((Math.random() - .5) * 3, Math.random() * 3, (Math.random() - .5) * 3); g.add(q)} }
