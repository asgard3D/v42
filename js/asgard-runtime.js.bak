    function normalizeStarterEquipmentAppearance(out) {
      if (!out || !out.classSet || Number(out.itemLevel || 0) !== 1) return out;
      // 舊存檔相容：早期版本的五職新手武器改成木質款式。
      if (out.type === 'weapon' || out.slot === 'weapon') {
        const map = {
          warrior: {name: '新手木劍', icon: '🪵', visual: 'noviceWoodSword', family: 'sword'},
          monk: {name: '新手木指虎', icon: '🪵', visual: 'noviceWoodFist', family: 'fist'},
          mage: {name: '新手寶珠', icon: '🪵', visual: 'noviceWoodOrb', family: 'orb'},
          priest: {name: '新手木杖', icon: '🪵', visual: 'noviceWoodStaff', family: 'staff'},
          thief: {name: '新手木刀', icon: '🪵', visual: 'noviceWoodDagger', family: 'dagger'}
        }[out.classId];
        if (map) {out.name = map.name; out.icon = map.icon; out.visual = map.visual; out.family = map.family;}
      }
