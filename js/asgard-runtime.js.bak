      const zoneRange = zoneData[state.zone]?.range || [1, 100];
      const fallback = state.enemies.filter(x => x !== current && x.userData?.alive && !x.userData?.boss && x.userData.level >= zoneRange[0] && x.userData.level <= zoneRange[1]);
