      }
      if (type === 'holypillar') {
        const base = mesh(new THREE.CylinderGeometry(.48, .72, .08, 32), new THREE.MeshBasicMaterial({color: 0xffef9a, transparent: true, opacity: .9})); base.position.y = .04; g.add(base);
        const beam = mesh(new THREE.CylinderGeometry(.24, .42, 2.5, 20, 1, true), new THREE.MeshBasicMaterial({color: 0xfff6b0, transparent: true, opacity: .34, side: THREE.DoubleSide})); beam.position.y = 1.25; g.add(beam);
        const beam2 = mesh(new THREE.CylinderGeometry(.10, .22, 2.9, 16, 1, true), new THREE.MeshBasicMaterial({color: 0xffffff, transparent: true, opacity: .42, side: THREE.DoubleSide})); beam2.position.y = 1.45; g.add(beam2);
        const ring = mesh(new THREE.TorusGeometry(.62, .045, 8, 28), new THREE.MeshBasicMaterial({color: 0xffdf6a, transparent: true, opacity: .9})); ring.rotation.x = Math.PI / 2; ring.position.y = .08; g.add(ring);
      }
