      weapon: [{name: '新手木劍', icon: '🪵', atk: 3, visual: 'noviceWoodSword', family: 'sword', classId: 'novice'}, {name: '新手木刀', icon: '🪵', atk: 3, visual: 'noviceWoodDagger', family: 'dagger', classId: 'thief'}, {name: '新手寶珠', icon: '🪵', atk: 2, matk: 6, visual: 'noviceWoodOrb', family: 'orb', classId: 'mage'}, {name: '新手木指虎', icon: '🪵', atk: 3, visual: 'noviceWoodFist', family: 'fist', classId: 'monk'}, {name: '新手木杖', icon: '🪵', atk: 3, matk: 6, visual: 'noviceWoodStaff', family: 'staff', classId: 'priest'}, {name: '冒險者短劍', icon: '🗡️', atk: 8, visual: 'sword', family: 'sword'}, {name: '星輝法杖', icon: '🪄', atk: 12, visual: 'staff', family: 'staff'}, {name: '月晶法杖', icon: '🔮', atk: 20, visual: 'crystalstaff', family: 'staff'}, {name: '星界寶珠', icon: '🔮', atk: 14, matk: 8, visual: 'orb', family: 'orb'}, {name: '秘法寶珠', icon: '🟣', atk: 22, matk: 14, visual: 'arcaneorb', family: 'orb'}, {name: '武道護手', icon: '🥊', atk: 10, visual: 'fist', family: 'fist'}, {name: '赤炎拳甲', icon: '🔥', atk: 22, visual: 'gauntlet', family: 'fist'}, {name: '疾風短刃', icon: '🔪', atk: 13, visual: 'dagger', family: 'dagger'}],
      shield: [{name: '鋼鐵圓盾', icon: '🛡️', def: 10, visual: 'shield', family: 'shield'}, {name: '騎士塔盾', icon: '🛡️', def: 18, visual: 'towerShield', family: 'shield'}]
    };
    const EQUIP_SLOTS = ['necklace', 'earringL', 'helmet', 'earringR', 'weapon', 'armor', 'offhand', 'ring1', 'ring2', 'belt', 'ring3', 'ring4', 'pants', 'glovesL', 'cloak', 'shoes', 'glovesR'];
    const EQUIP_LABELS = {weapon: '主武', armor: '身', offhand: '副武', helmet: '帽', glovesL: '手套1', glovesR: '手套2', shoes: '鞋', belt: '腰帶', pants: '腿', cloak: '外套', necklace: '項鍊', earringL: '左耳', earringR: '右耳', ring1: '戒1', ring2: '戒2', ring3: '戒3', ring4: '戒4'};
    const EQUIP_ICONS = {weapon: '⚔️', armor: '🥋', offhand: '🛡️', helmet: '🎩', glovesL: '🧤', glovesR: '🧤', shoes: '🥾', belt: '🧷', pants: '👖', cloak: '🧥', necklace: '📿', earringL: '💎', earringR: '💎', ring1: '💍', ring2: '💍', ring3: '💍', ring4: '💍'};
    const KNIGHT_HELMET_ICON_SRC = 'data:image/png;base64,';
    const EQUIP_UNIQUE_ICONS = {
      sword: '🗡️', greatsword: '⚔️', noviceWoodDagger: '🪵', noviceWoodOrb: '🪵', noviceWoodFist: '🪵', noviceWoodStaff: '🪵', staff: '🪄', crystalstaff: '🔮', orb: '🔮', arcaneorb: '🟣', fist: '🥊', gauntlet: '🔥', dagger: '🔪', dualblade: '🌀', shield: '🛡️', towerShield: '🛡️',
      leather: '👕', redleather: '👕', forestguard: '👕', silverlight: '🧥', knight: '🧥',
      leatherhelm: '⛑️', wolfcap: '🐺', foresthelm: '🪖', silverhelm: '🪞', knighthelm: '🐱', flamehelm: '🔥', martialhelm: '🥋', moonhelm: '🌙',
      novicecap: '🧢', windcap: '🥽', wolfcap: '🐺', headband: '⭕', wizardhat: '🎩', holycrw: '👑', mageRobe: '🧙', magePants: '👖', mageShoes: '👢', mageGloves: '🧤', heavyArmor: '🧥', heavyPants: '🦿', heavyBoots: '🥾', heavyGloves: '🦾', thiefPants: '👖', thiefBoots: '🥾', thiefGloves: '🧤', priestRobe: '⛪', priestPants: '👖', priestShoes: '👞', priestGloves: '📿', monkArmor: '🥋', monkPants: '👖', monkShoes: '🩴', monkGloves: '🥊', holyBook: '📖',
      leatherglove: '🧤', iron_glove: '🦾', martial_glove: '🧤', royal_glove: '🦅', tightpants: '👖', forestpants: '🌿', silverpants: '🪙', knightpants: '🧱',
      adventureboots: '🥾', forestboots: '🌲', silverbots: '🧊', silverboots: '❄️', knightboots: '👢', gold: '💍', green: '🍀', red: '🔴', blue: '💎', goldneck: '📿', leafneck: '🪬', crystalneck: '🔷'
    };
    const EQUIP_UNIQUE_ICONS_EXTRA = {adventurebelt: '🟫', magebelt: '🟣', knightbelt: '🛡️', shadowbelt: '🖤', crystalearring: '💎', starearring: '✨', leafearring: '🍃'};
    for (const [k, v] of Object.entries(EQUIP_UNIQUE_ICONS_EXTRA)) EQUIP_UNIQUE_ICONS[k] = v;
    function potionIconMarkup(it) {
      const src = (it?.potion === 'hp' || it?.id === 'potion') ? HP_POTION_ICON_SRC : (it?.potion === 'mp' || it?.id === 'mp_potion') ? MP_POTION_ICON_SRC : (it?.potion === 'sp' || it?.id === 'sp_potion') ? SP_POTION_ICON_SRC : null;
      return src ? '<img class="potionItemIcon" src="' + src + '" alt="">' : null;
    }
    function equipmentIcon(it) {
      const potion = potionIconMarkup(it); if (potion) return potion;
      const icon = EQUIP_UNIQUE_ICONS[it?.visual] || it?.icon || EQUIP_ICONS[it?.slot || it?.type] || '✨';
      // 裝備縮圖可能是 data:image/png;base64,...；不可直接把 data URL 當文字插入 innerHTML。
      // 例如戰士 knighthelm 的專屬頭盔圖就是內嵌 PNG，因此統一轉成 img。
      if (typeof icon === 'string' && icon.startsWith('data:image/')) {
        return '<img class=\"equipmentItemIcon\" src=\"' + icon + '\" alt=\"\">';
      }
      return icon;
    }

    function classWeaponFamily() {return classes[state.classId]?.weapon || 'sword'}
    const CLASS_HELMETS = {
      novice: {name: '初心者冒險帽', visual: 'novicecap', icon: '🧢'},
      warrior: {name: '戰士貓耳兜帽', visual: 'knighthelm', icon: '🐱'},
      thief: {name: '狼帽', visual: 'wolfcap', icon: '🐺'},
      monk: {name: '頭環', visual: 'headband', icon: '⭕'},
      mage: {name: '魔導帽', visual: 'wizardhat', icon: '🎩'},
      priest: {name: '皇冠帽', visual: 'holycrw', icon: '👑'}
    };
    function helmetCanEquip(it) {return !!it && it.type === 'helmet' && !!it.classId && it.classId === state.classId}
    function isTwoHandedWeapon(it) {
      if (!it) return false;
      return it.twoHanded === true ||
        it.visual === 'greatsword' ||
        it.family === 'greatsword' ||
        String(it.name || '').includes('闊劍');
    }
    function weaponFamilyOf(it) {if (!it) return null; if (it.family) return it.family; if (it.visual === 'orb' || it.visual === 'arcaneorb') return 'orb'; if (it.visual === 'staff' || it.visual === 'crystalstaff') return 'staff'; if (it.visual === 'shield' || it.visual === 'towerShield') return 'shield'; if (it.visual === 'dagger' || it.visual === 'dualblade') return 'dagger'; if (it.visual === 'fist' || it.visual === 'gauntlet') return 'fist'; return 'sword'}
    function weaponCanEquip(it) {if (!it || it.visual === 'dualblade' || String(it.name || '').includes('雙影刃')) return false; const fam = weaponFamilyOf(it); return !!it && it.type === 'weapon' && !!weaponFamilies[fam] && weaponFamilies[fam].classes.includes(state.classId) && (!it.classId || it.classId === state.classId)}
    function classEquipCanUse(it) {
      if (!it) return false;
      if (it.type === 'weapon') return weaponCanEquip(it);
      if (it.type === 'shield') return !!it.classId && weaponFamilies.shield.classes.includes(state.classId) && it.classId === state.classId;
      if (it.type === 'offhand') return !!it.classId && it.classId === state.classId && state.classId === 'priest' && it.family === 'holyBook';
      if (it.type === 'helmet') return helmetCanEquip(it);
      if (it.type === 'cloak' || it.slot === 'cloak') return !!it.classId && PLAYABLE_CLASS_IDS.includes(it.classId) && it.classId === state.classId;
      if (!['ring', 'necklace', 'earring', 'belt', 'gloves', 'shoes', 'armor', 'pants', 'cloak'].includes(it.type) && !['ring', 'necklace', 'earring', 'belt', 'gloves', 'shoes', 'armor', 'pants', 'cloak'].includes(it.slot)) return true;
      return !it.classId || it.classId === state.classId;
    }
    function normalizeEquipmentForClass() {
      // 舊存檔相容：把舊版 armor slot 的「職業長外套」搬到獨立 cloak slot。
      if (state.equip?.armor && (state.equip.armor.visual === 'longcoat' || state.equip.armor.type === 'cloak' || state.equip.armor.slot === 'cloak')) {
        const oldCloak = normalizeItemRecord(state.equip.armor);
        if (!state.equip.cloak) state.equip.cloak = oldCloak;
        else if (state.inventory.length < 60) state.inventory.push(oldCloak);
        state.equip.armor = null;
      }
      // 舊存檔相容：移除已取消的盜賊雙刀。
      if (state.equip.weapon?.visual === 'dualblade' || state.equip.weapon?.visual === 'greatsword' || String(state.equip.weapon?.name || '').includes('雙影刃') || String(state.equip.weapon?.name || '').includes('闊劍')) state.equip.weapon = null;
      if (state.equip.offhand?.visual === 'dualblade' || String(state.equip.offhand?.name || '').includes('雙影刃')) state.equip.offhand = null;
      state.inventory = (state.inventory || []).filter(it => it?.visual !== 'dualblade' && it?.visual !== 'greatsword' && !String(it?.name || '').includes('雙影刃') && !String(it?.name || '').includes('闊劍'));
      for (const k of EQUIP_SLOTS) {
        const it = state.equip[k];
        if (it && isEquipmentRecord(it) && !isAllowedEquipmentLevel(it.itemLevel)) {
          state.equip[k] = null;
          continue;
        }
        if (it && !classEquipCanUse(it)) {
          if (state.inventory.length < 60) state.inventory.push(it);
          state.equip[k] = null;
        }
      }
      // 盾牌與雙手武器互斥：舊存檔若同時存在，保留雙手武器並移除副手盾牌。
      if (state.equip.offhand?.family === 'shield' && isTwoHandedWeapon(state.equip.weapon)) {
        if (state.inventory.length < 60) state.inventory.push(state.equip.offhand);
        state.equip.offhand = null;
      }
      state.inventory = state.inventory.filter(Boolean);
    }
    function makeNoviceWoodSword() {return {id: 'starter_novice_wood_sword', name: '新手木劍', icon: '🪵', qty: 1, type: 'weapon', slot: 'weapon', atk: 3, matk: 0, visual: 'noviceWoodSword', family: 'sword', rarity: 'normal', itemLevel: 1, dropable: false, classId: 'novice', equipTier: 0};}
    const CLASS_STARTER_GEAR = {
      warrior: {name: '戰士', armor: 'warriorArmor', pants: 'heavyPants', helmet: 'knighthelm', gloves: 'heavyGloves', shoes: 'heavyBoots', belt: 'knightbelt', weapon: {name: '新手木劍', visual: 'noviceWoodSword', family: 'sword', atk: 6, icon: '🪵'}},
      monk: {name: '武道家', armor: 'monkArmorSet', pants: 'monkPants', helmet: 'headband', gloves: 'monkGloves', shoes: 'monkShoes', belt: 'adventurebelt', weapon: {name: '新手木指虎', visual: 'noviceWoodFist', family: 'fist', atk: 6, icon: '🪵'}},
      mage: {name: '法師', armor: 'mageArmor', pants: 'magePants', helmet: 'wizardhat', gloves: 'mageGloves', shoes: 'mageShoes', belt: 'magebelt', weapon: {name: '新手寶珠', visual: 'noviceWoodOrb', family: 'orb', atk: 2, matk: 7, icon: '🪵'}},
      priest: {name: '聖職者', armor: 'priestArmor', pants: 'priestPants', helmet: 'holycrw', gloves: 'priestGloves', shoes: 'priestShoes', belt: 'knightbelt', weapon: {name: '新手木杖', visual: 'noviceWoodStaff', family: 'staff', atk: 4, matk: 6, icon: '🪵'}, offhand: {name: '新手祈禱書', visual: 'holyBook', family: 'holyBook', icon: '📖'}},
      thief: {name: '盜賊', armor: 'thiefArmor', pants: 'thiefPants', helmet: 'wolfcap', gloves: 'thiefGloves', shoes: 'thiefBoots', belt: 'shadowbelt', weapon: {name: '新手木刀', visual: 'noviceWoodDagger', family: 'dagger', atk: 7, icon: '🪵'}, offhand: {name: '新手木盾', visual: 'shield', family: 'shield', icon: '🛡️', type: 'shield', def: 4}}
    };
    function makeStarterClassItem(classId, slot, visual, name, extra = {}) {
      const base = {id: 'starter_' + classId + '_' + slot, name, icon: equipmentIcon({visual, slot}), qty: 1, rarity: 'normal', itemLevel: 1, dropable: true, classSet: true, classId, slot, type: slot, def: slot === 'armor' ? 6 : slot === 'pants' ? 3 : slot === 'helmet' ? 2 : slot === 'gloves' ? 2 : slot === 'shoes' ? 2 : slot === 'belt' ? 1 : 0, matk: 0, atk: 0, classSet: true, setLevel: 1, equipTier: 0, visual};
      return {...base, ...extra};
    }
    function makeClassStarterGear(classId) {
      const cfg = CLASS_STARTER_GEAR[classId]; if (!cfg) return [];
      const list = [];
      list.push(makeStarterClassItem(classId, 'armor', cfg.armor, cfg.name + ' 1級戰衣', {def: 8}));
      list.push(makeStarterClassItem(classId, 'pants', cfg.pants, cfg.name + ' 1級腿裝', {def: 4}));
      list.push(makeStarterClassItem(classId, 'helmet', cfg.helmet, cfg.name + ' 1級頭飾', {def: 3}));
      list.push(makeStarterClassItem(classId, 'gloves', cfg.gloves, cfg.name + ' 1級手裝', {def: 3}));
      list.push(makeStarterClassItem(classId, 'shoes', cfg.shoes, cfg.name + ' 1級靴', {def: 3}));
      list.push(makeStarterClassItem(classId, 'belt', cfg.belt, cfg.name + ' 1級腰裝', {def: 2}));
      list.push({...cfg.weapon, id: 'starter_' + classId + '_weapon', qty: 1, type: 'weapon', slot: 'weapon', rarity: 'normal', itemLevel: 1, dropable: true, classSet: true, classId, visual: cfg.weapon.visual, family: cfg.weapon.family, atk: cfg.weapon.atk || 0, matk: cfg.weapon.matk || 0, equipTier: 0, classSet: true, setLevel: 1});
      if (cfg.offhand) list.push({...cfg.offhand, id: 'starter_' + classId + '_offhand', qty: 1, type: cfg.offhand.type || 'offhand', slot: 'offhand', rarity: 'normal', itemLevel: 1, dropable: true, classSet: true, classId, visual: cfg.offhand.visual, family: cfg.offhand.family, def: cfg.offhand.def || 2, classSet: true, setLevel: 1});
      return list;
    }
    function ensureClassStarterGear(classId) {
      const ids = new Set(makeClassStarterGear(classId).map(x => x.id));
      const existing = new Set((state.inventory || []).map(x => x?.id));
      for (const item of makeClassStarterGear(classId)) if (!existing.has(item.id)) {item.dropable = true; item.classSet = true; state.inventory.push(item);}
      return ids;
    }
    function ensureNoviceStarterGear() {
      // Legacy compatibility only: new characters no longer start as novice.
      if (state.classId === 'novice') {
        if (!state.inventory.some(it => it?.id === 'starter_novice_wood_sword')) state.inventory.push(makeNoviceWoodSword());
      }
    }

    // 玩家升級經驗表：數值代表「目前等級 → 下一等級」所需 EXP。
    // Lv.1~10 原始資料僅提供「100 ~ 5,500 遞增」，未提供 2~9 級逐級值；
    // 因此這 10 級先以等距遞增補足，Lv.11~100 使用提供的完整數值。
    const PLAYER_EXP_TABLE = {
      1: 100, 2: 700, 3: 1300, 4: 1900, 5: 2500, 6: 3100, 7: 3700, 8: 4300, 9: 4900, 10: 5500,
      11: 7200, 12: 9200, 13: 11600, 14: 14400, 15: 17700, 16: 21500, 17: 26000, 18: 31100, 19: 37000, 20: 43800,
      21: 51500, 22: 60300, 23: 70200, 24: 81400, 25: 93900, 26: 108000, 27: 123700, 28: 141200, 29: 160800, 30: 182600,
      31: 206800, 32: 233700, 33: 263400, 34: 296200, 35: 332400, 36: 372200, 37: 416000, 38: 464200, 39: 517000, 40: 575000,
      41: 684200, 42: 775600, 43: 876400, 44: 988200, 45: 1114000, 46: 1254000, 47: 1410000, 48: 1582000, 49: 1772000, 50: 1984000,
      51: 2216000, 52: 2472000, 53: 2756000, 54: 3068000, 55: 3412000, 56: 3790000, 57: 4204000, 58: 4660000, 59: 5160000, 60: 5710000,
      61: 6314000, 62: 6978000, 63: 7706000, 64: 8506000, 65: 9384000, 66: 10346000, 67: 11402000, 68: 12560000, 69: 13830000, 70: 15224000,
      71: 15248000, 72: 17214000, 73: 19400000, 74: 21800000, 75: 24500000, 76: 27500000, 77: 30800000, 78: 34500000, 79: 38500000, 80: 43000000,
      81: 48000000, 82: 53500000, 83: 59500000, 84: 66000000, 85: 73000000, 86: 81000000, 87: 90000000, 88: 100000000, 89: 111000000, 90: 123000000,
      91: 136500000, 92: 151500000, 93: 168000000, 94: 186500000, 95: 207000000, 96: 230000000, 97: 255500000, 98: 284000000, 99: 315500000, 100: Infinity
    };
    function xpToNext() {
      if (state.level >= 100) return Infinity;
      return PLAYER_EXP_TABLE[state.level] ?? Infinity;
    }
    function getMaxHP() {return classes[state.classId].hp + (state.level - 1) * 12 + state.stats.vit * 10}
    function getMaxMP() {return classes[state.classId].mp + (state.level - 1) * 8 + state.stats.int * 4}
    function getMaxSP() {return 100 + (state.level - 1) * 3 + state.stats.vit * 2}
    function getEquipAttack() {return EQUIP_SLOTS.reduce((n, k) => n + (state.equip[k]?.atk || 0), 0)}
    function getEquipDefense() {return EQUIP_SLOTS.reduce((n, k) => n + (state.equip[k]?.def || 0), 0)}
    function getBuffValue(key) {return Object.values(state.buffs || {}).reduce((n, b) => n + (Number(b[key]) || 0), 0)}
    function getBuffMultiplier(key) {return 1 + getBuffValue(key)}
    function getAttack() {return Math.round((classes[state.classId].atk + (state.level - 1) * 2 + state.stats.str * 2 + state.stats.dex * .5 + getEquipAttack()) * getBuffMultiplier('atk'))}
    function getMagicAttack() {return Math.round((classes[state.classId].matk + (state.level - 1) * 2.4 + state.stats.int * 3.2 + state.stats.luk * .15) * getBuffMultiplier('matk'))}
    function getDefense() {return Math.round((classes[state.classId].def + Math.floor((state.level - 1) * .8) + state.stats.vit + getEquipDefense()) * getBuffMultiplier('def'))}
    function getMagicDefense() {return Math.round((classes[state.classId].mdef + Math.floor((state.level - 1) * .7) + state.stats.int * 1.5 + getEquipDefense() * .35) * getBuffMultiplier('mdef'))}
    function getAttackSpeed() {return Math.max(.25, (1 + state.stats.dex * .025) * getBuffMultiplier('attackSpeed'))}
    function getBasicAttackInterval() {return 1 / getAttackSpeed();}
    function getCritRate() {return Math.max(0, Math.min(100, 5 + state.stats.luk * .35 + getBuffValue('crit')))}
    function rollCritical() {return Math.random() * 100 < getCritRate();}
    function getHpRegen() {return Math.max(1, 1 + Math.floor(state.stats.vit * .25) + Math.floor(state.level / 10) + Math.floor(getBuffValue('hpRegen')))}
    function getMpRegen() {return Math.max(1, Math.round((1 + Math.floor(state.stats.int * .20) + Math.floor(state.level / 12)) * getBuffMultiplier('mpRegen')))}
