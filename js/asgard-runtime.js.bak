      const fill = mesh(new THREE.SphereGeometry(.15, 10, 8), liquid); fill.scale.y = .95; fill.position.y = .25; g.add(fill);
      const neck = mesh(new THREE.CylinderGeometry(.07, .09, .16, 10), glass); neck.position.y = .55; g.add(neck);
