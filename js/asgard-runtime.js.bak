    function spawnSkillPath(type, from, to, color) {return spawnEffect(type, from, color, {from: from.clone(), to: to.clone()})}
    function startAttack(type = 'slash') {
      // 戰士／初心者劍系：單手劍「舉高 -> 向下劈 -> 收回」。
      // 右手與手臂一起抬高，但不向後大幅折腕；劍保持在角色前方的攻擊弧線。
      const swordClass = (state.classId === 'warrior' || state.classId === 'novice');
      // 劍系普通攻擊：完整三段式「舉劍 -> 向下劈 -> 收劍」。
      // 抬劍幅度提高，但避免手臂向背後旋轉；下劈從高位直接帶到前下方。
      // 給戰士稍長的動作時間，讓抬手、下劈、收劍都能清楚看見。
      const duration = swordClass ? (type === 'skill' ? 0.88 : 0.78) : (type === 'skill' ? 0.58 : .42);
      state.attackAnim = {active: true, t: 0, duration, type, swordOverhead: false};
      state.walkAnim.moving = false;
      if (swordClass && state.parts?.armR) {
        state.parts.armR.rotation.x = -.38;
        state.parts.armR.rotation.y = 0;
        state.parts.armR.rotation.z = -.13;
      }
    }
    function hasRaisedShield() {
      const off = state.equip?.offhand;
      return !!off && off.family === 'shield' && (state.classId === 'warrior' || state.classId === 'thief');
    }
    function applyShieldArmPose() {
      if (!state.parts?.armL) return;
      if (hasRaisedShield()) {
        // 持盾時左前臂持續上舉，盾牌跟隨前臂，不因待機／走路動畫垂下。
        state.parts.armL.rotation.x = -.72;
        state.parts.armL.rotation.y = 0;
        state.parts.armL.rotation.z = .10;
      }
    }
    // V1.01.30：法師寶珠托掌姿勢。
    // 右上臂自然抬起、前臂向內彎，形成明確的 V 字肘部；掌心朝上，寶珠
    // 不再像握住武器，而是固定浮在掌心上方。所有握持／走路／攻擊流程都共用。
    function applyMageOrbHandPose() {
      if (state.classId !== 'mage' || !state.parts?.armR) return;
      const p = state.parts;
      // V1.01.30 FIX：法師右前臂提高至肩線。
      // 上臂先抬起，前臂再向內上折，讓掌心／寶珠停在肩膀附近，
      // 而不是垂在胸口以下。所有持珠狀態共用此姿勢。
      p.armR.rotation.set(-.68, 0, -.11);
      if (p.foreR) {
        p.foreR.rotation.set(0, 0, -1.28);
        p.foreR.position.set(-.16, -.28, .07);
      }
      if (p.gloveR) {
        p.gloveR.rotation.set(0, 0, -1.28);
        p.gloveR.position.set(-.36, -.22, .12);
      }
      if (p.wristSkinR) {
        p.wristSkinR.position.set(-.31, -.25, .10);
      }
      if (p.guardR) {
        p.guardR.position.set(-.25, -.27, .08);
        p.guardR.rotation.set(0, 0, -1.28);
      }
      if (p.weaponMountR) {
        p.weaponMountR.position.set(-.36, -.22, .12);
        p.weaponMountR.rotation.set(0, 0, 0);
      }
    }
    function syncWeaponGrip(extraR = 0, extraL = 0) {
      const wr = state.parts.weaponMountR, wl = state.parts.weaponMountL;
      if (state.classId === 'mage') applyMageOrbHandPose();
      // 每幀把握持點鎖回手套中心；手臂動畫只改旋轉，不改武器與手的相對位置。
      if (wr) {
        if (state.classId !== 'mage') wr.position.set(0, -.78, 0);
        if (state.classId !== 'mage') {
          wr.rotation.set(-(state.parts.armR.rotation.x || 0) + extraR + ((state.parts.weaponVisualRootR || state.parts.weaponMountR).children.some(o => o.userData?.isHeldSword) ? SWORD_HOLD_X : 0), 0, 0);
          for (const o of (state.parts.weaponVisualRootR || wr).children) {if (o.userData?.isHeldSword) o.rotation.y = SWORD_FORWARD_Y;}
          for (const o of (state.parts.weaponVisualRootR || wr).children) {
            if (o.userData?.isHeldSword) o.rotation.z = SWORD_HOLD_Z;
          }
        }
      }
      if (wl) {
        wl.position.set(0, -.78, 0);
        if (state.classId !== 'mage') {
          // 盾牌是手臂的實體裝備：持盾時不抵消左臂角度，讓盾牌跟著前臂一起抬起。
          if (hasRaisedShield()) {
            // 盾牌隨前臂位置移動，但反向抵消前臂傾角，盾面保持正對前方。
            wl.rotation.set(-(state.parts.armL.rotation.x || 0), 0, -(state.parts.armL.rotation.z || 0));
          } else {
            wl.rotation.set(-(state.parts.armL.rotation.x || 0) + extraL, 0, 0);
          }
        }
      }
    }
    function updateThiefClothAnimation(dt) {
      if (!state.parts?.classVisuals) return;
      const t = performance.now() * .004;
      state.parts.classVisuals.traverse(o => {
        if (o.userData?.thiefHeadbandTail) {o.rotation.z = (o.userData.baseZ || o.rotation.z) + Math.sin(t + (o.position.x > 0 ? 1.3 : 0)) * 0.10;}
        if (o.userData?.thiefScarfTail) {o.rotation.z = (o.userData.baseZ || o.rotation.z) + Math.sin(t * 1.15 + (o.position.x > 0 ? 1.7 : 0)) * 0.13; o.position.x += 0;}
      });
    }
    function updateFloatingMageOrb(dt) {
      if (!state.player || state.classId !== 'mage' || !state.parts?.weaponMountR) return;
      applyMageOrbHandPose();
      state.parts.weaponMountR.traverse(o => {
        if (o.userData?.floatingMageOrb) {
          const t = performance.now() * .0022;
          // 寶珠浮在掌心上方：只做極小幅度上下／前後浮動，絕不離開托掌位置。
          o.position.y = .15 + Math.sin(t) * .035;
          o.position.x = Math.cos(t * .72) * .025;
          o.position.z = .06 + Math.sin(t * .72) * .022;
          o.rotation.y += dt * .9;
        }
      });
    }
    function setHeldWeaponThrust(group, z = 0) {
      if (!group) return;
      // WeaponMount 永遠固定在手套中心；攻擊前後只移動武器本體。
      group.position.set(0, -.78, 0);
      group.traverse(o => {
        if (o.userData?.heldWeapon && o !== group) o.userData.attackThrustZ = z;
      });
      for (const o of group.children) {
        if (o.userData?.heldWeapon) {
          const base = o.userData.floatingMageOrb ? {x: 0, y: .15, z: .06} : {x: 0, y: 0, z: 0};
          o.position.x = base.x;
          o.position.y = base.y;
          o.position.z = base.z + z;
        }
      }
    }
    function updateFaceAnimation(dt) {
      if (!state.player || !state.parts?.faceEyes) return;
      const fa = state.player.userData.faceAnim || (state.player.userData.faceAnim = {timer: 2, blink: 0});
      fa.timer -= dt;
      if (fa.timer <= 0 && fa.blink <= 0) {
        fa.blink = .16;
        fa.timer = 1.8 + Math.random() * 3.2;
      }
      if (fa.blink > 0) {
        fa.blink -= dt;
        const p = Math.max(0, Math.min(1, (.16 - fa.blink) / .16));
        const close = p < .5 ? p * 2 : (1 - p) * 2;
        const sy = .08 + .92 * close;
        for (const eg of state.parts.faceEyes) eg.scale.y = sy;
      } else {
        for (const eg of state.parts.faceEyes) eg.scale.y = 1;
      }
    }
    function updateWalkAnimation(dt) {
      if (!state.player || !state.parts) return;
      stripArmWeaponAdjustments();
      updateThiefClothAnimation(dt);
      const moving = !!state.walkAnim.moving;
      const w = state.walkAnim;
      const ac = state.parts.animationController;
      if (ac) { ac.setMoving(moving, w.speed); ac.setAttack(!!state.attackAnim.active); ac.update(dt); ac.setState(moving ? 'walk' : 'idle'); }
      if (moving) {
        const speed = Math.max(5, w.speed || 6);
        w.phase += dt * speed * 1.65;
        const swing = Math.sin(w.phase);
        const swing2 = Math.sin(w.phase + Math.PI);
        const bob = Math.abs(Math.sin(w.phase)) * 0.045;
        state.parts.legL.rotation.x = swing * .62;
        state.parts.legR.rotation.x = swing2 * .62;
        if (state.parts.shoeL) {
          state.parts.shoeL.rotation.x = swing * .22;
          state.parts.shoeR.rotation.x = swing2 * .22;
          state.parts.soleL.rotation.x = swing * .22;
          state.parts.soleR.rotation.x = swing2 * .22;
          state.parts.shoeL.position.z = .12 + Math.max(0, swing) * .075;
          state.parts.shoeR.position.z = .12 + Math.max(0, swing2) * .075;
          state.parts.soleL.position.z = .12 + Math.max(0, swing) * .075;
          state.parts.soleR.position.z = .12 + Math.max(0, swing2) * .075;
        }
        if (!state.attackAnim.active) {
          state.parts.armL.rotation.x = hasRaisedShield() ? -.72 : (-.38 + swing2 * .42);
          state.parts.armR.rotation.x = -.38 + swing * .42;
          state.parts.armL.rotation.z = hasRaisedShield() ? .10 : .13;
          state.parts.armR.rotation.z = -.13;
          if (state.classId === 'mage') applyMageOrbHandPose();
        }
        state.parts.body.position.y = bob;
        state.parts.head.position.y = 2.18 + bob;
        if (state.parts.hairStyles) state.parts.hairStyles.position.y = bob;
      } else {
        w.phase *= .82;
        state.parts.legL.rotation.x *= .78;
        state.parts.legR.rotation.x *= .78;
        if (state.parts.shoeL) {
          state.parts.shoeL.rotation.x *= .78;
          state.parts.shoeR.rotation.x *= .78;
          state.parts.soleL.rotation.x *= .78;
          state.parts.soleR.rotation.x *= .78;
          state.parts.shoeL.position.z += (.12 - state.parts.shoeL.position.z) * .22;
          state.parts.shoeR.position.z += (.12 - state.parts.shoeR.position.z) * .22;
          state.parts.soleL.position.z += (.12 - state.parts.soleL.position.z) * .22;
          state.parts.soleR.position.z += (.12 - state.parts.soleR.position.z) * .22;
        }
        if (!state.attackAnim.active) {
          if (hasRaisedShield()) applyShieldArmPose();
          else {
            state.parts.armL.rotation.x *= .72;
            state.parts.armR.rotation.x *= .72;
            state.parts.armL.rotation.z = .13;
            state.parts.armR.rotation.z = -.13;
            if (state.classId === 'mage') applyMageOrbHandPose();
          }

        }
        state.parts.body.position.y *= .78;
        state.parts.head.position.y = 2.18 + state.parts.body.position.y;
        if (state.parts.hairStyles) state.parts.hairStyles.position.y = state.parts.body.position.y;
      }
      if (!state.attackAnim.active) syncWeaponGrip();
      applyArmRotationOffsets();
      applyArmWeaponMountAdjustments();
    }
    function updateAttackAnimation(dt) {
      stripArmWeaponAdjustments();
      const a = state.attackAnim; if (!a.active || !state.player) return;
      if (state.parts?.animationController) { state.parts.animationController.setAttack(true); state.parts.animationController.setState('attack'); }
      a.t += dt;
      const p = Math.min(1, a.t / a.duration), c = state.classId;
      const wind = Math.sin(Math.PI * Math.min(1, p / .42));
      const hit = p < .42 ? -wind : Math.sin(Math.PI * ((p - .42) / .58));
      const wr = state.parts.weaponMountR, wl = state.parts.weaponMountL;
      // 每個職業使用不同的「向前」攻擊動作；武器仍然跟隨手掌。
      if (c === 'warrior' || c === 'novice') {
        // 戰士／初心者：真正的單手劍「舉劍 -> 向下劈 -> 收回」三段式攻擊。
        // 手臂本身就是持劍骨骼，因此劍會跟著右手一起抬起與下劈；不另外移動握點。
        const windEnd = .34;
        const strikeEnd = .66;
        let armX = -.38;
        let slashStrength = 0;
        if (p < windEnd) {
          // ① 舉高：手掌＋整條右臂一起往上抬，劍提高到頭部上方。
          // 使用負 X 角度，讓手保持在角色前側，不再往背後折。
          const q = Math.min(1, p / windEnd);
          const e = 1 - Math.pow(1 - q, 3);
          armX = -.38 + (-1.46 + .38) * e;
        } else if (p < strikeEnd) {
          // ② 向下劈：從高位直接向前下方帶劍劈落。
          // 不再穿過「大幅後擺」的 1.6rad 區域，避免劍直接翻向地面／背後。
          const q = Math.min(1, (p - windEnd) / (strikeEnd - windEnd));
          const e = q * q * (3 - 2 * q);
          armX = -1.46 + (.28 + 1.46) * e;
          slashStrength = Math.sin(Math.PI * q);
        } else {
          // ③ 收回：快速回到正常持劍姿勢。
          const q = Math.min(1, (p - strikeEnd) / (1 - strikeEnd));
          const e = 1 - Math.pow(1 - q, 3);
          armX = .28 + (-.38 - .28) * e;
        }
