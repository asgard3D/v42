          const tailTip = mesh(new THREE.ConeGeometry(.095, .31, 8), whiteLongHairMat);
          tailTip.position.set(0, -.405, -.585);
          tailTip.rotation.x = Math.PI;
          tailTip.userData.wolfHatWhiteLongHair = true;
          tailTip.userData.wolfTailRootTucked = true;
          g.add(tailTip);

