    function makeBossLegendaryDrop(enemyLevel) {
      const kind = randomEquipmentDrop(enemyLevel); if (!kind) return null;
      const sacred = !['demon', 'volcano'].includes(state.zone);
      const bossLevel = equipmentTierAtOrBelow(enemyLevel || kind.itemLevel || 1); const item = {...kind, rarity: 'legendary', specialSeries: sacred ? 'sacred' : 'demon', itemLevel: bossLevel, classId: state.classId, equipTier: equipmentVisualTier(bossLevel)};
      const prefix = sacred ? '神聖·' : '惡魔·';
      item.name = (kind.name || '裝備').replace(/^(?:傳說|史詩|稀有|精良|神聖|惡魔)[·\s]*/, '');
      item.atk = Math.round((item.atk || 0) * 1.55) + 18; item.def = Math.round((item.def || 0) * 1.55) + 18;
      item.matk = Math.round((item.matk || 0) * 1.45) + (sacred ? 14 : 10); item.mdef = Math.round((item.mdef || 0) * 1.45) + (sacred ? 14 : 10);
      return item;
    }
    function weaponQualityStyle(it) {
      const rarity = it?.rarity || 'normal';
      // 普通白 / 精良綠 / 稀有藍 / 史詩紫 / 傳說橙金。
      // 神聖白黃 / 惡魔黑紅。
      if (it?.specialSeries === 'sacred') return {main: 0xfff8df, metal: 0xfff2b84b, accent: 0xfffff2, glow: 0xffffd36b, shape: 3};
      if (it?.specialSeries === 'demon') return {main: 0x160b10, metal: 0x5c1724, accent: 0xff334c, glow: 0xff1028, shape: 3};
      return ({
        normal: {main: 0xf2f2f2, metal: 0xcfd4dc, accent: 0xffffff, glow: 0xffffff, shape: 0},
        good: {main: 0x4fbd68, metal: 0x75d98a, accent: 0x9affaa, glow: 0x55ff78, shape: 1},
        rare: {main: 0x348cff, metal: 0x74b8ff, accent: 0xa8d8ff, glow: 0x3fa7ff, shape: 1},
        epic: {main: 0x9a4be8, metal: 0xc487ff, accent: 0xe0b5ff, glow: 0xb55cff, shape: 2},
        legendary: {main: 0xff9f24, metal: 0xffc75a, accent: 0xffedaa, glow: 0xffa51f, shape: 3}
      }[rarity]) || {main: 0xf2f2f2, metal: 0xcfd4dc, accent: 0xffffff, glow: 0xffffff, shape: 0};
    }
    function weaponTierStyle(it) {
      const tier = equipmentVisualTier(it?.itemLevel || 1);
      return {
        tier,
        ...({
          starter: {name: '初心', length: 1.00, width: 1.00, detail: 0},
          field: {name: '精製', length: 1.08, width: 1.08, detail: 1},
          royal: {name: '王家', length: 1.16, width: 1.15, detail: 2},
          sacred: {name: '神聖', length: 1.24, width: 1.20, detail: 3},
          transcendent: {name: '天啟', length: 1.32, width: 1.27, detail: 4},
          divine: {name: '聖耀', length: 1.42, width: 1.34, detail: 5}
        }[tier] || {name: '初心', length: 1, width: 1, detail: 0})
      };
    }
    function makeWeaponVisual(it) {
      const g = new THREE.Group(); if (!it) return g;
      const q = weaponQualityStyle(it), ts = weaponTierStyle(it);
      const r = q.shape, d = ts.detail;
      const metal = mat(q.metal, .30 + r * .04, .42 + r * .08);
      const main = mat(q.main, .28 + r * .03, .34 + r * .08);
      const accent = mat(q.accent, .22 + r * .04, .52 + r * .08);
      const glowMat = () => new THREE.MeshBasicMaterial({color: q.glow, transparent: true, opacity: r === 0 ? .34 : r === 1 ? .55 : r === 2 ? .78 : .92, blending: THREE.AdditiveBlending, depthWrite: false});
      const add = (o, x = 0, y = 0, z = 0) => {o.position.set(x, y, z); g.add(o); return o};
      const bladeMaterial = () => mat(r === 0 ? q.main : r === 1 ? q.metal : r === 2 ? q.accent : q.metal, .22, .58);

      // 武器的「品質」會改變輪廓、材質與裝飾，而不只是加光。
      // 武器的「裝備等級範圍」則逐階增加長度、護手、寶石與翼狀結構。
      if (it.visual === 'noviceWoodSword') {
        const woodDark = mat(0x6f4a2f, .75, .05), wood = mat(0xa9794e, .70, .05), wrap = mat(0x4f3828, .72, .04);
        const handle = add(mesh(new THREE.CylinderGeometry(.045, .055, .34, 8), wrap), 0, 0, -.20); handle.rotation.x = Math.PI / 2;
        const guard = add(mesh(new THREE.BoxGeometry(.40, .07, .09), woodDark), 0, 0, .015);
        const blade = add(mesh(new THREE.BoxGeometry(.16, .16, 1.17), wood), 0, 0, .625);
        blade.scale.y = .72;
        const tip = add(mesh(new THREE.ConeGeometry(.115, .20, 4), wood), 0, 0, 1.23); tip.rotation.x = Math.PI / 2;
        const grain = add(mesh(new THREE.BoxGeometry(.035, .17, 1.05), woodDark), 0, .015, .64); grain.scale.x = .55;
        return g;

      } else if (it.visual === 'noviceWoodDagger') {
        const woodDark = mat(0x5a3c27, .82, .03), wood = mat(0xa87445, .76, .03), wrap = mat(0x6c4930, .80, .02);
        const h = add(mesh(new THREE.CylinderGeometry(.045, .055, .30, 8), wrap), 0, 0, -.14); h.rotation.x = Math.PI / 2;
        const guard = add(mesh(new THREE.BoxGeometry(.33, .065, .08), woodDark), 0, 0, .015);
        const blade = add(mesh(new THREE.BoxGeometry(.11, .12, .78), wood), 0, 0, .40); blade.rotation.y = .03;
        add(mesh(new THREE.BoxGeometry(.028, .13, .68), woodDark), 0, .015, .42);
        add(mesh(new THREE.ConeGeometry(.09, .16, 4), wood), 0, 0, .86).rotation.x = Math.PI / 2;
      } else if (it.visual === 'noviceWoodOrb') {
        const wood = mat(0x9c6a3d, .78, .03), dark = mat(0x634226, .82, .02);
        const shaft = add(mesh(new THREE.CylinderGeometry(.035, .05, .46, 8), dark), 0, .02, 0); shaft.rotation.x = Math.PI / 2;
        const orb = add(mesh(new THREE.SphereGeometry(.18, 14, 10), wood), 0, .02, .33); orb.scale.set(1, 1, .82);
        const ring = add(mesh(new THREE.TorusGeometry(.22, .018, 7, 20), dark), 0, .02, .33); ring.rotation.x = Math.PI / 2;
      } else if (it.visual === 'noviceWoodFist') {
        const wood = mat(0xa56d3c, .78, .02), dark = mat(0x5c3b24, .82, .02);
        const base = add(mesh(new THREE.SphereGeometry(.18, 10, 8), wood), 0, .04, .13); base.scale.set(1.18, .88, 1.22);
        for (const x of [-.10, 0, .10]) add(mesh(new THREE.SphereGeometry(.044, 8, 6), dark), x, .10, .29);
        const plate = add(mesh(new THREE.BoxGeometry(.32, .12, .09), dark), 0, .02, .24); plate.rotation.x = -.10;
      } else if (it.visual === 'noviceWoodStaff') {
        const wood = mat(0xa87445, .78, .03), dark = mat(0x5a3c27, .82, .02);
        const shaft = add(mesh(new THREE.CylinderGeometry(.045, .065, .96, 8), wood), 0, .05, 0); shaft.rotation.x = Math.PI / 2;
        const head = add(mesh(new THREE.SphereGeometry(.15, 12, 8), wood), 0, .05, .53);
        const cross = add(mesh(new THREE.BoxGeometry(.22, .055, .055), dark), 0, .05, .53);
        cross.rotation.z = .55;
      } else if (it.visual === 'orb' || it.visual === 'arcaneorb') {return makeMageOrb();} else if (it.visual === 'staff' || it.visual === 'crystalstaff') {
        const shaft = add(mesh(new THREE.CylinderGeometry(.045, .065, .82 * ts.length, 8), main), 0, .05, 0);
        shaft.rotation.x = Math.PI / 2;
        const cap = add(mesh(new THREE.SphereGeometry(.08, .12, 8), metal), 0, .05, .43 * ts.length);
        if (r >= 1) add(mesh(new THREE.OctahedronGeometry(.10 + r * .018), accent), 0, .05, .47 * ts.length);
        if (r >= 2) {
          const ring = add(new THREE.Mesh(new THREE.TorusGeometry(.16 + .025 * d, .018, 7, 20), glowMat()), 0, .05, .47 * ts.length);
          ring.rotation.x = Math.PI / 2;
          const ring2 = add(new THREE.Mesh(new THREE.TorusGeometry(.105 + .018 * d, .012, 7, 20), new THREE.MeshBasicMaterial({color: q.accent, transparent: true, opacity: .75, blending: THREE.AdditiveBlending, depthWrite: false})), 0, .05, .47 * ts.length);
          ring2.rotation.y = Math.PI / 2;
        }
        if (d >= 2) {
          for (const sx of [-1, 1]) {
            const fin = add(mesh(new THREE.ConeGeometry(.045 + .01 * d, .22 + .025 * d, 6), accent), sx * (.09 + .018 * d), .05, .42 * ts.length);
            fin.rotation.z = sx * .72;
          }
        }
        if (d >= 3) {
          for (const sx of [-1, 1]) {
            const wing = add(new THREE.Mesh(new THREE.ConeGeometry(.055, .30 + .035 * d, 6), glowMat()), sx * (.13 + .02 * d), .05, .40 * ts.length);
            wing.rotation.z = sx * .78; wing.rotation.y = sx * .18;
          }
        }
        if (d >= 4) {
          add(new THREE.PointLight(q.glow, 1.0 + r * .35, 2.4, 2), 0, .05, .42 * ts.length);
        }
      } else if (it.visual === 'dagger') {
        const count = 1;
        for (let i = 0; i < count; i++) {
          const x = 0;
          const dir = i === 1 ? -1 : 1;
          const handle = add(mesh(new THREE.CylinderGeometry(.04, .055, .28, 8), metal), x, 0, -.14);
          handle.rotation.x = Math.PI / 2;
          const guard = add(mesh(new THREE.BoxGeometry(.34 + .045 * d, .065 + .012 * d, .09), accent), x, 0, .015);
          guard.rotation.z = (r >= 2 ? (i === 0 ? .08 : -.08) : 0);
          const blade = add(mesh(new THREE.ConeGeometry(.075 * ts.width, .54 * ts.length, 4), bladeMaterial()), x, 0, .35 * dir);
          blade.rotation.x = dir > 0 ? Math.PI / 2 : -Math.PI / 2;
          if (r >= 1) {
            const edge = add(new THREE.Mesh(new THREE.BoxGeometry(.025, .05, .56 * ts.length), glowMat()), x, 0, .36 * dir);
            edge.rotation.x = Math.PI / 2;
          }
          if (r >= 2) {
            for (const sx of [-1, 1]) {
              const fin = add(mesh(new THREE.ConeGeometry(.028, .18 + .025 * d, 5), accent), x + sx * .09, 0, .27 * dir);
              fin.rotation.z = sx * .72;
            }
          }
        }
      } else if (it.visual === 'fist' || it.visual === 'gauntlet') {
        const base = add(mesh(new THREE.SphereGeometry(.18 + .018 * d, 10, 8), main), 0, .04, .13);
        base.scale.set(1.2 + .06 * d, .88, 1.25 + .04 * d);
        for (const x of [-.10, 0, .10]) {
          add(mesh(new THREE.SphereGeometry(.045 + .008 * d, 8, 6), r >= 2 ? accent : metal), x, .10, .29);
        }
        if (r >= 1) {
          const plate = add(mesh(new THREE.BoxGeometry(.34 + .04 * d, .18, .10), metal), 0, .02, .24);
          plate.rotation.x = -.12;
        }
        if (r >= 2) {
          for (const sx of [-1, 1]) {
            const spike = add(mesh(new THREE.ConeGeometry(.035, .20 + .025 * d, 6), accent), sx * .15, .08, .34);
            spike.rotation.x = -Math.PI / 2;
          }
        }
        if (r >= 3) add(new THREE.PointLight(q.glow, 1.0, 2.2, 2), 0, .05, .28);
      } else {
        // 劍系：Lv.1-10 為簡潔短劍；Lv.11+ 加寬刃；Lv.21+ 雙層護手；
        // Lv.41+ 神聖翼刃；Lv.61+ 天啟王冠刃。品質再改變金屬、刃形與裝飾。
        const isGreat = it.visual === 'greatsword'; if (isGreat) g.userData.twoHanded = true;
        const len = (isGreat ? 2.07 : 1.53) * ts.length;
        const width = (isGreat ? .28 : .22) * ts.width;

        // 握把：與劍身使用不同材質與顏色，避免整把武器看起來像一根鐵條。
        const gripMat = mat(r >= 2 ? 0x252a33 : 0x30343b, .78, .20);
        const gripWrap = mat(r >= 2 ? 0x171b22 : 0x252a30, .82, .14);
        const handle = add(mesh(new THREE.CylinderGeometry(isGreat ? .055 : .05, isGreat ? .065 : .058, isGreat ? .40 : .32, 10), gripMat), 0, 0, -.20);
        handle.rotation.x = Math.PI / 2;
        // 深色皮革纏帶，讓握把有明確的材質層次。
        for (let i = 0; i < 4; i++) {
          const band = add(mesh(new THREE.TorusGeometry(isGreat ? .067 : .060, .012, 6, 14), gripWrap), 0, 0, -.33 + i * (isGreat ? .085 : .068));
          band.rotation.x = Math.PI / 2;
        }

        // 護手：獨立金屬材質，左右略微上翹。
        const guard = add(mesh(new THREE.BoxGeometry((isGreat ? .58 : .46) + .055 * d, .085 + .016 * d, .11), accent), 0, 0, .015);
        if (r >= 2) guard.rotation.z = .08;
        for (const sx of [-1, 1]) {
          const guardWing = add(mesh(new THREE.ConeGeometry(.055 + .012 * d, .22 + .035 * d, 6), accent), sx * (isGreat ? .27 : .21), 0, .035);
          guardWing.rotation.z = sx * (Math.PI / 2 - .25);
          guardWing.rotation.y = sx * .12;
        }

        // 劍身：薄片長條 + 一點實際厚度，不再使用厚方塊。
        // Shape 的 Y 軸就是劍長，Extrude 的 Z 軸提供薄片厚度。
        const bladeShape = new THREE.Shape();
        const shoulder = .46;
        bladeShape.moveTo(-width * .46, 0);
        bladeShape.lineTo(-width * .50, len * .70);
        bladeShape.lineTo(-width * .20, len * .90);
        bladeShape.lineTo(0, len);
        bladeShape.lineTo(width * .20, len * .90);
        bladeShape.lineTo(width * .50, len * .70);
        bladeShape.lineTo(width * .46, 0);
        bladeShape.closePath();
        const bladeGeo = new THREE.ExtrudeGeometry(bladeShape, {depth: isGreat ? .075 : .055, bevelEnabled: true, bevelSegments: 1, bevelSize: .012, bevelThickness: .008, curveSegments: 1, steps: 1});
        bladeGeo.translate(0, 0, -(isGreat ? .075 : .055) / 2);
        const blade = add(new THREE.Mesh(bladeGeo, bladeMaterial()), 0, 0, .16);
        blade.rotation.x = Math.PI / 2;

        // 劍脊／血槽：使用稍深的鋼色薄片，突出劍身結構。
        const fullerMat = mat(r >= 2 ? 0x7e8997 : 0x9aa4af, .30, .48);
        const fullerShape = new THREE.Shape();
        const fw = width * .11;
        fullerShape.moveTo(-fw, 0);
        fullerShape.lineTo(-fw * .72, len * .73);
        fullerShape.lineTo(0, len * .86);
        fullerShape.lineTo(fw * .72, len * .73);
        fullerShape.lineTo(fw, 0);
        fullerShape.closePath();
        const fullerGeo = new THREE.ExtrudeGeometry(fullerShape, {depth: .012, bevelEnabled: false});
        fullerGeo.translate(0, 0, -.006);
        const fuller = add(new THREE.Mesh(fullerGeo, fullerMat), 0, .018, .16);
        fuller.rotation.x = Math.PI / 2;

        // 對稱刃口高光，讓薄片劍身有清楚的左右刃線。
        const edgeMat = mat(r >= 2 ? 0xcbd5df : 0xdce3ea, .22, .62);
        for (const sx of [-1, 1]) {
          const edgeShape = new THREE.Shape();
          const ew = width * .045;
          edgeShape.moveTo(sx * width * .43, 0);
          edgeShape.lineTo(sx * width * .46, len * .68);
          edgeShape.lineTo(sx * width * .18, len * .91);
          edgeShape.lineTo(sx * width * .12, len * .87);
          edgeShape.closePath();
          const edgeGeo = new THREE.ExtrudeGeometry(edgeShape, {depth: .009, bevelEnabled: false});
          edgeGeo.translate(0, 0, -.0045);
          const edge = add(new THREE.Mesh(edgeGeo, edgeMat), 0, .025, .16);
          edge.rotation.x = Math.PI / 2;
        }

        if (d >= 1) {
          const pommel = add(mesh(new THREE.OctahedronGeometry(.075 + .014 * d), accent), 0, 0, -.40);
          pommel.scale.set(1, 1, .72);
          const pommelGem = add(new THREE.Mesh(new THREE.OctahedronGeometry(.038 + .008 * r), new THREE.MeshBasicMaterial({color: q.glow, transparent: true, opacity: .78, blending: THREE.AdditiveBlending, depthWrite: false})), 0, 0, -.43);
          pommelGem.scale.set(1, 1, .65);
        }
        if (d >= 2) {
          for (const sx of [-1, 1]) {
            const side = add(mesh(new THREE.BoxGeometry(.055 + .012 * d, .12, .46 + .06 * d), metal), sx * (width * .72), .03, .60);
            side.rotation.z = sx * .20;
          }
        }
        if (d >= 3) {
          for (const sx of [-1, 1]) {
            const wing = add(mesh(new THREE.ConeGeometry(.055, .34 + .04 * d, 6), accent), sx * (.16 + .025 * d), .03, .70);
            wing.rotation.z = sx * (r >= 2 ? .55 : .42);
          }
          const core = add(new THREE.Mesh(new THREE.OctahedronGeometry(.075 + .012 * r), glowMat()), 0, .13, .70);
          core.rotation.y = .35;
        }
        if (d >= 4) {
          const crown = add(mesh(new THREE.TorusGeometry(.18, .025, 7, 20), glowMat()), 0, .13, .82);
          crown.rotation.x = Math.PI / 2;
          add(new THREE.PointLight(q.glow, 1.0 + r * .20, 2.8, 2), 0, .12, .68);
        }
      }
      // 稀有 / 史詩 / 傳說的品質標誌：輪廓逐級增加，且只有傳說才使用金色核心光。
      if (r === 1) {
        const mark = add(new THREE.Mesh(new THREE.TorusGeometry(.18, .014, 7, 20), new THREE.MeshBasicMaterial({color: q.glow, transparent: true, opacity: .68, blending: THREE.AdditiveBlending, depthWrite: false})), 0, .08, .48);
        mark.rotation.x = Math.PI / 2;
      } else if (r === 2) {
        for (const sx of [-1, 1]) {
          const gem = add(new THREE.Mesh(new THREE.OctahedronGeometry(.055, 0), new THREE.MeshBasicMaterial({color: q.glow, transparent: true, opacity: .9, blending: THREE.AdditiveBlending, depthWrite: false})), sx * .13, .10, .50);
          gem.rotation.z = sx * .3;
        }
      } else if (r === 3) {
        const crown = add(new THREE.Mesh(new THREE.TorusGeometry(.24, .025, 8, 24), new THREE.MeshBasicMaterial({color: q.glow, transparent: true, opacity: .9, blending: THREE.AdditiveBlending, depthWrite: false})), 0, .11, .52);
        crown.rotation.x = Math.PI / 2;
        const core = add(new THREE.Mesh(new THREE.OctahedronGeometry(.085, 0), new THREE.MeshBasicMaterial({color: q.accent, transparent: true, opacity: .98, blending: THREE.AdditiveBlending, depthWrite: false})), 0, .11, .62);
        core.rotation.y = .4;
        add(new THREE.PointLight(q.glow, 1.35, 2.8, 2), 0, .11, .60);
      }
      addClassTierVisual(g, it, 'weapon');
      return g;
    }

    function wolfHatTierStyle(it) {
      const n = Math.max(1, Number(it?.itemLevel) || 1);
      const tier = n >= 91 ? 'divine' : n >= 81 ? 'sanctum' : n >= 71 ? 'legacy' : n >= 61 ? 'heroic' : n >= 51 ? 'royal' : n >= 41 ? 'elite' : n >= 21 ? 'advanced' : n >= 11 ? 'field' : 'starter';
      const palettes = {
        starter: {fur: 0x4b403d, deep: 0x272126, inner: 0xd18b87, trim: 0x7b685d, eye: 0xc89a43},
        field: {fur: 0x3f4d48, deep: 0x202928, inner: 0x8fc0a7, trim: 0x5d786f, eye: 0x8fe0b0},
        advanced: {fur: 0x3a3f52, deep: 0x171a25, inner: 0x9aa7d2, trim: 0x6877a9, eye: 0x8ec7ff},
        elite: {fur: 0x51404d, deep: 0x211826, inner: 0xd0a0d5, trim: 0x7d5d86, eye: 0xd49cff},
        royal: {fur: 0x5a4937, deep: 0x241b12, inner: 0xe1b77e, trim: 0x8f713f, eye: 0xffd866},
        heroic: {fur: 0x46545e, deep: 0x1a2228, inner: 0x9fd6e8, trim: 0x6b8691, eye: 0xa7efff},
        legacy: {fur: 0x4b3d53, deep: 0x21152a, inner: 0xc7a2e3, trim: 0x775a92, eye: 0xefb7ff},
        sanctum: {fur: 0x6b6254, deep: 0x2e291f, inner: 0xf0d6b8, trim: 0xb29a6a, eye: 0xffef9c},
        divine: {fur: 0x6a6460, deep: 0x27282a, inner: 0xe8e9ef, trim: 0xbfc4d2, eye: 0xffffff}
      }[tier];
      const rarity = it?.rarity || 'normal';
      if (rarity === 'rare') {palettes.fur = 0x365a77; palettes.trim = 0x5b9ed3; palettes.eye = 0x8bd5ff;}
      if (rarity === 'epic') {palettes.fur = 0x54336c; palettes.trim = 0x9b67cf; palettes.eye = 0xe9b6ff;}
      if (rarity === 'legendary') {palettes.fur = 0x7b4d24; palettes.trim = 0xd09a40; palettes.eye = 0xffe08a;}
      return {...palettes, tier};
    }
    function helmetQualityStyle(it) {
      const rarity = it.rarity || 'normal';
      const classTone = {
        novice: {main: 0x76563d, accent: 0xd9bd7c, gem: 0x8fd8ff},
        warrior: {main: 0x8f2635, accent: 0xff6b4a, gem: 0xff4b45},
        mage: {main: 0x4b2f8f, accent: 0xc5a3ff, gem: 0xb66cff},
        thief: {main: 0x27352f, accent: 0x68d391, gem: 0x55e58a},
        priest: {main: 0xe9e2d2, accent: 0xffe28a, gem: 0x69c9ff},
        monk: {main: 0x9b4a2f, accent: 0xf3bf5b, gem: 0xff9f3f}
      }[it.classId] || null;
      const q = {
        normal: {main: classTone?.main || 0x6d7078, accent: classTone?.accent || 0xc6cbd2, gem: classTone?.gem || 0xd6d9df, metal: .18},
        rare: {main: classTone ? THREE.MathUtils.lerp(classTone.main, 0x3d7db7, .35) : 0x356fa3, accent: classTone?.accent || 0x70c8ff, gem: classTone?.gem || 0x69cfff, metal: .30},
        epic: {main: classTone ? THREE.MathUtils.lerp(classTone.main, 0x713fa2, .28) : 0x7042a2, accent: classTone?.accent || 0xd28cff, gem: classTone?.gem || 0xc779ff, metal: .34},
        legendary: {main: classTone?.main || 0x5f6470, accent: classTone?.accent || 0xc6cbd2, gem: classTone?.gem || 0xd6d9df, metal: .40}
      }[rarity] || {main: classTone?.main || 0x6d7078, accent: classTone?.accent || 0xc6cbd2, gem: classTone?.gem || 0xd6d9df, metal: .18};
      const base = {
        novicecap: {main: 0xe9edf2, accent: 0xcbd5df, gem: 0x9fdcff},
        wolfcap: {main: 0x4b403d, accent: 0x8d7a72, gem: 0xc89a43},
        knighthelm: {main: q.main, accent: q.accent, gem: q.gem},
        windcap: {main: rarity === 'normal' ? 0x3d4a58 : q.main, accent: q.accent, gem: q.gem},
        headband: {main: rarity === 'normal' ? 0x9a3038 : q.main, accent: q.accent, gem: q.gem},
        wizardhat: {main: rarity === 'normal' ? 0x51439d : q.main, accent: q.accent, gem: q.gem},
        holycrw: {main: rarity === 'normal' ? 0xd8d2c5 : q.main, accent: q.accent, gem: q.gem}
      }[it.visual] || {main: q.main, accent: q.accent, gem: q.gem};
      return {main: base.main, accent: base.accent, gem: base.gem, metal: q.metal};
    }

    function addSpecialEquipmentWings(g, series) {
      if (!g) return;

      const holy = series === 'sacred';

      // 神聖：白色羽翼 + 金白光
      // 惡魔：近黑羽翼 + 深紅光
      const wingColor = holy ? 0xfffbeb : 0x12070b;
      const glowColor = holy ? 0xfff0a6 : 0xff2038;
      const outerColor = holy ? 0xffffff : 0xff1830;
      const auraColor = holy ? 0xffe7a0 : 0x8f001c;

      const wings = new THREE.Group();
      wings.name = 'SpecialEquipmentWings';
      wings.userData.specialEquipmentWings = true;

      // V8.20：
      // 1. 翼整體向後移，與頭髮／身體保持明顯空隙。
      // 2. 翼根浮在角色背後，不直接貼背。
      // 3. 翼面改為「左右伸展」，不再往頭頂延伸。
      wings.position.set(0, 1.72, -1.10);

      // 建立一側翅膀：X 軸向外展開，Y 軸只保留輕微上下起伏。
      const makeWing = (side) => {
        const s = side;

        const shape = new THREE.Shape();
        shape.moveTo(0, 0);

        // 上緣：由翼根向左右肩外側展開
        shape.bezierCurveTo(
          s * .30, .10,
          s * .70, .27,
          s * 1.08, .28
        );
        shape.bezierCurveTo(
          s * 1.38, .29,
          s * 1.62, .12,
          s * 1.78, -.08
        );

        // 翼尖向外、略向下
        shape.bezierCurveTo(
          s * 1.55, -.06,
          s * 1.34, -.02,
          s * 1.10, -.12
        );

        // 下緣收回翼根
        shape.bezierCurveTo(
          s * .82, -.23,
          s * .54, -.17,
          s * .28, -.08
        );
        shape.bezierCurveTo(
          s * .12, -.04,
          s * .04, -.01,
          0, 0
        );

        const geo = new THREE.ShapeGeometry(shape, 12);

        // 主翼：神聖是乳白色，惡魔是近黑色。
        const matMain = new THREE.MeshBasicMaterial({
          color: wingColor,
          transparent: true,
          opacity: holy ? .58 : .82,
          side: THREE.DoubleSide,
          blending: holy ? THREE.AdditiveBlending : THREE.NormalBlending,
          depthWrite: false
        });

        const wing = new THREE.Mesh(geo, matMain);
        wing.position.set(0, 0, 0);
        wing.scale.set(1, 1, 1);
        wing.rotation.y = s > 0 ? .025 : -.025;
        wing.userData.specialWing = true;
        wings.add(wing);

        // 柔和外光暈：讓「發光」不只是一條線。
        const auraMat = new THREE.MeshBasicMaterial({
          color: auraColor,
          transparent: true,
          opacity: holy ? .12 : .18,
          side: THREE.DoubleSide,
          blending: THREE.AdditiveBlending,
          depthWrite: false
        });
        const aura = new THREE.Mesh(geo.clone(), auraMat);
        aura.scale.set(1.10, 1.10, 1);
        aura.position.z = -.012;
        aura.userData.specialWing = true;
        wings.add(aura);

        // 翼脈：沿著左右方向延伸，不再向上。
        const veinMat = new THREE.LineBasicMaterial({
          color: glowColor,
          transparent: true,
          opacity: holy ? 1.0 : .96,
          blending: THREE.AdditiveBlending,
          depthWrite: false
        });

        const points = [
          new THREE.Vector3(0, .015, .018),
          new THREE.Vector3(s * .34, .09, .018),
          new THREE.Vector3(s * .72, .18, .018),
          new THREE.Vector3(s * 1.12, .20, .018),
          new THREE.Vector3(s * 1.48, .07, .018),
          new THREE.Vector3(s * 1.72, -.06, .018)
        ];

        const vein = new THREE.Line(
          new THREE.BufferGeometry().setFromPoints(points),
          veinMat
        );
        vein.userData.specialWing = true;
        wings.add(vein);

        // 兩條較短的羽脈，增加「翼」的層次。
        const featherLines = [
          [
            new THREE.Vector3(s * .24, .02, .019),
            new THREE.Vector3(s * .68, .07, .019),
            new THREE.Vector3(s * 1.18, .02, .019)
          ],
          [
            new THREE.Vector3(s * .30, -.025, .019),
            new THREE.Vector3(s * .78, -.06, .019),
            new THREE.Vector3(s * 1.38, -.04, .019)
          ]
        ];

        for (const pts of featherLines) {
          const line = new THREE.Line(
            new THREE.BufferGeometry().setFromPoints(pts),
            new THREE.LineBasicMaterial({
              color: holy ? 0xffffe8 : 0xff3048,
              transparent: true,
              opacity: holy ? .90 : .84,
              blending: THREE.AdditiveBlending,
              depthWrite: false
            })
          );
          line.userData.specialWing = true;
          wings.add(line);
        }

        // 外輪廓光。
        const outlinePts = [
          new THREE.Vector3(0, 0, .022),
          new THREE.Vector3(s * .30, .10, .022),
          new THREE.Vector3(s * .70, .27, .022),
          new THREE.Vector3(s * 1.08, .28, .022),
          new THREE.Vector3(s * 1.38, .29, .022),
          new THREE.Vector3(s * 1.62, .12, .022),
          new THREE.Vector3(s * 1.78, -.08, .022),
          new THREE.Vector3(s * 1.55, -.06, .022),
          new THREE.Vector3(s * 1.10, -.12, .022),
          new THREE.Vector3(s * .82, -.23, .022),
          new THREE.Vector3(s * .54, -.17, .022),
          new THREE.Vector3(s * .28, -.08, .022)
        ];

        const outline = new THREE.Line(
          new THREE.BufferGeometry().setFromPoints(outlinePts),
          new THREE.LineBasicMaterial({
            color: outerColor,
            transparent: true,
            opacity: holy ? .96 : .94,
            blending: THREE.AdditiveBlending,
            depthWrite: false
          })
        );
        outline.userData.specialWing = true;
        wings.add(outline);
      };

      makeWing(-1);
      makeWing(1);

      // 翼根也保持懸空，只保留一小團光，不與身體直接接觸。
      const rootGlow = new THREE.Mesh(
        new THREE.SphereGeometry(.14, 12, 10),
        new THREE.MeshBasicMaterial({
          color: glowColor,
          transparent: true,
          opacity: holy ? .82 : .78,
          blending: THREE.AdditiveBlending,
          depthWrite: false
        })
      );
      rootGlow.scale.set(1.45, .75, .45);
      rootGlow.position.set(0, .01, .00);
      rootGlow.userData.specialWing = true;
      wings.add(rootGlow);

      // 光翼的環境光：神聖偏白黃，惡魔偏深紅。
      const wingLight = new THREE.PointLight(
        holy ? 0xffffd2 : 0xff1730,
        holy ? 1.55 : 1.55,
        3.4,
        2
      );
      wingLight.position.set(0, .05, .10);
      wingLight.userData.specialWing = true;
      wings.add(wingLight);

      // 更寬的柔光，讓神聖翼呈現白金色「發光」而不是只有輪廓亮線。
      const wingFillLight = new THREE.PointLight(
        holy ? 0xffffe2 : 0x5c0012,
        holy ? .72 : .58,
        4.8,
        2
      );
      wingFillLight.position.set(0, .12, -.05);
      wingFillLight.userData.specialWing = true;
      wings.add(wingFillLight);

      // 翼位於角色後方，避免覆蓋頭髮與身體。
      wings.traverse(o => {
        o.renderOrder = 1;
        o.userData.specialWing = true;
      });

      g.add(wings);
      g.userData.specialEquipmentWings = wings;
    }
    function makeDivineBlessingCloakVisual(it = {}, targetParts = null) {
      const cloakParts = targetParts || state.parts;
      const g = new THREE.Group();
      const cls = it.classId || state.classId || 'warrior';
      const lv = divineCloakLevelForCharacter(it.itemLevel || state.level || 1);
      const idx = divineCloakLevelIndex(lv);
      const p = divineCloakClassStyle(cls, lv);
      const main = mat(p.main, .82, .08), dark = mat(p.dark, .88, .06), accent = mat(p.accent, .66, .12), trim = mat(p.trim, .30, .62);
      const add = o => {o.userData.divineBlessingCloak = true; o.userData.equipmentTierVisual = false; g.add(o); return o;};

      // V9 outfit：以參考圖的「貼身外皮 + 多層長衣 + 狹窄肩線」為基準。
      // 不再使用大圓肩塊／厚積木；所有層次都沿同一骨架向外包覆。
      const levelScale = [.96, .98, 1, 1.02, 1.04, 1.06, 1.08, 1.10][Math.min(7, idx)];
      const coatLen = [.72, .78, .84, .92, 1.00, 1.08, 1.16, 1.24][Math.min(7, idx)];
      const panelCount = [2, 2, 3, 3, 4, 4, 5, 6][Math.min(7, idx)];

      const makePanel = (x, z, wTop, wBottom, h, m, side = 1, rot = 0) => {
        const sh = new THREE.Shape();
        sh.moveTo(-wTop / 2, h / 2);
        sh.quadraticCurveTo(-wBottom * .42, 0, -wBottom / 2, -h / 2);
        sh.lineTo(wBottom / 2, -h / 2);
        sh.quadraticCurveTo(wBottom * .42, 0, wTop / 2, h / 2);
        sh.closePath();
        const geo = new THREE.ExtrudeGeometry(sh, {depth: .026, bevelEnabled: true, bevelSegments: 1, bevelSize: .008, bevelThickness: .006, curveSegments: 2});
        const o = add(mesh(geo, m));
        o.position.set(x, .86, z); o.rotation.y = rot; return o;
      };
      const makeTrimLine = (x, z, y, h, m = trim) => {
        const geo = new THREE.BoxGeometry(.018, h, .018);
        const o = add(mesh(geo, m)); o.position.set(x, y, z); return o;
      };

      // 貼身內層：窄胸身、窄腰、窄肩，避免外套被撐成桶狀。
      const body = add(mesh(new THREE.CapsuleGeometry(.43, .62, 8, 16), dark));
      body.position.set(0, 1.36, .01); body.scale.set(.98, .98, .70);

      // 領口採雙層 V 領／高領，直接貼在頸根。
      const collar = add(mesh(new THREE.CapsuleGeometry(.28, .18, 8, 12), main));
      collar.position.set(0, 1.68, .02); collar.scale.set(1.02, .82, .60);
      const collarInner = add(mesh(new THREE.CapsuleGeometry(.23, .15, 8, 10), dark));
      collarInner.position.set(0, 1.70, .08); collarInner.scale.set(1.04, .78, .55);

      // 肩披層：薄而貼身，不使用球形肩甲。
      const mantle = add(mesh(new THREE.CapsuleGeometry(.46, .20, 8, 12), main));
      mantle.position.set(0, 1.56, -.015); mantle.scale.set(1.12, .72, .64);
      const mantleEdge = add(mesh(new THREE.TorusGeometry(.40, .012, 6, 28, Math.PI * 1.15), trim));
      mantleEdge.rotation.x = Math.PI / 2; mantleEdge.position.set(0, 1.55, .27); mantleEdge.scale.set(1.10, .66, 1);

      // 黑色主外套：中央一層 + 左右兩層，逐層向外展開。
      const center = makePanel(0, .285, .42, .58, .98, dark, 1, 0);
      center.scale.set(1, levelScale, 1);
      const leftMain = makePanel(-.25, .255, .34, .50, 1.05, main, -1, -.025);
      const rightMain = makePanel(.25, .255, .34, .50, 1.05, main, 1, .025);
      leftMain.scale.y = rightMain.scale.y = levelScale;

      // 職業色內襟：只佔外套的一部分，形成黑→職業色的層次。
      const leftAccent = makePanel(-.18, .315, .20, .31, .88, accent, -1, -.02);
      const rightAccent = makePanel(.18, .315, .20, .31, .88, accent, 1, .02);
      leftAccent.scale.y = rightAccent.scale.y = levelScale * .98;

      // 外側漸變感：深色第一層＋職業色第二層＋深色邊層。
      for (let i = 0; i < panelCount; i++) {
        const side = i % 2 === 0 ? -1 : 1;
        const band = i % 3;
        const x = side * (.33 + Math.floor(i / 2) * .045);
        const z = .21 + (i % 2) * .018;
        const wTop = .13 - (band * .012), wBottom = .22 - (band * .012);
        const h = .72 + Math.min(2, Math.floor(i / 2)) * .08;
        const m = band === 1 ? accent : (band === 2 ? dark : main);
        const panel = makePanel(x, z, wTop, wBottom, h, m, side, side * .015);
        panel.scale.set(1, levelScale * (1 + i * .018), 1);
      }

      // 前下襬：左右分叉，露出腿部，參考圖的長外套線條。
      for (const side of [-1, 1]) {
        const tail = makePanel(side * .29, .19, .18, .28, .78, main, side, side * .035);
        tail.scale.set(1, levelScale * (1 + idx * .015), 1);
        const tailAccent = makePanel(side * .22, .205, .10, .19, .64, accent, side, side * .02);
        tailAccent.scale.set(1, levelScale, 1);
      }

      // 背部長層：三片窄布，從肩胛向下收，不形成一整塊硬板。
      for (let i = 0; i < 3 + Math.min(2, idx); i++) {
        const side = i % 2 === 0 ? -1 : 1;
        const x = side * (i < 2 ? .18 : .30);
        const back = makePanel(x, -.19, .20, .34, .82 + idx * .035, i % 2 ? main : dark, side, side * .025);
        back.rotation.y = Math.PI;
        back.scale.set(1, levelScale * (1 + i * .025), 1);
      }

      // 貼身袖子：直接掛到手臂骨骼，袖圍縮窄，金邊嵌入袖口。
      const makeArmCloak = arm => {
        if (!arm) return;
        const wrap = new THREE.Group(); wrap.userData.divineCloakArmPiece = true;
        const upper = mesh(new THREE.CapsuleGeometry(.175, .42, 8, 14), main);
        upper.position.set(0, -.27, .025); upper.scale.set(.92, .98, .90); wrap.add(upper);
        const lower = mesh(new THREE.CapsuleGeometry(.155, .38, 8, 14), dark);
        lower.position.set(0, -.62, .035); lower.scale.set(.90, .98, .88); wrap.add(lower);
        const cuff = mesh(new THREE.CapsuleGeometry(.15, .10, 7, 10), main);
        cuff.position.set(0, -.84, .05); cuff.scale.set(.94, .90, .90); wrap.add(cuff);
        const cuffLine = mesh(new THREE.TorusGeometry(.137, .008, 5, 18), trim);
        cuffLine.rotation.x = Math.PI / 2; cuffLine.position.set(0, -.84, .12); wrap.add(cuffLine);
        wrap.traverse(o => o.userData.divineCloakArmPiece = true);
        arm.add(wrap);
      };
      makeArmCloak(cloakParts?.armL); makeArmCloak(cloakParts?.armR);

      // 金邊：沿胸襟、腰線與下襬做「壓邊」，不是凸出的金條。
      const lineMat = trim;
      const chestLine = add(mesh(new THREE.TorusGeometry(.27, .009, 5, 20, Math.PI * .92), lineMat));
      chestLine.rotation.x = Math.PI / 2; chestLine.position.set(0, 1.46, .35); chestLine.scale.set(1.05, .72, 1);
      const waist = add(mesh(new THREE.TorusGeometry(.34, .010, 5, 24), lineMat));
      waist.rotation.x = Math.PI / 2; waist.position.set(0, 1.03, .06); waist.scale.set(1.16, .72, .80);

      // 職業徽章 + 水晶：全部嵌在胸前，位置貼近身體。
      const crystalColor = p.crystal || p.glow;
      const crystalMat = new THREE.MeshStandardMaterial({color: crystalColor, roughness: .22, metalness: .45, emissive: crystalColor, emissiveIntensity: .22});
      const crystal = add(mesh(new THREE.OctahedronGeometry(.078 + idx * .006, 1), crystalMat));
      crystal.position.set(0, 1.40, .385); crystal.rotation.set(.16, Math.PI / 4, .08);
      const crystalFrame = add(mesh(new THREE.TorusGeometry(.105 + idx * .004, .009, 5, 18), trim));
      crystalFrame.rotation.y = Math.PI / 2; crystalFrame.position.set(0, 1.40, .378);

      const emblemMat = new THREE.MeshStandardMaterial({color: p.emblem || p.accent, roughness: .42, metalness: .28});
      const emblem = add(mesh(new THREE.OctahedronGeometry(.095 + idx * .005, 1), emblemMat));
      emblem.scale.set(1.0, .72, .30); emblem.position.set(0, 1.12, .385); emblem.rotation.z = Math.PI / 4;

      // 職業徽章細節。
      const badgeRing = add(mesh(new THREE.TorusGeometry(.115 + idx * .004, .008, 5, 20), trim));
      badgeRing.rotation.y = Math.PI / 2; badgeRing.position.set(0, 1.12, .38);
      if (cls === 'priest') {
        for (const sy of [-.045, .045]) {
          const bar = add(mesh(new THREE.BoxGeometry(.018, .12, .012), trim)); bar.position.set(0, 1.12 + sy, .405);
        }
        const cross = add(mesh(new THREE.BoxGeometry(.10, .018, .012), trim)); cross.position.set(0, 1.12, .405);
      } else if (cls === 'warrior') {
        for (const side of [-1, 1]) {
          const blade = add(mesh(new THREE.BoxGeometry(.018, .13, .012), trim)); blade.position.set(side * .045, 1.12, .405); blade.rotation.z = side * .35;
        }
      } else if (cls === 'mage') {
        const ring = add(mesh(new THREE.TorusGeometry(.075, .007, 5, 20), trim)); ring.position.set(0, 1.12, .405);
      } else if (cls === 'thief') {
        for (const side of [-1, 1]) {
          const blade = add(mesh(new THREE.BoxGeometry(.014, .12, .012), trim)); blade.position.set(side * .035, 1.12, .405); blade.rotation.z = side * .62;
        }
      } else if (cls === 'monk') {
        const fist = add(mesh(new THREE.BoxGeometry(.09, .07, .014), trim)); fist.position.set(0, 1.12, .405);
      }

      // 聖職者專用金十字架，嵌在徽章下方。
      if (cls === 'priest') {
        const v = add(mesh(new THREE.BoxGeometry(.028, .17, .012), trim)); v.position.set(0, 1.00, .392);
        const h = add(mesh(new THREE.BoxGeometry(.11, .028, .012), trim)); h.position.set(0, 1.045, .392);
      }

      // 金色小菱紋，隨等級增加，但不改變職業主色。
      const detailCount = Math.min(7, 1 + idx);
      for (let i = 0; i < detailCount; i++) {
        const side = i % 2 === 0 ? -1 : 1;
        const y = .91 - i * .09;
        const d = add(mesh(new THREE.OctahedronGeometry(.026 + idx * .002, 0), trim));
        d.scale.set(.75, 1.35, .25); d.position.set(side * (.20 + i * .018), y, .37); d.rotation.z = Math.PI / 4;
      }

      // 水晶微光只照亮胸前，不把整套衣服變成發光裝。
      const glow = new THREE.PointLight(crystalColor, .38 + idx * .04, 1.35, 2);
      glow.position.set(0, 1.38, .48); add(glow);

      // 套用外套調整器；預設維持貼身。
      const a = getCloakAdjustments();
      g.scale.set(a.scale * a.width, a.scale * a.height, a.scale * a.depth);
      g.position.y = a.y; g.position.z = a.z;
      g.traverse(o => {if (o.isMesh) {o.renderOrder = 4; o.userData.divineBlessingCloak = true;} });
      g.userData.isDivineBlessingCloak = true;
      g.userData.cloakLevel = lv; g.userData.cloakClassId = cls; g.userData.armorItemId = it.id || null;
      return g;
    }
    function makeEquipVisual(slot, it = {}) {
      const g = new THREE.Group(); if (!it) return g;
      if (slot === 'helmet') g.userData.isHelmetVisual = true;
      const colors = {
        leatherhelm: 0x70472f, foresthelm: 0x4d744b, silverhelm: 0xa8b2bd, knighthelm: 0x9ca9b7, flamehelm: 0xa83a2a,
        martialhelm: 0x9b3035, moonhelm: 0x5d69a8, novicecap: 0xe9edf2, windcap: 0x3d4a58, headband: 0x9a3038, wizardhat: 0x51439d, holycrw: 0xd8d2c5,
        leatherglove: 0x7b4d31, iron_glove: 0x8995a2, martial_glove: 0x9b3035, royal_glove: 0xc7cbd2,
        tightpants: 0x6b6e73, forestpants: 0x4d744b, silverpants: 0xa8b2bd, knightpants: 0x9ca9b7,
        adventureboots: 0x5b3828, forestboots: 0x4d382c, silverboots: 0x7c8792, knightboots: 0x4b5562
      }[it.visual] || 0x8b5a3c;

      if (slot === 'cloak' || it.visual === 'divineCloak' || it.divineBlessing) {
        return makeDivineBlessingCloakVisual(it);
      } else if (slot === 'helmet') {
        // V7.41：所有職業頭盔統一以「頭部局部座標」製作。
        // 頭盔只覆蓋頭頂／後腦，底緣保持在眉線以上，絕不包住整張臉。
        // 裝備頭盔時由 updateEquipmentVisual 隱藏頭髮，避免頭髮穿帽。
        const q = helmetQualityStyle(it);
        const main = mat(q.main, .38, q.metal), accent = mat(q.accent, .28, .45), gem = mat(q.gem, .20, .65);
        const front = .60;

        if (it.visual === 'wolfcap') {
          const p = wolfHatTierStyle(it);
          const fur = mat(p.fur, .96, .03), deep = mat(p.deep, 1, .015), inner = mat(p.inner, .78, .02), trim = mat(p.trim, .78, .22);
          // 狼帽 V2：不再用一顆完整球體包住頭部；改成「狼耳＋狼額＋雙頰＋口鼻」的清晰輪廓。
          // 讓帽子看起來像真正的狼頭兜帽，而不是黑色圓帽。
          // 狼帽 V3：更貼合真正的狼頭輪廓，帽體縮窄並向頭部內收，不再像圓球套在頭上。
          const hood = mesh(new THREE.SphereGeometry(.67, 30, 22, 0, Math.PI * 2, .20, Math.PI * .60), fur);
          hood.position.set(0, .045, -.105); hood.scale.set(1.00, .88, .86); g.add(hood);
          const hoodCheekL = mesh(new THREE.SphereGeometry(.30, 18, 12), fur); hoodCheekL.position.set(-.39, -.12, .02); hoodCheekL.scale.set(.62, .82, .72); g.add(hoodCheekL);
          const hoodCheekR = hoodCheekL.clone(); hoodCheekR.position.x = .39; g.add(hoodCheekR);

          // 後腦狼毛改成短層次，直接貼著帽體；真正長髮由下方白色髮束自然接出。
          for (const sx of [-1, 1]) {
            const backTuft = mesh(new THREE.ConeGeometry(.23, .34, 8), fur);
            backTuft.position.set(sx * .27, -.28, -.39); backTuft.rotation.x = Math.PI; backTuft.scale.set(.95, 1, .72); g.add(backTuft);
          }

          // 狼帽後方：白色短狼尾改成「多束、集中、分層、尖尾」的髮型。
