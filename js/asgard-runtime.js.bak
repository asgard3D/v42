      const b = p.classBase || [], torso = b[0], waist = b[1], shoulderL = b[2], shoulderR = b[3], belt = b[4], upperL = b[5], upperR = b[6], foreL = b[7], foreR = b[8], gloveL = b[9], gloveR = b[10], thighL = b[11], thighR = b[12], armorL = b[13], armorR = b[14], shinL = b[15], shinR = b[16], shoeL = b[17], shoeR = b[18];
