      if (armorL) {armorL.scale.set(c.thigh * cp.thigh, c.thigh * c.kneeBone * thighLen, c.thigh * cp.thigh); armorL.position.y = -.04 * c.kneeBone * thighLen;} if (armorR) {armorR.scale.copy(armorL.scale); armorR.position.copy(armorL.position);}
      const calfLen = c.calfLength;
