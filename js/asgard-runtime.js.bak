        if (!raw && slot === 1) {raw = localStorage.getItem(SAVE_KEY) || localStorage.getItem('aier_3d_mmo_save_v757') || null; if (raw) {try {const legacy = JSON.parse(raw); if (legacy?.characterCreated === true) writeCharacterSlot(1, {...legacy, version: CURRENT_SAVE_VERSION});} catch (e) { } } }
