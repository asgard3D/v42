      const foreLen = c.forearmLength;
      if (foreL) {foreL.scale.set(c.forearm * cp.forearm, c.forearm * c.wristBone * foreLen, c.forearm * cp.forearm); foreL.position.y = -.49 * c.wristBone * foreLen;} if (foreR) {foreR.scale.copy(foreL.scale); foreR.position.copy(foreL.position);}
      if (gloveL) {gloveL.scale.setScalar(c.hand * cp.hand); gloveL.position.y = -.78 * c.wristBone * foreLen;} if (gloveR) {gloveR.scale.copy(gloveL.scale); gloveR.position.copy(gloveL.position);}
      const thighLen = c.thighLength;
