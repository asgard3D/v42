        const crossV = mesh(new THREE.BoxGeometry(.10, 1.05, .05), new THREE.MeshBasicMaterial({color: 0xffffff, transparent: true, opacity: .85})); const crossH = mesh(new THREE.BoxGeometry(.65, .10, .05), new THREE.MeshBasicMaterial({color: 0xffdf74, transparent: true, opacity: .85})); g.add(crossV, crossH);
      }
