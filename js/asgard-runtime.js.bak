    function spawnDrop(pos, itemId, isElite = false, enemyLevel = null) {
      const bossDrop = arguments.length > 4 ? arguments[4] : false;
      const levelFactor = Math.max(.35, 1 - (Math.max(1, state.level) - 1) * .009);
      const dropDifficulty = 3;
      const equipmentChance = (.76 / dropDifficulty) * levelFactor;
      const skillBookChance = 0.01; // 技能書掉落率 1%
      const roll = Math.random();
      const skillBook = getSkillBookDrop();
      let dropped = null;

      // Boss：使用既有的神聖／惡魔傳說裝備掉落系統。
      if (bossDrop) {
        dropped = makeBossLegendaryDrop(enemyLevel || zoneData[state.zone]?.range?.[1] || 1);
      } else if (skillBook && roll < skillBookChance) {
        dropped = skillBook;
      } else if (roll < skillBookChance + equipmentChance) {
        // 一般怪物／精英：依目前地圖、職業、怪物等級抽取裝備。
        dropped = randomEquipmentDrop(enemyLevel || zoneData[state.zone]?.range?.[0] || 1);
        // 掉落池若因舊存檔／職業資料缺失而無法建立裝備，改走藥水掉落，避免擊殺流程中斷。
        if (!dropped) {
          dropped = {id: 'drop_potion_fallback_' + Date.now() + '_' + Math.floor(Math.random() * 9999), name: 'HP藥水', icon: HP_POTION_ICON_SRC, qty: 1, type: 'consumable', potion: 'hp', rarity: 'normal', dropable: false};
        }
      }

      // 裝備／技能書沒有命中時，才進入藥水掉落區間。
      if (!dropped && !bossDrop && roll >= skillBookChance + equipmentChance && roll < skillBookChance + equipmentChance + .08) {
        dropped = {id: 'drop_potion_' + Date.now() + '_' + Math.floor(Math.random() * 9999), name: 'HP藥水', icon: HP_POTION_ICON_SRC, qty: 1, type: 'consumable', potion: 'hp', rarity: 'normal', dropable: false};
      }
      if (!dropped && !bossDrop && roll >= skillBookChance + equipmentChance + .08 && roll < skillBookChance + equipmentChance + .16) {
        dropped = {id: 'drop_mp_potion_' + Date.now() + '_' + Math.floor(Math.random() * 9999), name: 'MP藥水', icon: MP_POTION_ICON_SRC, qty: 1, type: 'consumable', potion: 'mp', rarity: 'normal', dropable: false};
      }
      if (!dropped && !bossDrop && roll >= skillBookChance + equipmentChance + .16 && roll < skillBookChance + equipmentChance + .22) {
        dropped = {id: 'drop_sp_potion_' + Date.now() + '_' + Math.floor(Math.random() * 9999), name: 'SP藥水', icon: SP_POTION_ICON_SRC, qty: 1, type: 'consumable', potion: 'sp', rarity: 'normal', dropable: false};
      }
      if (!dropped && !bossDrop) {
        dropped = {id: 'drop_potion_bonus_' + Date.now() + '_' + Math.floor(Math.random() * 9999), name: 'HP藥水', icon: HP_POTION_ICON_SRC, qty: 1, type: 'consumable', potion: 'hp', rarity: 'normal', dropable: false};
      }
      if (!dropped) return;
      const g = new THREE.Group();
      g.add(makeDropVisual(dropped));
      g.position.copy(pos); g.position.y = 0;
      g.userData = {item: dropped, life: 18};
      const label = makeLabel(String(dropped.name || '掉落物'));
      label.position.y = 1.55; label.scale.set(1.8, .45, 1); g.add(label);
      scene.add(g); state.drops.push(g);
      addCombatLog('🎁 掉落：' + String(dropped.name || '掉落物'), 'sys')
    }
    function nearestEnemy(range = 999, minLevel = 1, maxLevel = 99, includeBoss = true) {let best = null, dist = range; for (const e of state.enemies) if (e.userData.alive && e.userData.level >= minLevel && e.userData.level <= maxLevel && (includeBoss || !e.userData.boss)) {const d = e.position.distanceTo(state.player.position); if (d < dist) {dist = d; best = e} } return best}
    let gameAudioCtx = null;
    let gameAudioReady = false;
    let gameAudioMaster = null;
    let gameAudioEnabled = true;
    function ensureGameAudioMaster(ac) {
      if (!ac) return null;
      if (!gameAudioMaster) {gameAudioMaster = ac.createGain(); gameAudioMaster.gain.value = .85; gameAudioMaster.connect(ac.destination)}
      return gameAudioMaster;
    }
    function getGameAudio() {
      try {
        const AC = window.AudioContext || window.webkitAudioContext; if (!AC) return null;
        if (!gameAudioCtx) gameAudioCtx = new AC();
        if (gameAudioCtx.state === 'suspended') gameAudioCtx.resume().then(() => {gameAudioReady = true}).catch(() => { });
        else if (gameAudioCtx.state === 'running') gameAudioReady = true;
        return gameAudioCtx;
      } catch (e) {return null}
    }
    // 瀏覽器的自動播放政策會阻止未經使用者操作的 AudioContext。
    // 第一次滑鼠／鍵盤／觸控操作時先解鎖共用 AudioContext，之後戰鬥聲即可正常播放。
    function unlockGameAudio() {
      try {
        const AC = window.AudioContext || window.webkitAudioContext; if (!AC) return false;
        if (!gameAudioCtx) gameAudioCtx = new AC();
        ensureGameAudioMaster(gameAudioCtx);
        if (gameAudioCtx.state === 'suspended') return gameAudioCtx.resume().then(() => {gameAudioReady = true; return true}).catch(() => false);
        gameAudioReady = gameAudioCtx.state === 'running'; return Promise.resolve(gameAudioReady);
      } catch (e) {return Promise.resolve(false)}
    }
    async function enableAndTestGameAudio() {
      gameAudioEnabled = true;
      const ok = await unlockGameAudio();
      if (!ok) {toast('🔇 瀏覽器未允許音效，請確認分頁沒有靜音，並重新點擊此按鈕'); return;}
      playGameSoundNow(gameAudioCtx, 'sword', 'sword', 2.8);
      setTimeout(() => playGameSoundNow(gameAudioCtx, 'hit', 'hit', 2.4), 170);
      toast('🔊 音效已開啟！如果仍無聲音，請檢查瀏覽器分頁／系統音量');
    }
    ['pointerdown', 'keydown', 'touchstart'].forEach(ev => window.addEventListener(ev, unlockGameAudio, {passive: true}));
    function playLevelUpSound() {
      try {
        const ac = getGameAudio(); if (!ac) return;
        const start = () => {const now = ac.currentTime;[523.25, 659.25, 783.99, 1046.5].forEach((f, i) => {const o = ac.createOscillator(), g = ac.createGain(); o.type = 'sine'; o.frequency.value = f; const t = now + i * .08; g.gain.setValueAtTime(.0001, t); g.gain.exponentialRampToValueAtTime(.12, t + .025); g.gain.exponentialRampToValueAtTime(.0001, t + .28); o.connect(g).connect(ensureGameAudioMaster(ac) || ac.destination); o.start(t); o.stop(t + .3)});};
        if (ac.state === 'running') start(); else ac.resume().then(start).catch(() => { });
      } catch (e) { }
    }
    function playGameSound(kind = 'hit', family = 'sword', intensity = 1) {
      if (!gameAudioEnabled) return;
      const ac = getGameAudio(); if (!ac) return;
      const start = () => playGameSoundNow(ac, kind, family, intensity);
      if (ac.state !== 'running') {ac.resume().then(start).catch(() => { }); return;}
      start();
    }
    function playGameSoundNow(ac, kind = 'hit', family = 'sword', intensity = 1) {
      const now = ac.currentTime;
      const presets = {
        hit: {freq: 145, dur: .14, type: 'sawtooth', gain: .24},
        sword: {freq: 240, dur: .15, type: 'sawtooth', gain: .16}, dagger: {freq: 430, dur: .10, type: 'triangle', gain: .14},
        fist: {freq: 105, dur: .12, type: 'square', gain: .16}, staff: {freq: 520, dur: .17, type: 'sine', gain: .14},
        magic: {freq: 720, dur: .22, type: 'sine', gain: .12}, fire: {freq: 180, dur: .20, type: 'sawtooth', gain: .14},
        ice: {freq: 900, dur: .18, type: 'sine', gain: .11}, holy: {freq: 660, dur: .25, type: 'sine', gain: .11},
        hurt: {freq: 92, dur: .20, type: 'square', gain: .26}, boss: {freq: 78, dur: .24, type: 'sawtooth', gain: .30}
      };
      const p = presets[kind] || presets.hit;
      // 命中／受擊使用較短但明顯的 transient，避免瀏覽器在極短音量包絡下聽不到。
      const o = ac.createOscillator(), g = ac.createGain();
      o.type = p.type; o.frequency.setValueAtTime(p.freq, now);
      o.frequency.exponentialRampToValueAtTime(Math.max(50, p.freq * (kind === 'hit' ? .62 : 1.35)), now + p.dur);
      g.gain.setValueAtTime(.0001, now); g.gain.exponentialRampToValueAtTime(p.gain * intensity, now + .008);
      g.gain.exponentialRampToValueAtTime(.0001, now + p.dur);
