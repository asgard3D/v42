    function findAutoAlternativeTarget(current) {
      const candidates = state.enemies.filter(x => x !== current && x.userData?.alive && !x.userData?.boss && x.userData.level >= state.autoMinLevel && x.userData.level <= state.autoMaxLevel);
      candidates.sort((a, b) => a.position.distanceTo(state.player.position) - b.position.distanceTo(state.player.position));
