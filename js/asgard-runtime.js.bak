      // live character currently has. Do not recreate arm bases here. The live
      // runtime has class-specific poses (especially Mage orb pose), shield pose,
      // attack/idle state and weapon grip logic. Reusing hard-coded preview bases
      // was the reason the preview and actual character looked different.
      const setArm = (arm, key) => {
        if (!arm) return;
        const d = p[key];
        if (!arm.userData.awPreviewBase) {
          arm.userData.awPreviewBase = {position:arm.position.clone(),rotation:arm.rotation.clone()};
        }
        const b = arm.userData.awPreviewBase;
        arm.position.set(b.position.x+d.position.x,b.position.y+d.position.y,b.position.z+d.position.z);
