    const MAGE_ORB_ARM_Z = -.13 + Math.PI;
    const MAGE_ORB_ARM_X = -.38;
    function cloneArmWeaponAdjustments(v){try{return JSON.parse(JSON.stringify(v));}catch(e){return makeDefaultArmWeaponAdjustments();}}
    function normalizeArmWeaponSide(v){
      const p=v?.position||{}, r=v?.rotation||{};
      const n=x=>Number.isFinite(Number(x))?Number(x):0;
      return {position:{x:n(p.x),y:n(p.y),z:n(p.z)},rotation:{x:n(r.x),y:n(r.y),z:n(r.z)}};
    }
    function normalizeArmWeaponProfile(v,classId='warrior'){
      const fallback=classId==='mage'?MAGE_ARM_WEAPON_JSON_BASELINE:null;
      return {
        armL:normalizeArmWeaponSide(v?.armL || fallback?.armL),
        armR:normalizeArmWeaponSide(v?.armR || fallback?.armR),
        weaponL:normalizeArmWeaponSide(v?.weaponL || fallback?.weaponL),
        weaponR:normalizeArmWeaponSide(v?.weaponR || fallback?.weaponR)
      };
    }
    function makeDefaultArmWeaponAdjustments(){
      const o={}; for(const id of ARM_WEAPON_ADJUST_CLASSES)o[id]=normalizeArmWeaponProfile(null,id); return o;
    }
    function normalizeAllArmWeaponAdjustments(v){
      const o=makeDefaultArmWeaponAdjustments();
      if(v&&typeof v==='object')for(const id of ARM_WEAPON_ADJUST_CLASSES)o[id]=normalizeArmWeaponProfile(v[id],id);
      return o;
    }
    function getArmWeaponProfile(classId=state?.classId||'warrior'){
      if(!state.armWeaponAdjustments)state.armWeaponAdjustments=makeDefaultArmWeaponAdjustments();
      if(!state.armWeaponAdjustments[classId])state.armWeaponAdjustments[classId]=normalizeArmWeaponProfile(null,classId);
      return state.armWeaponAdjustments[classId];
    }
    function applyArmWeaponAdjustmentsToModel(){
      if(!state.parts)return;
      const p=getArmWeaponProfile();
      const applyArm=(arm,key)=>{
        if(!arm)return;
        const d=p[key];
        arm.position.set((arm.userData.awBaseX||0)+d.position.x,(arm.userData.awBaseY||arm.position.y)+d.position.y,(arm.userData.awBaseZ||0)+d.position.z);
      };
      // Position offsets are applied relative to the original Character Model V2 arm roots.
      if(state.parts.armL){state.parts.armL.position.set(-.49+p.armL.position.x,1.50+p.armL.position.y,p.armL.position.z); state.parts.armL.userData.armWeaponAdjustApplied=true;}
      if(state.parts.armR){state.parts.armR.position.set(.49+p.armR.position.x,1.50+p.armR.position.y,p.armR.position.z); state.parts.armR.userData.armWeaponAdjustApplied=true;}
      const mounts=[['weaponMountL','weaponL'],['weaponMountR','weaponR']];
      for(const [name,key] of mounts){
        const m=state.parts[name]; if(!m)continue; const d=p[key];
        // Preserve the normal grip anchor, then add user offset/rotation.
        m.userData.awAdjustPosition={x:d.position.x,y:d.position.y,z:d.position.z};
        m.userData.awAdjustRotation={x:d.rotation.x,y:d.rotation.y,z:d.rotation.z};
      }
    }
    function applyArmWeaponMountAdjustments(){
      if(!state.parts)return;
      const p=getArmWeaponProfile();
      for(const [name,key] of [['weaponMountL','weaponL'],['weaponMountR','weaponR']]){
        const m=state.parts[name]; if(!m)continue; const d=p[key];
        m.position.x += d.position.x; m.position.y += d.position.y; m.position.z += d.position.z;
        m.rotation.x += d.rotation.x; m.rotation.y += d.rotation.y; m.rotation.z += d.rotation.z;
      }
    }
    function stripArmWeaponAdjustments(){
      if(!state.parts)return;
      // 每一幀動畫開始前回到 Character Model V2 的原始待機基準，避免滑桿偏移被上一幀累加。
      if(state.parts.armL){state.parts.armL.position.set(-.49,1.50,0);state.parts.armL.rotation.set(hasRaisedShield() ? -.72 : -.38,0,hasRaisedShield() ? .10 : .13);}
      if(state.parts.armR){state.parts.armR.position.set(.49,1.50,0);state.parts.armR.rotation.set(-.38,0,-.13);}
    }
    function applyArmRotationOffsets(){
      if(!state.parts)return; const p=getArmWeaponProfile();
      if(state.parts.armL){state.parts.armL.rotation.x+=p.armL.rotation.x;state.parts.armL.rotation.y+=p.armL.rotation.y;state.parts.armL.rotation.z+=p.armL.rotation.z;}
      if(state.parts.armR){state.parts.armR.rotation.x+=p.armR.rotation.x;state.parts.armR.rotation.y+=p.armR.rotation.y;state.parts.armR.rotation.z+=p.armR.rotation.z;}
    }
    function setArmWeaponAdjustment(path,value){
      const m=String(path||'').match(/^(armL|armR|weaponL|weaponR)\.(position|rotation)\.(x|y|z)$/); if(!m)return;
      const [_,part,group,axis]=m; const cid=window.armWeaponAdjustEditorClass&&ARM_WEAPON_ADJUST_CLASSES.includes(window.armWeaponAdjustEditorClass)?window.armWeaponAdjustEditorClass:state.classId;
      const p=getArmWeaponProfile(cid); p[part][group][axis]=Number(value)||0;
      if(cid===state.classId&&state.player){ updateEquipmentVisual(); applyArmRotationOffsets(); applyArmWeaponMountAdjustments(); }
      refreshArmWeaponPreviewOnly();
      saveGame();
      const el=document.getElementById('aw_'+path.replaceAll('.','_')+'_value'); if(el)el.textContent=(Number(value)||0).toFixed(2);
    }
    function resetArmWeaponAdjustments(classId=state.classId){
      classId=ARM_WEAPON_ADJUST_CLASSES.includes(classId)?classId:state.classId;
      state.armWeaponAdjustments[classId]=normalizeArmWeaponProfile(null);
      if(classId===state.classId&&state.player){updateEquipmentVisual();}
      saveGame(); renderModal('armWeaponAdjust');
    }
    function downloadArmWeaponAdjustmentJson(all=false){
      const cid=ARM_WEAPON_ADJUST_CLASSES.includes(window.armWeaponAdjustEditorClass)?window.armWeaponAdjustEditorClass:(ARM_WEAPON_ADJUST_CLASSES.includes(state.classId)?state.classId:'warrior');
      const adjustments=all?normalizeAllArmWeaponAdjustments(state.armWeaponAdjustments):{[cid]:normalizeArmWeaponProfile(getArmWeaponProfile(cid))};
      const payload={type:'ASGARD_ARM_WEAPON_ADJUSTMENT',version:ARM_WEAPON_ADJUST_VERSION,gameVersion:'V1.01.38',exportedAt:new Date().toISOString(),classId:all?'all':cid,className:all?'全部職業':(classes[cid]?.name||cid),adjustments};
      const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');
      a.href=url;a.download=all?'asgard_arm_weapon_all_classes.json':'asgard_arm_weapon_'+cid+'.json';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1200);
      toast('💾 已匯出 '+(all?'五職':'目前職業')+' 手臂／武器 JSON');
    }
    function openArmWeaponAdjustmentFilePicker(){document.getElementById('armWeaponAdjustmentImportFile')?.click();}
    function importArmWeaponAdjustmentFile(input){
      const file=input?.files?.[0]; if(!file)return; const reader=new FileReader();
      reader.onload=()=>{try{const d=JSON.parse(String(reader.result||''));if(d?.type!=='ASGARD_ARM_WEAPON_ADJUSTMENT')throw new Error('不是 ASGARD 手臂／武器調整 JSON');if(Number(d.version)!==ARM_WEAPON_ADJUST_VERSION)throw new Error('JSON 版本不相容');state.armWeaponAdjustments=normalizeAllArmWeaponAdjustments({...state.armWeaponAdjustments,...(d.adjustments||{})});applyArmWeaponAdjustmentsToModel();updateEquipmentVisual();saveGame();renderModal('armWeaponAdjust');toast('✅ 已匯入手臂／武器設定');}catch(e){alert('匯入失敗：'+(e?.message||e));}};reader.readAsText(file);input.value='';
    }
    function awSlider(path,label,min,max,step,value){const id='aw_'+path.replaceAll('.','_');return '<div class="hatAdjustRow"><div class="hatAdjustLabel"><b>'+label+'</b><span id="'+id+'_value">'+Number(value||0).toFixed(2)+'</span></div><input type="range" min="'+min+'" max="'+max+'" step="'+step+'" value="'+Number(value||0)+'" oninput="setArmWeaponAdjustment(\''+path+'\',this.value)"></div>';}
    function getArmWeaponCurrentEquipmentMarkup(classId){
      const actualClass = PLAYABLE_CLASS_IDS.includes(state.classId) ? state.classId : 'warrior';
      const sameClass = classId === actualClass;
      const main = sameClass ? (state.equip?.weapon || null) : null;
      const off = sameClass ? (state.equip?.offhand || null) : null;
      const starter = CLASS_STARTER_GEAR?.[classId];
      const mainName = main ? (equipmentDisplayName(main) || main.name || '目前主武') : (sameClass ? '目前未裝備主武器' : ((starter?.weapon?.name) || '職業預設主武'));
      const offName = off ? (equipmentDisplayName(off) || off.name || '目前副手') : (sameClass ? '目前未裝備副手' : ((starter?.offhand?.name) || '無職業預設副手'));
      const mainIcon = main ? (main.icon || equipmentIcon(main)) : (starter?.weapon?.icon || '⚔️');
      const offIcon = off ? (off.icon || equipmentIcon(off)) : (starter?.offhand?.icon || '🛡️');
      const title = sameClass ? '目前實際裝備（3D 預覽同步）' : '此職業調整預覽武器';
      const note = sameClass ? '左側 3D 人物會直接顯示目前已裝備的主武器／副手；調整滑桿就是調整這把武器。' : '切換其他職業時，先以該職業的起始武器作為調整參考；回到目前職業會恢復實際裝備。';
      return '<div class="settingsBlock" style="margin-bottom:10px;border-color:#6b5730;background:linear-gradient(180deg,rgba(38,31,19,.82),rgba(18,25,35,.88))"><div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:7px"><b>⚔ '+title+'</b><span style="font-size:11px;color:#e8bd54">'+(sameClass?'LIVE':'PREVIEW')+'</span></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px"><div style="padding:8px;border:1px solid #3d5066;border-radius:8px;background:rgba(8,14,22,.58)"><div style="font-size:11px;color:#9eacbd">右手／主武</div><div style="font-size:14px;margin-top:3px">'+mainIcon+' <b>'+mainName+'</b></div></div><div style="padding:8px;border:1px solid #3d5066;border-radius:8px;background:rgba(8,14,22,.58)"><div style="font-size:11px;color:#9eacbd">左手／副手</div><div style="font-size:14px;margin-top:3px">'+offIcon+' <b>'+offName+'</b></div></div></div><div class="tip" style="margin-top:7px">'+note+'</div></div>';
    }
    function renderArmWeaponAdjustModal(c){
      const cid=ARM_WEAPON_ADJUST_CLASSES.includes(window.armWeaponAdjustEditorClass)?window.armWeaponAdjustEditorClass:(ARM_WEAPON_ADJUST_CLASSES.includes(state.classId)?state.classId:'warrior'); window.armWeaponAdjustEditorClass=cid; const p=getArmWeaponProfile(cid), cname=classes[cid]?.name||cid;
      const panel=(part,title)=>{const d=p[part];return '<div class="settingsBlock hatAdjustPanel"><h3 style="margin:0 0 8px">'+title+'</h3>'+awSlider(part+'.position.x','位置 X',-.60,.60,.01,d.position.x)+awSlider(part+'.position.y','位置 Y',-.60,.60,.01,d.position.y)+awSlider(part+'.position.z','位置 Z',-.60,.60,.01,d.position.z)+awSlider(part+'.rotation.x','旋轉 X',-3.14,3.14,.01,d.rotation.x)+awSlider(part+'.rotation.y','旋轉 Y',-3.14,3.14,.01,d.rotation.y)+awSlider(part+'.rotation.z','旋轉 Z',-3.14,3.14,.01,d.rotation.z)+'</div>';};
      const buttons=ARM_WEAPON_ADJUST_CLASSES.map(id=>'<button type="button" class="menuBtn" style="flex:1;border-color:'+(id===cid?'#e8bd54':'#3d5066')+'" onclick="window.armWeaponAdjustEditorClass=\''+id+'\';renderModal(\'armWeaponAdjust\')">'+(classes[id]?.name||id)+'</button>').join('');
      c.innerHTML='<h2>🦾 手臂／武器位置調整</h2><p class="tip">目前職業：<b>'+cname+'</b>。手臂與左右手持物分開調整；每個職業獨立保存。位置為 Character Model V2 local unit，旋轉為弧度。</p><div style="display:flex;gap:6px;flex-wrap:wrap;margin:8px 0 12px">'+buttons+'</div>'+getArmWeaponCurrentEquipmentMarkup(cid)+'<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">'+panel('armL','⬅ 左手臂')+panel('armR','右手臂 ➡')+panel('weaponL','🛡 左手武器／盾')+panel('weaponR','⚔ 右手武器')+'</div><div class="settingsBlock" style="margin-top:10px"><b>JSON 設定</b><div class="menuGrid" style="margin-top:8px"><button type="button" class="menuCard" onclick="downloadArmWeaponAdjustmentJson(false)"><span class="big">💾</span>匯出目前職業<small>'+cname+' JSON</small></button><button type="button" class="menuCard" onclick="downloadArmWeaponAdjustmentJson(true)"><span class="big">📦</span>匯出全部五職<small>一份 JSON</small></button><button type="button" class="menuCard" onclick="openArmWeaponAdjustmentFilePicker()"><span class="big">📥</span>匯入 JSON<small>依職業套用</small></button></div><input id="armWeaponAdjustmentImportFile" type="file" accept="application/json,.json" style="display:none" onchange="importArmWeaponAdjustmentFile(this)"></div><div class="menuActions"><button type="button" class="menuBtn" onclick="resetArmWeaponAdjustments(\'"+cid+"\')">↺ 還原本職</button><button type="button" class="menuBtn" onclick="closeModal()">完成</button></div>';
    }
    let armWeaponAdjustEditorClass = null;

    const state = {
      zone: 'forest', time: 8.0, weather: 'clear', auto: true, level: 1, xp: 0, gold: 250, characterName: '凱伊', hp: 100, mp: 100, sp: 100, kills: 0, statPoints: 0, stats: {str: 0, int: 0, vit: 0, dex: 0, luk: 0}, regenTimer: 0, enemyHitCooldown: 0,
      characterCreated: false, accountName: '', gender: 'male', characterCustomization: {height: 1, head: 1, neck: 1, shoulder: 1, chest: 1, waist: 1, hip: 1, upperArm: 1, forearm: 1, hand: 1, thigh: 1, calf: 1, foot: 1, spine: 1, shoulderBone: 1, elbowBone: 1, wristBone: 1, hipBone: 1, kneeBone: 1, ankleBone: 1},
      classId: 'warrior', armWeaponAdjustments: {}, previewOutfitLevel: 1, hairStyle: 'shortCurl', hairColor: 'chestnut', hairDesigns: Object.fromEntries(['shortCurl', 'highPony', 'mediumLayer', 'buzzCut', 'samuraiLong', 'straightLong'].map(id => [id, {layers: []}])), hairDesignPresetVersion: 0, eyeStyle: 'wolf', eyeColor: 'wolf', mouthStyle: 'smile', earAdjustments: {left: {scale: 1, x: 0, y: 0, z: 0}, right: {scale: 1, x: 0, y: 0, z: 0}}, hatAdjustments: {}, cloakAdjustments: {scale: 0.97, width: 0.89, height: 1.13, depth: 1.45, y: -0.09, z: -0.08}, target: null, autoTarget: null, autoMinLevel: 1, autoMaxLevel: 100, autoRangeMeters: 15, autoAnchorX: null, autoAnchorZ: null, autoDetourSide: 0, autoDetourTime: 0, autoUseSkill: true, autoUseBuffSkill: true, autoUseAttackSkill: true, autoSkillSelection: {}, autoSkillCursor: 0, autoUseHpPotion: false, autoUseMpPotion: false, autoUseSpPotion: false, autoHpThreshold: 50, autoMpThreshold: 30, autoSpThreshold: 30, autoUseRecoverySkill: false, autoRecoveryThreshold: 50, autoRecoverySkillId: 'auto', autoFightBoss: true, autoRoamTarget: null, autoRoamTimer: 0, pickupMinRarity: 'normal', potionCd: 0, dead: false, grave: null, attackCd: 0, skillCd: 0, skillCds: {}, player: null, parts: {}, enemies: [], drops: [], npcs: [], portals: [], particles: [], world: [], colliders: [], forestRiver: null, forestRiverFlow: [],
      cam: {yaw: .55, pitch: .48, dist: 12, drag: false, lastX: 0, lastY: 0}, cameraFirstPerson: false, mobileCameraUserAdjusted: false, keys: {},
      attackAnim: {active: false, t: 0, duration: .38, type: 'slash'}, walkAnim: {moving: false, phase: 0, speed: 0}, effects: [], eliteKills: 0, quickSlots: ['attack', null, null, null, null, null, null, null], learnedSkills: {warrior: [], thief: [], mage: [], monk: [], priest: []}, skillLevels: {warrior: {}, thief: {}, mage: {}, monk: {}, priest: {}}, buffs: {}, buffVisuals: {}, areaSkills: [], cityLights: [], environment: {dayNight: true, seasons: true, seasonMode: 'auto', season: 'summer'},
      inventory: [
        {id: 'potion', name: 'HP藥水', icon: HP_POTION_ICON_SRC, qty: 0, type: 'consumable', potion: 'hp'},
        {id: 'mp_potion', name: 'MP藥水', icon: MP_POTION_ICON_SRC, qty: 0, type: 'consumable', potion: 'mp'},
        {id: 'sp_potion', name: 'SP藥水', icon: SP_POTION_ICON_SRC, qty: 0, type: 'consumable', potion: 'sp'},
        {id: 'gem', name: '綠色魔石', icon: '💎', qty: 2, type: 'material'}
      ], equip: {necklace: null, earringL: null, helmet: null, earringR: null, weapon: null, armor: null, offhand: null, ring1: null, ring2: null, belt: null, ring3: null, ring4: null, pants: null, glovesL: null, shoes: null, glovesR: null, cloak: null}
    };

    // MMORPG character-slot runtime state. Slot 0 means no character is currently active.
    let activeCharacterSlot = 0;
    let creatorPreviewClass = 'warrior';
    let creatorPreviewOutfitLevel = 1;
    let creatorClassSelected = false;
    let creatorOutfitEquipped = false;
    let creatorCloakEquipped = true;
    let creatorMode = 'new';
    const CURRENT_SAVE_VERSION = 40;
    // Equipment progression is restricted to these exact level nodes. Legacy items at other levels are removed on load.
    const CHARACTER_SLOT_COUNT = 3;
    const CHARACTER_SLOTS_KEY = 'aier_3d_mmo_character_slots_v1';
    const ACTIVE_CHARACTER_SLOT_KEY = 'aier_3d_mmo_active_slot_v1';

    const classes = {
      novice: {name: '初心者', color: 0xf1f1ed, hp: 100, mp: 100, atk: 12, matk: 8, def: 5, mdef: 4, skill: '衝擊', skillDmg: 25, skillCost: 15, weapon: 'sword', outfit: 'novice'},
      warrior: {name: '戰士', color: 0x9b2f35, hp: 145, mp: 70, atk: 21, matk: 7, def: 13, mdef: 7, skill: '旋風斬', skillDmg: 38, skillCost: 20, weapon: 'sword', outfit: 'warrior'},
      mage: {name: '法師', color: 0x5944b5, hp: 90, mp: 150, atk: 8, matk: 24, def: 4, mdef: 12, skill: '火焰彈', skillDmg: 48, skillCost: 25, weapon: 'orb', outfit: 'mage', ranged: true},
      monk: {name: '武道家', color: 0xb87828, hp: 125, mp: 95, atk: 24, matk: 10, def: 9, mdef: 8, skill: '氣功拳', skillDmg: 42, skillCost: 22, weapon: 'fist', outfit: 'monk'},
      thief: {name: '盜賊', color: 0x252b38, hp: 110, mp: 85, atk: 27, matk: 8, def: 7, mdef: 6, skill: '影襲', skillDmg: 45, skillCost: 18, weapon: 'dagger', outfit: 'thief'},
      priest: {name: '聖職者', color: 0xf0ead8, hp: 115, mp: 140, atk: 10, matk: 22, def: 8, mdef: 13, skill: '治癒祈禱', skillDmg: 28, skillCost: 18, weapon: 'staff', outfit: 'priest', ranged: true}
    };

    // ============================================================================
    // CLASS CREATION + OUTFIT TIER SYSTEM V2
    // 5 playable classes are selected at character creation.
    // Outfit milestones are based on the supplied MMORPG reference sheet:
    // Lv.1 / 11 / 21 / 51 / 61 / 71 / 81 / 91.
    // ============================================================================
    const PLAYABLE_CLASS_IDS = ['warrior', 'monk', 'mage', 'priest', 'thief'];
    const EQUIPMENT_ALLOWED_LEVELS = [1, 11, 21, 41, 61, 71, 81, 91];
    const CLASS_OUTFIT_LEVELS = [...EQUIPMENT_ALLOWED_LEVELS];
    const CLASS_OUTFIT_TIER_INFO = [
      {level: 1, name: '新手裝', short: 'Lv.1', accent: '初心'},
      {level: 11, name: '精製裝', short: 'Lv.11', accent: '精製'},
      {level: 21, name: '進階裝', short: 'Lv.21', accent: '進階'},
      {level: 41, name: '王家裝', short: 'Lv.41', accent: '王家'},
      {level: 61, name: '英雄裝', short: 'Lv.61', accent: '英雄'},
      {level: 71, name: '傳承裝', short: 'Lv.71', accent: '傳承'},
      {level: 81, name: '聖域裝', short: 'Lv.81', accent: '聖域'},
      {level: 91, name: '終極裝', short: 'Lv.91', accent: '終極'}
    ];
    function classOutfitTierIndex(level) {
      const n = Math.max(1, Number(level) || 1);
      let idx = 0;
      for (let i = 0; i < CLASS_OUTFIT_LEVELS.length; i++)if (n >= CLASS_OUTFIT_LEVELS[i]) idx = i;
      return idx;
    }
    function classOutfitTierLevel(level) {return CLASS_OUTFIT_LEVELS[classOutfitTierIndex(level)];}
    function classOutfitTierInfo(level) {return CLASS_OUTFIT_TIER_INFO[classOutfitTierIndex(level)];}

    // 職業顏色與造型語言：貼身、窄腰、短版下擺，避免過去的圓筒／漏斗衣服。
    const CLASS_OUTFIT_STYLE = {
      warrior: {main: [0x111116, 0x111116, 0x111116, 0x111116, 0x111116, 0x111116, 0x111116, 0x111116, 0x111116], dark: [0x07080b, 0x07080b, 0x07080b, 0x07080b, 0x07080b, 0x07080b, 0x07080b, 0x07080b, 0x07080b], accent: [0x7f1828, 0x7f1828, 0x7f1828, 0x7f1828, 0x7f1828, 0x7f1828, 0x7f1828, 0x7f1828, 0x7f1828], trim: [0xc99a35, 0xc99a35, 0xc99a35, 0xc99a35, 0xc99a35, 0xc99a35, 0xc99a35, 0xc99a35, 0xc99a35], glow: 0xe43b50},
      monk: {
        main: [0x131417, 0x131417, 0x131417, 0x131417, 0x131417, 0x131417, 0x131417, 0x131417, 0x131417], dark: [0x09090b, 0x09090b, 0x09090b, 0x09090b, 0x09090b, 0x09090b, 0x09090b, 0x09090b, 0x09090b], accent: [0x8a272d, 0x8a272d, 0x8a272d, 0x8a272d, 0x8a272d, 0x8a272d, 0x8a272d, 0x8a272d, 0x8a272d], trim: [0xd1a13c, 0xd1a13c, 0xd1a13c, 0xd1a13c, 0xd1a13c, 0xd1a13c, 0xd1a13c, 0xd1a13c, 0xd1a13c], glow: 0xffc43e
      },
      mage: {main: [0x15161b, 0x15161b, 0x15161b, 0x15161b, 0x15161b, 0x15161b, 0x15161b, 0x15161b, 0x15161b], dark: [0x080a0d, 0x080a0d, 0x080a0d, 0x080a0d, 0x080a0d, 0x080a0d, 0x080a0d, 0x080a0d, 0x080a0d], accent: [0x1e6b45, 0x1e6b45, 0x1e6b45, 0x1e6b45, 0x1e6b45, 0x1e6b45, 0x1e6b45, 0x1e6b45, 0x1e6b45], trim: [0xc79b39, 0xc79b39, 0xc79b39, 0xc79b39, 0xc79b39, 0xc79b39, 0xc79b39, 0xc79b39, 0xc79b39], glow: 0x4edc82},
      priest: {
        main: [0xe8e8e2, 0xe8e8e2, 0xe8e8e2, 0xe8e8e2, 0xe8e8e2, 0xe8e8e2, 0xe8e8e2, 0xe8e8e2, 0xe8e8e2], dark: [0x202733, 0x202733, 0x202733, 0x202733, 0x202733, 0x202733, 0x202733, 0x202733, 0x202733], accent: [0x284f87, 0x284f87, 0x284f87, 0x284f87, 0x284f87, 0x284f87, 0x284f87, 0x284f87, 0x284f87], trim: [0xd5ae4b, 0xd5ae4b, 0xd5ae4b, 0xd5ae4b, 0xd5ae4b, 0xd5ae4b, 0xd5ae4b, 0xd5ae4b, 0xd5ae4b], glow: 0x54a7e8
      },
      thief: {main: [0x121419, 0x121419, 0x121419, 0x121419, 0x121419, 0x121419, 0x121419, 0x121419, 0x121419], dark: [0x07080c, 0x07080c, 0x07080c, 0x07080c, 0x07080c, 0x07080c, 0x07080c, 0x07080c, 0x07080c], accent: [0x633a93, 0x633a93, 0x633a93, 0x633a93, 0x633a93, 0x633a93, 0x633a93, 0x633a93, 0x633a93], trim: [0xc59a3e, 0xc59a3e, 0xc59a3e, 0xc59a3e, 0xc59a3e, 0xc59a3e, 0xc59a3e, 0xc59a3e, 0xc59a3e], glow: 0xb178ff}
    };
    const CLASS_OUTFIT_LABELS = {warrior: '戰士', monk: '武道家', mage: '法師', priest: '聖職者', thief: '盜賊'};

    // ============================================================================
    // 神佑外長外套（額外裝備）
    // - 獨立於「身」裝備，不會取代胸甲／法衣／皮甲。
    // - 只有 Lv.1 / 11 / 21 / 51 / 61 / 71 / 81 / 91 八個外觀節點。
    // - 沒有 normal / rare / epic / legendary 階級；以 divineBlessing 標記為獨特裝備。
    // - 每個職業維持自己的主色系，七個等級節點只改變剪裁、衣襬、領口與飾邊。
    // ============================================================================
    const DIVINE_CLOAK_LEVELS = [...EQUIPMENT_ALLOWED_LEVELS];
    const DIVINE_CLOAK_STYLE_INDEX = [0, 1, 2, 3, 4, 5, 6];
    function divineCloakLevelForCharacter(level) {
      const n = Math.max(1, Number(level) || 1);
      let out = DIVINE_CLOAK_LEVELS[0];
      for (const lv of DIVINE_CLOAK_LEVELS) if (n >= lv) out = lv;
      return out;
    }
    function divineCloakLevelIndex(level) {
      const lv = equipmentTierAtOrBelow(level);
      return Math.max(0, DIVINE_CLOAK_LEVELS.indexOf(lv));
    }
    // 神佑外套專用職業配色：不沿用一般職業服裝色，固定維持神佑外套的識別色。
    // 戰士：黑／紅／白；武道家：白／紅／黑；聖職者：白／藍／金；
    // 法師：黑／藍／金；盜賊：黑／紫／金。七個神佑節點只做明暗層次變化，不改變職業色系。
    const DIVINE_CLOAK_CLASS_PALETTE = {
      warrior: {
        main: [0x14161a, 0x16181c, 0x181a1f, 0x1a1c21, 0x1c1e24, 0x1e2027, 0x20232a, 0x22252d],
        dark: [0x07080b, 0x08090c, 0x090a0e, 0x0a0b0f, 0x0b0c10, 0x0d0e12, 0x0f1014, 0x111216],
        accent: [0x861827, 0x8f192a, 0x981b2e, 0xa31e31, 0xae2135, 0xb72539, 0xc02a3f, 0xc93145],
        trim: [0xc99b32, 0xd0a33a, 0xd7ab42, 0xdfb34a, 0xe6bb52, 0xedc25a, 0xf3ca62, 0xf8d06a],
        glow: 0xff4055, crystal: 0xd82b43, emblem: 0xe7b84e
      },
      monk: {
        main: [0x15161a, 0x17181d, 0x191a20, 0x1b1c22, 0x1d1f25, 0x1f2128, 0x21232b, 0x23262e],
        dark: [0x08090c, 0x090a0e, 0x0a0b0f, 0x0b0c10, 0x0c0d11, 0x0e0f13, 0x101115, 0x121317],
        accent: [0x8b1c2b, 0x941e2e, 0x9d2031, 0xa82235, 0xb12539, 0xba293d, 0xc32d42, 0xcc3247],
        trim: [0xc99b32, 0xd0a33a, 0xd7ab42, 0xdfb34a, 0xe6bb52, 0xedc25a, 0xf3ca62, 0xf8d06a],
        glow: 0xffc928, crystal: 0xf2bd31, emblem: 0xffd66b
      },
      priest: {
        main: [0xd9d8d3, 0xdad9d5, 0xdcdbd7, 0xdeddd9, 0xe0dfdb, 0xe2e1dd, 0xe4e3df, 0xe7e6e2],
        dark: [0x172946, 0x1a3152, 0x1d385d, 0x203e68, 0x234573, 0x274b7c, 0x2b5185, 0x2f578e],
        accent: [0x2f6fba, 0x3477c5, 0x397fd0, 0x3e87da, 0x438fe4, 0x4897ee, 0x4d9ff7, 0x55a7ff],
        trim: [0xc99b32, 0xd0a33a, 0xd7ab42, 0xdfb34a, 0xe6bb52, 0xedc25a, 0xf3ca62, 0xf8d06a],
        glow: 0x62bfff, crystal: 0x4d9dff, emblem: 0xf0cf66
      },
      mage: {
        main: [0x14171a, 0x16191d, 0x181b20, 0x1a1d23, 0x1c1f26, 0x1e2129, 0x20232c, 0x22252f],
        dark: [0x07090b, 0x080a0c, 0x090b0e, 0x0a0c0f, 0x0b0d10, 0x0d0f12, 0x0f1114, 0x111316],
        accent: [0x1e6a43, 0x22754a, 0x267f50, 0x2a8956, 0x2e935c, 0x329d62, 0x36a768, 0x3ab16e],
        trim: [0xc99b32, 0xd0a33a, 0xd7ab42, 0xdfb34a, 0xe6bb52, 0xedc25a, 0xf3ca62, 0xf8d06a],
        glow: 0x46e18a, crystal: 0x37c978, emblem: 0xe0c85d
      },
      thief: {
        main: [0x14151a, 0x16171c, 0x18191f, 0x1a1b22, 0x1c1d25, 0x1e1f28, 0x20212b, 0x22242e],
        dark: [0x07080b, 0x08090c, 0x090a0e, 0x0a0b0f, 0x0b0c10, 0x0d0e12, 0x0f1014, 0x111216],
        accent: [0x61319d, 0x6936aa, 0x713bb7, 0x7940c4, 0x8145d1, 0x894ade, 0x914feb, 0x9954f8],
        trim: [0xc99b32, 0xd0a33a, 0xd7ab42, 0xdfb34a, 0xe6bb52, 0xedc25a, 0xf3ca62, 0xf8d06a],
        glow: 0xa95cff, crystal: 0x9a58e8, emblem: 0xe1bd5b
      }
    };
    function divineCloakClassStyle(classId, level) {
      const cls = PLAYABLE_CLASS_IDS.includes(classId) ? classId : 'warrior';
      const st = DIVINE_CLOAK_CLASS_PALETTE[cls] || DIVINE_CLOAK_CLASS_PALETTE.warrior;
      const idx = DIVINE_CLOAK_STYLE_INDEX[divineCloakLevelIndex(level)] || 0;
      return {main: st.main[idx], dark: st.dark[idx], accent: st.accent[idx], trim: st.trim[idx], glow: st.glow};
    }
    function getCloakAdjustments() {
      const d = {scale: 0.97, width: 0.89, height: 1.13, depth: 1.45, y: -0.09, z: -0.08};
      const a = state.cloakAdjustments && typeof state.cloakAdjustments === 'object' ? state.cloakAdjustments : {};
      return {scale: Number.isFinite(Number(a.scale)) ? Number(a.scale) : d.scale, width: Number.isFinite(Number(a.width)) ? Number(a.width) : d.width, height: Number.isFinite(Number(a.height)) ? Number(a.height) : d.height, depth: Number.isFinite(Number(a.depth)) ? Number(a.depth) : d.depth, y: Number.isFinite(Number(a.y)) ? Number(a.y) : d.y, z: Number.isFinite(Number(a.z)) ? Number(a.z) : d.z};
    }
    function cloakAdjustmentsEqual(a, b) {
      return !!a && Math.abs(Number(a.scale) - b.scale) < 0.001 && Math.abs(Number(a.width) - b.width) < 0.001 && Math.abs(Number(a.height) - b.height) < 0.001 && Math.abs(Number(a.depth) - b.depth) < 0.001 && Math.abs(Number(a.y) - b.y) < 0.001 && Math.abs(Number(a.z) - b.z) < 0.001;
    }
    const DIVINE_CLOAK_DEFAULT_ADJUSTMENTS = {scale: .97, width: .89, height: 1.13, depth: 1.45, y: -.09, z: -.08};

    function setCloakAdjustment(key, value) {
      const allowed = {scale: [.90, 1.80], width: [.85, 1.55], height: [.90, 1.55], depth: [.80, 1.45], y: [-.30, .20], z: [-.60, .60]};
      if (!allowed[key]) return;
      const n = Number(value); if (!Number.isFinite(n)) return;
      if (!state.cloakAdjustments) state.cloakAdjustments = getCloakAdjustments();
      state.cloakAdjustments[key] = Math.max(allowed[key][0], Math.min(allowed[key][1], n));
      updateEquipmentVisual();
      refreshCloakAdjustPreview();
      saveGame();
      const el = document.getElementById('cloak_' + key + 'Value'); if (el) el.textContent = key === 'y' ? n.toFixed(2) : n.toFixed(2) + '×';
    }
    function resetCloakAdjustments() {
      state.cloakAdjustments = {scale: 0.97, width: 0.89, height: 1.13, depth: 1.45, y: -0.09, z: -0.08};
      updateEquipmentVisual(); saveGame(); appearanceAdjustTab = 'cloak'; renderModal('appearanceAdjust'); toast('🧥 神佑外套尺寸已重設');
    }
    function makeDivineBlessingCloakItem(classId = state.classId, level = state.level || 1) {
      const cls = PLAYABLE_CLASS_IDS.includes(classId) ? classId : 'warrior';
      const lv = divineCloakLevelForCharacter(level);
      const labels = {warrior: '戰士', monk: '武道家', mage: '法師', priest: '聖職者', thief: '盜賊'};
      const id = 'divine_cloak_' + cls + '_' + lv;
      const st = divineCloakClassStyle(cls, lv);
      return {
        id, name: '神佑外長外套 · ' + labels[cls] + ' Lv.' + lv, icon: '🧥', qty: 1,
        type: 'cloak', slot: 'cloak', classId: cls, allowedClasses: [cls], visual: 'divineCloak',
        family: 'divineCloak', itemLevel: lv, rarity: 'normal', specialSeries: 'divineBlessing',
        divineBlessing: true, dropable: true, atk: 0, def: Math.max(2, Math.floor(lv * .32)), mdef: Math.max(1, Math.floor(lv * .20)),
        cloakMain: st.main, cloakDark: st.dark, cloakAccent: st.accent, cloakTrim: st.trim
      };
    }


    // 技能系統：技能書可從怪物掉落，學習後才能裝入快捷欄；技能每次成功施放會累積熟練度，最高 Lv.99，等級提升會強化技能效果。
    // 所有 Buff 持續 5 分鐘；範圍／Buff 技能 CD 10 秒，其餘一般技能 CD 1 秒。
    // mage / priest 的攻擊技能使用魔攻；其普攻也使用魔攻。
    const SKILLS = {
      warrior: [
        {id: 'berserker_wind', name: '狂戰士之風', icon: '🌪️', type: 'buff', desc: '物攻 +20%、物防 +20%、魔防 +15%、HP回復 +10', buff: {atk: 0.20, def: 0.20, mdef: 0.15, hpRegen: 10}},
        {id: 'flame_slash', name: '烈焰斬', icon: '🔥', type: 'attack', power: 1.75, element: 'fire', desc: '強力火焰斬擊'},
