          })() +
          '<div class="menuGrid" style="margin-top:10px"><button type="button" class="menuCard" onclick="downloadArmWeaponAdjustmentJson(false)"><span class="big">💾</span>匯出本職 JSON</button><button type="button" class="menuCard" onclick="downloadArmWeaponAdjustmentJson(true)"><span class="big">📦</span>匯出五職 JSON</button><button type="button" class="menuCard" onclick="openArmWeaponAdjustmentFilePicker()"><span class="big">📥</span>匯入 JSON</button></div><input id="armWeaponAdjustmentImportFile" type="file" accept="application/json,.json" style="display:none" onchange="importArmWeaponAdjustmentFile(this)"><div class="menuActions"><button type="button" class="menuBtn" onclick="resetArmWeaponAdjustments(\''+armsCid+'\');appearanceAdjustTab=\'arms\';renderModal(\'appearanceAdjust\')">↺ 還原本職</button></div></div>';
        const panel = active === 'hat' ? hatPanel : (active === 'arms' ? armPanel : cloakPanel);
        c.innerHTML = '<h2>🎨 角色外觀調整</h2><p class="tip">3D 預覽直接使用<b>目前實體人物</b>的完整外觀，包含目前帽子、狼帽白色長髮、身體裝備、武器／盾牌、長袖、披肩與目前神佑外套。可在下方 Tab 切換神佑外套、帽子，以及手臂／武器位置；左側 3D 預覽會同步顯示。</p><div style="' + tabStyle + '">' + tabBtn('cloak', '🧥 神佑外套') + tabBtn('hat', '🎩 帽子') + tabBtn('arms', '🦾 手臂／武器') + '</div><div style="display:grid;grid-template-columns:minmax(280px,1.2fr) minmax(250px,.8fr);gap:12px;align-items:start"><div id="cloakAdjustPreviewViewport" style="height:520px;border:1px solid #4d6075;border-radius:12px;overflow:hidden;background:#0d1520;position:relative"><div style="position:absolute;left:10px;bottom:8px;z-index:2;color:#b9c7d8;font-size:10px;pointer-events:none">拖曳旋轉 3D 人物 · 使用目前實體外觀</div></div><div>' + panel + '</div></div><div class="menuActions"><button type="button" class="menuBtn" onclick="closeModal()">完成</button></div>';
        refreshCloakAdjustPreview(); return
      }

      if (type === 'stats') {renderStatsPanel('base'); return }
      if (type === 'auto') {renderAutoSettings(c); return }

      if (type === 'map') {
        const zones = Object.entries(zoneData);
        const iconFor = id => id === 'city' ? '🏰' : id.startsWith('beast') ? '🪨' : id.startsWith('alice') ? '🃏' : id === 'snowcity' ? '❄️' : id === 'volcano' ? '🌋' : id === 'demon' ? '👿' : id === 'seomi' ? '💧' : id === 'miluris' ? '🌲' : '🌳';
        const titleFor = id => id === 'city' ? '主城' : id === 'beastcave' ? '妖貓獸窟' : id.startsWith('alice') ? '愛麗絲夢境' : id === 'snowcity' ? '雪之城' : id === 'volcano' ? '火山地帶' : id === 'demon' ? '魔族領域' : id === 'seomi' ? '波特族森林' : id === 'miluris' ? '米爾里斯森林' : '路爾斯森林';
        const cards = zones.map(([id, v]) => {
          const range = v.range ? 'Lv.' + v.range[0] + ' – ' + v.range[1] : '安全區域';
          const current = id === state.zone;
          return '<button type="button" class="worldMapCard ' + (current ? 'current' : '') + '" onclick="goZone(\'' + id + '\');closeModal()">' +
            '<span class="mapIcon">' + iconFor(id) + '</span><span class="mapName">' + v.name + '</span><span class="mapLv">' + range + '</span>' +
            '<span class="mapTag ' + (current ? 'currentTag' : '') + '">' + (current ? '📍 目前' : '進入') + '</span></button>';
        }).join('');
